<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>WebGIS · Vườn Cây Cao Su</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Poppins:wght@600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"/>
  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

  <style>
    :root {
      --primary: #10b981;
      --primary-dark: #059669;
      --primary-light: #6ee7b7;
      --secondary: #0ea5e9;
      --accent: #f59e0b;
      --danger: #ef4444;
      --warning: #f59e0b;
      --success: #10b981;
      
      --bg-dark: #0f172a;
      --bg-darker: #051628;
      --surface: #1e293b;
      --surface-light: #334155;
      --border: #475569;
      --border-light: rgba(148, 163, 184, 0.2);
      
      --text-primary: #f1f5f9;
      --text-secondary: #cbd5e1;
      --text-muted: #94a3b8;
      
      --radius-sm: 6px;
      --radius-md: 10px;
      --radius-lg: 16px;
      --radius-xl: 24px;
      
      --shadow-sm: 0 1px 2px 0 rgba(0, 0, 0, 0.3);
      --shadow-md: 0 4px 6px -1px rgba(0, 0, 0, 0.4);
      --shadow-lg: 0 10px 15px -3px rgba(0, 0, 0, 0.5);
      --shadow-xl: 0 20px 25px -5px rgba(0, 0, 0, 0.6);
      
      --transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }

    * { 
      box-sizing: border-box; 
      margin: 0; 
      padding: 0; 
    }

    html, body {
      height: 100%;
      width: 100%;
    }

    body {
      font-family: 'Inter', sans-serif;
      background: var(--bg-dark);
      color: var(--text-primary);
      display: flex;
      flex-direction: column;
      overflow: hidden;
    }

    /* ============= HEADER ============= */
    header {
      height: 72px;
      background: linear-gradient(135deg, var(--surface) 0%, rgba(30, 41, 59, 0.8) 100%);
      border-bottom: 1px solid var(--border-light);
      display: flex;
      align-items: center;
      padding: 0 32px;
      gap: 24px;
      box-shadow: var(--shadow-md);
      position: relative;
      z-index: 10;
    }

    .logo {
      display: flex;
      align-items: center;
      gap: 12px;
      font-weight: 700;
      font-size: 18px;
      color: var(--text-primary);
      font-family: 'Poppins', sans-serif;
      letter-spacing: -0.5px;
    }

    .logo i {
      font-size: 24px;
      background: linear-gradient(135deg, var(--primary), var(--secondary));
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }

    .status {
      display: flex;
      align-items: center;
      gap: 8px;
      background: rgba(16, 185, 129, 0.15);
      color: var(--primary-light);
      padding: 8px 16px;
      border-radius: 20px;
      font-size: 13px;
      font-weight: 600;
      border: 1px solid rgba(16, 185, 129, 0.3);
    }

    .status::before {
      content: '';
      width: 8px;
      height: 8px;
      background: var(--primary);
      border-radius: 50%;
      animation: pulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
    }

    @keyframes pulse {
      0%, 100% { opacity: 1; }
      50% { opacity: 0.5; }
    }

    .stats-bar {
      display: flex;
      gap: 32px;
      margin-left: auto;
      font-size: 14px;
    }

    .stat-item {
      display: flex;
      flex-direction: column;
      gap: 2px;
    }

    .stat-item label {
      font-size: 12px;
      color: var(--text-muted);
      font-weight: 500;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }

    .stat-item strong {
      font-size: 18px;
      color: var(--primary);
      font-weight: 700;
    }

    .user-info {
      display: flex;
      align-items: center;
      gap: 12px;
      margin-left: 32px;
      padding-left: 32px;
      border-left: 1px solid var(--border-light);
    }

    .avatar {
      width: 40px;
      height: 40px;
      background: linear-gradient(135deg, var(--primary), var(--secondary));
      border-radius: 10px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: 700;
      color: white;
      font-size: 14px;
    }

    /* ============= LAYOUT UTAMA ============= */
    .container {
      display: flex;
      flex: 1;
      overflow: hidden;
      gap: 0;
    }

    /* ============= SIDEBAR ============= */
    .sidebar {
      width: 220px;
      background: var(--surface);
      border-right: 1px solid var(--border-light);
      padding: 20px 0;
      overflow-y: auto;
      flex-shrink: 0;
      display: flex;
      flex-direction: column;
    }

    .sidebar-header {
      padding: 0 16px;
      margin-bottom: 20px;
    }

    .sidebar-header h3 {
      font-size: 11px;
      color: var(--text-muted);
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 1px;
    }

    .sidebar nav {
      display: flex;
      flex-direction: column;
      gap: 4px;
      padding: 0 12px;
      flex: 1;
    }

    .sidebar a {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 10px 14px;
      color: var(--text-secondary);
      text-decoration: none;
      border-radius: var(--radius-md);
      transition: var(--transition);
      font-size: 13px;
      font-weight: 500;
      position: relative;
    }

    .sidebar a::before {
      content: '';
      position: absolute;
      left: 0;
      top: 0;
      bottom: 0;
      width: 3px;
      background: var(--primary);
      border-radius: 0 3px 3px 0;
      opacity: 0;
      transition: var(--transition);
    }

    .sidebar a:hover {
      background: rgba(16, 185, 129, 0.1);
      color: var(--primary);
    }

    .sidebar a.active {
      background: rgba(16, 185, 129, 0.2);
      color: var(--primary);
    }

    .sidebar a.active::before {
      opacity: 1;
    }

    .sidebar a i {
      font-size: 16px;
      width: 18px;
      text-align: center;
    }

    .sidebar-footer {
      padding: 12px 12px;
      border-top: 1px solid var(--border-light);
      margin-top: auto;
    }

    .sidebar a.logout {
      color: var(--danger);
    }

    .sidebar a.logout:hover {
      background: rgba(239, 68, 68, 0.1);
    }

    /* ============= MAIN CONTENT ============= */
    .main {
      flex: 1;
      display: flex;
      flex-direction: column;
      overflow: hidden;
    }

    .top-bar {
      height: 64px;
      background: linear-gradient(135deg, rgba(30, 41, 59, 0.6), rgba(15, 23, 42, 0.8));
      border-bottom: 1px solid var(--border-light);
      padding: 0 32px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 24px;
    }

    .top-bar-title {
      display: flex;
      flex-direction: column;
      gap: 4px;
    }

    .top-bar-title h2 {
      font-size: 28px;
      font-weight: 700;
      color: var(--text-primary);
      font-family: 'Poppins', sans-serif;
    }

    .top-bar-title p {
      font-size: 12px;
      color: var(--text-muted);
    }

    .top-bar-controls {
      display: flex;
      align-items: center;
      gap: 16px;
      margin-left: auto;
    }

    .export-btn {
      display: flex;
      align-items: center;
      gap: 8px;
      padding: 8px 16px;
      background: rgba(15, 23, 42, 0.6);
      color: var(--text-secondary);
      border: 1px solid var(--border-light);
      border-radius: var(--radius-md);
      cursor: pointer;
      font-size: 13px;
      transition: var(--transition);
    }

    .export-btn:hover {
      background: rgba(16, 185, 129, 0.1);
      color: var(--primary);
      border-color: var(--primary);
    }

    .add-btn {
      display: flex;
      align-items: center;
      gap: 8px;
      padding: 8px 16px;
      background: var(--primary);
      color: white;
      border: none;
      border-radius: var(--radius-md);
      cursor: pointer;
      font-size: 13px;
      font-weight: 600;
      transition: var(--transition);
    }

    .add-btn:hover {
      background: var(--primary-dark);
    }

    /* ============= FILTER BAR ============= */
    .filter-bar {
      height: auto;
      background: rgba(30, 41, 59, 0.5);
      border-bottom: 1px solid var(--border-light);
      padding: 16px 32px;
      display: flex;
      align-items: center;
      gap: 16px;
      overflow-x: auto;
    }

    .filter-badge {
      display: flex;
      align-items: center;
      gap: 8px;
      padding: 8px 12px;
      background: rgba(16, 185, 129, 0.15);
      color: var(--primary);
      border-radius: var(--radius-md);
      border: 1px solid rgba(16, 185, 129, 0.3);
      font-size: 12px;
      font-weight: 500;
      white-space: nowrap;
      cursor: pointer;
      transition: var(--transition);
    }

    .filter-badge:hover {
      background: rgba(16, 185, 129, 0.25);
    }

    .filter-badge.active {
      background: var(--primary);
      color: white;
    }

    .filter-select {
      padding: 6px 12px;
      background: rgba(30, 41, 59, 0.6);
      color: var(--text-secondary);
      border: 1px solid var(--border-light);
      border-radius: var(--radius-sm);
      font-size: 12px;
      cursor: pointer;
      transition: var(--transition);
    }

    .filter-select:hover {
      border-color: var(--primary);
      color: var(--text-primary);
    }

    /* ============= MAP CONTAINER ============= */
    .map-wrapper {
      flex: 1;
      position: relative;
      overflow: hidden;
      background: var(--bg-dark);
    }

    #dashMap {
      width: 100%;
      height: 100%;
    }

    .map-control-panel {
      position: absolute;
      bottom: 32px;
      right: 32px;
      display: flex;
      flex-direction: column;
      gap: 12px;
      z-index: 400;
    }

    .map-control-btn {
      width: 44px;
      height: 44px;
      background: var(--surface);
      border: 1px solid var(--border-light);
      border-radius: var(--radius-md);
      color: var(--text-secondary);
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 16px;
      transition: var(--transition);
      box-shadow: var(--shadow-md);
    }

    .map-control-btn:hover {
      background: var(--primary);
      color: white;
      border-color: var(--primary);
    }

    .zoom-slider-container {
      display: flex;
      flex-direction: column;
      gap: 8px;
      align-items: center;
      background: var(--surface);
      padding: 12px 8px;
      border-radius: var(--radius-md);
      border: 1px solid var(--border-light);
      box-shadow: var(--shadow-md);
    }

    .zoom-slider {
      width: 30px;
      height: 120px;
      writing-mode: bt-lr;
      -webkit-appearance: slider-vertical;
      -moz-appearance: slider-vertical;
      appearance: slider-vertical;
    }

    .zoom-label {
      font-size: 12px;
      font-weight: 600;
      color: var(--primary);
      text-align: center;
      min-width: 24px;
    }

    /* ============= LEGEND ============= */
    .legend-panel {
      position: absolute;
      bottom: 32px;
      left: 32px;
      background: var(--surface);
      border: 1px solid var(--border-light);
      border-radius: var(--radius-lg);
      padding: 16px;
      box-shadow: var(--shadow-lg);
      max-width: 280px;
      z-index: 400;
      max-height: 50vh;
      overflow-y: auto;
    }

    .legend-panel h4 {
      font-size: 14px;
      color: var(--text-primary);
      margin-bottom: 12px;
      font-weight: 600;
    }

    .legend-items {
      display: flex;
      flex-direction: column;
      gap: 10px;
    }

    .legend-item {
      display: flex;
      align-items: center;
      gap: 10px;
      font-size: 12px;
      color: var(--text-secondary);
    }

    .legend-color {
      width: 16px;
      height: 16px;
      border-radius: var(--radius-sm);
      flex-shrink: 0;
    }

    /* ============= TOAST ============= */
    #toast {
      position: fixed;
      bottom: 32px;
      left: 50%;
      transform: translateX(-50%) translateY(200px);
      background: var(--surface);
      color: var(--text-primary);
      padding: 12px 24px;
      border-radius: var(--radius-lg);
      border: 1px solid var(--border-light);
      box-shadow: var(--shadow-lg);
      z-index: 9999;
      transition: transform 0.3s ease;
      font-size: 13px;
      display: flex;
      align-items: center;
      gap: 12px;
    }

    #toast.show {
      transform: translateX(-50%) translateY(0);
    }

    #toastIcon {
      font-size: 16px;
    }

    /* ============= SEARCH ============= */
    .search-input {
      padding: 8px 16px;
      background: rgba(30, 41, 59, 0.6);
      border: 1px solid var(--border-light);
      border-radius: var(--radius-md);
      color: var(--text-primary);
      font-size: 13px;
      width: 200px;
      transition: var(--transition);
    }

    .search-input:focus {
      outline: none;
      border-color: var(--primary);
      background: rgba(30, 41, 59, 0.9);
    }

    /* ============= SCROLLBAR ============= */
    ::-webkit-scrollbar {
      width: 6px;
      height: 6px;
    }

    ::-webkit-scrollbar-track {
      background: transparent;
    }

    ::-webkit-scrollbar-thumb {
      background: var(--border);
      border-radius: 3px;
    }

    ::-webkit-scrollbar-thumb:hover {
      background: var(--primary);
    }
  /* ============= LAYER MANAGER ============= */
.layer-manager-panel {
  position: absolute;
  top: 80px;
  right: 20px;
  background: var(--surface);
  border: 1px solid var(--border-light);
  border-radius: var(--radius-lg);
  padding: 18px 20px;
  width: 280px;
  box-shadow: var(--shadow-xl);
  z-index: 1000;
  display: none;
  max-height: 70vh;
  overflow-y: auto;
}

.layer-manager-panel h4 {
  margin-bottom: 16px;
  font-size: 15px;
  color: var(--primary);
  display: flex;
  align-items: center;
  gap: 8px;
}

.layer-list {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.layer-item {
  display: flex;
  align-items: center;
  padding: 10px 12px;
  background: rgba(255,255,255,0.05);
  border-radius: var(--radius-md);
  transition: var(--transition);
}

.layer-item:hover {
  background: rgba(16, 185, 129, 0.12);
}

.layer-item label {
  display: flex;
  align-items: center;
  gap: 10px;
  width: 100%;
  cursor: pointer;
  font-size: 13.5px;
  color: var(--text-secondary);
}

.layer-item input[type="checkbox"] {
  accent-color: var(--primary);
  width: 16px;
  height: 16px;
}

/* Nhãn lớp */
.lot-label {
  background: rgba(0,0,0,0.65);
  padding: 2px 6px;
  border-radius: 4px;
  font-size: 11px;
  color: white;
  text-align: center;
  line-height: 1.2;
  text-shadow: 0 1px 2px rgba(0,0,0,0.8);
  pointer-events: none;
}
  </style>
</head>

<body>
  <!-- ========== HEADER ========== -->
  <header>
    <div class="logo">
      <i class="fas fa-leaf"></i>
      <span style="display: flex; flex-direction: column; gap: 0; line-height: 1;">
        <span style="font-size: 18px;">WEBGIS CAO SU</span>
        <span style="font-size: 11px; color: var(--text-muted); font-weight: 400;">TỔNG CÔNG TY</span>
      </span>
    </div>
    <div class="status">
      <span>🟢 Trực tuyến</span>
    </div>
    <div class="stats-bar">
      <div class="stat-item">
        <label>Lô vườn</label>
        <strong id="statsTotal">425</strong>
      </div>
      <div class="stat-item">
        <label>Diện tích</label>
        <strong id="statsArea">7.244 ha</strong>
      </div>
    </div>
    <div class="user-info">
      <div style="display: flex; align-items: center; gap: 12px; cursor: pointer;">
        <i class="fas fa-bell" style="font-size: 18px; color: var(--text-secondary);"></i>
        <i class="fas fa-globe" style="font-size: 18px; color: var(--text-secondary);"></i>
        <i class="fas fa-cog" style="font-size: 18px; color: var(--text-secondary);"></i>
      </div>
      <div style="display: flex; align-items: center; gap: 8px; padding-left: 16px; border-left: 1px solid var(--border-light);">
        <div style="display: flex; flex-direction: column; align-items: flex-end; gap: 2px;">
          <span style="font-size: 13px; color: var(--text-primary);">Nguyễn Văn An</span>
          <span style="font-size: 11px; color: var(--text-muted);">Quản lý vườn</span>
        </div>
        <div class="avatar" id="userAvatar">NA</div>
      </div>
    </div>
  </header>

  <!-- MAIN CONTAINER -->
  <div class="container">
    <!-- SIDEBAR -->
    <aside class="sidebar">
      <div class="sidebar-icon-group">
        <a href="#" class="active" title="Trang chủ">
          <i class="fas fa-home"></i>
        </a>
        <a href="#" title="Tìm kiếm">
          <i class="fas fa-search"></i>
        </a>
        <a href="#" title="Bản đồ">
          <i class="fas fa-map"></i>
        </a>
      </div>

      <div class="sidebar-divider"></div>

      <div class="sidebar-icon-group">
        <a href="#" title="Phân tích">
          <i class="fas fa-chart-bar"></i>
        </a>
        <a href="#" title="Cài đặt">
          <i class="fas fa-cog"></i>
        </a>
        <a href="#" title="Công cụ">
          <i class="fas fa-tools"></i>
        </a>
      </div>

      <div class="sidebar-footer">
        <a href="#" class="logout" title="Đăng xuất">
          <i class="fas fa-sign-out-alt"></i>
        </a>
      </div>
    </aside>

    <!-- MAIN CONTENT -->
    <div class="main">
      <!-- TOP BAR -->
      <div class="top-bar">
        <div class="top-bar-title">
          <h2>Xã Kraya, Huyện Santuk, Kampong Thom</h2>
          <p>Hệ thống quản lý và giám sát vườn cây cao su</p>
        </div>
        <div class="top-bar-controls">
          <div class="export-dropdown">
            <button class="export-btn" onclick="toggleExportMenu()" title="Xuất bản đồ">
              <i class="fas fa-download"></i>
              Xuất bản đồ
              <i class="fas fa-chevron-down" style="font-size: 10px; margin-left: 4px;"></i>
            </button>
            <div class="export-menu" id="exportMenu">
              <button class="export-menu-item" onclick="exportMapAsImage()">
                <i class="fas fa-image"></i> Xuất thành ảnh (PNG)
              </button>
              <button class="export-menu-item" onclick="exportMapAsPDF()">
                <i class="fas fa-file-pdf"></i> Xuất thành PDF
              </button>
            </div>
          </div>
          <button class="add-btn">
            <i class="fas fa-plus"></i>
            Thêm lô
          </button>
        </div>
      </div>

      <!-- FILTER BAR -->
      <div class="filter-bar">
        <div style="display: flex; gap: 12px; align-items: center; margin-left: auto; flex-wrap: wrap;">
          <span style="font-size: 12px; color: var(--text-muted);">Đội:</span>
          <select class="filter-select" name="doi">
            <option value="">Tất cả</option>
          </select>
          
          <span style="font-size: 12px; color: var(--text-muted);">Năm trồng:</span>
          <select class="filter-select" name="nam_trong">
            <option value="">Tất cả</option>
          </select>

          <span style="font-size: 12px; color: var(--text-muted);">Giống cây:</span>
          <select class="filter-select" name="giong">
            <option value="">Tất cả</option>
          </select>

          <span style="font-size: 12px; color: var(--text-muted);">Phân loại:</span>
          <select class="filter-select">
            <option>Tất cả</option>
          </select>

          <span style="font-size: 12px; color: var(--text-muted);">Nhịp độ cao:</span>
          <select class="filter-select">
            <option>Tất cả</option>
          </select>

          <span style="font-size: 12px; color: var(--text-muted);">Quay hoạch tài canh:</span>
          <select class="filter-select">
            <option>Tất cả</option>
          </select>
        </div>
      </div>

      <!-- MAP WRAPPER -->
      <div class="map-wrapper">
        <div id="dashMap"></div>

        <!-- MAP CONTROL PANEL -->
<div class="map-control-panel">
  <button class="map-control-btn" onclick="zoomMapIn()" title="Phóng to">
    <i class="fas fa-plus"></i>
  </button>
  <div class="zoom-slider-container">
    <input type="range" id="zoomRange" class="zoom-slider" min="3" max="20" value="12" onchange="setZoomLevel(this.value)">
    <span class="zoom-label" id="zoomLabel">12</span>
  </div>
  <button class="map-control-btn" onclick="zoomMapOut()" title="Thu nhỏ">
    <i class="fas fa-minus"></i>
  </button>
  <button class="map-control-btn" onclick="zoomHome()" title="Về vị trí gốc">
    <i class="fas fa-home"></i>
  </button>
  <button class="map-control-btn" onclick="toggleLayerManager()" title="Quản lý lớp bản đồ">
    <i class="fas fa-layer-group"></i>
  </button>
</div>

<!-- LAYER MANAGER PANEL -->
<div class="layer-manager-panel" id="layerManager">
  <h4><i class="fas fa-layer-group"></i> Quản lý lớp bản đồ</h4>
  <div class="layer-list">
    <div class="layer-item">
      <label>
        <input type="checkbox" id="chk-satellite" checked onchange="toggleBasemap()">
        <span>🌍 Ảnh vệ tinh (Basemap)</span>
      </label>
    </div>
    <div class="layer-item">
      <label>
        <input type="checkbox" id="chk-background-lots" checked onchange="toggleLayer('backgroundLots')">
        <span>📍 Nền lô (Background Lots)</span>
      </label>
    </div>
    <div class="layer-item">
      <label>
        <input type="checkbox" id="chk-main-lots" checked onchange="toggleLayer('mainLots')">
        <span>🟩 Lô chính (Màu theo giai đoạn)</span>
      </label>
    </div>
    <div class="layer-item">
      <label>
        <input type="checkbox" id="chk-labels" checked onchange="toggleLayer('labels')">
        <span>🏷️ Nhãn lô</span>
      </label>
    </div>
    <div class="layer-item">
      <label>
        <input type="checkbox" id="chk-zones" checked onchange="toggleLayer('zones')">
        <span>🔲 Nền vùng (Ranh giới đội)</span>
      </label>
    </div>
  </div>
</div>
      </div>
    </div>
  </div>

  <!-- TOAST NOTIFICATION -->
  <div id="toast">
    <span id="toastIcon">✅</span>
    <span id="toastMsg">Đã cập nhật thành công</span>
  </div>

  <!-- SCRIPTS -->
<script src="https://unpkg.com/@turf/turf@6/turf.min.js"></script>

<script>
// ==================== BIẾN TOÀN CỤC ====================
let dashMap = null;

let basemapSatellite = null;
let backgroundLotsLayer = null;
let mainLotsLayer = null;
let labelLayer = null;
let zoneBoundaryLayer = null;

let currentFilters = {};

// ==================== API CONFIG ====================
const API_BASE = window.location.hostname === 'localhost' || window.location.hostname === '127.0.0.1'
  ? 'http://localhost:3000'
  : 'https://caosu-sncx.vercel.app';

// ==================== API FUNCTIONS ====================

async function fetchLoCaoSu(filters = {}) {
  try {
    const params = new URLSearchParams();
    if (filters.doi) params.append('doi', filters.doi);
    if (filters.nam_trong) params.append('nam_trong', filters.nam_trong);
    if (filters.giong) params.append('giong', filters.giong);

    const response = await fetch(`${API_BASE}/api/lo-cao-su?${params.toString()}`);
    if (!response.ok) throw new Error(`HTTP ${response.status}`);
    
    return await response.json();
  } catch (error) {
    console.error('❌ Lỗi fetchLoCaoSu:', error);
    return { type: 'FeatureCollection', features: [] };
  }
}

async function fetchBoundary(doi = null) {
  try {
    const params = new URLSearchParams();
    if (doi) params.append('doi', doi);
    const response = await fetch(`${API_BASE}/api/boundary?${params.toString()}`);
    if (!response.ok) throw new Error(`HTTP ${response.status}`);
    return await response.json();
  } catch (error) {
    console.error('❌ Lỗi fetchBoundary:', error);
    return { type: 'FeatureCollection', features: [] };
  }
}

async function fetchMapData(filters = {}) {
  try {
    const [loData, boundaryData] = await Promise.all([
      fetchLoCaoSu(filters),
      fetchBoundary(filters.doi || null)
    ]);

    return {
      plots: loData.features || [],
      boundaries: boundaryData.features || []
    };
  } catch (error) {
    console.error('❌ Lỗi fetchMapData:', error);
    showToast('Lỗi tải dữ liệu bản đồ', '❌');
    return null;
  }
}

// ==================== KHỞI TẠO BẢN ĐỒ ====================
async function initDashMap() {
  console.log('🚀 Khởi tạo bản đồ...');

  dashMap = L.map('dashMap', {
    zoomControl: false,
    attributionControl: true
  }).setView([12.524, 105.452], 12);

  // Basemap vệ tinh
  basemapSatellite = L.tileLayer('https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}', {
    attribution: '© Esri World Imagery',
    maxZoom: 19
  }).addTo(dashMap);

  // Tải dữ liệu lần đầu
  const mapData = await fetchMapData(currentFilters);
  if (mapData) {
    createAllLayers(mapData);
  }

  // Khởi tạo filter dropdowns
  await loadFilterDropdowns();

  // Sự kiện thay đổi filter
  setupFilterListeners();

  showToast('Bản đồ đã tải thành công', '✅');
}

// ==================== TẠO TẤT CẢ CÁC LAYER ====================
function createAllLayers(mapData) {
  // Xóa các layer cũ nếu có
  if (backgroundLotsLayer) dashMap.removeLayer(backgroundLotsLayer);
  if (mainLotsLayer) dashMap.removeLayer(mainLotsLayer);
  if (labelLayer) dashMap.removeLayer(labelLayer);
  if (zoneBoundaryLayer) dashMap.removeLayer(zoneBoundaryLayer);

  // 5. Zone Boundary
  if (mapData.boundaries?.length > 0) {
    zoneBoundaryLayer = L.geoJSON({
      type: 'FeatureCollection',
      features: mapData.boundaries
    }, {
      style: {
        color: '#94a3b8',
        weight: 3.5,
        opacity: 0.75,
        fillOpacity: 0.06,
        dashArray: '6, 3'
      }
    }).addTo(dashMap);
  }

  if (mapData.plots?.length > 0) {
    const geoCollection = { type: 'FeatureCollection', features: mapData.plots };

    // 2. Background Lots
    backgroundLotsLayer = L.geoJSON(geoCollection, {
      style: {
        color: '#cbd5e1',
        weight: 1.5,
        opacity: 0.65,
        fillColor: '#1e2937',
        fillOpacity: 0.18
      }
    }).addTo(dashMap);

    // 3. Main Lots (màu theo năm)
    mainLotsLayer = L.geoJSON(geoCollection, {
      style: (feature) => {
        const year = parseInt(feature.properties.nam_trong);
        const colorMap = {
          2025: '#5ee7b1',
          2024: '#10b981',
          2023: '#0ea5e9',
          2022: '#f59e0b',
          2021: '#fb923c',
          2020: '#ef4444'
        };
        return {
          color: colorMap[year] || '#8b5cf6',
          weight: 2.8,
          opacity: 0.95,
          fillOpacity: 0.48
        };
      },
      onEachFeature: (feature, layer) => {
        const p = feature.properties;
        const popup = `
          <div style="min-width: 240px;">
            <strong style="color:#10b981;">${p.ten_lo || 'Lô ' + p.id_lo}</strong><br>
            <hr style="margin:6px 0;">
            Đội: <strong>${p.doi || 'N/A'}</strong><br>
            Giống: ${p.giong || 'N/A'}<br>
            Năm trồng: <strong>${p.nam_trong || 'N/A'}</strong><br>
            Diện tích: <strong>${p.dien_tich_map ? p.dien_tich_map + ' ha' : 'N/A'}</strong>
          </div>
        `;
        layer.bindPopup(popup);
      }
    }).addTo(dashMap);

    // 4. Labels
    createLabelLayer(mapData.plots);
  }
}

// ==================== TẠO LAYER NHÃN ====================
function createLabelLayer(plots) {
  labelLayer = L.layerGroup().addTo(dashMap);

  plots.forEach(feature => {
    if (feature.geometry?.type === 'Polygon' || feature.geometry?.type === 'MultiPolygon') {
      try {
        const centroid = turf.centroid(feature);
        const coords = centroid.geometry.coordinates;
        const props = feature.properties;

        const labelHtml = `
          <div class="lot-label">
            ${props.ten_lo || props.id_lo}<br>
            <small style="opacity:0.9;">${props.nam_trong}</small>
          </div>
        `;

        const label = L.marker([coords[1], coords[0]], {
          icon: L.divIcon({
            className: '',
            html: labelHtml,
            iconSize: [70, 40],
            iconAnchor: [35, 20]
          }),
          interactive: false
        });

        labelLayer.addLayer(label);
      } catch (e) {
        console.warn('Không tạo nhãn cho lô:', feature.properties.id_lo);
      }
    }
  });
}

// ==================== FILTER FUNCTIONS ====================

async function loadFilterDropdowns() {
  try {
    await Promise.all([
      fetchDashboardStats(),
      fetchDonViList(),
      fetchGiongStats(),
      fetchNamTrongStats()
    ]);
  } catch (e) {
    console.error('Lỗi load filter dropdowns:', e);
  }
}

function setupFilterListeners() {
  const filters = ['doi', 'nam_trong', 'giong'];

  filters.forEach(filterName => {
    const select = document.querySelector(`select[name="${filterName}"]`);
    if (select) {
      select.addEventListener('change', async () => {
        currentFilters[filterName] = select.value || null;
        
        console.log('🔄 Đang áp dụng filter:', currentFilters);
        
        // Tải lại dữ liệu với filter mới
        const mapData = await fetchMapData(currentFilters);
        if (mapData) {
          createAllLayers(mapData);
          showToast(`Đã áp dụng bộ lọc - ${mapData.plots.length} lô`, '🔍');
        }
      });
    }
  });
}

// ==================== TOGGLE LAYER ====================
function toggleBasemap() {
  const checked = document.getElementById('chk-satellite').checked;
  if (checked) {
    if (!dashMap.hasLayer(basemapSatellite)) basemapSatellite.addTo(dashMap);
  } else {
    if (dashMap.hasLayer(basemapSatellite)) dashMap.removeLayer(basemapSatellite);
  }
}

function toggleLayer(layerName) {
  const checked = document.getElementById(`chk-${layerName.replace(/([A-Z])/g, '-$1').toLowerCase()}`).checked;
  
  let layer = null;
  switch(layerName) {
    case 'backgroundLots': layer = backgroundLotsLayer; break;
    case 'mainLots':       layer = mainLotsLayer; break;
    case 'labels':         layer = labelLayer; break;
    case 'zones':          layer = zoneBoundaryLayer; break;
  }

  if (layer) {
    if (checked) {
      if (!dashMap.hasLayer(layer)) layer.addTo(dashMap);
    } else {
      if (dashMap.hasLayer(layer)) dashMap.removeLayer(layer);
    }
  }
}

// ==================== TOAST ====================
function showToast(msg, icon = '✅') {
  const t = document.getElementById('toast');
  if (!t) return;
  document.getElementById('toastIcon').innerHTML = icon;
  document.getElementById('toastMsg').innerHTML = msg;
  t.classList.add('show');
  setTimeout(() => t.classList.remove('show'), 4000);
}
    function zoomMapIn() {
      if (dashMap) {
        const currentZoom = dashMap.getZoom();
        dashMap.setZoom(currentZoom + 1);
        document.getElementById('zoomRange').value = currentZoom + 1;
        updateZoomLabel(currentZoom + 1);
      }
    }

    function zoomMapOut() {
      if (dashMap) {
        const currentZoom = dashMap.getZoom();
        dashMap.setZoom(currentZoom - 1);
        document.getElementById('zoomRange').value = currentZoom - 1;
        updateZoomLabel(currentZoom - 1);
      }
    }

    function setZoomLevel(level) {
      if (dashMap) {
        dashMap.setZoom(parseInt(level));
        updateZoomLabel(level);
      }
    }

    function updateZoomLabel(level) {
      document.getElementById('zoomLabel').textContent = level;
    }

    function zoomHome() {
      if (dashMap) {
        dashMap.setView([12.524, 105.452], 12);
        document.getElementById('zoomRange').value = 12;
        updateZoomLabel(12);
        showToast("Quay về vị trí ban đầu", "🏠");
      }
    }

    function initZoomSync() {
      if (dashMap) {
        dashMap.on('zoomend', () => {
          const zoom = dashMap.getZoom();
          document.getElementById('zoomRange').value = zoom;
          updateZoomLabel(zoom);
        });
      }
    }

    function toggleMeasurePanel() {
      showToast("Công cụ đo lường đang được phát triển", "📏");
    }

    function toggleBasemapGallery() {
      showToast("Đã chuyển sang bản đồ vệ tinh", "🗺️");
      if (basemapLayers[currentBasemap] && dashMap.hasLayer(basemapLayers[currentBasemap])) {
        dashMap.removeLayer(basemapLayers[currentBasemap]);
      }
      currentBasemap = currentBasemap === 'osm' ? 'satellite' : 'osm';
      basemapLayers[currentBasemap].addTo(dashMap);
      basemapLayers[currentBasemap].bringToBack();
    }

    function toggleLayerList() {
      showToast(layerVisibility.loCay ? "Ẩn lô cây" : "Hiển thị lô cây", "👁️");
      layerVisibility.loCay = !layerVisibility.loCay;
      if (layerVisibility.loCay) {
        if (thematicLayer) dashMap.addLayer(thematicLayer);
      } else {
        if (thematicLayer) dashMap.removeLayer(thematicLayer);
      }
    }

    // ==================== FILTER & SEARCH ====================
    async function applyMapFilters() {
      const filters = {
        doi: document.querySelector('select[name="doi"]')?.value || '',
        nam_trong: document.querySelector('select[name="nam_trong"]')?.value || '',
        giong: document.querySelector('select[name="giong"]')?.value || ''
      };

      // Loại bỏ filter rỗng
      Object.keys(filters).forEach(key => filters[key] === '' && delete filters[key]);

      console.log('📍 Áp dụng filter:', filters);
      showToast('Đang cập nhật bản đồ...', '⏳');

      // Lấy dữ liệu lọc từ API
      const loData = await fetchLoCaoSu(filters);
      
      if (!loData.features) {
        showToast('Không có dữ liệu phù hợp', '⚠️');
        return;
      }

      // Xóa layer cũ
      if (thematicLayer) dashMap.removeLayer(thematicLayer);

      // Tạo layer mới từ dữ liệu lọc
      if (loData.features.length > 0) {
        thematicLayer = L.geoJSON(loData, {
          style: (feature) => {
            let color = '#10b981';
            if (feature.properties.nam_trong) {
              const year = feature.properties.nam_trong;
              const yearMap = {
                2025: '#5ee7b1',
                2024: '#10b981',
                2023: '#0ea5e9',
                2022: '#f59e0b',
                2021: '#fb923c',
                2020: '#ef4444'
              };
              color = yearMap[year] || '#8b5cf6';
            }
            return {
              color: color,
              weight: 2,
              opacity: 0.8,
              fillOpacity: 0.4
            };
          },
          onEachFeature: (feature, layer) => {
            const props = feature.properties;
            const popupContent = `
              <div style="font-family: Arial, sans-serif; font-size: 12px; width: 250px;">
                <strong style="color: #10b981; font-size: 14px;">${props.ten_lo || 'Lô ' + props.id_lo}</strong><br/>
                <hr style="margin: 5px 0; border: none; border-top: 1px solid #e5e7eb;">
                <div style="line-height: 1.6;">
                  <strong>ID:</strong> ${props.id_lo}<br/>
                  <strong>Đội:</strong> ${props.doi || 'N/A'}<br/>
                  <strong>Giống:</strong> ${props.giong || 'N/A'}<br/>
                  <strong>Năm trồng:</strong> ${props.nam_trong || 'N/A'}<br/>
                  <strong>Diện tích:</strong> ${props.dien_tich_map ? props.dien_tich_map + ' ha' : 'N/A'}<br/>
                  <strong>Chế độ cao:</strong> ${props.che_do_cao || 'N/A'}<br/>
                  <strong>Cây cao:</strong> ${props.cay_cao || 'N/A'}
                </div>
              </div>
            `;
            layer.bindPopup(popupContent);
          }
        }).addTo(dashMap);
      }

      showToast(`Hiển thị ${loData.features.length} lô cây`, '✅');
    }
     // ==================== EXPORT MAP FUNCTIONS ====================
    function toggleExportMenu() {
      const menu = document.getElementById('exportMenu');
      menu.style.display = menu.style.display === 'none' ? 'block' : 'none';
      
      // Đóng menu khi click bên ngoài
      document.addEventListener('click', (e) => {
        if (!e.target.closest('.export-btn') && !e.target.closest('.export-menu')) {
          menu.style.display = 'none';
        }
      }, { once: true });
    }

    function exportMapAsImage() {
      const menu = document.getElementById('exportMenu');
      menu.style.display = 'none';
      
      showToast('Đang xuất bản đồ...', '⏳');
      
      const mapContainer = document.querySelector('.map-wrapper');
      
      html2canvas(mapContainer, {
        backgroundColor: '#0f172a',
        scale: 2,
        useCORS: true,
        allowTaint: true
      }).then(canvas => {
        const link = document.createElement('a');
        link.href = canvas.toDataURL('image/png');
        link.download = `ban-do-cao-su-${new Date().toISOString().split('T')[0]}.png`;
        link.click();
        showToast('Xuất hình ảnh thành công!', '✅');
      }).catch(err => {
        console.error('Export image error:', err);
        showToast('Lỗi xuất hình ảnh', '❌');
      });
    }

    function exportMapAsPDF() {
      const menu = document.getElementById('exportMenu');
      menu.style.display = 'none';
      
      showToast('Đang xuất PDF...', '⏳');
      
      const mapContainer = document.querySelector('.map-wrapper');
      
      html2canvas(mapContainer, {
        backgroundColor: '#0f172a',
        scale: 2,
        useCORS: true,
        allowTaint: true
      }).then(canvas => {
        const imgData = canvas.toDataURL('image/png');
        const { jsPDF } = window.jspdf;
        
        // Tính toán kích thước để giữ tỷ lệ
        const width = canvas.width;
        const height = canvas.height;
        const aspectRatio = width / height;
        
        let pdfWidth = 210; // A4 width in mm
        let pdfHeight = pdfWidth / aspectRatio;
        
        // Nếu quá dài, điều chỉnh
        if (pdfHeight > 297) { // A4 max height
          pdfHeight = 297;
          pdfWidth = pdfHeight * aspectRatio;
        }
        
        const pdf = new jsPDF({
          orientation: pdfHeight > pdfWidth ? 'portrait' : 'landscape',
          unit: 'mm',
          format: [pdfWidth, pdfHeight]
        });
        
        pdf.addImage(imgData, 'PNG', 0, 0, pdfWidth, pdfHeight);
        pdf.save(`ban-do-cao-su-${new Date().toISOString().split('T')[0]}.pdf`);
        showToast('Xuất PDF thành công!', '✅');
      }).catch(err => {
        console.error('Export PDF error:', err);
        showToast('Lỗi xuất PDF', '❌');
      });
    }

    // ==================== KHỞI CHẠY ====================
    window.addEventListener('load', initDashMap);
    
    document.addEventListener('DOMContentLoaded', () => {
      const filterSelects = document.querySelectorAll('select[name="doi"], select[name="nam_trong"], select[name="giong"]');
      filterSelects.forEach(select => {
        select.addEventListener('change', applyMapFilters);
      });
    });

    // ==================== EXPORT MAP FUNCTIONS ====================
    function toggleExportMenu() {
      const menu = document.getElementById('exportMenu');
      menu.classList.toggle('show');
    }

    // Close menu when clicking outside
    document.addEventListener('click', (e) => {
      const exportDropdown = document.querySelector('.export-dropdown');
      if (!exportDropdown.contains(e.target)) {
        document.getElementById('exportMenu').classList.remove('show');
      }
    });

    function exportMapAsImage() {
      const mapElement = document.getElementById('dashMap');
      showToast('Đang xuất bản đồ thành hình ảnh...', '⏳');
      
      html2canvas(mapElement, {
        backgroundColor: '#0f172a',
        scale: 2,
        logging: false,
        useCORS: true,
        allowTaint: true
      }).then(canvas => {
        const link = document.createElement('a');
        link.href = canvas.toDataURL('image/png');
        link.download = `ban-do-cao-su-${new Date().toISOString().split('T')[0]}.png`;
        link.click();
        showToast('Xuất bản đồ thành công!', '✅');
        document.getElementById('exportMenu').classList.remove('show');
      }).catch(error => {
        console.error('Export error:', error);
        showToast('Lỗi khi xuất bản đồ', '❌');
      });
    }

    function exportMapAsPDF() {
      const mapElement = document.getElementById('dashMap');
      showToast('Đang xuất bản đồ thành PDF...', '⏳');
      
      html2canvas(mapElement, {
        backgroundColor: '#0f172a',
        scale: 2,
        logging: false,
        useCORS: true,
        allowTaint: true
      }).then(canvas => {
        const mapWidth = mapElement.offsetWidth;
        const mapHeight = mapElement.offsetHeight;
        const imgData = canvas.toDataURL('image/png');
        
        // Calculate dimensions for PDF (landscape orientation)
        const pdfWidth = 297; // A4 landscape width in mm
        const pdfHeight = 210; // A4 landscape height in mm
        const ratio = mapWidth / mapHeight;
        
        let finalWidth = pdfWidth;
        let finalHeight = pdfWidth / ratio;
        
        if (finalHeight > pdfHeight) {
          finalHeight = pdfHeight;
          finalWidth = pdfHeight * ratio;
        }
        
        const { jsPDF } = window.jspdf;
        const pdf = new jsPDF({
          orientation: 'landscape',
          unit: 'mm',
          format: 'a4'
        });
        
        const xOffset = (pdfWidth - finalWidth) / 2;
        const yOffset = (pdfHeight - finalHeight) / 2;
        
        pdf.addImage(imgData, 'PNG', xOffset, yOffset, finalWidth, finalHeight);
        
        // Add title and metadata
        pdf.setFontSize(16);
        pdf.text('Bản Đồ Vườn Cây Cao Su', pdfWidth / 2, 15, { align: 'center' });
        
        pdf.setFontSize(10);
        pdf.setTextColor(150);
        pdf.text(`Xuất ngày: ${new Date().toLocaleDateString('vi-VN')}`, pdfWidth / 2, 20, { align: 'center' });
        pdf.text('Xã Kraya, Huyện Santuk, Kampong Thom', pdfWidth / 2, 25, { align: 'center' });
        
        pdf.save(`ban-do-cao-su-${new Date().toISOString().split('T')[0]}.pdf`);
        showToast('Xuất PDF thành công!', '✅');
        document.getElementById('exportMenu').classList.remove('show');
      }).catch(error => {
        console.error('Export error:', error);
        showToast('Lỗi khi xuất PDF', '❌');
      });
    }
  </script>

</body>
</html>