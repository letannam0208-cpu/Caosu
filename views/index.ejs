      <!-- LAYER LIST -->
      <div class="layer-list" id="layerList">
        <h4>Lớp dữ liệu</h4>
        <div class="layer-item" id="layer-boundary">
          <div class="layer-checkbox checked" onclick="toggleLayer('boundary', this)">
            <i class="fas fa-check" style="font-size: 11px;"></i>
          </div>
          <div class="layer-info">
            <div class="layer-name">Ranh giới</div>
            <div class="layer-desc">Ranh giới vườn cao su</div>
          </div>
        </div>
        <div class="layer-item" id="layer-loCay">
          <div class="layer-checkbox checked" onclick="toggleLayer('loCay', this)">
            <i class="fas fa-check" style="font-size: 11px;"></i>
          </div>
          <div class="layer-info">
            <div class="layer-name">Lô cây</div>
            <div class="layer-desc">Các lô trồng cao su</div>
          </div>
