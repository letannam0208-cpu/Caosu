      <!-- MAP INFO -->
      <div class="map-info" id="coordBar">
        <div class="coord-row">
          <div class="coord-item">
            <span class="coord-label">Lat:</span>
            <span class="coord-value"><span id="lat">12.5240</span>°</span>
          </div>
          <div class="coord-item">
            <span class="coord-label">Lng:</span>
            <span class="coord-value"><span id="lng">105.4520</span>°</span>
          </div>
