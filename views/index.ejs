      <!-- BASEMAP TOGGLE -->
      <button class="basemap-toggle" onclick="toggleBasemapGallery()" title="Thay đổi bản đồ nền">
        <i class="fas fa-layer-group"></i>
      </button>

      <!-- LAYER TOGGLE -->
      <button class="layer-toggle" onclick="toggleLayerList()" title="Quản lý lớp dữ liệu">
        <i class="fas fa-list"></i>
      </button>

      <!-- BASEMAP GALLERY -->
      <div class="basemap-gallery" id="basemapGallery">
        <h4>Bản đồ nền</h4>
        <div class="basemap-item active" onclick="changeBasemap('satellite', this)">
          <div class="basemap-thumbnail" style="background: linear-gradient(135deg, #90caf9 0%, #64b5f6 100%);"></div>
          <div class="basemap-info">
            <div class="basemap-name">Vệ tinh</div>
            <div class="basemap-desc">Ảnh vệ tinh từ trên cao</div>
          </div>
          <div class="basemap-check">
            <i class="fas fa-check" style="font-size: 12px;"></i>
          </div>
        </div>
        <div class="basemap-item" onclick="changeBasemap('terrain', this)">
          <div class="basemap-thumbnail" style="background: linear-gradient(135deg, #ffcc80 0%, #ffb74d 100%);"></div>
          <div class="basemap-info">
            <div class="basemap-name">Địa hình</div>
            <div class="basemap-desc">Bản đồ địa hình</div>
          </div>
          <div class="basemap-check"></div>
        </div>
        <div class="basemap-item" onclick="changeBasemap('dark', this)">
          <div class="basemap-thumbnail" style="background: linear-gradient(135deg, #616161 0%, #424242 100%);"></div>
          <div class="basemap-info">
            <div class="basemap-name">Tối</div>
            <div class="basemap-desc">Bản đồ tối</div>
          </div>
          <div class="basemap-check"></div>
        </div>
        <div class="basemap-item" onclick="changeBasemap('streets', this)">
          <div class="basemap-thumbnail" style="background: linear-gradient(135deg, #e1f5fe 0%, #b3e5fc 100%);"></div>
          <div class="basemap-info">
            <div class="basemap-name">Giao thông</div>
            <div class="basemap-desc">Bản đồ giao thông</div>
