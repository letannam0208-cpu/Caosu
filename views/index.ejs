  </div>
  <div class="stats-bar">
    <div class="stat-item">
      <label>Lô vườn</label>
      <strong>425</strong>
    </div>
    <div class="stat-item">
      <label>Diện tích</label>
      <strong>7.244 ha</strong>
    </div>
  </div>
  <div class="user-info">
