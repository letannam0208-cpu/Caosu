<!-- TOAST NOTIFICATION -->
<div class="toast" id="toast">
  <span class="toast-icon" id="toastIcon">✅</span>
  <span class="toast-message" id="toastMsg"></span>
</div>

<script>
// ==================== BIẾN TOÀN CỤC ====================
let dashMap;
let CAOSU_GEOJSON = null;
let mapViewMode = 'doi';
let currentBasemap = 'satellite';

// Layers
let boundaryOuterLayer = null;
let backgroundLayer = null;
let thematicLayer = null;

// Palettes
const doiPalette = { 
  'NT 1': '#10b981', 'NT 2': '#0ea5e9', 'NT 3': '#f59e0b', 'default': '#64748b' 
};

const phienPalette = { 
  'Main': '#10b981', 'Replant': '#f59e0b', 'Immature': '#0ea5e9', 
  'Mature': '#8b5cf6', 'default': '#64748b' 
};

const nhipPalette = { 
  'Thấp': '#0ea5e9', 'Trung bình': '#f59e0b', 'Cao': '#ef4444', 
  'Rất cao': '#8b5cf6', 'default': '#64748b' 
};

const taiCanhPalette = { 
  '2025': '#5ee7b1', '2024': '#10b981', '2023': '#0ea5e9', 
  '2022': '#f59e0b', '2021': '#fb923c', '2020': '#ef4444', 
  'default': '#64748b' 
};

// ==================== KHỞI TẠO MAP ====================
async function initDashMap() {
  dashMap = L.map('dashMap', { zoomControl: false }).setView([12.524, 105.452], 12);

  // Basemap mặc định (vệ tinh)
  L.tileLayer('https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}', {
    maxZoom: 19,
    attribution: '© Esri'
  }).addTo(dashMap);

  // Tọa độ chuột
  dashMap.on('mousemove', function(e) {
    document.getElementById('lat').textContent = e.latlng.lat.toFixed(4);
    document.getElementById('lng').textContent = e.latlng.lng.toFixed(4);
  });

  // Load dữ liệu
  await Promise.all([
    loadMapData(),
    buildFilterUI()
  ]);

  setTimeout(loadBoundaries, 800);

  console.log("✅ Bản đồ đã khởi tạo và đồng bộ với backend");
}

// ==================== LOAD DỮ LIỆU TỪ BACKEND ====================
async function loadMapData(filters = {}) {
  try {
    const params = new URLSearchParams(filters);
    const response = await fetch(`/api/lo-cao-su?${params}`);
    
    if (!response.ok) throw new Error(`HTTP error! status: ${response.status}`);
    
    CAOSU_GEOJSON = await response.json();
    renderThematicLayer();
    
    console.log(`✅ Tải thành công ${CAOSU_GEOJSON.features ? CAOSU_GEOJSON.features.length : 0} features`);
  } catch (error) {
    console.error("❌ Lỗi loadMapData:", error);
    showToast("Không thể tải dữ liệu bản đồ từ server", "⚠️");
  }
}

function renderThematicLayer() {
  if (!CAOSU_GEOJSON || !dashMap) return;
  if (thematicLayer) dashMap.removeLayer(thematicLayer);

  thematicLayer = L.featureGroup().addTo(dashMap);

  CAOSU_GEOJSON.features.forEach(feat => {
    const p = feat.properties || {};
    let color = '#64748b';

    switch(mapViewMode) {
      case 'doi':
        color = doiPalette[p.doi] || doiPalette.default;
        break;
      case 'phien':
        color = phienPalette[p.che_do_cao] || phienPalette.default;
        break;
      case 'nhip':
        color = nhipPalette[p.nhip_do_cao] || nhipPalette.default;
        break;
      case 'tai':
        color = taiCanhPalette[p.tai_canh_nam] || taiCanhPalette.default;
        break;
      case 'giong':
        color = (p.giong === 'RRIV 4') ? '#10b981' : '#ef4444';
        break;
      case 'nam':
        color = (p.nam_trong && parseInt(p.nam_trong) < 2015) ? '#8b5cf6' : '#f472b6';
        break;
    }

    L.geoJSON(feat, {
      style: {
        color: color,
        weight: 1.5,
        fillColor: color,
        fillOpacity: 0.68
      }
    }).bindPopup(`
      <strong style="color:${color}">${p.giong || '—'}</strong><br>
      Lô: ${p.id_lo}<br>
      Đội: ${p.doi || '—'}<br>
      Phiên cạo: ${p.che_do_cao || '—'}<br>
      Nhịp độ cao: ${p.nhip_do_cao || '—'}<br>
      Tài canh năm: ${p.tai_canh_nam || '—'}<br>
      Năm trồng: ${p.nam_trong || '—'}
    `).addTo(thematicLayer);
  });
}

// ==================== LOAD RANH GIỚI ====================
async function loadBoundaries() {
  try {
    const res = await fetch('/api/boundary');
    const data = await res.json();

    if (boundaryOuterLayer) dashMap.removeLayer(boundaryOuterLayer);
    boundaryOuterLayer = L.geoJSON(data, {
      style: { color: "#e2e8f0", weight: 3.5, opacity: 0.9, fillOpacity: 0, dashArray: "8, 4" }
    }).addTo(dashMap);

    if (backgroundLayer) dashMap.removeLayer(backgroundLayer);
    backgroundLayer = L.geoJSON(data, {
      style: { color: "#cbd5e1", weight: 0.8, fillColor: "#1e2937", fillOpacity: 0.06 }
    }).addTo(dashMap);
    backgroundLayer.bringToBack();

  } catch (e) {
    console.error("Lỗi loadBoundaries:", e);
  }
}

// ==================== BUILD FILTER ====================
async function buildFilterUI() {
  try {
    // Đội (Nông trường)
    const doiRes = await fetch('/api/don-vi-list');
    const doiData = await doiRes.json();
    populateSelect('filter-nt', doiData.data || [], 'doi');

    // Năm trồng
    const namRes = await fetch('/api/nam-trong-stats');
    const namData = await namRes.json();
    populateSelect('filter-nam', namData.data || [], 'nam_trong');

    // Giống cây
    const giongRes = await fetch('/api/giong-stats');
    const giongData = await giongRes.json();
    populateSelect('filter-giong', giongData.data || [], 'giong');

    console.log("✅ Bộ lọc đã đồng bộ với backend");
  } catch (e) {
    console.error("Lỗi buildFilterUI:", e);
    showToast("Không tải được dữ liệu bộ lọc", "⚠️");
  }
}

function populateSelect(selectId, items, field) {
  const select = document.getElementById(selectId);
  if (!select) return;
  select.innerHTML = '<option value="all">Tất cả</option>';

  items.forEach(item => {
    const value = item[field] || item.doi || item.nam_trong || item.giong;
    if (value) {
      const option = document.createElement('option');
      option.value = value;
      option.textContent = value;
      select.appendChild(option);
    }
  });
}

function updateMapFilters() {
  const filters = {};
  
  const nt = document.getElementById('filter-nt').value;
  const nam = document.getElementById('filter-nam').value;
  const giong = document.getElementById('filter-giong').value;

  if (nt !== 'all') filters.doi = nt;
  if (nam !== 'all') filters.nam_trong = nam;
  if (giong !== 'all') filters.giong = giong;

  loadMapData(filters);
}

