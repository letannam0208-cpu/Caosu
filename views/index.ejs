  opacity: 0;
  transition: 0.15s;
  backdrop-filter: blur(6px);
  font-weight: normal;
}

.map-ctrl-right .mc-btn:hover .mc-tooltip {
  opacity: 1;
  transform: translateY(-50%) translateX(0);
}

/* Điều chỉnh lại vị trí tooltip mặc định nếu có class right */
.map-ctrl-right .mc-tooltip-right {
