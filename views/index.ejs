  </div>
</header>

<!-- MAIN CONTAINER -->
<div class="container">
  <!-- SIDEBAR -->
  <nav class="sidebar">
    <div class="sidebar-header">
      <h3>📍 Quản lý</h3>
    </div>
    <nav>
      <a href="/" class="active">
        <i class="fas fa-home"></i>
        <span>Dashboard</span>
      </a>
      <a href="/quan-ly-lo-cay">
        <i class="fas fa-tree"></i>
        <span>Quản lý lô cây</span>
      </a>
      <a href="/them-du-lieu-lo-cay">
        <i class="fas fa-plus-circle"></i>
        <span>Thêm dữ liệu</span>
      </a>
    </nav>
    <div class="sidebar-footer">
      <a href="#" class="logout">
        <i class="fas fa-sign-out-alt"></i>
        <span>Đăng xuất</span>
      </a>
    </div>
  </nav>

  <!-- MAIN CONTENT -->
  <div class="main">
    <!-- MAP TOPBAR -->
    <div class="map-topbar">
      <div class="map-title">
        <i class="fas fa-map-marked-alt"></i>
        Bản đồ vườn cây cao su — Kampong Thom, Cambodia
      </div>
      <div class="view-chips">
        <button class="chip active" onclick="switchMapView('doi',this)">Đội</button>
        <button class="chip" onclick="switchMapView('giong',this)">Giống cây</button>
        <button class="chip" onclick="switchMapView('nam',this)">Năm trồng</button>
        <button class="chip" onclick="switchMapView('phien',this)">Phiên cạo</button>
        <button class="chip" onclick="switchMapView('nhip',this)">Nhịp độ cao</button>
        <button class="chip" onclick="switchMapView('tai',this)">Tài canh năm</button>
      </div>
      <div class="map-actions">
        <button class="btn-action" onclick="toggleMeasurePanel()">
          <i class="fas fa-ruler"></i>
          <span>Đo lường</span>
        </button>
      </div>
    </div>

    <!-- FILTER BAR -->
    <div class="filter-bar">
      <div class="filter-group">
        <label>Đội:</label>
        <select id="filter-nt" onchange="updateMapFilters()">
          <option value="all">Tất cả</option>
        </select>
      </div>
      <div class="filter-group">
        <label>Năm trồng:</label>
        <select id="filter-nam" onchange="updateMapFilters()">
          <option value="all">Tất cả</option>
        </select>
      </div>
      <div class="filter-group">
        <label>Giống cây:</label>
        <select id="filter-giong" onchange="updateMapFilters()">
          <option value="all">Tất cả</option>
        </select>
      </div>
    </div>

    <!-- MAP AREA -->
    <div class="map-area">
      <div id="dashMap"></div>

      <!-- SEARCH BAR -->
      <div class="search-container">
        <div class="search-box">
          <i class="fas fa-search search-icon"></i>
          <input 
            type="text" 
            class="search-input" 
            id="searchInput" 
            placeholder="Tìm kiếm lô cây, đội, năm trồng..."
            onkeyup="performSearch(this.value)"
            onchange="clearSearch()"
          >
          <button class="search-clear" onclick="clearSearchInput()">
            <i class="fas fa-times"></i>
          </button>
        </div>
        <div class="search-results" id="searchResults"></div>
      </div>

      <!-- MAP CONTROLS - REMOVED -->

      <!-- CUSTOM ZOOM CONTROL -->
      <div class="custom-zoom-control">
        <div class="zoom-buttons">
          <button class="zoom-btn" onclick="zoomMapIn()" title="Phóng to">
            <i class="fas fa-plus"></i>
          </button>
          <button class="zoom-btn" onclick="zoomMapOut()" title="Thu nhỏ">
            <i class="fas fa-minus"></i>
          </button>
          <button class="zoom-btn" onclick="zoomHome()" title="Về vị trí ban đầu" style="background: linear-gradient(135deg, rgba(14, 165, 233, 0.2), rgba(14, 165, 233, 0.1)); border-color: var(--secondary); color: var(--secondary);">
            <i class="fas fa-home"></i>
          </button>
        </div>
        <div class="zoom-slider">
          <label class="zoom-label" id="zoomLabel">12</label>
          <input 
            type="range" 
            id="zoomRange" 
            min="1" 
            max="19" 
            value="12" 
            onchange="setZoomLevel(this.value)"
            oninput="updateZoomLabel(this.value)"
