<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>WebGIS · Vườn Cây Cao Su</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&family=Syne:wght@700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"/>
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

<style>
:root {
  --bg: #0a0f1c; --s1: #121a2e; --s2: #1a2338;
  --accent: #00d68f; --accentB: #00b4ff; --text: #e8eeff;
  --muted: #5a6a8a; --border: rgba(255,255,255,0.08); --r: 8px;
}
* { box-sizing: border-box; margin:0; padding:0; }
body { font-family: 'Be Vietnam Pro', sans-serif; background: var(--bg); color: var(--text); height: 100vh; overflow: hidden; display: flex; flex-direction: column; }

header { height: 64px; background: var(--s1); border-bottom: 1px solid var(--border); display: flex; align-items: center; padding: 0 20px; gap: 20px; }
.logo { display: flex; align-items: center; gap: 10px; font-weight: 700; font-size: 18px; color: var(--accent); }
.status { background: rgba(0,214,143,0.15); color: var(--accent); padding: 5px 14px; border-radius: 20px; font-size: 13px; display: flex; align-items: center; gap: 6px; }
.stats-bar { display: flex; gap: 40px; margin-left: 30px; font-size: 14px; }
.stat-item strong { color: var(--accent); font-size: 16px; }
.user-info { margin-left: auto; display: flex; align-items: center; gap: 12px; }
.avatar { width: 38px; height: 38px; background: linear-gradient(135deg, var(--accent), var(--accentB)); border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: bold; color: #000; }

.sidebar { width: 240px; background: var(--s1); border-right: 1px solid var(--border); padding-top: 20px; overflow-y: auto; flex-shrink: 0; }
.sidebar a { display: flex; align-items: center; gap: 14px; padding: 14px 24px; color: var(--muted); text-decoration: none; }
.sidebar a:hover, .sidebar a.active { background: var(--s2); color: var(--text); }

.main { flex: 1; display: flex; flex-direction: column; }
.map-topbar, .filter-bar { background: var(--s2); padding: 12px 20px; display: flex; align-items: center; gap: 12px; border-bottom: 1px solid var(--border); }
.filter-bar { padding: 10px 20px; gap: 18px; flex-wrap: wrap; }
.filter-group { display: flex; align-items: center; gap: 8px; font-size: 13px; }
.filter-group label { color: var(--muted); white-space: nowrap; }
.filter-group select { background: var(--s1); border: 1px solid var(--border); color: var(--text); padding: 6px 12px; border-radius: var(--r); }

.map-area { flex: 1; position: relative; overflow: hidden; }
#dashMap { width: 100%; height: 100%; }

.map-ctrl-left {
  position: absolute; top: 20px; left: 20px; z-index: 500;
  background: rgba(26,35,56,0.95); border: 1px solid var(--border);
  border-radius: var(--r); padding: 10px; display: flex; flex-direction: column; gap: 6px;
}
.mc-btn { padding: 10px 14px; background: transparent; border: 1px solid var(--border); color: var(--muted); border-radius: var(--r); cursor: pointer; display: flex; align-items: center; gap: 8px; }
.mc-btn:hover { border-color: var(--accentB); color: var(--accentB); }

.map-coord-bar {
  position: absolute; bottom: 15px; right: 15px; z-index: 600;
  background: rgba(26,35,56,0.95); border: 1px solid var(--border); padding: 8px 14px; border-radius: var(--r); font-size: 12px;
}

.legend {
  position: absolute; bottom: 15px; left: 20px; z-index: 600;
  background: rgba(26,35,56,0.95); border: 1px solid var(--border);
  border-radius: var(--r); padding: 12px 16px; width: 280px;
}
.legend h4 { margin-bottom: 10px; color: var(--accent); font-size: 13px; }
.legend-item { display: flex; align-items: center; gap: 8px; margin: 4px 0; font-size: 12.5px; }

.toast { position: fixed; bottom: 20px; left: 50%; transform: translateX(-50%); background: var(--s1); border: 1px solid var(--border); padding: 14px 20px; border-radius: 12px; color: var(--text); z-index: 2000; display: none; align-items: center; gap: 10px; }
.toast.show { display: flex; }
</style>
</head>
<body>

<header>
  <div class="logo"><i class="fas fa-leaf"></i> <span>WEBGIS CAO SU</span></div>
  <div class="status"><i class="fas fa-circle"></i> Trực tuyến</div>
  <div class="stats-bar">
    <div class="stat-item">Lô vườn <strong>425</strong></div>
    <div class="stat-item">Diện tích <strong>7.244 ha</strong></div>
  </div>
  <div class="user-info"><span>Nguyễn Văn An</span><div class="avatar">NA</div></div>
</header>

<div style="display:flex; flex:1; overflow:hidden;">
  <nav class="sidebar">
    <a href="/" class="active"><i class="fas fa-home"></i> <span>Dashboard</span></a>
    <a href="/quan-ly-lo-cay"><i class="fas fa-tree"></i> <span>Quản lý lô cây</span></a>
    <a href="/them-du-lieu-lo-cay"><i class="fas fa-plus-circle"></i> <span>Thêm dữ liệu lô</span></a>
    <hr>
    <a href="#" style="color:#f4656a"><i class="fas fa-sign-out-alt"></i> <span>Đăng xuất</span></a>
  </nav>

  <div class="main">
    <div class="map-topbar">
      <div class="map-title"><i class="fas fa-map-marked-alt"></i> Bản đồ vườn cây cao su — Kampong Thom, Cambodia</div>
      <div class="chips">
        <button class="map-chip on" onclick="switchMapView('doi',this)">Đội</button>
        <button class="map-chip" onclick="switchMapView('giong',this)">Giống cây</button>
        <button class="map-chip" onclick="switchMapView('nam',this)">Năm trồng</button>
        <button class="map-chip" onclick="switchMapView('phien',this)">Phiên cạo</button>
        <button class="map-chip" onclick="switchMapView('nhip',this)">Nhịp độ cao</button>
        <button class="map-chip" onclick="switchMapView('tai',this)">Tài canh năm</button>
      </div>
      <button onclick="toggleMeasurePanel()" class="map-chip" style="margin-left:auto"><i class="fas fa-ruler"></i> Đo lường</button>
    </div>

    <div class="filter-bar">
      <div class="filter-group"><label>Đội:</label><select id="filter-nt" onchange="updateMapFilters()"><option value="all">Tất cả</option></select></div>
      <div class="filter-group"><label>Năm trồng:</label><select id="filter-nam" onchange="updateMapFilters()"><option value="all">Tất cả</option></select></div>
      <div class="filter-group"><label>Giống cây:</label><select id="filter-giong" onchange="updateMapFilters()"><option value="all">Tất cả</option></select></div>
    </div>

    <div class="map-area">
      <div id="dashMap"></div>

      <div class="map-ctrl-left">
        <button class="mc-btn" onclick="mapZoomIn()"><i class="fas fa-plus"></i> Phóng to</button>
        <button class="mc-btn" onclick="mapZoomOut()"><i class="fas fa-minus"></i> Thu nhỏ</button>
        <button class="mc-btn active" onclick="goHome()"><i class="fas fa-home"></i> Toàn vùng</button>
      </div>

      <div class="map-coord-bar" id="coordBar">
        Lat: <span id="lat">12.5240</span>° | Lng: <span id="lng">105.4520</span>°
      </div>

      <div class="legend" id="legend">
        <h4>🔹 Đội</h4>
        <div class="legend-item"><span style="background:#00d68f;width:18px;height:18px;display:inline-block;border-radius:3px"></span> Đội 1</div>
        <div class="legend-item"><span style="background:#00b4ff;width:18px;height:18px;display:inline-block;border-radius:3px"></span> Đội 2</div>
        <div class="legend-item"><span style="background:#f59e0b;width:18px;height:18px;display:inline-block;border-radius:3px"></span> Đội 3</div>
      </div>
    </div>
  </div>
</div>

<div class="toast" id="toast"><span id="toastIcon"></span><span id="toastMsg"></span></div>

<script>
// ==================== BIẾN TOÀN CỤC ====================
let dashMap;
let CAOSU_GEOJSON = null;
let mapViewMode = 'doi';

let boundaryOuterLayer = null;
let backgroundLayer = null;
let thematicLayer = null;

// Palette
const doiPalette = { 'NT 1': '#00d68f', 'NT 2': '#00b4ff', 'NT 3': '#f59e0b', 'default': '#5a6a8a' };
const phienPalette = { 'Main': '#00d68f', 'Replant': '#f59e0b', 'Immature': '#00b4ff', 'Mature': '#a78bfa', 'default': '#5a6a8a' };
const nhipPalette = { 'Thấp': '#00b4ff', 'Trung bình': '#f59e0b', 'Cao': '#ff6b6b', 'Rất cao': '#a78bfa', 'default': '#5a6a8a' };
const taiCanhPalette = {
  '2025': '#00ff9d', '2024': '#00d68f', '2023': '#00b4ff',
  '2022': '#f59e0b', '2021': '#ff9f43', '2020': '#ff6b6b',
  '2019': '#a78bfa', '2018': '#c44569', 'default': '#5a6a8a'
};

// ==================== KHỞI TẠO ====================
async function initDashMap() {
  dashMap = L.map('dashMap', { zoomControl: false }).setView([12.524, 105.452], 12);

  L.tileLayer('https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}', { maxZoom: 19 }).addTo(dashMap);

  dashMap.on('mousemove', e => {
    document.getElementById('lat').textContent = e.latlng.lat.toFixed(4);
    document.getElementById('lng').textContent = e.latlng.lng.toFixed(4);
  });

  await Promise.all([loadMapData(), buildFilterUI()]);
  setTimeout(loadBoundaries, 600);
}

// ==================== LOAD & RENDER ====================
async function loadMapData(filters = {}) {
  try {
    const params = new URLSearchParams(filters);
    const res = await fetch(`/api/lo-cao-su?${params}`);
    CAOSU_GEOJSON = await res.json();
    renderThematicLayer();
  } catch (e) { console.error(e); }
}

function renderThematicLayer() {
  if (!CAOSU_GEOJSON || !dashMap) return;
  if (thematicLayer) dashMap.removeLayer(thematicLayer);

  thematicLayer = L.featureGroup().addTo(dashMap);

  CAOSU_GEOJSON.features.forEach(feat => {
    const p = feat.properties || {};
    let col = '#5a6a8a';

    if (mapViewMode === 'doi') col = doiPalette[p.doi] || doiPalette.default;
    else if (mapViewMode === 'phien') col = phienPalette[p.che_do_cao] || phienPalette.default;
    else if (mapViewMode === 'nhip') col = nhipPalette[p.nhip_do_cao] || nhipPalette.default;
    else if (mapViewMode === 'tai') col = taiCanhPalette[p.tai_canh_nam] || taiCanhPalette.default;
    else if (mapViewMode === 'giong') col = p.giong === 'RRIV 4' ? '#1b9e77' : '#d95f02';
    else if (mapViewMode === 'nam') col = (p.nam_trong && p.nam_trong < 2015) ? '#7570b3' : '#e7298a';

    L.geoJSON(feat, {
      style: { color: col, weight: 1.6, fillColor: col, fillOpacity: 0.65 }
    }).bindPopup(`
      <strong style="color:${col}">${p.giong || '—'}</strong><br>
      Lô: ${p.id_lo}<br>
      Đội: ${p.doi || '—'}<br>
      Phiên cạo: ${p.che_do_cao || '—'}<br>
      Nhịp độ cao: ${p.nhip_do_cao || '—'}<br>
      Tài canh năm: ${p.tai_canh_nam || '—'}<br>
      Năm trồng: ${p.nam_trong || '—'}
    `).addTo(thematicLayer);
  });
}

// ==================== 3 LỚP RANH GIỚI ====================
async function loadBoundaries() {
  try {
    const res = await fetch('/api/boundary');
    const data = await res.json();

    if (boundaryOuterLayer) dashMap.removeLayer(boundaryOuterLayer);
    boundaryOuterLayer = L.geoJSON(data, {
      style: { color: "#ffffff", weight: 4.5, opacity: 0.95, fillOpacity: 0, dashArray: "10, 5" }
    }).addTo(dashMap);

    if (backgroundLayer) dashMap.removeLayer(backgroundLayer);
    backgroundLayer = L.geoJSON(data, {
      style: { color: "#ffffff", weight: 1, fillColor: "#ffffff", fillOpacity: 0.07 }
    }).addTo(dashMap);
    backgroundLayer.bringToBack();
  } catch (e) { console.error(e); }
}

// ==================== FILTER ====================
async function buildFilterUI() {
  try {
    const doiRes = await fetch('/api/don-vi-list');
    const doiData = await doiRes.json();
    populateSelect('filter-nt', doiData.data || [], 'doi');

    const namRes = await fetch('/api/nam-trong-stats');
    const namData = await namRes.json();
    populateSelect('filter-nam', namData.data || [], 'nam_trong');

    const giongRes = await fetch('/api/giong-stats');
    const giongData = await giongRes.json();
    populateSelect('filter-giong', giongData.data || [], 'giong');
  } catch (e) { console.error(e); }
}

function populateSelect(id, items, key) {
  const sel = document.getElementById(id);
  items.forEach(item => {
    const val = item[key] || item.doi || item.nam_trong || item.giong;
    if (val) sel.add(new Option(val, val));
  });
}

function updateMapFilters() {
  const filters = {};
  if (document.getElementById('filter-nt').value !== 'all') filters.doi = document.getElementById('filter-nt').value;
  if (document.getElementById('filter-nam').value !== 'all') filters.nam_trong = document.getElementById('filter-nam').value;
  if (document.getElementById('filter-giong').value !== 'all') filters.giong = document.getElementById('filter-giong').value;
  loadMapData(filters);
}

// ==================== CHUYỂN CHẾ ĐỘ TÔ MÀU ====================
function switchMapView(mode, btn) {
  mapViewMode = mode;
  document.querySelectorAll('.map-chip').forEach(b => b.classList.remove('on'));
  btn.classList.add('on');
  updateLegend(mode);
  renderThematicLayer();
}

function updateLegend(mode) {
  const legend = document.getElementById('legend');
  
  if (mode === 'doi') {
    legend.innerHTML = `
      <h4>🔹 Đội</h4>
      <div class="legend-item"><span style="background:#00d68f;width:18px;height:18px;display:inline-block;border-radius:3px"></span> Đội 1</div>
      <div class="legend-item"><span style="background:#00b4ff;width:18px;height:18px;display:inline-block;border-radius:3px"></span> Đội 2</div>
      <div class="legend-item"><span style="background:#f59e0b;width:18px;height:18px;display:inline-block;border-radius:3px"></span> Đội 3</div>
    `;
  } else if (mode === 'giong') {
    legend.innerHTML = `<h4>🔹 Giống cây</h4><div class="legend-item">Màu theo từng giống</div>`;
  } else if (mode === 'nam') {
    legend.innerHTML = `<h4>🔹 Năm trồng</h4><div class="legend-item">Màu theo năm trồng</div>`;
  } else if (mode === 'phien') {
    legend.innerHTML = `<h4>🔹 Phiên cạo</h4>
      <div class="legend-item"><span style="background:#00d68f;width:18px;height:18px;display:inline-block;border-radius:3px"></span> Main</div>
      <div class="legend-item"><span style="background:#f59e0b;width:18px;height:18px;display:inline-block;border-radius:3px"></span> Replant</div>
      <div class="legend-item"><span style="background:#00b4ff;width:18px;height:18px;display:inline-block;border-radius:3px"></span> Immature</div>
      <div class="legend-item"><span style="background:#a78bfa;width:18px;height:18px;display:inline-block;border-radius:3px"></span> Mature</div>`;
  } else if (mode === 'nhip') {
    legend.innerHTML = `<h4>🔹 Nhịp độ cao</h4>
      <div class="legend-item"><span style="background:#00b4ff;width:18px;height:18px;display:inline-block;border-radius:3px"></span> Thấp</div>
      <div class="legend-item"><span style="background:#f59e0b;width:18px;height:18px;display:inline-block;border-radius:3px"></span> Trung bình</div>
      <div class="legend-item"><span style="background:#ff6b6b;width:18px;height:18px;display:inline-block;border-radius:3px"></span> Cao</div>
      <div class="legend-item"><span style="background:#a78bfa;width:18px;height:18px;display:inline-block;border-radius:3px"></span> Rất cao</div>`;
  } else if (mode === 'tai') {
    legend.innerHTML = `
      <h4>🔹 Tài canh năm</h4>
      <div class="legend-item"><span style="background:#00ff9d;width:18px;height:18px;display:inline-block;border-radius:3px"></span> 2025</div>
      <div class="legend-item"><span style="background:#00d68f;width:18px;height:18px;display:inline-block;border-radius:3px"></span> 2024</div>
      <div class="legend-item"><span style="background:#00b4ff;width:18px;height:18px;display:inline-block;border-radius:3px"></span> 2023</div>
      <div class="legend-item"><span style="background:#f59e0b;width:18px;height:18px;display:inline-block;border-radius:3px"></span> 2022</div>
      <div class="legend-item"><span style="background:#ff9f43;width:18px;height:18px;display:inline-block;border-radius:3px"></span> 2021</div>
      <div class="legend-item"><span style="background:#ff6b6b;width:18px;height:18px;display:inline-block;border-radius:3px"></span> 2020</div>
      <div class="legend-item"><span style="background:#a78bfa;width:18px;height:18px;display:inline-block;border-radius:3px"></span> Trước 2020</div>
    `;
  }
}

// Controls
function mapZoomIn() { if(dashMap) dashMap.zoomIn(); }
function mapZoomOut() { if(dashMap) dashMap.zoomOut(); }
function goHome() { if(dashMap) dashMap.setView([12.524, 105.452], 12); }

function showToast(msg, icon = '✅') {
  const t = document.getElementById('toast');
  document.getElementById('toastIcon').innerHTML = icon;
  document.getElementById('toastMsg').innerHTML = msg;
  t.classList.add('show');
  setTimeout(() => t.classList.remove('show'), 4000);
}

function toggleMeasurePanel() {
  showToast("Công cụ đo lường đang được phát triển", "📏");
}

// ==================== KHỞI CHẠY ====================
window.addEventListener('load', initDashMap);
</script>
</body>
</html>