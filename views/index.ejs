    }

    function updateMapFilters(type, selectEl) {
      const val = selectEl.value;
      if (val === "all") {
        if (type === "NT") filterNT.clear();
        else if (type === "nam") filterNam.clear();
        else if (type === "giong") filterGiong.clear();
        else if (type === "phien_cao") filterPhienCao.clear();
        else if (type === "nhip_do_cao") filterNhipDo.clear();
        else if (type === "quy_hoach_tai_canh") filterQuyHoach.clear();
        else if (type === "khu_vuc") filterKhuVuc.clear();
        else if (type === "tuoi_cao") filterTuoiCao.clear();
        else if (type === "che_do_cao") filterCheDoCao.clear();
      } else {
        if (type === "NT") filterNT = new Set([normalizeTeamValue(val)]);
        else if (type === "nam") filterNam = new Set([val]);
        else if (type === "giong") filterGiong = new Set([val]);
        else if (type === "phien_cao") filterPhienCao = new Set([val]);
        else if (type === "nhip_do_cao") filterNhipDo = new Set([val]);
        else if (type === "quy_hoach_tai_canh") filterQuyHoach = new Set([val]);
        else if (type === "khu_vuc") filterKhuVuc = new Set([val]);
        else if (type === "tuoi_cao") filterTuoiCao = new Set([val]);
        else if (type === "che_do_cao") filterCheDoCao = new Set([val]);
      }
      // Xử lý ranh giới đội (union)
      if (type === 'NT') {
        if (val === 'all') {
          updateTeamBoundary(null);
        } else {
          updateTeamBoundary(normalizeTeamValue(val));
        }
      }
      // Cascade: cập nhật các dropdown khác dựa trên tập dữ liệu đã lọc
      cascadeFilterOptions(type);
      renderRealLots();
    }

    /**
     * CASCADING FILTERS: Khi thay đổi 1 bộ lọc, MỖI dropdown khác
     * chỉ hiển thị giá trị tồn tại khi áp dụng tất cả filter NGOẠI TRỪ
     * chính nó. Nghĩa là dropdown Đội luôn hiển thị tất cả đội phù hợp
     * với các filter khác (năm trồng, giống, ...), không bị giới hạn bởi
     * giá trị Đội đang chọn.
     */
    function cascadeFilterOptions(changedType) {
      // Định nghĩa mapping: filterKey → { selectId, extractor, filterSet, fullSet, checker }
      const filterDefs = [
        { key: 'NT', selectId: 'filter-Doi', extractor: p => normalizeTeamValue(p.doi), filterSet: () => filterNT, fullSet: fullNT, setFilter: v => { filterNT = v; }, labelFn: v => /^\d+$/.test(v) ? `Đội ${v}` : v },
        { key: 'nam', selectId: 'filter-nam', extractor: p => normalizeFilterValue(p.nam_trong), filterSet: () => filterNam, fullSet: fullNam, setFilter: v => { filterNam = v; }, labelFn: null },
        { key: 'giong', selectId: 'filter-giong', extractor: p => normalizeFilterValue(p.giong), filterSet: () => filterGiong, fullSet: fullGiong, setFilter: v => { filterGiong = v; }, labelFn: null },
        { key: 'phien_cao', selectId: 'filter-phien_cao', extractor: p => normalizeFilterValue(p.phien_cao), filterSet: () => filterPhienCao, fullSet: fullPhienCao, setFilter: v => { filterPhienCao = v; }, labelFn: null },
        { key: 'nhip_do_cao', selectId: 'filter-Nhip_do_cao', extractor: p => normalizeFilterValue(p.nhip_do_cao), filterSet: () => filterNhipDo, fullSet: fullNhipDo, setFilter: v => { filterNhipDo = v; }, labelFn: null },
        { key: 'quy_hoach_tai_canh', selectId: 'filter-quy_hoach_tai_canh', extractor: p => normalizeFilterValue(p.tai_canh_nam), filterSet: () => filterQuyHoach, fullSet: fullQuyHoach, setFilter: v => { filterQuyHoach = v; }, labelFn: null },
        { key: 'khu_vuc', selectId: 'filter-khu-vuc', extractor: p => normalizeFilterValue(p.khu_vuc), filterSet: () => filterKhuVuc, fullSet: fullKhuVuc, setFilter: v => { filterKhuVuc = v; }, labelFn: null },
        { key: 'tuoi_cao', selectId: 'filter-tuoi-cao', extractor: p => normalizeFilterValue(p.tuoi_cao), filterSet: () => filterTuoiCao, fullSet: fullTuoiCao, setFilter: v => { filterTuoiCao = v; }, labelFn: null },
        { key: 'che_do_cao', selectId: 'filter-che-do-cao', extractor: p => normalizeFilterValue(p.che_do_cao), filterSet: () => filterCheDoCao, fullSet: fullCheDoCao, setFilter: v => { filterCheDoCao = v; }, labelFn: null },
      ];

      /**
       * Hàm kiểm tra feature có thỏa TẤT CẢ filter NGOẠI TRỪ filterKey.
       * Ví dụ: excludeKey = 'NT' → bỏ qua filter Đội, chỉ kiểm tra năm, giống, ...
       */
      function featureVisibleExcluding(f, excludeKey) {
        const p = f.properties || f;
        if (!p || !p.ten_lo) return false;

        const checks = {
          NT: () => { const v = normalizeTeamValue(p.doi); return filterNT.size === 0 || filterNT.has(v); },
          nam: () => { const v = p.nam_trong != null ? String(p.nam_trong) : ''; return filterNam.size === 0 || filterNam.has(v); },
          giong: () => { const v = p.giong ?? ''; return filterGiong.size === 0 || filterGiong.has(v); },
          phien_cao: () => { const v = p.phien_cao != null ? String(p.phien_cao) : ''; return filterPhienCao.size === 0 || filterPhienCao.has(v); },
          nhip_do_cao: () => { const v = p.nhip_do_cao != null ? String(p.nhip_do_cao) : ''; return filterNhipDo.size === 0 || filterNhipDo.has(v); },
          quy_hoach_tai_canh: () => { const v = p.tai_canh_nam != null ? String(p.tai_canh_nam) : ''; return filterQuyHoach.size === 0 || filterQuyHoach.has(v); },
          khu_vuc: () => { const v = p.khu_vuc ?? ''; return filterKhuVuc.size === 0 || filterKhuVuc.has(v); },
          tuoi_cao: () => { const v = p.tuoi_cao != null ? String(p.tuoi_cao) : ''; return filterTuoiCao.size === 0 || filterTuoiCao.has(v); },
          che_do_cao: () => { const v = p.che_do_cao ?? ''; return filterCheDoCao.size === 0 || filterCheDoCao.has(v); },
        };

        // Kiểm tra tất cả filter TRỪ excludeKey
        for (const [key, checkFn] of Object.entries(checks)) {
          if (key === excludeKey) continue; // Bỏ qua chính nó
          if (!checkFn()) return false;
        }
        return true;
      }

      // Cập nhật từng dropdown
      filterDefs.forEach(def => {
        const el = document.getElementById(def.selectId);
        if (!el) return;

        // Lọc features bỏ qua CHÍNH filter này → lấy danh sách giá trị khả dụng
        const availableValues = new Set();
        caosuFeatures.forEach(f => {
          if (!featureVisibleExcluding(f, def.key)) return;
          const val = def.extractor(f.properties);
          if (val !== '') availableValues.add(val);
        });

        // Giá trị đang chọn
        const currentVal = el.value;

        // Tạo mảng sorted
        const sortedValues = Array.from(availableValues).sort(sortFilterValues);

        // Rebuild options
        el.innerHTML = '<option value="all">Tất cả</option>';
        sortedValues.forEach(v => {
          const opt = document.createElement('option');
          opt.value = v;
          opt.textContent = def.labelFn ? def.labelFn(v) : v;
          el.appendChild(opt);
        });

        // Giữ lại giá trị nếu vẫn có trong danh sách
        if (currentVal !== 'all' && availableValues.has(currentVal)) {
          el.value = currentVal;
        } else if (currentVal !== 'all' && !availableValues.has(currentVal)) {
          // Giá trị cũ không còn hợp lệ → reset về tất cả
          el.value = 'all';
          def.setFilter(new Set()); // reset về không lọc
          if (def.key === 'NT') {
            updateTeamBoundary(null);
          }
        }
      });

    }

    function clearSelection() {
      selectedIdx.clear();
      updateSelBar();
      renderRealLots();
    }
    /* ==================== RANH GIỚI ĐỘI (UNION) ==================== */
    async function updateTeamBoundary(teamValue) {
      // Xóa layer cũ
      if (teamBoundaryLayer) {
        dashMap.removeLayer(teamBoundaryLayer);
        teamBoundaryLayer = null;
      }
      if (!teamValue) return;

      // Lọc các lô thuộc đội (dùng normalizeTeamValue)
      const teamFeatures = caosuFeatures.filter(f => normalizeTeamValue(f.properties.doi) === teamValue);
      if (teamFeatures.length === 0) return;

      // Chuyển đổi geometry sang turf polygon (hỗ trợ Multipolygon)
      const polygons = [];
      teamFeatures.forEach(f => {
        const geom = f.geometry;
        if (geom.type === 'Polygon') {
          polygons.push(turf.polygon(geom.coordinates));
        } else if (geom.type === 'MultiPolygon') {
          geom.coordinates.forEach(polyCoords => {
            polygons.push(turf.polygon(polyCoords));
          });
        }
      });
      if (polygons.length === 0) return;

      let unionPoly;
      try {
        unionPoly = polygons[0];
        for (let i = 1; i < polygons.length; i++) {
          if (!unionPoly) break;
          unionPoly = turf.union(unionPoly, polygons[i]);
        }
        if (!unionPoly) throw new Error('Union failed');
      } catch (e) {
        console.warn("Turf union failed, fallback to convex hull", e);
        // Fallback: tạo convex hull từ tất cả điểm của đội
        const allPoints = [];
        teamFeatures.forEach(f => {
          const coords = turf.getCoords(f.geometry);
          // Đi qua tất cả tọa độ
          const flatten = (arr) => {
            if (Array.isArray(arr[0])) return arr.flatMap(flatten);
            return [arr];
          };
          const points = flatten(coords).map(c => turf.point(c));
          allPoints.push(...points);
        });
        const fc = turf.featureCollection(allPoints);
        unionPoly = turf.convex(fc);
      }

      if (unionPoly) {
        teamBoundaryLayer = L.geoJSON(unionPoly, {
          style: {
            color: "#ff6600",
            weight: 4,
            opacity: 0.9,
            fillColor: "#ff6600",
            fillOpacity: 0.1,
            dashArray: "8, 6"
          }
        }).addTo(dashMap);
      }
    }

    /* ==================== CÁC CÔNG CỤ BẢN ĐỒ ==================== */
    const MAP_DEFAULT_CENTER = [12.524, 105.452];
    const MAP_DEFAULT_ZOOM = 12;

    function mapZoomIn() {
      if (!dashMap) return;
      const z = dashMap.getZoom();
      if (z >= 19) return;
      dashMap.setZoom(z + 1, { animate: true });
      const btn = document.getElementById("btn-zoom-in");
      if (btn) {
        btn.classList.add("active");
        setTimeout(() => btn.classList.remove("active"), 250);
      }
    }

    function mapZoomOut() {
      if (!dashMap) return;
      const z = dashMap.getZoom();
      if (z <= 1) return;
      dashMap.setZoom(z - 1, { animate: true });
      const btn = document.getElementById("btn-zoom-out");
      if (btn) {
        btn.classList.add("active");
        setTimeout(() => btn.classList.remove("active"), 250);
      }
    }

    function goHome() {
      if (!dashMap) return;
      const btn = document.getElementById("btn-home");
      if (btn) {
        btn.classList.add("active");
        setTimeout(() => btn.classList.remove("active"), 1500);
      }
      dashMap.flyTo(MAP_DEFAULT_CENTER, MAP_DEFAULT_ZOOM, {
        animate: true,
        duration: 1.2,
        easeLinearity: 0.35,
      });
      showToast("Đã quay về vị trí mặc định", "🏠");
    }

    function setMapTool(tool, btn) {
      if (
        document.getElementById("measure-panel").classList.contains("show")
      ) {
        closeMeasure();
      }

      currentTool = tool;
      ["tool-pan", "tool-pointer", "tool-rect"].forEach((id) => {
        const el = document.getElementById(id);
        if (el) el.classList.remove("active");
      });
      if (btn) btn.classList.add("active");

      const wrap = document.querySelector(".map-canvas-wrap");
      const mapEl = document.getElementById("dashMap");

      if (tool === "pan") {
        dashMap.dragging.enable();
        dashMap.scrollWheelZoom.enable();
        dashMap.doubleClickZoom.enable();
        if (mapEl) mapEl.style.cursor = "grab";
        wrap.classList.add("pan-mode");
        wrap.classList.remove("measuring-distance", "measuring-area");
      } else if (tool === "pointer") {
        dashMap.dragging.enable();
        dashMap.scrollWheelZoom.enable();
        dashMap.doubleClickZoom.disable();
        if (mapEl) mapEl.style.cursor = "default";
        wrap.classList.remove(
          "pan-mode",
          "measuring-distance",
          "measuring-area",
        );
      }
    }

    function togglePanel(id) {
      document
        .querySelectorAll(".map-layer-panel,.map-search-panel")
        .forEach((p) => {
          if (p.id !== id) p.classList.remove("show");
        });
      document.getElementById(id).classList.toggle("show");
    }

    function toggleLayer(el, type) {
      const chk = el.querySelector(".mlp-check");
      const on = chk.classList.toggle("on");
      chk.textContent = on ? "✓" : "";

      if (type === "lots") {
        lotsVis = on;
        renderRealLots();
      } else if (type === "background-layer") {
        backgroundLotLayers.forEach((o) =>
          on ? o.layer.addTo(dashMap) : dashMap.removeLayer(o.layer),
        );
      } else if (type === "boundary") {
        boundaryVis = on;
        // Cập nhật trực tiếp ranh giới xã
        if (boundaryVis && xaLayer) xaLayer.addTo(dashMap);
        else if (xaLayer) dashMap.removeLayer(xaLayer);
        showToast(
          boundaryVis ? "Hiện ranh giới xã" : "Ẩn ranh giới xã",
          "🗂",
        );
      } else if (type === "label") {
        labelsVis = on;
        // Cập nhật trực tiếp nhãn lô
        renderRealLots();
        showToast(labelsVis ? "Đã bật nhãn tên lô" : "Đã tắt nhãn lô", "🏷");
      }
    }

    function locateUser() {
      const fixedLat = 12.552952324711912;
      const fixedLng = 105.4415664963791;
      const fixedAccuracy = 10;

      if (userLocationMarker) {
        dashMap.removeLayer(userLocationMarker);
        userLocationMarker = null;
      }
      if (userLocationCircle) {
        dashMap.removeLayer(userLocationCircle);
        userLocationCircle = null;
      }

      dashMap.setView([fixedLat, fixedLng], 16, { animate: true });

      userLocationMarker = L.circleMarker([fixedLat, fixedLng], {
        radius: 8,
        fillColor: "#10b981",
        color: "#ffffff",
        weight: 2,
        fillOpacity: 1,
      }).addTo(dashMap);

      userLocationCircle = L.circle([fixedLat, fixedLng], {
        radius: fixedAccuracy,
        color: "#10b981",
        weight: 1,
        fillColor: "#10b981",
        fillOpacity: 0.1,
      }).addTo(dashMap);

      userLocationMarker
        .bindPopup(
          `
    <b>📍 Vị trí </b><br>
    ${fixedLat.toFixed(6)}, ${fixedLng.toFixed(6)}<br>
    <small>Công Ty TNHH phát triển cao su Tân Biên - Kampong Thom</small>
  `,
        )
        .openPopup();

      showToast(`📍 Đã di chuyển đến vị trí quản lý`, "📍");
    }

    function toggleFullscreen() {
      const wrap = document.querySelector(".map-canvas-wrap");
      const btn = document.querySelector('[onclick="toggleFullscreen()"]');
      const isFs = wrap.classList.contains("is-fullscreen");

      if (!isFs) {
        wrap.classList.add("is-fullscreen");
        btn.innerHTML = `<svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path d="M8 3v3a2 2 0 0 1-2 2H3M21 8h-3a2 2 0 0 1-2-2V3M3 16h3a2 2 0 0 0 2 2v3M16 21v-3a2 2 0 0 1 2-2h3"/>
    </svg>Thoát<span class="mc-tooltip mc-tooltip-right">Thoát toàn màn hình (ESC để thoát)</span>`;
        btn.classList.add("active");
        btn.classList.add("danger");
      } else {
        wrap.classList.remove("is-fullscreen");
        wrap.style.removeProperty("height");
        document.getElementById("dashMap").style.removeProperty("height");
        btn.innerHTML = `<svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path d="M8 3H5a2 2 0 0 0-2 2v3M21 8V5a2 2 0 0 0-2-2h-3M3 16v3a2 2 0 0 0 2 2h3M16 21h3a2 2 0 0 0 2-2v-3"/>
    </svg>Toàn màn hình<span class="mc-tooltip mc-tooltip-right">Phóng to bản đồ toàn màn hình (ESC để thoát)</span>`;
        btn.classList.remove("active");
        btn.classList.remove("danger");
      }
      setTimeout(() => dashMap && dashMap.invalidateSize(), 100);
    }

    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") {
        const wrap = document.querySelector(".map-canvas-wrap");
        if (wrap.classList.contains("is-fullscreen")) toggleFullscreen();
      }
    });

    /* ==================== TÌM KIẾM BẢN ĐỒ ==================== */
    function mapSearch(q) {
      const res = document.getElementById("mapSearchResults");
      if (!q.trim()) {
        res.innerHTML = "";
        return;
      }
      const ql = q.toLowerCase();
      const hits = caosuFeatures
        .filter((f) => {
          const p = f.properties;
          return (
            (p.ten_lo || "").toLowerCase().includes(ql) ||
            (p.id_lo || "").toLowerCase().includes(ql) ||
            (p.giong || "").toLowerCase().includes(ql) ||
            (p.doi || "").toLowerCase().includes(ql) ||
            String(p.nam_trong || "").includes(ql)
          );
        })
        .slice(0, 8);
      res.innerHTML = hits.length
        ? hits
          .map((f) => {
            const p = f.properties;
            const idx = caosuFeatures.indexOf(f);
            return `<div class="msp-result" onclick="flyToFeature(${idx})"><strong>${p.ten_lo || p.id_lo || "—"}</strong> ${p.doi || ""} · ${p.giong || "—"} · ${p.nam_trong || "—"} · ${p.dien_tich_map || "?"} ha</div>`;
          })
          .join("")
        : `<div class="msp-result" style="color:var(--muted)">Không tìm thấy kết quả</div>`;
    }

    function flyToFeature(idx) {
      const feat = caosuFeatures[idx];
      if (!feat || !feat.geometry) return;
      const tmp = L.geoJSON(feat);
      dashMap.flyToBounds(tmp.getBounds(), { maxZoom: 16, duration: 1 });
      selectedIdx.add(idx);
      updateSelBar();
      renderRealLots();
      document.getElementById("map-search-panel").classList.remove("show");
      showToast(
        `Đã tìm thấy: ${feat.properties.ten_lo || feat.properties.id_lo}`,
        "📍",
      );
    }

    /* ==================== CÔNG CỤ ĐO ĐẠC ==================== */
    let msrMode = "distance";
    let msrActive = false;
    let msrPoints = [];
    let msrPolyline = null;
    let msrPolygon = null;
    let msrMarkers = [];
    let msrTempLine = null;

    // Right-click drag to pan in measure mode
    let _msrRightDragging = false;
    let _msrRightLast = null;
    function _onMsrRightDown(e) {
      if (e.button !== 2) return;
      e.preventDefault();
      _msrRightDragging = true;
      _msrRightLast = { x: e.clientX, y: e.clientY };
      dashMap.getContainer().style.cursor = "grabbing";
    }
    function _onMsrRightMove(e) {
      if (!_msrRightDragging || !_msrRightLast) return;
      dashMap.panBy(
        [_msrRightLast.x - e.clientX, _msrRightLast.y - e.clientY],
        { animate: false }
      );
      _msrRightLast = { x: e.clientX, y: e.clientY };
    }
    function _onMsrRightUp(e) {
      if (e.button !== 2) return;
      _msrRightDragging = false;
      _msrRightLast = null;
      if (msrActive) dashMap.getContainer().style.cursor = "crosshair";
    }
    function _preventCtxMenu(e) { e.preventDefault(); }
    let msrLabels = [];

    function haversine(a, b) {
      const R = 6371000;
      const dLat = ((b.lat - a.lat) * Math.PI) / 180;
      const dLng = ((b.lng - a.lng) * Math.PI) / 180;
      const s =
        Math.sin(dLat / 2) ** 2 +
        Math.cos((a.lat * Math.PI) / 180) *
        Math.cos((b.lat * Math.PI) / 180) *
        Math.sin(dLng / 2) ** 2;
      return R * 2 * Math.atan2(Math.sqrt(s), Math.sqrt(1 - s));
    }

    function polygonArea(pts) {
      if (pts.length < 3) return 0;
      const R = 6371000;
      const lat0 = (pts[0].lat * Math.PI) / 180;
      const pts2 = pts.map((p) => ({
        x: (((p.lng - pts[0].lng) * Math.PI) / 180) * R * Math.cos(lat0),
        y: (((p.lat - pts[0].lat) * Math.PI) / 180) * R,
      }));
      let area = 0;
      for (let i = 0, j = pts2.length - 1; i < pts2.length; j = i++) {
        area += (pts2[j].x + pts2[i].x) * (pts2[j].y - pts2[i].y);
      }
      return Math.abs(area / 2);
    }

    function fmtDistance(m) {
      if (m >= 1000) return (m / 1000).toFixed(3) + " m";
      return Math.round(m) + " m";
    }
    function fmtArea(m2) {
      const ha = m2 / 10000;
      if (ha >= 1) return ha.toFixed(4) + " ha";
      return Math.round(m2).toLocaleString("vi") + " m²";
    }
    function fmtAreaSub(m2) {
      const ha = m2 / 10000;
      return `${Math.round(m2).toLocaleString("vi")} m²  ·  ${ha.toFixed(4)} ha`;
    }

    function openMeasure(mode) {
      window.previousTool = currentTool;
      currentTool = "measure";
      msrMode = mode;
      msrActive = true;
      document.getElementById("measure-panel").classList.add("show");
      document.getElementById("map-layer-panel").classList.remove("show");
      document.getElementById("map-search-panel").classList.remove("show");
      switchMeasureTab(mode);
      dashMap.getContainer().style.cursor = "crosshair";
      dashMap.dragging.disable();
      dashMap.doubleClickZoom.disable();
      dashMap.on("click", onMsrClick);
      dashMap.on("mousemove", onMsrMove);
      dashMap.on("dblclick", onMsrDblClick);
      const _c = dashMap.getContainer();
      _c.addEventListener("mousedown", _onMsrRightDown);
      _c.addEventListener("mousemove", _onMsrRightMove);
      _c.addEventListener("mouseup", _onMsrRightUp);
      _c.addEventListener("contextmenu", _preventCtxMenu);
      clearSelection();
      renderRealLots();
    }
    function closeMeasure() {
      document.getElementById("measure-panel").classList.remove("show");
      msrActive = false;
      dashMap.getContainer().style.cursor = "";
      dashMap.off("click", onMsrClick);
      dashMap.off("mousemove", onMsrMove);
      dashMap.off("dblclick", onMsrDblClick);
      const _c = dashMap.getContainer();
      _c.removeEventListener("mousedown", _onMsrRightDown);
      _c.removeEventListener("mousemove", _onMsrRightMove);
      _c.removeEventListener("mouseup", _onMsrRightUp);
      _c.removeEventListener("contextmenu", _preventCtxMenu);
      _msrRightDragging = false;
      dashMap.dragging.enable();
      dashMap.doubleClickZoom.enable();
      if (window.previousTool === "pan") {
        setMapTool("pan", document.getElementById("tool-pan"));
      } else if (window.previousTool === "pointer") {
        setMapTool("pointer", document.getElementById("tool-pointer"));
      } else {
        setMapTool("pan", document.getElementById("tool-pan"));
      }
      resetMeasure();
      document.getElementById("btn-measure-dist").classList.remove("active");
      document.getElementById("btn-measure-area").classList.remove("active");
      renderRealLots();
    }
    function switchMeasureTab(mode) {
      msrMode = mode;
      document
        .getElementById("msr-tab-dist")
        .classList.toggle("active", mode === "distance");
      document
        .getElementById("msr-tab-area")
        .classList.toggle("active", mode === "area");
      if (mode === "distance") {
        document.getElementById("msr-instruction").innerHTML =
          "Click bản đồ để thêm điểm đo.<br>Double-click hoặc nhấn <strong>Hoàn thành</strong> để kết thúc.";
        document.getElementById("msr-result-label").textContent =
          "Khoảng cách";
      } else {
        document.getElementById("msr-instruction").innerHTML =
          "Click bản đồ để vẽ vùng đo.<br>Click điểm đầu hoặc nhấn <strong>Hoàn thành</strong> để đóng vùng.";
        document.getElementById("msr-result-label").textContent = "Diện tích";
      }
      document
        .getElementById("btn-measure-dist")
        .classList.toggle("active", mode === "distance");
      document
        .getElementById("btn-measure-area")
        .classList.toggle("active", mode === "area");
      resetMeasure();
    }

    function onMsrClick(e) {
      if (!msrActive) return;
      const pt = { lat: e.latlng.lat, lng: e.latlng.lng };
      if (msrMode === "area" && msrPoints.length >= 3) {
        const first = msrPoints[0];
        const distToFirst = haversine(pt, first);
        if (distToFirst < 20) {
          finishMeasure();
          return;
        }
      }
      msrPoints.push(pt);
      const isFirst = msrPoints.length === 1;
      const marker = L.circleMarker([pt.lat, pt.lng], {
        radius: isFirst ? 6 : 4,
        fillColor: isFirst ? "#f59e0b" : "#00d68f",
        color: "#fff",
        weight: 1.5,
        fillOpacity: 1,
      }).addTo(dashMap);
      msrMarkers.push(marker);
      updateMeasureGraphics();
      updateMeasureResult();
    }
    function onMsrMove(e) {
      if (!msrActive || msrPoints.length === 0) return;
      const last = msrPoints[msrPoints.length - 1];
      const cur = e.latlng;
      if (msrTempLine) dashMap.removeLayer(msrTempLine);
      msrTempLine = L.polyline(
        [
          [last.lat, last.lng],
          [cur.lat, cur.lng],
        ],
        {
          color: "#00b4ff",
          weight: 1.5,
          dashArray: "5,4",
          opacity: 0.7,
        },
      ).addTo(dashMap);
    }
    function onMsrDblClick(e) {
      L.DomEvent.stopPropagation(e);
      finishMeasure();
    }
    function updateMeasureGraphics() {
      if (msrPolyline) {
        dashMap.removeLayer(msrPolyline);
        msrPolyline = null;
      }
      if (msrPolygon) {
        dashMap.removeLayer(msrPolygon);
        msrPolygon = null;
      }
      msrLabels.forEach((l) => dashMap.removeLayer(l));
      msrLabels = [];
      if (msrPoints.length < 2) return;
      const latlngs = msrPoints.map((p) => [p.lat, p.lng]);
      if (msrMode === "distance") {
        msrPolyline = L.polyline(latlngs, {
          color: "#00d68f",
          weight: 2.5,
          opacity: 0.9,
        }).addTo(dashMap);
        for (let i = 1; i < msrPoints.length; i++) {
          const d = haversine(msrPoints[i - 1], msrPoints[i]);
          const midLat = (msrPoints[i - 1].lat + msrPoints[i].lat) / 2;
          const midLng = (msrPoints[i - 1].lng + msrPoints[i].lng) / 2;
          const lbl = L.marker([midLat, midLng], {
            icon: L.divIcon({
              html: `<div style="background:rgba(0,214,143,.9);color:#080d18;font-size:10px;font-weight:700;padding:2px 6px;border-radius:10px;white-space:nowrap;">${fmtDistance(d)}</div>`,
              className: "",
              iconAnchor: [0, 0],
            }),
          }).addTo(dashMap);
          msrLabels.push(lbl);
        }
      } else {
        msrPolygon = L.polygon(latlngs, {
          color: "#f59e0b",
          weight: 2,
          fillColor: "#f59e0b",
          fillOpacity: 0.15,
        }).addTo(dashMap);
        msrPolyline = L.polyline(latlngs, {
          color: "#f59e0b",
          weight: 2.5,
          opacity: 0.9,
        }).addTo(dashMap);
      }
    }
    function updateMeasureResult() {
      const cnt = msrPoints.length;
      document.getElementById("msr-points-count").textContent = `${cnt} điểm`;
      if (msrMode === "distance") {
        if (cnt < 2) {
          document.getElementById("msr-result-value").textContent = "—";
          document.getElementById("msr-result-sub").textContent =
            "Cần ít nhất 2 điểm";
          return;
        }
        let total = 0;
        for (let i = 1; i < cnt; i++)
          total += haversine(msrPoints[i - 1], msrPoints[i]);
        document.getElementById("msr-result-value").textContent =
          fmtDistance(total);
        document.getElementById("msr-result-sub").textContent =
          `${Math.round(total)} m · ${cnt - 1} đoạn`;
      } else {
        if (cnt < 3) {
          document.getElementById("msr-result-value").textContent = "—";
          document.getElementById("msr-result-sub").textContent =
            "Cần ít nhất 3 điểm";
          return;
        }
        const area = polygonArea(msrPoints);
        document.getElementById("msr-result-value").textContent =
          fmtArea(area);
        document.getElementById("msr-result-sub").textContent =
          fmtAreaSub(area);
      }
    }
    function finishMeasure() {
      if (msrPoints.length < 2) return;
      if (msrMode === "area" && msrPoints.length >= 3)
        updateMeasureGraphics();
      if (msrTempLine) {
        dashMap.removeLayer(msrTempLine);
        msrTempLine = null;
      }
      updateMeasureResult();
      showToast(
        msrMode === "distance"
          ? `Khoảng cách: ${fmtDistance(msrPoints.slice(1).reduce((s, p, i) => s + haversine(msrPoints[i], p), 0))}`
          : `Diện tích: ${fmtArea(polygonArea(msrPoints))}`,
        msrMode === "distance" ? "📏" : "⬡",
      );
    }
    function undoMeasurePoint() {
      if (msrPoints.length === 0) return;
      msrPoints.pop();
      const m = msrMarkers.pop();
      if (m) dashMap.removeLayer(m);
      if (msrTempLine) {
        dashMap.removeLayer(msrTempLine);
        msrTempLine = null;
      }
      updateMeasureGraphics();
      updateMeasureResult();
    }
    function resetMeasure() {
      msrPoints = [];
      msrMarkers.forEach((m) => dashMap.removeLayer(m));
      msrMarkers = [];
      msrLabels.forEach((l) => dashMap.removeLayer(l));
      msrLabels = [];
      if (msrPolyline) {
        dashMap.removeLayer(msrPolyline);
        msrPolyline = null;
      }
      if (msrPolygon) {
        dashMap.removeLayer(msrPolygon);
        msrPolygon = null;
      }
      if (msrTempLine) {
        dashMap.removeLayer(msrTempLine);
        msrTempLine = null;
      }
      document.getElementById("msr-result-value").textContent = "—";
      document.getElementById("msr-result-sub").textContent =
        "Chưa có điểm nào";
      document.getElementById("msr-points-count").textContent = "0 điểm";
    }

    /* ==================== KHỞI TẠO DASHBOARD ==================== */
    async function initDashMap() {
      dashMap = L.map("dashMap", {
        zoomControl: false,
        attributionControl: false,
      }).setView([12.524, 105.452], 12);

      window.currentBaseLayer = L.tileLayer(
        "https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}",
        { maxZoom: 19, attribution: "Esri, Maxar, Earthstar" },
      ).addTo(dashMap);

      try {
        const xaRes = await fetch("/data/xa_cambodia.geojson");
        if (xaRes.ok) {
          const xaGeojson = await xaRes.json();
          xaLayer = L.geoJSON(xaGeojson, {
            style: {
              color: "#ffffff",
              weight: 2.5,
              fillColor: "transparent",
              fillOpacity: 0,
              dashArray: "6,4",
              opacity: 0.6,
            },
          }).addTo(dashMap);
        } else {
          console.warn("Không tìm thấy file ranh giới xã, bỏ qua");
          xaLayer = L.geoJSON({
            type: "FeatureCollection",
            features: [],
          }).addTo(dashMap);
        }
      } catch (err) {
        console.warn("Lỗi tải ranh giới xã:", err);
        xaLayer = L.geoJSON({
          type: "FeatureCollection",
          features: [],
        }).addTo(dashMap);
      }

      await loadCaosuData();
      await buildFilterUI();
      renderRealLots();

      dashMap.on("mousemove", (e) => {
        document.getElementById("coordLat").textContent =
          `Lat: ${e.latlng.lat.toFixed(5)}`;
        document.getElementById("coordLng").textContent =
          `Lng: ${e.latlng.lng.toFixed(5)}`;
      });
      dashMap.on("zoom", () => {
        const z = dashMap.getZoom();
        document.getElementById("zoomLevel").textContent = `Zoom: ${z}`;
        document.getElementById("mc-zoom-num").textContent = z;
        renderRealLots();
      });
      dashMap.on("click", () => {
        document
          .querySelectorAll(".map-layer-panel,.map-search-panel")
          .forEach((p) => p.classList.remove("show"));
      });

      const panBtn = document.getElementById("tool-pan");
      if (panBtn) setMapTool("pan", panBtn);
      document.addEventListener("keydown", (e) => {
        if (e.target.tagName === "INPUT" || e.target.tagName === "TEXTAREA")
          return;
        if (e.key === "+" || e.key === "=") mapZoomIn();
        if (e.key === "-" || e.key === "_") mapZoomOut();
        if (e.key === "h" || e.key === "H") goHome();
      });

      const focusLotId = localStorage.getItem("focus_lot_id");
      if (focusLotId) {
        localStorage.removeItem("focus_lot_id");
        const idx = caosuFeatures.findIndex(
          (f) => f.properties.id_lo === focusLotId,
        );
        if (idx !== -1) {
          setTimeout(() => {
            flyToFeature(idx);
            showToast(
              ` Đã chuyển đến lô: ${caosuFeatures[idx].properties.ten_lo || focusLotId}`,
              "📍",
            );
          }, 500);
        } else {
          showToast(`⚠️ Không tìm thấy lô với ID: ${focusLotId}`, "⚠️");
        }
      }
    }

    /* ==================== TOAST ==================== */
    function showToast(msg, icon = "✅") {
      const t = document.getElementById("toast");
      if (!t) return;
      document.getElementById("toastMsg").textContent = msg;
      document.getElementById("toastIcon").textContent = icon;
      t.classList.add("show");
      setTimeout(() => t.classList.remove("show"), 3000);
    }

    /* ==================== ĐIỀU HƯỚNG TRANG ==================== */
    function goTo(id, el) {
      document
        .querySelectorAll(".page")
        .forEach((p) => p.classList.remove("active"));
      document
        .querySelectorAll(".nav-item")
        .forEach((n) => n.classList.remove("active"));
      document.getElementById("page-" + id).classList.add("active");
      if (el) el.classList.add("active");
      if (id === "dashboard")
        setTimeout(() => dashMap && dashMap.invalidateSize(), 120);
    }

    /* ==================== XUẤT BẢN ĐỒ ==================== */
    async function waitForMapStable() {
      if (dashMap) dashMap.invalidateSize();
      return new Promise((resolve) => setTimeout(resolve, 800));
    }

    async function exportMapToPDF() {
      const mapContainer = document.querySelector(".map-canvas-wrap");
      const legend = document.getElementById("mapLegend");

      if (!mapContainer) {
        showToast("Không tìm thấy vùng bản đồ", "⚠️");
        return;
      }

      showToast("Đang xuất PDF (giữ nhãn lô)...", "⏳");

      try {
        const leftToolbar = document.querySelector(".map-ctrl-left");
        const rightToolbar = document.querySelector(".map-ctrl-right");
        const coordBar = document.querySelector(".map-coord-bar");
        const selBar = document.querySelector(".map-sel-bar");
        const measurePanel = document.getElementById("measure-panel");

        if (leftToolbar) leftToolbar.style.visibility = "hidden";
        if (rightToolbar) rightToolbar.style.visibility = "hidden";
        if (coordBar) coordBar.style.visibility = "hidden";
        if (selBar) selBar.style.visibility = "hidden";
        if (measurePanel) measurePanel.style.visibility = "hidden";

        await waitForMapStable();

        const mapCanvas = await html2canvas(mapContainer, {
          scale: 4,
          backgroundColor: "#0a0e1a",
          logging: false,
          useCORS: true,
          allowTaint: false,
          imageTimeout: 0,
        });

        let legendCanvas = null;
        if (legend) {
          legendCanvas = await html2canvas(legend, {
            scale: 3,
            backgroundColor: "#0a0e1a",
          });
        }

        if (leftToolbar) leftToolbar.style.visibility = "visible";
        if (rightToolbar) rightToolbar.style.visibility = "visible";
        if (coordBar) coordBar.style.visibility = "visible";
        if (selBar) selBar.style.visibility = "visible";
        if (measurePanel) measurePanel.style.visibility = "visible";

        const { jsPDF } = window.jspdf;
        const pdf = new jsPDF({
          orientation: "landscape",
          unit: "mm",
          format: "a4",
        });
        const pdfWidth = pdf.internal.pageSize.getWidth();
        const pdfHeight = pdf.internal.pageSize.getHeight();

        const mapImgData = mapCanvas.toDataURL("image/jpeg", 1.0);
        const mapImgWidth = pdfWidth;
        const mapImgHeight =
          (mapCanvas.height * mapImgWidth) / mapCanvas.width;

        let yOffset = 0;
        pdf.addImage(
          mapImgData,
          "JPEG",
          0,
          yOffset,
          mapImgWidth,
          mapImgHeight,
        );

        if (legendCanvas) {
          const legendWidth = pdfWidth * 0.7;
          const legendHeight =
            (legendCanvas.height * legendWidth) / legendCanvas.width;
          yOffset = mapImgHeight + 5;
          if (yOffset + legendHeight > pdfHeight) {
            pdf.addPage();
            yOffset = 0;
          }
          pdf.addImage(
            legendCanvas,
            "JPEG",
            (pdfWidth - legendWidth) / 2,
            yOffset,
            legendWidth,
            legendHeight,
          );
        }

        const title = "BÁO CÁO BẢN ĐỒ VƯỜN CÂY CAO SU";
        const date = new Date().toLocaleString("vi-VN");
        pdf.setFontSize(12);
        pdf.setTextColor(200, 200, 200);
        pdf.text(title, pdfWidth / 2, 10, { align: "center" });
        pdf.setFontSize(9);
        pdf.text(`Xuất ngày: ${date}`, pdfWidth - 20, 10, { align: "right" });

        pdf.save(`ban_do_cao_su_${Date.now()}.pdf`);
        showToast("Xuất PDF thành công!", "✅");
      } catch (err) {
        console.error(err);
        showToast("Lỗi xuất PDF: " + err.message, "❌");
        const leftToolbar = document.querySelector(".map-ctrl-left");
        const rightToolbar = document.querySelector(".map-ctrl-right");
        const coordBar = document.querySelector(".map-coord-bar");
        const selBar = document.querySelector(".map-sel-bar");
        const measurePanel = document.getElementById("measure-panel");
        if (leftToolbar) leftToolbar.style.visibility = "visible";
        if (rightToolbar) rightToolbar.style.visibility = "visible";
        if (coordBar) coordBar.style.visibility = "visible";
        if (selBar) selBar.style.visibility = "visible";
        if (measurePanel) measurePanel.style.visibility = "visible";
      }
    }

    async function exportMapToJPEG() {
      const mapContainer = document.querySelector(".map-canvas-wrap");
      const legend = document.getElementById("mapLegend");

      if (!mapContainer) {
        showToast("Không tìm thấy vùng bản đồ", "⚠️");
        return;
      }

      showToast("Đang xuất JPEG (giữ nhãn lô)...", "⏳");

      try {
        const leftToolbar = document.querySelector(".map-ctrl-left");
        const rightToolbar = document.querySelector(".map-ctrl-right");
        const coordBar = document.querySelector(".map-coord-bar");
        const selBar = document.querySelector(".map-sel-bar");
        const measurePanel = document.getElementById("measure-panel");

        if (leftToolbar) leftToolbar.style.visibility = "hidden";
        if (rightToolbar) rightToolbar.style.visibility = "hidden";
        if (coordBar) coordBar.style.visibility = "hidden";
        if (selBar) selBar.style.visibility = "hidden";
        if (measurePanel) measurePanel.style.visibility = "hidden";

        await waitForMapStable();

        const mapCanvas = await html2canvas(mapContainer, {
          scale: 3,
          backgroundColor: "#0a0e1a",
          logging: false,
          useCORS: true,
          allowTaint: false,
        });

        let legendCanvas = null;
        if (legend) {
          legendCanvas = await html2canvas(legend, {
            scale: 2,
            backgroundColor: "#0a0e1a",
          });
        }

        if (leftToolbar) leftToolbar.style.visibility = "visible";
        if (rightToolbar) rightToolbar.style.visibility = "visible";
        if (coordBar) coordBar.style.visibility = "visible";
        if (selBar) selBar.style.visibility = "visible";
        if (measurePanel) measurePanel.style.visibility = "visible";

        const finalCanvas = document.createElement("canvas");
        const mapWidth = mapCanvas.width;
        const mapHeight = mapCanvas.height;
        let legendHeight = legendCanvas ? legendCanvas.height : 0;
        const padding = 30;
        finalCanvas.width = mapWidth;
        finalCanvas.height = mapHeight + legendHeight + padding + 70;
        const ctx = finalCanvas.getContext("2d");
        ctx.fillStyle = "#0a0e1a";
        ctx.fillRect(0, 0, finalCanvas.width, finalCanvas.height);

        ctx.font = 'bold 32px "Inter", sans-serif';
        ctx.fillStyle = "#e8eeff";
        ctx.fillText("BÁO CÁO BẢN ĐỒ VƯỜN CÂY CAO SU", 20, 55);
        ctx.font = '16px "Inter", sans-serif';
        ctx.fillStyle = "#8a9ab8";
        const dateStr = `Xuất ngày: ${new Date().toLocaleString("vi-VN")}`;
        ctx.fillText(
          dateStr,
          finalCanvas.width - ctx.measureText(dateStr).width - 20,
          55,
        );

        ctx.drawImage(mapCanvas, 0, 85);

        if (legendCanvas) {
          const legendX = (mapWidth - legendCanvas.width) / 2;
          const legendY = 85 + mapHeight + 15;
          ctx.drawImage(legendCanvas, legendX, legendY);
        }

        ctx.font = '12px "Inter", sans-serif';
        ctx.fillStyle = "#5a6a8a";
        ctx.fillText(
          "WebGIS Cao Su - Hệ thống quản lý vườn cây thông minh",
          finalCanvas.width - 280,
          finalCanvas.height - 12,
        );

        finalCanvas.toBlob(
          (blob) => {
            const url = URL.createObjectURL(blob);
            const a = document.createElement("a");
            a.href = url;
            a.download = `ban_do_cao_su_${Date.now()}.jpg`;
            a.click();
            URL.revokeObjectURL(url);
            showToast("Xuất JPEG thành công!", "✅");
          },
          "image/jpeg",
          0.95,
        );
      } catch (err) {
        console.error(err);
        showToast("Lỗi xuất JPEG: " + err.message, "❌");
      }
    }

    function changeBaseMap(type) {
      if (!dashMap) return;

      if (window.currentBaseLayer) {
        dashMap.removeLayer(window.currentBaseLayer);
      }

      let newLayer;
      switch (type) {
        case "osm":
          newLayer = L.tileLayer(
            "https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png",
            {
              maxZoom: 19,
              attribution: "© OpenStreetMap",
            },
          );
          break;
        case "carto":
          newLayer = L.tileLayer(
            "https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}.png",
            {
              maxZoom: 19,
              attribution: "© CartoDB",
            },
          );
          break;
        case "gray":
          newLayer = L.tileLayer(
            "https://server.arcgisonline.com/ArcGIS/rest/services/Canvas/World_Light_Gray_Base/MapServer/tile/{z}/{y}/{x}",
            {
              maxZoom: 19,
              attribution: "Esri, DeLorme",
            },
          );
          break;
        default:
          newLayer = L.tileLayer(
            "https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}",
            {
              maxZoom: 19,
              attribution: "Esri, Maxar, Earthstar",
            },
          );
      }

      newLayer.addTo(dashMap);
      window.currentBaseLayer = newLayer;

      showToast(`Đã chuyển sang nền: ${type}`, "🖼️");
    }

    async function loadRealStats() {
      try {
        const res = await fetch("/api/lo-cay", {
          credentials: "same-origin",
        });
        const data = await res.json();
        const loCayList = data.data || [];
        const totalLots = loCayList.length;
        const totalArea = loCayList.reduce(
          (sum, lo) => sum + (parseFloat(lo.dien_tich_map) || 0),
          0,
        );

        document.getElementById("totalLots").innerText =
          totalLots.toLocaleString("vi-VN");
        document.getElementById("totalArea").innerHTML =
          totalArea.toLocaleString("vi-VN", {
            minimumFractionDigits: 2,
            maximumFractionDigits: 2,
          }) + " ha";
      } catch (err) {
        console.error("Lỗi tải thống kê:", err);
        document.getElementById("totalLots").innerText = "0";
        document.getElementById("totalArea").innerHTML = "0 ha";
      }
    }

    async function loadUserInfo() {
      try {
        const res = await fetch("/api/me", { credentials: "same-origin" });
        const data = await res.json();
        if (data.success) {
          const user = data.data;
          document.getElementById("userFullName").innerText = user.fullname;
          document.getElementById("userRole").innerText =
            user.role === "admin" ? "Quản trị viên" : "Người dùng";
          document.getElementById("userAvatar").innerText = user.fullname
            .charAt(0)
            .toUpperCase();
        } else {
          console.warn("Không lấy được thông tin user");
        }
      } catch (err) {
        console.error("Lỗi /api/me:", err);
      }
    }

    document.addEventListener("DOMContentLoaded", () => {
      loadUserInfo();
      loadRealStats();
    });

    setTimeout(initDashMap, 200);

    document.querySelectorAll(".nav-item").forEach((item) => {
      item.addEventListener("click", function (e) {
        if (this.getAttribute("href") === "/logout") return;
        document
          .querySelectorAll(".nav-item")
          .forEach((i) => i.classList.remove("active"));
        this.classList.add("active");
      });
    });
    window.addEventListener("load", () => {
      const currentPath = window.location.pathname;
      document.querySelectorAll(".nav-item").forEach((item) => {
        const href = item.getAttribute("href");
        if (
          href &&
          (currentPath === href ||
            (currentPath === "/dashboard" && href === "/"))
        ) {
          item.classList.add("active");
        }
      });
    });
    function logout() {
      if (confirm("Bạn có chắc muốn đăng xuất?"))
        window.location.href = "/logout";
    }
