<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>WebGIS · Vườn Cây Cao Su</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&family=Syne:wght@700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"/>
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<style>
:root {
  --bg:       #080d18;
  --s1:       #0f1729;
  --s2:       #151f35;
  --s3:       #1c2844;
  --border:   rgba(255,255,255,0.07);
  --border2:  rgba(255,255,255,0.12);
  --text:     #e8eeff;
  --muted:    #5a6a8a;
  --muted2:   #8a9ab8;
  --accent:   #00d68f;
  --accentB:  #00b4ff;
  --warn:     #f59e0b;
  --danger:   #f4656a;
  --purple:   #a78bfa;
  --font-d:   'Syne', sans-serif;
  --font-b:   'Be Vietnam Pro', sans-serif;
  --nav-w:    220px;
  --top-h:    56px;
  --r:        8px;
  --r-lg:     12px;
}
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
body{font-family:var(--font-b);background:var(--bg);color:var(--text);height:100vh;overflow:hidden;display:flex;flex-direction:column}
::-webkit-scrollbar{width:4px;height:4px}
::-webkit-scrollbar-track{background:transparent}
::-webkit-scrollbar-thumb{background:var(--s3);border-radius:2px}

/* ── TOP BAR ── */
#topbar{
  height:var(--top-h);flex-shrink:0;
  background:var(--s1);border-bottom:1px solid var(--border);
  display:flex;align-items:center;padding:0 20px;gap:16px;
  position:relative;z-index:100;
}
#topbar::after{
  content:'';position:absolute;bottom:0;left:0;right:0;height:1px;
  background:linear-gradient(90deg,transparent,rgba(0,214,143,0.3),transparent);
}
.tb-logo{display:flex;align-items:center;gap:10px;text-decoration:none}
.tb-icon{
  width:34px;height:34px;border-radius:9px;
  background:linear-gradient(135deg,var(--accent),var(--accentB));
  display:flex;align-items:center;justify-content:center;font-size:17px;
  box-shadow:0 0 20px rgba(0,214,143,0.25);flex-shrink:0;
}
.tb-title{font-family:var(--font-d);font-size:14px;letter-spacing:.06em;color:var(--text)}
.tb-sub{font-size:10px;color:var(--muted);letter-spacing:.12em;text-transform:uppercase}
.tb-sep{width:1px;height:28px;background:var(--border);margin:0 4px}
.tb-pill{
  background:var(--s2);border:1px solid var(--border);border-radius:6px;
  padding:5px 12px;font-size:11px;color:var(--muted2);display:flex;align-items:center;gap:6px;
}
.tb-pill strong{color:var(--text);font-size:13px}
.live-dot{width:6px;height:6px;border-radius:50%;background:var(--accent);box-shadow:0 0 6px var(--accent);animation:blink 2s infinite}
@keyframes blink{0%,100%{opacity:1}50%{opacity:.3}}
.tb-right{margin-left:auto;display:flex;align-items:center;gap:10px}

/* ── BODY ── */
#body{display:flex;flex:1;overflow:hidden}

/* ── MAP TOPBAR ── */
.map-topbar{
  background:var(--s1);border-bottom:1px solid var(--border);
  padding:12px 16px;gap:8px;
  display:flex;align-items:center;flex-wrap:wrap;
  z-index:50;
}
.map-topbar-title{
  display:flex;align-items:center;gap:6px;font-size:12px;color:var(--text);
  white-space:nowrap;
}
.map-topbar-title svg{opacity:.6}
.map-sep{width:1px;height:20px;background:var(--border);margin:0 4px}
.map-label{font-size:11px;color:var(--muted);white-space:nowrap;font-weight:500}
.map-chip{
  background:var(--s2);border:1px solid var(--border);border-radius:var(--r);
  padding:5px 10px;font-size:11px;color:var(--muted2);cursor:pointer;transition:.2s;
  white-space:nowrap;
}
.map-chip:hover{border-color:var(--accentB);color:var(--accentB)}
.map-chip.on{background:rgba(0,214,143,0.15);border-color:var(--accent);color:var(--accent)}

/* ── DASHBOARD MAP ── */
.map-container{
  flex:1;display:flex;flex-direction:column;overflow:hidden;position:relative;
}
.map-canvas-wrap{
  flex:1;position:relative;overflow:hidden;
}
#dashMap{
  width:100%;height:100%;
}

/* ── MAP CONTROLS ── */
.map-ctrl-left, .map-ctrl-right{
  position:absolute;top:12px;display:flex;flex-direction:column;gap:8px;z-index:400;
}
.map-ctrl-left{left:12px}
.map-ctrl-right{right:12px}
.map-ctrl-group{
  display:flex;flex-direction:column;gap:4px;
  background:rgba(15,23,41,0.9);border:1px solid var(--border);border-radius:var(--r-lg);
  padding:8px;backdrop-filter:blur(10px);
}
.mc-group-label{font-size:9px;color:var(--muted);font-weight:700;padding:0 4px;letter-spacing:.08em;text-transform:uppercase}
.mc-btn{
  width:40px;height:40px;border-radius:var(--r);border:1px solid var(--border);
  background:transparent;color:var(--muted2);cursor:pointer;
  display:flex;align-items:center;justify-content:center;transition:.2s;
  position:relative;font-size:10px;
}
.mc-btn:hover{border-color:var(--accentB);color:var(--accentB)}
.mc-btn svg{width:14px;height:14px}
.mc-btn-wide{
  width:100%;padding:6px 8px;text-align:left;font-size:11px;display:flex;align-items:center;gap:6px;
  white-space:nowrap;
}
.mc-btn-wide svg{flex-shrink:0}
.mc-btn.active, .mc-btn-wide.active{border-color:var(--accent);background:rgba(0,214,143,0.15);color:var(--accent)}
.mc-tooltip{
  position:absolute;bottom:100%;left:50%;transform:translateX(-50%);
  background:var(--s3);border:1px solid var(--border);border-radius:var(--r);
  padding:6px 10px;font-size:10px;white-space:nowrap;opacity:0;pointer-events:none;
  margin-bottom:8px;z-index:1000;transition:.2s;
}
.mc-btn:hover .mc-tooltip{opacity:1}
.mc-tooltip-right{right:100%;bottom:50%;transform:translate(-8px,50%);margin-bottom:0}

/* ── MAP PANELS ── */
.map-layer-panel, .map-search-panel, .measure-panel{
  position:absolute;bottom:12px;left:12px;
  background:rgba(15,23,41,0.95);border:1px solid var(--border);border-radius:var(--r-lg);
  backdrop-filter:blur(10px);padding:12px;z-index:500;
  display:none;width:280px;max-height:400px;overflow-y:auto;
}
.map-layer-panel.show, .map-search-panel.show, .measure-panel.show{display:block}

.mlp-header, .msp-header, .msr-header{
  font-size:12px;font-weight:600;color:var(--text);margin-bottom:10px;
  display:flex;justify-content:space-between;align-items:center;
}
.mlp-item, .msp-result{
  display:flex;align-items:center;gap:8px;padding:8px;border-radius:var(--r);
  cursor:pointer;transition:.2s;font-size:12px;color:var(--muted2);
}
.mlp-item:hover{background:rgba(255,255,255,0.05);color:var(--text)}
.mlp-check{
  width:16px;height:16px;border:1.5px solid var(--border);border-radius:3px;
  display:flex;align-items:center;justify-content:center;font-size:10px;color:var(--accent);
  flex-shrink:0;
}
.mlp-check.on{background:var(--accent);color:var(--s1);border-color:var(--accent)}
.mlp-dot{
  width:12px;height:12px;border-radius:3px;flex-shrink:0;
}

.msp-input{
  display:flex;align-items:center;gap:6px;background:var(--s2);border:1px solid var(--border);
  border-radius:var(--r);padding:6px 10px;margin-bottom:8px;
}
.msp-input input{
  flex:1;background:transparent;border:none;color:var(--text);font-size:11px;outline:none;
}
.msp-input input::placeholder{color:var(--muted)}

/* ── MEASURE PANEL ── */
.measure-panel{width:240px}
.msr-tabs{display:flex;gap:4px;margin-bottom:10px;border-bottom:1px solid var(--border);padding-bottom:8px}
.msr-tab{font-size:11px;color:var(--muted);cursor:pointer;padding:4px 0;transition:.2s;border-bottom:2px solid transparent}
.msr-tab.active{color:var(--accent);border-bottom-color:var(--accent)}
.msr-instruction{font-size:11px;color:var(--muted);margin-bottom:10px;line-height:1.4}
.msr-result-label{font-size:10px;color:var(--muted);margin-bottom:2px}
.msr-result-value{font-size:18px;font-weight:700;color:var(--accent);margin-bottom:2px;font-family:var(--font-d)}
.msr-result-sub{font-size:10px;color:var(--muted2);margin-bottom:10px}
.msr-points{font-size:11px;color:var(--muted);margin-bottom:8px}
.msr-btns{display:flex;gap:4px;flex-wrap:wrap}
.msr-btn{
  flex:1;min-width:70px;padding:6px 8px;font-size:10px;border:1px solid var(--border);
  background:transparent;color:var(--muted2);border-radius:var(--r);cursor:pointer;
  transition:.2s;white-space:nowrap;
}
.msr-btn:hover{border-color:var(--accentB);color:var(--accentB)}
.msr-btn.primary{background:var(--accent);border-color:var(--accent);color:var(--s1);font-weight:600}
.msr-btn.danger{border-color:var(--danger);color:var(--danger)}

/* ── MAP SELECTION BAR ── */
.map-sel-bar, .map-coord-bar{
  position:absolute;bottom:12px;right:12px;
  background:rgba(15,23,41,0.95);border:1px solid var(--border);border-radius:var(--r-lg);
  padding:8px 12px;font-size:11px;color:var(--muted2);
  display:flex;align-items:center;gap:8px;z-index:450;
  backdrop-filter:blur(10px);
}
.map-sel-bar{right:12px;bottom:auto;top:80px}
.map-sel-dot{width:8px;height:8px;border-radius:50%;background:var(--accent);box-shadow:0 0 8px var(--accent)}
.coord-item{display:flex;align-items:center;gap:4px;font-size:10px}

/* ── BOUNDARY TOOLTIP ── */
.boundary-tooltip{
  background:var(--s1)!important;border:1px solid var(--border)!important;
  color:var(--text)!important;border-radius:var(--r)!important;
  padding:4px 8px!important;font-size:11px!important;
}
.boundary-tooltip strong{color:var(--accent)}

/* ── TOAST ── */
.toast{
  position:fixed;bottom:-80px;left:50%;transform:translateX(-50%);
  background:var(--s1);border:1px solid var(--border);border-radius:var(--r-lg);
  padding:12px 16px;display:flex;align-items:center;gap:8px;
  color:var(--text);z-index:2000;font-size:12px;
  transition:.3s;backdrop-filter:blur(10px);
}
.toast.show{bottom:20px}
.toast-icon{font-size:16px}

/* ── SIDEBAR & DASHBOARD ── */
#content{flex:1;overflow-y:auto;padding:12px}
.page{display:none}
.page.active{display:block}

/* ── CARDS ── */
.card{
  background:var(--s1);border:1px solid var(--border);border-radius:var(--r-lg);
  padding:14px;margin-bottom:12px;
}
.stat-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(140px,1fr));gap:10px;margin-bottom:14px}
.stat-box{
  background:var(--s2);border:1px solid var(--border);border-radius:var(--r);padding:10px;
}
.stat-label{font-size:10px;color:var(--muted);font-weight:600;text-transform:uppercase;margin-bottom:4px}
.stat-value{font-size:20px;font-weight:700;color:var(--accent);font-family:var(--font-d)}

select {
  background:var(--s2);border:1px solid var(--border);border-radius:var(--r);
  color:var(--muted2);padding:6px 10px;font-size:11px;font-family:var(--font-b);
  cursor:pointer;transition:.2s;
}
select:hover{border-color:var(--accentB);color:var(--accentB)}

/* === CSS PHẦN CODE CŨ BỊ ĐẶT SAI VỊ TRÍ === */
#map { height: 80vh; }
.container { display: flex; }
aside { width: 200px; padding: 10px; background: #f5f5f5; }
header { display: flex; justify-content: space-between; padding: 10px; background: #2c3e50; color: white; }
#legend { padding: 10px; }
</style>
</head>
<body>

<!-- DASHBOARD CONTAINER -->
<div class="map-container">
  <!-- Row 1: Title bar with view modes -->
  <div class="map-topbar">
    <span class="map-topbar-title">
      <svg width="13" height="13" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><polygon points="3 11 22 2 13 21 11 13 3 11"/></svg>
      <span>Bản đồ vườn cây cao su</span> — Kampong Thom, Cambodia
    </span>
    <div class="map-sep"></div>
    <span class="map-label">Tô màu theo:</span>
    <button class="map-chip" id="mview-giong" onclick="switchMapView('giong',this)">Giống cây</button>
    <button class="map-chip" id="mview-nam" onclick="switchMapView('nam',this)">Năm trồng</button>
    <button class="map-chip on" id="mview-nt" onclick="switchMapView('doi',this)">Nông trường</button>
    <div style="margin-left:auto;display:flex;gap:6px;align-items:center">
      <span id="selCountTop" style="font-size:11px;color:var(--muted)">0 lô hiển thị</span>
      <button class="map-chip" onclick="goHome()">⌂ Toàn vùng</button>
    </div>
  </div>

  <!-- Row 2: Filter dropdowns -->
  <div class="map-topbar" style="background:rgba(15,23,41,0.6);padding:7px 14px;gap:12px;display:flex;align-items:center;flex-wrap:wrap">
    <span class="map-label" style="flex-shrink:0">Nông trường:</span>
    <select id="filter-nt" onchange="updateMapFilters('doi', this)">
      <option value="all">Tất cả</option>
    </select>
    <div class="map-sep"></div>
    <span class="map-label" style="flex-shrink:0">Năm trồng:</span>
    <select id="filter-nam" onchange="updateMapFilters('nam_trong', this)">
      <option value="all">Tất cả</option>
    </select>
    <div class="map-sep"></div>
    <span class="map-label" style="flex-shrink:0">Giống cây:</span>
    <select id="filter-giong" onchange="updateMapFilters('giong', this)">
      <option value="all">Tất cả</option>
    </select>
  </div>

  <!-- Map canvas + overlays -->
  <div class="map-canvas-wrap">
    <div id="dashMap"></div>

    <!-- LEFT TOOLBAR -->
    <div class="map-ctrl-left">
      <!-- ZOOM group -->
      <div class="map-ctrl-group">
        <div class="mc-group-label">Zoom</div>
        <button class="mc-btn-wide" onclick="mapZoomIn()">
          <svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
          Phóng to
        </button>
        <button class="mc-btn-wide" onclick="mapZoomOut()">
          <svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"/></svg>
          Thu nhỏ
        </button>
      </div>

      <!-- PAN group -->
      <div class="map-ctrl-group">
        <div class="mc-group-label">Công cụ</div>
        <button class="mc-btn-wide active" onclick="setMapTool('pan', this)">
          <svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path d="M5 9l-3 3 3 3M9 5l3-3 3 3M15 19l-3 3-3-3M19 9l3 3-3 3M12 12v0"/>
          </svg>
          Pan (kéo)
        </button>
      </div>

      <!-- HOME group -->
      <div class="map-ctrl-group">
        <div class="mc-group-label">Vị trí</div>
        <button class="mc-btn-wide" onclick="goHome()">
          <svg width="15" height="15" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
            <polyline points="9 22 9 12 15 12 15 22"/>
          </svg>
          Trang chủ
        </button>
      </div>
    </div>

    <!-- RIGHT TOOLBAR -->
    <div class="map-ctrl-right">
      <!-- Layers & Boundary -->
      <div class="map-ctrl-group">
        <button class="mc-btn" onclick="togglePanel('map-layer-panel')" title="Lớp bản đồ">
          <svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><polygon points="12 2 2 7 12 12 22 7 12 2"/><polyline points="2 17 12 22 22 17"/><polyline points="2 12 12 17 22 12"/></svg>
          <span class="mc-tooltip mc-tooltip-right">Lớp bản đồ</span>
        </button>
        <button class="mc-btn active" id="btn-boundary" onclick="toggleBoundary(this)" title="Ranh giới">
          <svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M3 3h18v18H3zM3 9h18M3 15h18M9 3v18M15 3v18" stroke-dasharray="2 2"/></svg>
          <span class="mc-tooltip mc-tooltip-right">Ranh giới đội</span>
        </button>
      </div>
    </div>

    <!-- LAYER PANEL -->
    <div class="map-layer-panel" id="map-layer-panel">
      <div class="mlp-header">
        Lớp bản đồ
        <span style="cursor:pointer;color:var(--muted)" onclick="togglePanel('map-layer-panel')">✕</span>
      </div>
      <div class="mlp-item" onclick="toggleLayer(this,'lots')">
        <div class="mlp-check on" id="lc-lots">✓</div>
        <div class="mlp-dot" style="background:#00d68f"></div>
        Lô vườn cây cao su
      </div>
      <div class="mlp-item" onclick="toggleLayer(this,'background-layer')">
        <div class="mlp-check on" id="lc-background-layer">✓</div>
        <div class="mlp-dot" style="background:#d4dce8"></div>
        Lớp nền
      </div>
      <div class="mlp-item" onclick="toggleLayer(this,'boundary')">
        <div class="mlp-check on" id="lc-boundary">✓</div>
        <div class="mlp-dot" style="background:#ffffff55"></div>
        Ranh giới đội
      </div>
      <div class="mlp-item" onclick="toggleLayer(this,'satellite')">
        <div class="mlp-check on" id="lc-satellite">✓</div>
        <div class="mlp-dot" style="background:#888"></div>
        Ảnh vệ tinh Esri
      </div>
    </div>

    <!-- SELECTION BAR -->
    <div class="map-sel-bar" id="mapSelBar" style="display:none">
      <div class="map-sel-dot"></div>
      <span id="selBarText">Đối tượng được chọn: 0</span>
    </div>
  </div>
</div>

<!-- TOAST -->
<div class="toast" id="toast">
  <span class="toast-icon" id="toastIcon">✅</span>
  <span id="toastMsg">Thao tác thành công</span>
</div>

<script>
// ==================== BIẾN TOÀN CỤC ====================
let dashMap;
let CAOSU_GEOJSON = null;
let mapViewMode = 'doi';
let selectedIdx = new Set();
let lotLayers = [], backgroundLotLayers = [], labelLayers = [];
let boundaryLayer = null;
let boundaryVis = true;
let lotsVis = true;
let layerVisibility = {
  'lots': true,
  'background-layer': true,
  'boundary': true,
  'satellite': true
};

// Palette tô màu theo đội
const doiPalette = {
  'NT 1': '#00d68f',
  'NT 2': '#00b4ff',
  'NT 3': '#f59e0b',
  'default': '#5a6a8a'
};

// ==================== LOAD DỮ LIỆU BẢN ĐỒ ====================
async function loadMapData(filters = {}) {
  try {
    const params = new URLSearchParams(filters);
    const res = await fetch(`/api/lo-cao-su?${params}`);
    const data = await res.json();
    CAOSU_GEOJSON = data;
    renderRealLots();
  } catch (e) {
    console.error("Lỗi load GeoJSON:", e);
    showToast("Không thể tải dữ liệu lô cây", "⚠️");
  }
}

// ==================== LOAD & HIỂN THỊ RANH GIỚI ====================
async function loadAndShowBoundary(selectedDoi = null) {
  try {
    if (boundaryLayer) {
      dashMap.removeLayer(boundaryLayer);
      boundaryLayer = null;
    }

    const url = selectedDoi 
      ? `/api/boundary?doi=${encodeURIComponent(selectedDoi)}` 
      : '/api/boundary';

    const res = await fetch(url);
    const data = await res.json();

    if (!data.features || data.features.length === 0) {
      console.warn("Không có dữ liệu ranh giới");
      return;
    }

    boundaryLayer = L.geoJSON(data, {
      style: {
        color: "#ffffff",
        weight: 4,
        opacity: 0.95,
        fillColor: "#ffffff",
        fillOpacity: 0.06,
        dashArray: "6, 3"
      },
      onEachFeature: function(feature, layer) {
        const name = feature.properties.doi || 'Toàn vùng';
        layer.bindTooltip(`<strong>Ranh giới ${name}</strong>`, {
          permanent: false,
          direction: 'center',
          className: 'boundary-tooltip'
        });
      }
    }).addTo(dashMap);

    boundaryLayer.bringToBack();
    console.log("✅ Ranh giới đã được tải");
  } catch (e) {
    console.error("Lỗi tải ranh giới:", e);
  }
}

// ==================== RENDER LÔ CÂY ====================
function renderRealLots() {
  if (!CAOSU_GEOJSON || !dashMap) return;

  lotLayers.forEach(o => dashMap.removeLayer(o.layer));
  backgroundLotLayers.forEach(o => dashMap.removeLayer(o.layer));
  labelLayers.forEach(l => dashMap.removeLayer(l));

  lotLayers = [];
  backgroundLotLayers = [];
  labelLayers = [];

  let count = 0;

  CAOSU_GEOJSON.features.forEach((feat) => {
    const p = feat.properties || {};
    const col = doiPalette[p.doi] || doiPalette.default;

    // Background nhẹ
    const bgLayer = L.geoJSON(feat, {
      style: { color: '#d4dce833', weight: 0.5, fillOpacity: 0.15 },
      interactive: false
    }).addTo(dashMap);
    backgroundLotLayers.push({layer: bgLayer});

    // Layer chính
    if (lotsVis) {
      const layer = L.geoJSON(feat, {
        style: {
          color: col,
          weight: 1.5,
          fillColor: col,
          fillOpacity: 0.55
        }
      });

      layer.bindPopup(`
        <div style="font-size:12px;color:var(--text);padding:8px">
          <strong style="color:${col}">${p.giong||'—'}</strong><br>
          <span style="font-size:10px;color:var(--muted)">Lô: ${p.id_lo}</span><br>
          Đội: ${p.doi || '—'}<br>
          Năm: ${p.nam_trong || '—'}<br>
          Diện tích: ${p.dien_tich_map || '—'} ha
        </div>
      `);

      layer.addTo(dashMap);
      lotLayers.push({layer, p});
    }
    count++;
  });

  document.getElementById('selCountTop').textContent = `${count} lô hiển thị`;
  console.log("✅ Đã render " + count + " lô");
}

// ==================== CÁC HÀM KHÁC (giữ nguyên) ====================
function toggleBoundary(btn) {
  boundaryVis = !boundaryVis;
  if (boundaryVis) {
    btn.classList.add('active');
    loadAndShowBoundary();
  } else {
    btn.classList.remove('active');
    if (boundaryLayer) {
      dashMap.removeLayer(boundaryLayer);
      boundaryLayer = null;
    }
  }
}

async function buildFilterUI() {
  try {
    const doiRes = await fetch('/api/don-vi-list');
    const doiData = await doiRes.json();
    if (doiData.success && doiData.data) {
      const select = document.getElementById('filter-nt');
      doiData.data.forEach(item => {
        const opt = document.createElement('option');
        opt.value = item.doi;
        opt.textContent = item.doi;
        select.appendChild(opt);
      });
    }

    const namRes = await fetch('/api/nam-trong-stats');
    const namData = await namRes.json();
    if (namData.success && namData.data) {
      const select = document.getElementById('filter-nam');
      namData.data.forEach(item => {
        const opt = document.createElement('option');
        opt.value = item.nam_trong;
        opt.textContent = item.nam_trong;
        select.appendChild(opt);
      });
    }

    const giongRes = await fetch('/api/giong-stats');
    const giongData = await giongRes.json();
    if (giongData.success && giongData.data) {
      const select = document.getElementById('filter-giong');
      giongData.data.forEach(item => {
        const opt = document.createElement('option');
        opt.value = item.giong;
        opt.textContent = item.giong;
        select.appendChild(opt);
      });
    }
    console.log("✅ Dropdowns được populate");
  } catch (e) {
    console.error("Lỗi build filter UI:", e);
  }
}

function updateMapFilters(type, selectElement) {
  const filters = {};
  if (document.getElementById('filter-nt').value !== 'all')
    filters.doi = document.getElementById('filter-nt').value;
  if (document.getElementById('filter-nam').value !== 'all')
    filters.nam_trong = document.getElementById('filter-nam').value;
  if (document.getElementById('filter-giong').value !== 'all')
    filters.giong = document.getElementById('filter-giong').value;

  loadMapData(filters);

  if (boundaryVis && type === 'doi') {
    const selectedDoi = selectElement.value === 'all' ? null : selectElement.value;
    loadAndShowBoundary(selectedDoi);
  }
}

function switchMapView(mode, btn) {
  mapViewMode = mode;
  document.querySelectorAll('.map-chip').forEach(b => b.classList.remove('on'));
  btn.classList.add('on');
  console.log("Chuyển sang chế độ:", mode);
}

function toggleLayer(el, layerType) {
  const check = el.querySelector('.mlp-check');
  layerVisibility[layerType] = !layerVisibility[layerType];
  check.classList.toggle('on', layerVisibility[layerType]);

  if (layerType === 'lots') {
    lotsVis = layerVisibility[layerType];
    renderRealLots();
  } else if (layerType === 'boundary') {
    boundaryVis = layerVisibility[layerType];
    if (boundaryVis) loadAndShowBoundary();
    else if (boundaryLayer) dashMap.removeLayer(boundaryLayer);
  }
}

function togglePanel(panelId) {
  const panel = document.getElementById(panelId);
  if (panel) panel.classList.toggle('show');
}

function mapZoomIn() { if(dashMap) dashMap.zoomIn(); }
function mapZoomOut() { if(dashMap) dashMap.zoomOut(); }
function goHome() { if(dashMap) dashMap.setView([12.524, 105.452], 12); }
function setMapTool(tool, btn) {
  document.querySelectorAll('.map-ctrl-left .mc-btn-wide').forEach(b => b.classList.remove('active'));
  btn.classList.add('active');
}
function showToast(msg, icon = '✅') {
  const toast = document.getElementById('toast');
  document.getElementById('toastIcon').innerHTML = icon;
  document.getElementById('toastMsg').innerHTML = msg;
  toast.classList.add('show');
  setTimeout(() => toast.classList.remove('show'), 3000);
}

// ==================== KHỞI TẠO BẢN ĐỒ ====================
async function initDashMap() {
  dashMap = L.map('dashMap', {
    zoomControl: false,
    attributionControl: false
  }).setView([12.524, 105.452], 12);

  L.tileLayer('https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}', {
    maxZoom: 19
  }).addTo(dashMap);

  await Promise.all([
    loadMapData(),
    loadDashboardStats(),
    buildFilterUI()
  ]);

  setTimeout(() => {
    loadAndShowBoundary();
  }, 600);

  console.log("✅ Bản đồ được khởi tạo");
}

async function loadDashboardStats() {
  try {
    const res = await fetch('/api/dashboard-stats');
    const data = await res.json();
    if (data.success) console.log("Dashboard stats:", data.data);
  } catch (e) {
    console.error("Lỗi load stats:", e);
  }
}

// ==================== KHỞI CHẠY ====================
window.addEventListener('load', () => {
  setTimeout(initDashMap, 300);
});
</script>

<!-- PHẦN CODE HTML + JS CŨ BẠN ĐẶT SAI VỊ TRÍ (đã đưa xuống dưới cùng) -->
<div id="app" style="display:none">
  <header>
    <h2>🌱 WebGIS Cao Su</h2>
    <select id="filterType">
      <option value="doi">Theo đội</option>
      <option value="giong">Theo giống</option>
      <option value="nam_trong">Theo năm</option>
    </select>
  </header>

  <div class="container">
    <aside>
      <h3>Layers</h3>
      <label><input type="checkbox" id="boundaryToggle" checked> Ranh giới</label>
      <label><input type="checkbox" id="baseToggle" checked> Lớp nền</label>
      <label><input type="checkbox" id="thematicToggle" checked> Phân loại</label>
    </aside>
    <div id="map"></div>
  </div>
  <div id="legend"></div>
</div>

<script>
// Phần JavaScript cũ của bạn (giữ nguyên hoàn toàn)
const map = L.map('map').setView([10.5, 106.5], 12);
L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png').addTo(map);

let boundaryLayer, baseLayer, thematicLayer;

fetch('/api/boundary')
  .then(res => res.json())
  .then(data => {
    boundaryLayer = L.geoJSON(data, {
      style: { color: '#000', weight: 3, dashArray: '6,6', fillOpacity: 0 }
    }).addTo(map);
  });

function loadBase() {
  fetch('/api/lo-cao-su')
    .then(res => res.json())
    .then(data => {
      baseLayer = L.geoJSON(data, {
        style: { color: '#999', weight: 1, fillColor: '#ccc', fillOpacity: 0.2 }
      }).addTo(map);
    });
}

function getColor(val, type) {
  if (type === 'doi') {
    return val == 1 ? '#e41a1c' : val == 2 ? '#377eb8' : val == 3 ? '#4daf4a' : '#999';
  }
  if (type === 'giong') {
    return val === 'RRIV 4' ? '#1b9e77' : '#d95f02';
  }
  if (type === 'nam_trong') {
    return val < 2010 ? '#7570b3' : '#e7298a';
  }
  return '#ccc';
}

function loadThematic(type = 'doi') {
  if (thematicLayer) map.removeLayer(thematicLayer);
  fetch('/api/lo-cao-su')
    .then(res => res.json())
    .then(data => {
      thematicLayer = L.geoJSON(data, {
        style: f => ({
          color: '#333',
          weight: 1,
          fillColor: getColor(f.properties[type], type),
          fillOpacity: 0.7
        }),
        onEachFeature: (feature, layer) => {
          layer.bindPopup(`
            <b>${feature.properties.ten_lo}</b><br>
            Đội: ${feature.properties.doi}<br>
            Giống: ${feature.properties.giong}<br>
            Năm: ${feature.properties.nam_trong}
          `);
        }
      }).addTo(map);
    });
}

function updateLegend(type) {
  const legend = document.getElementById('legend');
  if (type === 'doi') {
    legend.innerHTML = `<b>Đội</b><br><span style="color:#e41a1c">■</span> Đội 1<br><span style="color:#377eb8">■</span> Đội 2<br>`;
  }
  if (type === 'giong') {
    legend.innerHTML = `<b>Giống</b><br><span style="color:#1b9e77">■</span> RRIV 4<br><span style="color:#d95f02">■</span> Khác`;
  }
}

document.getElementById('filterType').addEventListener('change', e => {
  loadThematic(e.target.value);
  updateLegend(e.target.value);
});

document.getElementById('boundaryToggle').onchange = e => {
  e.target.checked ? map.addLayer(boundaryLayer) : map.removeLayer(boundaryLayer);
};
document.getElementById('baseToggle').onchange = e => {
  e.target.checked ? map.addLayer(baseLayer) : map.removeLayer(baseLayer);
};
document.getElementById('thematicToggle').onchange = e => {
  e.target.checked ? map.addLayer(thematicLayer) : map.removeLayer(thematicLayer);
};

loadBase();
loadThematic();
updateLegend('doi');
</script>

</body>
</html>