<script>
// ==================== BIẾN TOÀN CỤC ====================
let dashMap;
let CAOSU_GEOJSON = null;
let mapViewMode = 'doi';           // mặc định tô màu theo đội
let selectedIdx = new Set();
let lotLayers = [], backgroundLotLayers = [], labelLayers = [];
let boundaryLayer = null;
let boundaryVis = true;

// Palette tô màu theo đội (có thể mở rộng)
const doiPalette = {
  'NT 1': '#00d68f',
  'NT 2': '#00b4ff',
  'NT 3': '#f59e0b',
  'default': '#5a6a8a'
};

// ==================== LOAD DỮ LIỆU BẢN ĐỒ ====================
async function loadMapData(filters = {}) {
  try {
    const params = new URLSearchParams(filters);
    const res = await fetch(`/api/lo-cao-su?${params}`);
    const data = await res.json();
    CAOSU_GEOJSON = data;
    renderRealLots();
  } catch (e) {
    console.error("Lỗi load GeoJSON:", e);
    showToast("Không thể tải dữ liệu lô cây", "⚠️");
  }
}

// ==================== LOAD & HIỂN THỊ RANH GIỚI ====================
async function loadAndShowBoundary(selectedDoi = null) {
  try {
    if (boundaryLayer) {
      dashMap.removeLayer(boundaryLayer);
      boundaryLayer = null;
    }

    const url = selectedDoi 
      ? `/api/boundary?doi=${encodeURIComponent(selectedDoi)}` 
      : '/api/boundary';

    const res = await fetch(url);
    const data = await res.json();

    if (!data.features || data.features.length === 0) return;

    boundaryLayer = L.geoJSON(data, {
      style: {
        color: "#ffffff",      // viền trắng nổi bật
        weight: 4,
        opacity: 0.95,
        fillColor: "#ffffff",
        fillOpacity: 0.06,
        dashArray: "6, 3"
      },
      onEachFeature: function(feature, layer) {
        const name = feature.properties.doi || 'Toàn vùng';
        layer.bindTooltip(`<strong>Ranh giới ${name}</strong>`, {
          permanent: false,
          direction: 'center',
          className: 'boundary-tooltip'
        });
      }
    }).addTo(dashMap);

    boundaryLayer.bringToBack();   // đưa ranh giới xuống dưới lớp lô
  } catch (e) {
    console.error("Lỗi tải ranh giới:", e);
  }
}

// ==================== RENDER LÔ CÂY ====================
function renderRealLots() {
  if (!CAOSU_GEOJSON || !dashMap) return;

  // Xóa layer cũ
  lotLayers.forEach(o => dashMap.removeLayer(o.layer));
  backgroundLotLayers.forEach(o => dashMap.removeLayer(o.layer));
  labelLayers.forEach(l => dashMap.removeLayer(l));

  lotLayers = []; 
  backgroundLotLayers = []; 
  labelLayers = [];

  let count = 0;

  CAOSU_GEOJSON.features.forEach((feat) => {
    const p = feat.properties || {};
    const col = doiPalette[p.doi] || doiPalette.default;

    // Background nhẹ
    const bgLayer = L.geoJSON(feat, {
      style: { color: '#d4dce833', weight: 0.5, fillOpacity: 0.15 },
      interactive: false
    }).addTo(dashMap);
    backgroundLotLayers.push({layer: bgLayer});

    // Layer chính
    if (lotsVis) {
      const layer = L.geoJSON(feat, {
        style: { 
          color: col, 
          weight: 1.5, 
          fillColor: col, 
          fillOpacity: 0.55 
        }
      });

      layer.bindPopup(`
        <div class="lo-popup-title">
          <span class="lo-popup-badge" style="background:${col}22;color:${col}">${p.giong||'—'}</span>
          ${p.ten_lo || p.id_lo}
        </div>
        <div class="lo-popup-grid">
          <span class="lo-popup-label">Mã lô</span><span class="lo-popup-val">${p.id_lo}</span>
          <span class="lo-popup-label">Đội</span><span class="lo-popup-val">${p.doi || '—'}</span>
          <span class="lo-popup-label">Năm trồng</span><span class="lo-popup-val">${p.nam_trong || '—'}</span>
          <span class="lo-popup-label">Giống</span><span class="lo-popup-val">${p.giong || '—'}</span>
          <span class="lo-popup-label">Diện tích</span><span class="lo-popup-val">${p.dien_tich_map || '—'} ha</span>
        </div>
      `);

      layer.addTo(dashMap);
      lotLayers.push({layer, p});
    }
    count++;
  });

  document.getElementById('selCountTop').textContent = `${count} lô hiển thị`;
  renderMapLegend();
}

// ==================== TOGGLE RANH GIỚI ====================
function toggleBoundary(btn) {
  boundaryVis = !boundaryVis;

  if (boundaryVis) {
    btn.classList.add('active');
    loadAndShowBoundary(); 
  } else {
    btn.classList.remove('active');
    if (boundaryLayer) {
      dashMap.removeLayer(boundaryLayer);
      boundaryLayer = null;
    }
  }
}

// ==================== CẬP NHẬT FILTER ====================
function updateMapFilters(type, selectElement) {
  // Code filter cũ của bạn (nếu có) giữ nguyên...
  // Ví dụ:
  const filters = {};
  if (document.getElementById('filter-nt').value !== 'all') 
    filters.doi = document.getElementById('filter-nt').value;

  loadMapData(filters);

  // Tự động cập nhật ranh giới khi đổi đội
  if (boundaryVis && type === 'NT') {
    const selectedDoi = selectElement.value === 'all' ? null : selectElement.value;
    loadAndShowBoundary(selectedDoi);
  }
}

// ==================== KHỞI TẠO BẢN ĐỒ ====================
async function initDashMap() {
  dashMap = L.map('dashMap', { 
    zoomControl: false,
    attributionControl: false 
  }).setView([12.524, 105.452], 12);   // Kampong Thom

  // Tile layer ảnh vệ tinh
  L.tileLayer('https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}', {
    maxZoom: 19
  }).addTo(dashMap);

  // Load dữ liệu
  await Promise.all([
    loadMapData(),
    loadDashboardStats()
  ]);

  buildFilterUI();   // hàm build dropdown của bạn (nếu có)

  // Hiển thị ranh giới ngay khi load
  setTimeout(() => {
    loadAndShowBoundary();
  }, 600);
}

// ==================== CÁC HÀM HỖ TRỢ KHÁC (giữ nguyên hoặc bổ sung) ====================
function showToast(msg, icon = '✅') {
  const toast = document.getElementById('toast');
  document.getElementById('toastIcon').innerHTML = icon;
  document.getElementById('toastMsg').innerHTML = msg;
  toast.classList.add('show');
  setTimeout(() => toast.classList.remove('show'), 3000);
}

// Gọi khi trang load
window.addEventListener('load', () => {
  initializeLanguageSystem();   // nếu bạn có hàm này
  setTimeout(initDashMap, 300);
});
</script>
