        background:var(--s2);border:1px solid var(--border);border-radius:var(--r);
        color:var(--muted2);padding:6px 10px;font-size:11px;font-family:var(--font-b);
        cursor:pointer;transition:.2s;max-width:120px;
      " onchange="updateMapFilters('giong', this)">
        <option value="all" data-lang="all-species">Tất cả</option>
      </select>
    <div class="map-sep"></div>

        <span class="map-label" style="flex-shrink:0">Phiên cạo:</span>
