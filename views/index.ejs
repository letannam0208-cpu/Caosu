    <span id="toastMsg">Thao tác thành công</span>
  </div>

  <!-- MODAL SỬA LÔ -->
  <div id="editModal" class="modal">
    <div class="modal-content">
      <div style="
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 20px;
          ">
        <h3 id="modalTitle" style="font-family: var(--font-d); font-size: 22px">
          ✏️ Sửa thông tin lô
        </h3>
        <button class="icon-btn" id="closeEditModal">
          <i class="fas fa-times" style="color: #fff; font-size: 18px"></i>
        </button>
      </div>
      <form id="editForm"></form>
    </div>
  </div>

  <script>
    /* ==================== KHỞI TẠO BẢN ĐỒ & DASHBOARD ==================== */
    let dashMap, xaLayer;
    let lotLayers = [],
      backgroundLotLayers = [],
      labelLayers = [];
    let boundaryVis = true,
      lotsVis = true,
      labelsVis = true;
    let mapViewMode = "nt";
    let selectedIdx = new Set();
    let teamBoundaryLayer = null;
    let currentTool = "pointer";
    let filterNT = new Set(),
      filterNam = new Set(),
      filterGiong = new Set(),
      filterPhienCao = new Set(),
      filterNhipDo = new Set(),
      filterQuyHoach = new Set();
    let filterKhuVuc = new Set(),
      filterTuoiCao = new Set(),
      filterCheDoCao = new Set();
    let caosuFeatures = [];
    let userLocationMarker = null;
    let userLocationCircle = null;

    // Màu sắc cho các đối tượng (giống, năm trồng, Đội)
    const giongPalette = {
      "IRCA 130": "#f4656a",
      "PB 255": "#a78bfa",
      "PB 260": "#00b4ff",
      "RRIC 121": "#34d399",
      "RRIV 1": "#00d68f",
      "RRIV 106": "#f59e0b",
      "RRIV 107": "#fb923c",
      "RRIV 112": "#e879f9",
      "RRIV 117": "#38bdf8",
      "RRIV 124": "#4ade80",
      "RRIV 2": "#fbbf24",
      "RRIV 201": "#c084fc",
      "RRIV 3": "#f472b6",
      "RRIV 4": "#22d3ee",
      "RRIV 5": "#a3e635",
    };
    const namPalette = {
      2007: "#a78bfa",
      2008: "#818cf8",
      2009: "#38bdf8",
      2010: "#00d68f",
      2011: "#f59e0b",
      2012: "#f4656a",
    };
    const ntPalette = {
      1: "#00d68f",
      2: "#00b4ff",
      3: "#f59e0b",
    };
    const phienCaoPalette = {
      "A": "#00d68f",
      "B": "#00b4ff",
      "C": "#f59e0b",
      "D": "#a78bfa",
    };
    const nhipDoCaoPalette = {
      "d3": "#00d68f",
      "d4": "#00b4ff",
    };
    const taiCanhPalette = {
      2026: "#00d68f",
      2027: "#00b4ff",
      2028: "#f59e0b",
      2029: "#a78bfa",
      2030: "#f4656a",
    };
    const KHU_VUC_COLOR_POOL = [
      "#00d68f", "#00b4ff", "#f59e0b", "#a78bfa", "#f4656a",
      "#34d399", "#fb923c", "#e879f9", "#38bdf8", "#4ade80",
      "#fbbf24", "#c084fc", "#f472b6", "#22d3ee", "#a3e635",
    ];
    let khuVucPalette = {};

    /* ==================== LẤY DỮ LIỆU TỪ API ==================== */
    async function fetchAPI(url) {
      const res = await fetch(url);
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      return res.json();
    }

    let fullNT = new Set(),
      fullNam = new Set(),
      fullGiong = new Set(),
      fullPhienCao = new Set(),
      fullNhipDo = new Set(),
      fullQuyHoach = new Set();
    let fullKhuVuc = new Set(),
      fullTuoiCao = new Set(),
      fullCheDoCao = new Set();

    const originalData = [];
    const filteredData = [];

    async function loadCaosuData() {
      try {
        const data = await fetchAPI("/api/lo-cao-su");
        // originalData = await data.json(); // Lưu trữ dữ liệu gốc để sử dụng cho tìm kiếm
        // filteredData = [...originalData]; // Khởi tạo filteredData bằng dữ liệu gốc
        caosuFeatures = data.features || [];
        console.log("📦 Đã tải", caosuFeatures.length, "lô từ API");
        if (caosuFeatures.length === 0) {
          console.warn(
            "⚠️ Không có lô nào được trả về từ API. Kiểm tra database và endpoint /api/lo-cao-su",
          );
        } else {
          console.log("Ví dụ feature đầu tiên:", caosuFeatures[0]);
        }
        fullNT.clear();
        fullNam.clear();
        fullGiong.clear();
        fullPhienCao.clear();
        fullNhipDo.clear();
        fullQuyHoach.clear();
        fullKhuVuc.clear();
        fullTuoiCao.clear();
        fullCheDoCao.clear();

        caosuFeatures.forEach((f) => {
          const p = f.properties;
          fullNT.add(normalizeTeamValue(p.doi));
          if (p.nam_trong) fullNam.add(String(p.nam_trong));
          else fullNam.add("");
          if (p.giong) fullGiong.add(p.giong);
          else fullGiong.add("");
          if (p.phien_cao) fullPhienCao.add(p.phien_cao);
          else fullPhienCao.add("");
          if (p.nhip_do_cao) fullNhipDo.add(p.nhip_do_cao);
          else fullNhipDo.add("");
          if (p.tai_canh_nam) fullQuyHoach.add(String(p.tai_canh_nam));
          else fullQuyHoach.add("");
          if (p.khu_vuc) fullKhuVuc.add(p.khu_vuc);
          else fullKhuVuc.add("");
          if (p.tuoi_cao) fullTuoiCao.add(String(p.tuoi_cao));
          else fullTuoiCao.add("");
          if (p.che_do_cao) fullCheDoCao.add(p.che_do_cao);
          else fullCheDoCao.add("");
        });

        // Xây dựng palette màu cho Khu vực từ dữ liệu thực tế
        khuVucPalette = {};
        Array.from(fullKhuVuc).filter(v => v).sort().forEach((v, i) => {
          khuVucPalette[v] = KHU_VUC_COLOR_POOL[i % KHU_VUC_COLOR_POOL.length];
        });

        // Khởi tạo filter mặc định là tất cả
        filterNT.clear();
        filterNam.clear();
        filterGiong.clear();
        filterPhienCao.clear();
        filterNhipDo.clear();
        filterQuyHoach.clear();
        filterKhuVuc.clear();
        filterTuoiCao.clear();
        filterCheDoCao.clear();
        updateTeamBoundary(null);

        console.log("Filters initialized:", {
          fullNT: Array.from(fullNT),
          fullNam: Array.from(fullNam),
          fullGiong: Array.from(fullGiong),
          fullKhuVuc: Array.from(fullKhuVuc),
          fullTuoiCao: Array.from(fullTuoiCao),
          fullCheDoCao: Array.from(fullCheDoCao),
        });
      } catch (err) {
        console.error("❌ Lỗi loadCaosuData:", err);
        caosuFeatures = [];
      }

      // initFilters();
    }

    //Lấy giá trị duy nhất cho dropdown
    function getUniqueValues(data, field) {
      return [...new Set(data.map((item) => item[field]).filter(Boolean))];
    }

    //Render dropdown
    function renderSelect(id, values) {
      const select = document.getElementById(id);
      const currentValue = select.value;

      select.innerHTML = '<option value="">-- Tất cả --</option>';

      values.forEach((val) => {
        const option = document.createElement("option");
        option.value = val;
        option.textContent = val;
        select.appendChild(option);
      });

      // giữ lại value nếu còn hợp lệ
      if (values.includes(currentValue)) {
        select.value = currentValue;
      }
    }

    //Init filter ban đầu
    function initFilters() {
      renderAllFilters(originalData);
    }

    //Render toàn bộ filter (KEY)
    function renderAllFilters(data) {
      renderSelect("filter-doi", getUniqueValues(data, "doi"));
      renderSelect("filter-namtrong", getUniqueValues(data, "nam_trong"));
      renderSelect("filter-giong", getUniqueValues(data, "giong"));
      renderSelect("filter-khuvuc", getUniqueValues(data, "khu_vuc"));
      renderSelect("filter-tuoi", getUniqueValues(data, "tuoi_cao"));
      renderSelect("filter-namcao", getUniqueValues(data, "nam_cao"));
    }

    //Lọc dữ liệu theo selection
    function applyFilters() {
      const doi = document.getElementById("filter-doi").value;
      const namtrong = document.getElementById("filter-namtrong").value;
      const giong = document.getElementById("filter-giong").value;
      const khuvuc = document.getElementById("filter-khuvuc").value;
      const tuoi = document.getElementById("filter-tuoi").value;
      const namcao = document.getElementById("filter-namcao").value;

      filteredData = originalData.filter((item) => {
        return (
          (!doi || item.doi == doi) &&
          (!namtrong || item.nam_trong == namtrong) &&
          (!giong || item.giong == giong) &&
          (!khuvuc || item.khu_vuc == khuvuc) &&
          (!tuoi || item.tuoi_cao == tuoi) &&
          (!namcao || item.nam_cao == namcao)
        );
      });

      // 🔥 CẬP NHẬT NGƯỢC dropdown
      renderAllFilters(filteredData);

      // nếu có chart/table thì update ở đây
      renderTable(filteredData);
    }

    // Legacy global select listener removed - using dedicated onchange handlers per filter

    async function buildFilterUI() {
      const ntEl = document.getElementById("filter-Doi");
      if (ntEl) {
        ntEl.innerHTML = '<option value="all">Tất cả</option>';
        Array.from(fullNT)
          .filter((v) => v !== "")
          .sort(sortFilterValues)
          .forEach((nt) => {
            const opt = document.createElement("option");
            opt.value = nt;
            opt.textContent = /^\d+$/.test(nt) ? `Đội ${nt}` : nt;
            ntEl.appendChild(opt);
          });
      }

      const namEl = document.getElementById("filter-nam");
      if (namEl) {
        namEl.innerHTML = '<option value="all">Tất cả</option>';
        Array.from(fullNam)
          .sort()
          .forEach((y) => {
            const opt = document.createElement("option");
            opt.value = y;
            opt.textContent = y;
            namEl.appendChild(opt);
          });
      }

      const giongEl = document.getElementById("filter-giong");
      if (giongEl) {
        giongEl.innerHTML = '<option value="all">Tất cả</option>';
        Array.from(fullGiong)
          .sort()
          .forEach((g) => {
            const opt = document.createElement("option");
            opt.value = g;
            opt.textContent = g;
            giongEl.appendChild(opt);
          });
      }

      const phienCaoEl = document.getElementById("filter-phien_cao");
      if (phienCaoEl) {
        phienCaoEl.innerHTML = '<option value="all">Tất cả</option>';
        Array.from(fullPhienCao)
          .filter((v) => v !== "")
          .sort()
          .forEach((v) => {
            const opt = document.createElement("option");
            opt.value = v;
            opt.textContent = v;
            phienCaoEl.appendChild(opt);
          });
      }

      const nhipDoEl = document.getElementById("filter-Nhip_do_cao");
      if (nhipDoEl) {
        nhipDoEl.innerHTML = '<option value="all">Tất cả</option>';
        Array.from(fullNhipDo)
          .filter((v) => v !== "")
          .sort()
          .forEach((v) => {
            const opt = document.createElement("option");
            opt.value = v;
            opt.textContent = v;
            nhipDoEl.appendChild(opt);
          });
      }

      const quyHoachEl = document.getElementById("filter-quy_hoach_tai_canh");
      if (quyHoachEl) {
        quyHoachEl.innerHTML = '<option value="all">Tất cả</option>';
        Array.from(fullQuyHoach)
          .filter((v) => v !== "")
          .sort()
          .forEach((v) => {
            const opt = document.createElement("option");
            opt.value = v;
            opt.textContent = v;
            quyHoachEl.appendChild(opt);
          });
      }

      const khuVucEl = document.getElementById("filter-khu-vuc");
      if (khuVucEl) {
        khuVucEl.innerHTML = '<option value="all">Tất cả</option>';
        Array.from(fullKhuVuc)
          .filter((v) => v !== "")
          .sort()
          .forEach((v) => {
            const opt = document.createElement("option");
            opt.value = v;
            opt.textContent = v;
            khuVucEl.appendChild(opt);
          });
      }

      const tuoiCaoEl = document.getElementById("filter-tuoi-cao");
      if (tuoiCaoEl) {
        tuoiCaoEl.innerHTML = '<option value="all">Tất cả</option>';
        Array.from(fullTuoiCao)
          .filter((v) => v !== "")
          .sort((a, b) => Number(a) - Number(b))
          .forEach((v) => {
            const opt = document.createElement("option");
            opt.value = v;
            opt.textContent = v;
            tuoiCaoEl.appendChild(opt);
          });
      }

      const cheDoCaoEl = document.getElementById("filter-che-do-cao");
      if (cheDoCaoEl) {
        cheDoCaoEl.innerHTML = '<option value="all">Tất cả</option>';
        Array.from(fullCheDoCao)
          .filter((v) => v !== "")
          .sort()
          .forEach((v) => {
            const opt = document.createElement("option");
            opt.value = v;
            opt.textContent = v;
            cheDoCaoEl.appendChild(opt);
          });
      }
    }

    function normalizeFilterValue(value) {
      return value == null ? "" : String(value).trim();
    }

    function normalizeTeamValue(value) {
      const raw = normalizeFilterValue(value);
      if (!raw) return "";
      const digits = raw.match(/\d+/g);
      if (digits && digits.length === 1) return digits[0];
      return raw;
    }

    function sortFilterValues(a, b) {
      const na = Number(a);
      const nb = Number(b);
      if (!Number.isNaN(na) && !Number.isNaN(nb)) return na - nb;
      return a.localeCompare(b, "vi", { numeric: true, sensitivity: "base" });
    }

    function buildSelectOptions(
      selectId,
      values,
      selectedValue,
      filterSet,
      fullSet,
    ) {
      const el = document.getElementById(selectId);
      if (!el) return false;

      const uniqueValues = Array.from(
        new Set(values.filter((v) => v !== "")),
      );
      uniqueValues.sort(sortFilterValues);

      const validSelected =
        selectedValue && uniqueValues.includes(selectedValue);
      const preservedValue = validSelected ? selectedValue : "all";

      el.innerHTML = '<option value="all">Tất cả</option>';
      uniqueValues.forEach((value) => {
        const opt = document.createElement("option");
        opt.value = value;
        opt.textContent = value;
        if (value === preservedValue) opt.selected = true;
        el.appendChild(opt);
      });
      if (preservedValue === "all") el.value = "all";

      if (!validSelected && filterSet && fullSet) {
        filterSet.clear();
        fullSet.forEach((item) => filterSet.add(item));
        return true;
      }

      return false;
    }

    function refreshFilterOptions() {
      const visibleFeatures = caosuFeatures.filter(featureVisible);

      const currentSelections = {
        NT: document.getElementById("filter-Doi")?.value || "all",
        nam: document.getElementById("filter-nam")?.value || "all",
        giong: document.getElementById("filter-giong")?.value || "all",
        phien_cao:
          document.getElementById("filter-phien_cao")?.value || "all",
        nhip_do_cao:
          document.getElementById("filter-Nhip_do_cao")?.value || "all",
        quy_hoach_tai_canh:
          document.getElementById("filter-quy_hoach_tai_canh")?.value ||
          "all",
        khu_vuc: document.getElementById("filter-khu-vuc")?.value || "all",
        tuoi_cao: document.getElementById("filter-tuoi-cao")?.value || "all",
        che_do_cao:
          document.getElementById("filter-che-do-cao")?.value || "all",
      };

      const didReset =
        buildSelectOptions(
          "filter-Doi",
          visibleFeatures.map((f) => normalizeTeamValue(f.properties.doi)),
          currentSelections.NT,
          filterNT,
          fullNT,
        ) ||
        buildSelectOptions(
          "filter-nam",
          visibleFeatures.map((f) =>
            normalizeFilterValue(f.properties.nam_trong),
          ),
          currentSelections.nam,
          filterNam,
          fullNam,
        ) ||
        buildSelectOptions(
          "filter-giong",
          visibleFeatures.map((f) =>
            normalizeFilterValue(f.properties.giong),
          ),
          currentSelections.giong,
          filterGiong,
          fullGiong,
        ) ||
        buildSelectOptions(
          "filter-phien_cao",
          visibleFeatures.map((f) =>
            normalizeFilterValue(f.properties.phien_cao),
          ),
          currentSelections.phien_cao,
          filterPhienCao,
          fullPhienCao,
        ) ||
        buildSelectOptions(
          "filter-Nhip_do_cao",
          visibleFeatures.map((f) =>
            normalizeFilterValue(f.properties.nhip_do_cao),
          ),
          currentSelections.nhip_do_cao,
          filterNhipDo,
          fullNhipDo,
        ) ||
        buildSelectOptions(
          "filter-quy_hoach_tai_canh",
          visibleFeatures.map((f) =>
            normalizeFilterValue(f.properties.tai_canh_nam),
          ),
          currentSelections.quy_hoach_tai_canh,
          filterQuyHoach,
          fullQuyHoach,
        ) ||
        buildSelectOptions(
          "filter-khu-vuc",
          visibleFeatures.map((f) =>
            normalizeFilterValue(f.properties.khu_vuc),
          ),
          currentSelections.khu_vuc,
          filterKhuVuc,
          fullKhuVuc,
        ) ||
        buildSelectOptions(
          "filter-tuoi-cao",
          visibleFeatures.map((f) =>
            normalizeFilterValue(f.properties.tuoi_cao),
          ),
          currentSelections.tuoi_cao,
          filterTuoiCao,
          fullTuoiCao,
        ) ||
        buildSelectOptions(
          "filter-che-do-cao",
          visibleFeatures.map((f) =>
            normalizeFilterValue(f.properties.che_do_cao),
          ),
          currentSelections.che_do_cao,
          filterCheDoCao,
          fullCheDoCao,
        );
      return didReset;
    }

    // Chấp nhận cả feature object lẫn properties object
    function featureVisible(input) {
      const p = input && input.properties ? input.properties : input;
      if (!p || !p.id_lo) return false;
      const nt = normalizeTeamValue(p.doi);
      const nam = p.nam_trong != null ? String(p.nam_trong) : "";
      const g = p.giong ?? "";
      const pc = p.phien_cao != null ? String(p.phien_cao) : "";
      const nd = p.nhip_do_cao != null ? String(p.nhip_do_cao) : "";
      const qh = p.tai_canh_nam != null ? String(p.tai_canh_nam) : "";
      const kv = p.khu_vuc ?? "";
      const tc = p.tuoi_cao != null ? String(p.tuoi_cao) : "";
      const cdc = p.che_do_cao ?? "";

      const okNT = filterNT.size === 0 || filterNT.has(nt);
      const okNam = filterNam.size === 0 || filterNam.has(nam);
      const okGiong = filterGiong.size === 0 || filterGiong.has(g);
      const okPC = filterPhienCao.size === 0 || filterPhienCao.has(pc);
      const okND = filterNhipDo.size === 0 || filterNhipDo.has(nd);
      const okQH = filterQuyHoach.size === 0 || filterQuyHoach.has(qh);
      const okKV = filterKhuVuc.size === 0 || filterKhuVuc.has(kv);
      const okTC = filterTuoiCao.size === 0 || filterTuoiCao.has(tc);
      const okCDC = filterCheDoCao.size === 0 || filterCheDoCao.has(cdc);

      return (
        okNT &&
        okNam &&
        okGiong &&
        okPC &&
        okND &&
        okQH &&
        okKV &&
        okTC &&
        okCDC
      );
    }

    function getLotColorReal(p, mode) {
      if (mode === "giong") return giongPalette[p.giong] || "#5a6a8a";
      if (mode === "nam") return namPalette[p.nam_trong] || "#5a6a8a";
      if (mode === "nt") {
        let doi = p.doi;
        if (doi && typeof doi === "string") {
          const match = doi.match(/\d+$/);
          if (match) doi = match[0];
        }
        return ntPalette[doi] || ntPalette[p.doi] || "#5a6a8a";
      }
      if (mode === "phien_cao")
        return phienCaoPalette[p.phien_cao] || "#5a6a8a";
      if (mode === "nhiet_do_cao")
        return nhipDoCaoPalette[p.nhip_do_cao] || "#5a6a8a";
      if (mode === "quy_hoach_tai_canh")
        return taiCanhPalette[p.tai_canh_nam] || "#5a6a8a";
      if (mode === "khu_vuc")
        return khuVucPalette[p.khu_vuc] || "#5a6a8a";
      return "#00d68f";
    }

    /* ==================== RENDER BẢN ĐỒ ==================== */
    function renderRealLots() {
      if (!dashMap) return;
      lotLayers.forEach((o) => dashMap.removeLayer(o.layer));
      backgroundLotLayers.forEach((o) => dashMap.removeLayer(o.layer));
      labelLayers.forEach((l) => dashMap.removeLayer(l));
      lotLayers = [];
      backgroundLotLayers = [];
      labelLayers = [];

      if (!caosuFeatures.length) {
        console.warn("renderRealLots: không có feature nào để render");
        return;
      }

      // Nền cho tất cả lô
      caosuFeatures.forEach((feat, idx) => {
        const bgLayer = L.geoJSON(feat, {
          style: {
            color: "#d4dce833",
            weight: 0.5,
            fillColor: "#d4dce8",
            fillOpacity: 0.25,
          },
          interactive: false,
        });
        bgLayer.addTo(dashMap);
        backgroundLotLayers.push({ layer: bgLayer, p: feat.properties, idx });
      });

      let count = 0;
      caosuFeatures.forEach((feat, idx) => {
        const p = feat.properties;
        if (!featureVisible(p)) return;
        const isSel = selectedIdx.has(idx);
        const col = getLotColorReal(p, mapViewMode);

        if (lotsVis) {
          const layer = L.geoJSON(feat, {
            style: {
              color: isSel ? "#ffffff" : col,
              weight: isSel ? 2.5 : 1,
              fillColor: col,
              fillOpacity: isSel ? 0.65 : 0.52,
            },
            interactive: !msrActive,
          });

          if (!msrActive) {
            layer.bindPopup(
              `
  <div style="background: ${col}22; color: ${col}; border: 1px solid ${col}55; padding: 6px 12px; border-radius: 8px; margin-bottom: 12px; text-align: center; font-weight: bold; font-size: 18px;">
    ${p.ten_lo || p.id_lo || "—"}
  </div>
  <div style="max-height: 300px; overflow-y: auto; padding-right: 6px; margin-bottom: 12px;">
    <div class="lo-popup-grid">
      <span class="lo-popup-label">Mã lô</span><span class="lo-popup-val">${p.id_lo || "—"}</span>
      <span class="lo-popup-label">Đội</span><span class="lo-popup-val">${p.doi || "—"}</span>
      <span class="lo-popup-label">Năm trồng</span><span class="lo-popup-val">${p.nam_trong || "—"}</span>
