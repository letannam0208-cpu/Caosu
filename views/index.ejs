<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>WebGIS · Vườn Cây Cao Su</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Poppins:wght@600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"/>
  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

  <style>
    :root {
      --primary: #10b981;
      --primary-dark: #059669;
      --primary-light: #6ee7b7;
      --secondary: #0ea5e9;
      --accent: #f59e0b;
      --danger: #ef4444;
      --warning: #f59e0b;
      --success: #10b981;
      
      --bg-dark: #0f172a;
      --bg-darker: #051628;
      --surface: #1e293b;
      --surface-light: #334155;
      --border: #475569;
      --border-light: rgba(148, 163, 184, 0.2);
      
      --text-primary: #f1f5f9;
      --text-secondary: #cbd5e1;
      --text-muted: #94a3b8;
      
      --radius-sm: 6px;
      --radius-md: 10px;
      --radius-lg: 16px;
      --radius-xl: 24px;
      
      --shadow-sm: 0 1px 2px 0 rgba(0, 0, 0, 0.3);
      --shadow-md: 0 4px 6px -1px rgba(0, 0, 0, 0.4);
      --shadow-lg: 0 10px 15px -3px rgba(0, 0, 0, 0.5);
      --shadow-xl: 0 20px 25px -5px rgba(0, 0, 0, 0.6);
      
      --transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }

    * { 
      box-sizing: border-box; 
      margin: 0; 
      padding: 0; 
    }

    html, body {
      height: 100%;
      width: 100%;
    }

    body {
      font-family: 'Inter', sans-serif;
      background: var(--bg-dark);
      color: var(--text-primary);
      display: flex;
      flex-direction: column;
      overflow: hidden;
    }

    /* ============= HEADER ============= */
    header {
      height: 72px;
      background: linear-gradient(135deg, var(--surface) 0%, rgba(30, 41, 59, 0.8) 100%);
      border-bottom: 1px solid var(--border-light);
      display: flex;
      align-items: center;
      padding: 0 32px;
      gap: 24px;
      box-shadow: var(--shadow-md);
      position: relative;
      z-index: 10;
    }

    .logo {
      display: flex;
      align-items: center;
      gap: 12px;
      font-weight: 700;
      font-size: 18px;
      color: var(--text-primary);
      font-family: 'Poppins', sans-serif;
      letter-spacing: -0.5px;
    }

    .logo i {
      font-size: 24px;
      background: linear-gradient(135deg, var(--primary), var(--secondary));
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }

    .status {
      display: flex;
      align-items: center;
      gap: 8px;
      background: rgba(16, 185, 129, 0.15);
      color: var(--primary-light);
      padding: 8px 16px;
      border-radius: 20px;
      font-size: 13px;
      font-weight: 600;
      border: 1px solid rgba(16, 185, 129, 0.3);
    }

    .status::before {
      content: '';
      width: 8px;
      height: 8px;
      background: var(--primary);
      border-radius: 50%;
      animation: pulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
    }

    @keyframes pulse {
      0%, 100% { opacity: 1; }
      50% { opacity: 0.5; }
    }

    .stats-bar {
      display: flex;
      gap: 32px;
      margin-left: auto;
      font-size: 14px;
    }

    .stat-item {
      display: flex;
      flex-direction: column;
      gap: 2px;
    }

    .stat-item label {
      font-size: 12px;
      color: var(--text-muted);
      font-weight: 500;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }

    .stat-item strong {
      font-size: 18px;
      color: var(--primary);
      font-weight: 700;
    }

    .user-info {
      display: flex;
      align-items: center;
      gap: 12px;
      margin-left: 32px;
      padding-left: 32px;
      border-left: 1px solid var(--border-light);
    }

    .avatar {
      width: 40px;
      height: 40px;
      background: linear-gradient(135deg, var(--primary), var(--secondary));
      border-radius: 10px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: 700;
      color: white;
      font-size: 14px;
    }

    /* ============= LAYOUT UTAMA ============= */
    .container {
      display: flex;
      flex: 1;
      overflow: hidden;
      gap: 0;
    }

    /* ============= SIDEBAR ============= */
    .sidebar {
      width: 220px;
      background: var(--surface);
      border-right: 1px solid var(--border-light);
      padding: 20px 0;
      overflow-y: auto;
      flex-shrink: 0;
      display: flex;
      flex-direction: column;
    }

    .sidebar-header {
      padding: 0 16px;
      margin-bottom: 20px;
    }

    .sidebar-header h3 {
      font-size: 11px;
      color: var(--text-muted);
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 1px;
    }

    .sidebar nav {
      display: flex;
      flex-direction: column;
      gap: 4px;
      padding: 0 12px;
      flex: 1;
    }

    .sidebar a {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 10px 14px;
      color: var(--text-secondary);
      text-decoration: none;
      border-radius: var(--radius-md);
      transition: var(--transition);
      font-size: 13px;
      font-weight: 500;
      position: relative;
    }

    .sidebar a::before {
      content: '';
      position: absolute;
      left: 0;
      top: 0;
      bottom: 0;
      width: 3px;
      background: var(--primary);
      border-radius: 0 3px 3px 0;
      opacity: 0;
      transition: var(--transition);
    }

    .sidebar a:hover {
      background: rgba(16, 185, 129, 0.1);
      color: var(--primary);
    }

    .sidebar a.active {
      background: rgba(16, 185, 129, 0.2);
      color: var(--primary);
    }

    .sidebar a.active::before {
      opacity: 1;
    }

    .sidebar a i {
      font-size: 16px;
      width: 18px;
      text-align: center;
    }

    .sidebar-footer {
      padding: 12px 12px;
      border-top: 1px solid var(--border-light);
      margin-top: auto;
    }

    .sidebar a.logout {
      color: var(--danger);
    }

    .sidebar a.logout:hover {
      background: rgba(239, 68, 68, 0.1);
    }

    /* ============= MAIN CONTENT ============= */
    .main {
      flex: 1;
      display: flex;
      flex-direction: column;
      overflow: hidden;
    }

    .top-bar {
      height: 64px;
      background: linear-gradient(135deg, rgba(30, 41, 59, 0.6), rgba(15, 23, 42, 0.8));
      border-bottom: 1px solid var(--border-light);
      padding: 0 32px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 24px;
    }

    .top-bar-title {
      display: flex;
      flex-direction: column;
      gap: 4px;
    }

    .top-bar-title h2 {
      font-size: 28px;
      font-weight: 700;
      color: var(--text-primary);
      font-family: 'Poppins', sans-serif;
    }

    .top-bar-title p {
      font-size: 12px;
      color: var(--text-muted);
    }

    .top-bar-controls {
      display: flex;
      align-items: center;
      gap: 16px;
      margin-left: auto;
    }

    .export-btn {
      display: flex;
      align-items: center;
      gap: 8px;
      padding: 8px 16px;
      background: rgba(15, 23, 42, 0.6);
      color: var(--text-secondary);
      border: 1px solid var(--border-light);
      border-radius: var(--radius-md);
      cursor: pointer;
      font-size: 13px;
      transition: var(--transition);
    }

    .export-btn:hover {
      background: rgba(16, 185, 129, 0.1);
      color: var(--primary);
      border-color: var(--primary);
    }

    .add-btn {
      display: flex;
      align-items: center;
      gap: 8px;
      padding: 8px 16px;
      background: var(--primary);
      color: white;
      border: none;
      border-radius: var(--radius-md);
      cursor: pointer;
      font-size: 13px;
      font-weight: 600;
      transition: var(--transition);
    }

    .add-btn:hover {
      background: var(--primary-dark);
    }

    /* ============= FILTER BAR ============= */
    .filter-bar {
      height: auto;
      background: rgba(30, 41, 59, 0.5);
      border-bottom: 1px solid var(--border-light);
      padding: 16px 32px;
      display: flex;
      align-items: center;
      gap: 16px;
      overflow-x: auto;
    }

    .filter-badge {
      display: flex;
      align-items: center;
      gap: 8px;
      padding: 8px 12px;
      background: rgba(16, 185, 129, 0.15);
      color: var(--primary);
      border-radius: var(--radius-md);
      border: 1px solid rgba(16, 185, 129, 0.3);
      font-size: 12px;
      font-weight: 500;
      white-space: nowrap;
      cursor: pointer;
      transition: var(--transition);
    }

    .filter-badge:hover {
      background: rgba(16, 185, 129, 0.25);
    }

    .filter-badge.active {
      background: var(--primary);
      color: white;
    }

    .filter-select {
      padding: 6px 12px;
      background: rgba(30, 41, 59, 0.6);
      color: var(--text-secondary);
      border: 1px solid var(--border-light);
      border-radius: var(--radius-sm);
      font-size: 12px;
      cursor: pointer;
      transition: var(--transition);
    }

    .filter-select:hover {
      border-color: var(--primary);
      color: var(--text-primary);
    }

    /* ============= MAP CONTAINER ============= */
    .map-wrapper {
      flex: 1;
      position: relative;
      overflow: hidden;
      background: var(--bg-dark);
    }

    #dashMap {
      width: 100%;
      height: 100%;
    }

    .map-control-panel {
      position: absolute;
      bottom: 32px;
      right: 32px;
      display: flex;
      flex-direction: column;
      gap: 12px;
      z-index: 400;
    }

    .map-control-btn {
      width: 44px;
      height: 44px;
      background: var(--surface);
      border: 1px solid var(--border-light);
      border-radius: var(--radius-md);
      color: var(--text-secondary);
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 16px;
      transition: var(--transition);
      box-shadow: var(--shadow-md);
    }

    .map-control-btn:hover {
      background: var(--primary);
      color: white;
      border-color: var(--primary);
    }

    .zoom-slider-container {
      display: flex;
      flex-direction: column;
      gap: 8px;
      align-items: center;
      background: var(--surface);
      padding: 12px 8px;
      border-radius: var(--radius-md);
      border: 1px solid var(--border-light);
      box-shadow: var(--shadow-md);
    }

    .zoom-slider {
      width: 30px;
      height: 120px;
      writing-mode: bt-lr;
      -webkit-appearance: slider-vertical;
      -moz-appearance: slider-vertical;
      appearance: slider-vertical;
    }

    .zoom-label {
      font-size: 12px;
      font-weight: 600;
      color: var(--primary);
      text-align: center;
      min-width: 24px;
    }

    /* ============= LEGEND ============= */
    .legend-panel {
      position: absolute;
      bottom: 32px;
      left: 32px;
      background: var(--surface);
      border: 1px solid var(--border-light);
      border-radius: var(--radius-lg);
      padding: 16px;
      box-shadow: var(--shadow-lg);
      max-width: 280px;
      z-index: 400;
      max-height: 50vh;
      overflow-y: auto;
    }

    .legend-panel h4 {
      font-size: 14px;
      color: var(--text-primary);
      margin-bottom: 12px;
      font-weight: 600;
    }

    .legend-items {
      display: flex;
      flex-direction: column;
      gap: 10px;
    }

    .legend-item {
      display: flex;
      align-items: center;
      gap: 10px;
      font-size: 12px;
      color: var(--text-secondary);
    }

    .legend-color {
      width: 16px;
      height: 16px;
      border-radius: var(--radius-sm);
      flex-shrink: 0;
    }

    /* ============= TOAST ============= */
    #toast {
      position: fixed;
      bottom: 32px;
      left: 50%;
      transform: translateX(-50%) translateY(200px);
      background: var(--surface);
      color: var(--text-primary);
      padding: 12px 24px;
      border-radius: var(--radius-lg);
      border: 1px solid var(--border-light);
      box-shadow: var(--shadow-lg);
      z-index: 9999;
      transition: transform 0.3s ease;
      font-size: 13px;
      display: flex;
      align-items: center;
      gap: 12px;
    }

    #toast.show {
      transform: translateX(-50%) translateY(0);
    }

    #toastIcon {
      font-size: 16px;
    }

    /* ============= SEARCH ============= */
    .search-input {
      padding: 8px 16px;
      background: rgba(30, 41, 59, 0.6);
      border: 1px solid var(--border-light);
      border-radius: var(--radius-md);
      color: var(--text-primary);
      font-size: 13px;
      width: 200px;
      transition: var(--transition);
    }

    .search-input:focus {
      outline: none;
      border-color: var(--primary);
      background: rgba(30, 41, 59, 0.9);
    }

    /* ============= LAYER PANEL ============= */
    .map-layer-panel {
      position: absolute;
      top: 32px;
      right: 32px;
      background: var(--surface);
      border: 1px solid var(--border-light);
      border-radius: var(--radius-lg);
      width: 280px;
      max-height: 60vh;
      overflow-y: auto;
      box-shadow: var(--shadow-lg);
      z-index: 400;
      display: none;
    }

    .map-layer-panel.show {
      display: block;
      animation: slideIn 0.3s ease;
    }

    @keyframes slideIn {
      from {
        opacity: 0;
        transform: translateY(-10px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    .mlp-header {
      padding: 16px;
      font-weight: 600;
      font-size: 13px;
      color: var(--text-primary);
      border-bottom: 1px solid var(--border-light);
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .mlp-item {
      padding: 12px 16px;
      display: flex;
      align-items: center;
      gap: 12px;
      cursor: pointer;
      transition: var(--transition);
      font-size: 12px;
      color: var(--text-secondary);
      border-bottom: 1px solid var(--border-light);
    }

    .mlp-item:last-child {
      border-bottom: none;
    }

    .mlp-item:hover {
      background: rgba(16, 185, 129, 0.1);
      color: var(--primary);
    }

    .mlp-check {
      width: 18px;
      height: 18px;
      border: 2px solid var(--border);
      border-radius: 4px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 12px;
      font-weight: bold;
      color: white;
      transition: var(--transition);
    }

    .mlp-check.on {
      background: var(--primary);
      border-color: var(--primary);
    }

    .mlp-check.off {
      background: transparent;
      border-color: var(--border);
    }

    .mlp-dot {
      width: 12px;
      height: 12px;
      border-radius: 50%;
      flex-shrink: 0;
    }

    /* ============= SEARCH PANEL ============= */
    .map-search-panel {
      position: absolute;
      top: 32px;
      left: 32px;
      background: var(--surface);
      border: 1px solid var(--border-light);
      border-radius: var(--radius-lg);
      width: 320px;
      max-height: 60vh;
      overflow-y: auto;
      box-shadow: var(--shadow-lg);
      z-index: 400;
      display: none;
    }

    .map-search-panel.show {
      display: block;
      animation: slideIn 0.3s ease;
    }

    .msp-input {
      padding: 12px 16px;
      display: flex;
      align-items: center;
      gap: 10px;
      border-bottom: 1px solid var(--border-light);
    }

    .msp-input svg {
      flex-shrink: 0;
    }

    .msp-input input {
      flex: 1;
      background: transparent;
      border: none;
      color: var(--text-primary);
      font-size: 12px;
      outline: none;
    }

    .msp-input input::placeholder {
      color: var(--text-muted);
    }

    #mapSearchResults {
      display: flex;
      flex-direction: column;
      gap: 4px;
      padding: 8px;
    }

    .msp-result {
      padding: 10px 12px;
      border-radius: var(--radius-md);
      cursor: pointer;
      font-size: 11px;
      transition: var(--transition);
      border-left: 3px solid transparent;
    }

    .msp-result:hover {
      background: rgba(16, 185, 129, 0.1);
      color: var(--primary);
      border-left-color: var(--primary);
    }

    .msp-result strong {
      color: var(--primary);
      font-weight: 600;
    }

    .msp-result-desc {
      font-size: 10px;
      color: var(--text-muted);
      margin-top: 2px;
    }

    /* ============= SCROLLBAR ============= */
    ::-webkit-scrollbar {
      width: 6px;
      height: 6px;
    }

    ::-webkit-scrollbar-track {
      background: transparent;
    }

    ::-webkit-scrollbar-thumb {
      background: var(--border);
      border-radius: 3px;
    }

    ::-webkit-scrollbar-thumb:hover {
      background: var(--primary);
    }
  </style>
</head>

<body>
  <!-- ========== HEADER ========== -->
  <header>
    <div class="logo">
      <i class="fas fa-leaf"></i>
      <span style="display: flex; flex-direction: column; gap: 0; line-height: 1;">
        <span style="font-size: 18px;">WEBGIS CAO SU</span>
        <span style="font-size: 11px; color: var(--text-muted); font-weight: 400;">TỔNG CÔNG TY</span>
      </span>
    </div>
    <div class="status">
      <span>🟢 Trực tuyến</span>
    </div>
    <div class="stats-bar">
      <div class="stat-item">
        <label>Lô vườn</label>
        <strong id="statsTotal">425</strong>
      </div>
      <div class="stat-item">
        <label>Diện tích</label>
        <strong id="statsArea">7.244 ha</strong>
      </div>
    </div>
    <div class="user-info">
      <div style="display: flex; align-items: center; gap: 12px; cursor: pointer;">
        <i class="fas fa-bell" style="font-size: 18px; color: var(--text-secondary);"></i>
        <i class="fas fa-globe" style="font-size: 18px; color: var(--text-secondary);"></i>
        <i class="fas fa-cog" style="font-size: 18px; color: var(--text-secondary);"></i>
      </div>
      <div style="display: flex; align-items: center; gap: 8px; padding-left: 16px; border-left: 1px solid var(--border-light);">
        <div style="display: flex; flex-direction: column; align-items: flex-end; gap: 2px;">
          <span style="font-size: 13px; color: var(--text-primary);">Nguyễn Văn An</span>
          <span style="font-size: 11px; color: var(--text-muted);">Quản lý vườn</span>
        </div>
        <div class="avatar" id="userAvatar">NA</div>
      </div>
    </div>
  </header>

  <!-- ========== CONTAINER ========== -->
  <div class="container">
    <!-- SIDEBAR -->
    <div class="sidebar">
      <div class="sidebar-header">
        <h3>📊 TỔNG QUAN</h3>
      </div>
      <nav>
        <a href="#" class="active">
          <i class="fas fa-chart-line"></i>
          <span>Dashboard</span>
        </a>
        <a href="#">
          <i class="fas fa-plus"></i>
          <span>Thêm dữ liệu lô</span>
        </a>
      </nav>

      <div class="sidebar-header" style="margin-top: 20px;">
        <h3>⚙️ QUẢN LÝ DỮ LIỆU</h3>
      </div>
      <nav>
        <a href="#">
          <i class="fas fa-layer-group"></i>
          <span>Quản lý lô cây</span>
        </a>
        <a href="#">
          <i class="fas fa-file-alt"></i>
          <span>Thêm dữ liệu lô</span>
        </a>
      </nav>

      <div class="sidebar-header" style="margin-top: 20px;">
        <h3>👥 NGƯỜI DÙNG & PHÂN QUYỀN</h3>
      </div>
      <nav>
        <a href="#">
          <i class="fas fa-users"></i>
          <span>Quản lý người dùng</span>
        </a>
      </nav>

      <div class="sidebar-header" style="margin-top: 20px;">
        <h3>📈 PHÂN TÍCH</h3>
      </div>
      <nav>
        <a href="#">
          <i class="fas fa-bar-chart"></i>
          <span>Thống kê</span>
        </a>
      </nav>

      <div class="sidebar-footer">
        <a href="#" class="logout">
          <i class="fas fa-sign-out-alt"></i>
          <span>Đăng xuất</span>
        </a>
      </div>
    </div>

    <!-- MAIN CONTENT -->
    <div class="main">
      <!-- TOP BAR -->
      <div class="top-bar">
        <div class="top-bar-title">
          <h2>Dashboard</h2>
          <p>Tổng quan hoạt động vườn cây – cập nhật lúc 07:42, 16/03/2026</p>
        </div>
        <div class="top-bar-controls">
          <button class="export-btn">
            <i class="fas fa-download"></i>
            <span>Xuất báo cáo</span>
          </button>
          <button class="add-btn">
            <i class="fas fa-plus"></i>
            <span>Thêm dữ liệu</span>
          </button>
        </div>
      </div>

      <!-- FILTER BAR -->
      <div class="filter-bar">
        <span style="font-weight: 600; color: var(--text-secondary); font-size: 12px;">🔹 Bản đồ vườn cây cao su – Kampong Thom, Cambodia</span>
        <div style="display: flex; gap: 12px; align-items: center; margin-left: auto; flex-wrap: wrap;">
          <span style="font-size: 12px; color: var(--text-muted);">Đội:</span>
          <select class="filter-select" name="doi">
            <option value="">Tất cả</option>
          </select>
          
          <span style="font-size: 12px; color: var(--text-muted);">Năm trồng:</span>
          <select class="filter-select" name="nam_trong">
            <option value="">Tất cả</option>
          </select>

          <span style="font-size: 12px; color: var(--text-muted);">Giống cây:</span>
          <select class="filter-select" name="giong">
            <option value="">Tất cả</option>
          </select>

          <span style="font-size: 12px; color: var(--text-muted);">Phân loại:</span>
          <select class="filter-select">
            <option>Tất cả</option>
          </select>

          <span style="font-size: 12px; color: var(--text-muted);">Nhịp độ cao:</span>
          <select class="filter-select">
            <option>Tất cả</option>
          </select>

          <span style="font-size: 12px; color: var(--text-muted);">Quay hoạch tài canh:</span>
          <select class="filter-select">
            <option>Tất cả</option>
          </select>
        </div>
      </div>

      <!-- MAP WRAPPER -->
      <div class="map-wrapper">
        <div id="dashMap"></div>

        <!-- MAP CONTROL PANEL -->
        <div class="map-control-panel">
          <button class="map-control-btn" onclick="zoomMapIn()" title="Phóng to">
            <i class="fas fa-plus"></i>
          </button>
          <div class="zoom-slider-container">
            <input type="range" id="zoomRange" class="zoom-slider" min="3" max="20" value="12" onchange="setZoomLevel(this.value)">
            <span class="zoom-label" id="zoomLabel">12</span>
          </div>
          <button class="map-control-btn" onclick="zoomMapOut()" title="Thu nhỏ">
            <i class="fas fa-minus"></i>
          </button>
          <button class="map-control-btn" onclick="zoomHome()" title="Về vị trí gốc">
            <i class="fas fa-home"></i>
          </button>
          <button class="map-control-btn" onclick="toggleMeasurePanel()" title="Công cụ đo">
            <i class="fas fa-ruler"></i>
          </button>
          <button class="map-control-btn" onclick="toggleBasemapGallery()" title="Thay đổi bản đồ nền">
            <i class="fas fa-layer-group"></i>
          </button>
          <button class="map-control-btn" onclick="toggleLayerList()" title="Danh sách lớp">
            <i class="fas fa-bars"></i>
          </button>
          <button class="map-control-btn" onclick="togglePanel('map-search-panel')" title="Tìm kiếm lô">
            <i class="fas fa-search"></i>
          </button>
          <button class="map-control-btn" onclick="togglePanel('map-layer-panel')" title="Lớp bản đồ">
            <i class="fas fa-layer-group"></i>
          </button>
        </div>

        <!-- LEGEND PANEL -->
        <div class="legend-panel" id="legendPanel">
          <h4>🔹 Giai đoạn cây</h4>
          <div class="legend-items">
            <div class="legend-item">
              <span class="legend-color" style="background:#5ee7b1;"></span>
              <span>Mới trồng</span>
            </div>
            <div class="legend-item">
              <span class="legend-color" style="background:#0ea5e9;"></span>
              <span>Non</span>
            </div>
            <div class="legend-item">
              <span class="legend-color" style="background:#f59e0b;"></span>
              <span>Trưởng thành</span>
            </div>
          </div>
        </div>

        <!-- LAYER PANEL -->
        <div class="map-layer-panel" id="map-layer-panel">
          <div class="mlp-header">
            Lớp bản đồ
            <span style="cursor:pointer;color:var(--text-muted)" onclick="togglePanel('map-layer-panel')">✕</span>
          </div>
          <div class="mlp-item" onclick="toggleLayer(this,'lots')">
            <div class="mlp-check on" id="lc-lots">✓</div>
            <div class="mlp-dot" style="background:#00d68f"></div>
            Lô vườn cây cao su (509 lô)
          </div>
          <div class="mlp-item" onclick="toggleLayer(this,'background-layer')">
            <div class="mlp-check on" id="lc-background-layer">✓</div>
            <div class="mlp-dot" style="background:#d4dce8"></div>
            Lớp nền (509 lô)
          </div>
          <div class="mlp-item" onclick="toggleLayer(this,'boundary')">
            <div class="mlp-check on" id="lc-boundary">✓</div>
            <div class="mlp-dot" style="background:#ffffff55"></div>
            Ranh giới xã Kraya
          </div>
          <div class="mlp-item" onclick="toggleLayer(this,'label')">
            <div class="mlp-check on" id="lc-label">✓</div>
            <div class="mlp-dot" style="background:#00b4ff"></div>
            Nhãn tên lô (zoom ≥ 12)
          </div>
          <div class="mlp-item" onclick="toggleLayer(this,'satellite')">
            <div class="mlp-check on" id="lc-satellite">✓</div>
            <div class="mlp-dot" style="background:#888"></div>
            Ảnh vệ tinh Esri
          </div>
        </div>

        <!-- SEARCH PANEL -->
        <div class="map-search-panel" id="map-search-panel">
          <div class="msp-input">
            <svg width="13" height="13" fill="none" viewBox="0 0 24 24" stroke="#5a6a8a" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/></svg>
            <input type="text" placeholder="Tên lô, mã, giống, năm trồng..." id="mapSearchInput" oninput="mapSearch(this.value)">
          </div>
          <div id="mapSearchResults">
            <div class="msp-result" style="color:var(--text-muted);font-style:italic">Nhập từ khóa để tìm kiếm lô...</div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- TOAST NOTIFICATION -->
  <div id="toast">
    <span id="toastIcon">✅</span>
    <span id="toastMsg">Đã cập nhật thành công</span>
  </div>

  <!-- SCRIPTS -->
  <script>
    // ==================== KHỞI TẠO CẤU HÌNH ====================
    let dashMap = null;
    let thematicLayer = null;
    let backgroundLayer = null;
    let boundaryOuterLayer = null;
    let currentBasemap = 'osm';
    
    const basemapLayers = {};
    const layerVisibility = {
      boundary: true,
      loCay: true
    };
    
    let searchData = [];

    // ==================== API CALL ====================
    // Detect API base URL tự động
    const API_BASE = window.location.hostname === 'localhost' || window.location.hostname === '127.0.0.1'
      ? 'http://localhost:3000'
      : 'https://caosu-sncx.vercel.app'; // Domain production

    // Lấy thống kê dashboard
    async function fetchDashboardStats() {
      try {
        const response = await fetch(`${API_BASE}/api/dashboard-stats`);
        const result = await response.json();
        
        if (result.success && result.data) {
          document.getElementById('statsTotal').textContent = result.data.tong_lo_cay || 0;
          document.getElementById('statsArea').textContent = (result.data.tong_dien_tich || 0) + ' ha';
          console.log('✅ Thống kê dashboard:', result.data);
        }
      } catch (error) {
        console.error('❌ Lỗi fetchDashboardStats:', error);
      }
    }

    // Lấy danh sách đơn vị (fill dropdown)
    async function fetchDonViList() {
      try {
        const response = await fetch(`${API_BASE}/api/don-vi-list`);
        const result = await response.json();
        
        if (result.success) {
          const donViSelect = document.querySelector('select[name="doi"]');
          if (donViSelect) {
            const options = result.data.map(item => `<option value="${item.doi}">${item.doi}</option>`).join('');
            donViSelect.innerHTML = '<option value="">Tất cả</option>' + options;
          }
          console.log('✅ Danh sách đơn vị:', result.data);
        }
      } catch (error) {
        console.error('❌ Lỗi fetchDonViList:', error);
      }
    }

    // Lấy thống kê giống cây
    async function fetchGiongStats() {
      try {
        const response = await fetch(`${API_BASE}/api/giong-stats`);
        const result = await response.json();
        
        if (result.success) {
          const giongSelect = document.querySelector('select[name="giong"]');
          if (giongSelect) {
            const options = result.data.map(item => `<option value="${item.giong}">${item.giong} (${item.so_lo})</option>`).join('');
            giongSelect.innerHTML = '<option value="">Tất cả</option>' + options;
          }
          console.log('✅ Giống cây stats:', result.data);
        }
      } catch (error) {
        console.error('❌ Lỗi fetchGiongStats:', error);
      }
    }

    // Lấy thống kê năm trồng
    async function fetchNamTrongStats() {
      try {
        const response = await fetch(`${API_BASE}/api/nam-trong-stats`);
        const result = await response.json();
        
        if (result.success) {
          const namTrongSelect = document.querySelector('select[name="nam_trong"]');
          if (namTrongSelect) {
            const options = result.data.map(item => `<option value="${item.nam_trong}">${item.nam_trong} (${item.so_lo})</option>`).join('');
            namTrongSelect.innerHTML = '<option value="">Tất cả</option>' + options;
          }
          console.log('✅ Năm trồng stats:', result.data);
        }
      } catch (error) {
        console.error('❌ Lỗi fetchNamTrongStats:', error);
      }
    }

    // Lấy GeoJSON lô cây từ API (quan trọng nhất)
    async function fetchLoCaoSu(filters = {}) {
      console.log('📡 fetchLoCaoSu với filters:', filters);
      try {
        const params = new URLSearchParams();
        if (filters.doi) params.append('doi', filters.doi);
        if (filters.nam_trong) params.append('nam_trong', filters.nam_trong);
        if (filters.giong) params.append('giong', filters.giong);

        const url = `${API_BASE}/api/lo-cao-su?${params.toString()}`;
        console.log('🌐 Gọi URL:', url);
        
        const response = await fetch(url);
        console.log('📦 Response status:', response.status);
        
        if (!response.ok) {
          throw new Error(`HTTP ${response.status}: ${response.statusText}`);
        }
        
        const geoData = await response.json();
        console.log('✅ GeoJSON received:', geoData.features?.length, 'features');
        
        if (geoData.features) {
          console.log('📌 Sample feature:', geoData.features[0]);
          searchData = geoData.features.map(f => ({
            id: f.properties.id_lo,
            name: f.properties.ten_lo,
            doi: f.properties.doi,
            giong: f.properties.giong,
            nam_trong: f.properties.nam_trong,
            dien_tich_map: f.properties.dien_tich_map,
            geometry: f.geometry
          }));
        }

        return geoData;
      } catch (error) {
        console.error('❌ Lỗi fetchLoCaoSu:', error);
        return { type: 'FeatureCollection', features: [] };
      }
    }

    // Lấy boundary (ranh giới)
    async function fetchBoundary(doi = null) {
      console.log('📡 fetchBoundary với doi:', doi);
      try {
        const params = new URLSearchParams();
        if (doi) params.append('doi', doi);

        const url = `${API_BASE}/api/boundary?${params.toString()}`;
        console.log('🌐 Gọi URL:', url);
        
        const response = await fetch(url);
        console.log('📦 Response status:', response.status);
        
        if (!response.ok) {
          throw new Error(`HTTP ${response.status}: ${response.statusText}`);
        }
        
        const geoData = await response.json();
        console.log('✅ Boundary received:', geoData.features?.length, 'features');
        
        return geoData;
      } catch (error) {
        console.error('❌ Lỗi fetchBoundary:', error);
        return { type: 'FeatureCollection', features: [] };
      }
    }

    // Tải tất cả dữ liệu bản đồ
    async function fetchMapData() {
      console.log('🔄 fetchMapData: bắt đầu lấy dữ liệu...');
      try {
        console.log('📡 Gọi fetchLoCaoSu và fetchBoundary...');
        const [loData, boundaryData] = await Promise.all([
          fetchLoCaoSu(),
          fetchBoundary()
        ]);

        console.log('📊 loData:', loData);
        console.log('📊 boundaryData:', boundaryData);

        const result = {
          plots: loData.features || [],
          boundaries: boundaryData.features || [],
          stats: {
            total: loData.features?.length || 0
          }
        };

        console.log('✅ fetchMapData result:', result);
        return result;
      } catch (error) {
        console.error('❌ Lỗi fetchMapData:', error);
        showToast('Lỗi khi tải dữ liệu bản đồ: ' + error.message, '❌');
        return null;
      }
    }

    // ==================== KHỞI TẠO BẢN ĐỒ ====================
    async function initDashMap() {
      console.log('🚀 Bắt đầu initDashMap...');
      
      try {
        // Khởi tạo bản đồ
        console.log('📍 Khởi tạo Leaflet map...');
        dashMap = L.map('dashMap').setView([12.524, 105.452], 12);
        console.log('✅ Map created:', dashMap);

        // Basemap layers
        console.log('🗺️ Thêm OSM basemap...');
        basemapLayers.osm = L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
          attribution: '© OpenStreetMap contributors',
          maxZoom: 19
        }).addTo(dashMap);
        console.log('✅ OSM basemap added');

        basemapLayers.satellite = L.tileLayer('https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}', {
          attribution: 'Tiles &copy; Esri',
          maxZoom: 19
        });

        // Lấy dữ liệu từ API
        console.log('🔄 Lấy dữ liệu từ API...');
        const mapData = await fetchMapData();
        console.log('📊 Map data received:', mapData);
        
        if (!mapData) {
          console.error('❌ mapData là null!');
          return;
        }

        // Tạo boundary layer (ranh giới)
        if (mapData.boundaries && mapData.boundaries.length > 0) {
          console.log('🏗️ Tạo boundary layer với', mapData.boundaries.length, 'features');
          boundaryOuterLayer = L.geoJSON({
            type: 'FeatureCollection',
            features: mapData.boundaries
          }, {
            style: {
              color: '#e5e7eb',
              weight: 2,
              opacity: 0.5,
              fillOpacity: 0.1,
              dashArray: '5, 5'
            }
          }).addTo(dashMap);
          console.log('✅ Boundary layer added');
        } else {
          console.warn('⚠️ Không có boundary data');
        }

        // Tạo thematic layer (lô cây)
        if (mapData.plots && mapData.plots.length > 0) {
          console.log('🎨 Tạo thematic layer với', mapData.plots.length, 'features');
          console.log('📌 Sample feature:', mapData.plots[0]);
          
          thematicLayer = L.geoJSON({
            type: 'FeatureCollection',
            features: mapData.plots
          }, {
            style: (feature) => {
              let color = '#10b981';
              
              if (feature.properties.nam_trong) {
                const year = feature.properties.nam_trong;
                const yearMap = {
                  2025: '#5ee7b1',
                  2024: '#10b981',
                  2023: '#0ea5e9',
                  2022: '#f59e0b',
                  2021: '#fb923c',
                  2020: '#ef4444'
                };
                color = yearMap[year] || '#8b5cf6';
              }
              
              return {
                color: color,
                weight: 2,
                opacity: 0.8,
                fillOpacity: 0.4
              };
            },
            onEachFeature: (feature, layer) => {
              const props = feature.properties;
              const popupContent = `
                <div style="font-family: Arial, sans-serif; font-size: 12px; width: 250px;">
                  <strong style="color: #10b981; font-size: 14px;">${props.ten_lo || 'Lô ' + props.id_lo}</strong><br/>
                  <hr style="margin: 5px 0; border: none; border-top: 1px solid #e5e7eb;">
                  <div style="line-height: 1.6;">
                    <strong>ID:</strong> ${props.id_lo}<br/>
                    <strong>Đội:</strong> ${props.doi || 'N/A'}<br/>
                    <strong>Giống:</strong> ${props.giong || 'N/A'}<br/>
                    <strong>Năm trồng:</strong> ${props.nam_trong || 'N/A'}<br/>
                    <strong>Diện tích:</strong> ${props.dien_tich_map ? props.dien_tich_map + ' ha' : 'N/A'}<br/>
                    <strong>Chế độ cao:</strong> ${props.che_do_cao || 'N/A'}<br/>
                    <strong>Cây cao:</strong> ${props.cay_cao || 'N/A'}
                  </div>
                </div>
              `;
              layer.bindPopup(popupContent);
            }
          }).addTo(dashMap);
          console.log('✅ Thematic layer added');
        } else {
          console.warn('⚠️ Không có plots data');
        }

        // Khởi tạo zoom sync
        initZoomSync();

        // Tải dropdown filters
        console.log('📋 Tải filters...');
        await Promise.all([
          fetchDashboardStats(),
          fetchDonViList(),
          fetchGiongStats(),
          fetchNamTrongStats()
        ]);
        console.log('✅ Filters loaded');
        
        showToast('Bản đồ đã tải thành công', '✅');
        console.log('🎉 initDashMap hoàn tất!');
      } catch (error) {
        console.error('❌ Lỗi trong initDashMap:', error);
        showToast('Lỗi khởi tạo bản đồ: ' + error.message, '❌');
      }
    }

    // ==================== ĐIỀU KHIỂN ====================
    function showToast(msg, icon = '✅') {
      const t = document.getElementById('toast');
      document.getElementById('toastIcon').innerHTML = icon;
      document.getElementById('toastMsg').innerHTML = msg;
      t.classList.add('show');
      setTimeout(() => t.classList.remove('show'), 4000);
    }

    function zoomMapIn() {
      if (dashMap) {
        const currentZoom = dashMap.getZoom();
        dashMap.setZoom(currentZoom + 1);
        document.getElementById('zoomRange').value = currentZoom + 1;
        updateZoomLabel(currentZoom + 1);
      }
    }

    function zoomMapOut() {
      if (dashMap) {
        const currentZoom = dashMap.getZoom();
        dashMap.setZoom(currentZoom - 1);
        document.getElementById('zoomRange').value = currentZoom - 1;
        updateZoomLabel(currentZoom - 1);
      }
    }

    function setZoomLevel(level) {
      if (dashMap) {
        dashMap.setZoom(parseInt(level));
        updateZoomLabel(level);
      }
    }

    function updateZoomLabel(level) {
      document.getElementById('zoomLabel').textContent = level;
    }

    function zoomHome() {
      if (dashMap) {
        dashMap.setView([12.524, 105.452], 12);
        document.getElementById('zoomRange').value = 12;
        updateZoomLabel(12);
        showToast("Quay về vị trí ban đầu", "🏠");
      }
    }

    function initZoomSync() {
      if (dashMap) {
        dashMap.on('zoomend', () => {
          const zoom = dashMap.getZoom();
          document.getElementById('zoomRange').value = zoom;
          updateZoomLabel(zoom);
        });
      }
    }

    function toggleMeasurePanel() {
      showToast("Công cụ đo lường đang được phát triển", "📏");
    }

    function toggleBasemapGallery() {
      showToast("Đã chuyển sang bản đồ vệ tinh", "🗺️");
      if (basemapLayers[currentBasemap] && dashMap.hasLayer(basemapLayers[currentBasemap])) {
        dashMap.removeLayer(basemapLayers[currentBasemap]);
      }
      currentBasemap = currentBasemap === 'osm' ? 'satellite' : 'osm';
      basemapLayers[currentBasemap].addTo(dashMap);
      basemapLayers[currentBasemap].bringToBack();
    }

    function toggleLayerList() {
      showToast(layerVisibility.loCay ? "Ẩn lô cây" : "Hiển thị lô cây", "👁️");
      layerVisibility.loCay = !layerVisibility.loCay;
      if (layerVisibility.loCay) {
        if (thematicLayer) dashMap.addLayer(thematicLayer);
      } else {
        if (thematicLayer) dashMap.removeLayer(thematicLayer);
      }
    }

    // ==================== FILTER & SEARCH ====================
    async function applyMapFilters() {
      const filters = {
        doi: document.querySelector('select[name="doi"]')?.value || '',
        nam_trong: document.querySelector('select[name="nam_trong"]')?.value || '',
        giong: document.querySelector('select[name="giong"]')?.value || ''
      };

      // Loại bỏ filter rỗng
      Object.keys(filters).forEach(key => filters[key] === '' && delete filters[key]);

      console.log('📍 Áp dụng filter:', filters);
      showToast('Đang cập nhật bản đồ...', '⏳');

      // Lấy dữ liệu lọc từ API
      const loData = await fetchLoCaoSu(filters);
      
      if (!loData.features) {
        showToast('Không có dữ liệu phù hợp', '⚠️');
        return;
      }

      // Xóa layer cũ
      if (thematicLayer) dashMap.removeLayer(thematicLayer);

      // Tạo layer mới từ dữ liệu lọc
      if (loData.features.length > 0) {
        thematicLayer = L.geoJSON(loData, {
          style: (feature) => {
            let color = '#10b981';
            if (feature.properties.nam_trong) {
              const year = feature.properties.nam_trong;
              const yearMap = {
                2025: '#5ee7b1',
                2024: '#10b981',
                2023: '#0ea5e9',
                2022: '#f59e0b',
                2021: '#fb923c',
                2020: '#ef4444'
              };
              color = yearMap[year] || '#8b5cf6';
            }
            return {
              color: color,
              weight: 2,
              opacity: 0.8,
              fillOpacity: 0.4
            };
          },
          onEachFeature: (feature, layer) => {
            const props = feature.properties;
            const popupContent = `
              <div style="font-family: Arial, sans-serif; font-size: 12px; width: 250px;">
                <strong style="color: #10b981; font-size: 14px;">${props.ten_lo || 'Lô ' + props.id_lo}</strong><br/>
                <hr style="margin: 5px 0; border: none; border-top: 1px solid #e5e7eb;">
                <div style="line-height: 1.6;">
                  <strong>ID:</strong> ${props.id_lo}<br/>
                  <strong>Đội:</strong> ${props.doi || 'N/A'}<br/>
                  <strong>Giống:</strong> ${props.giong || 'N/A'}<br/>
                  <strong>Năm trồng:</strong> ${props.nam_trong || 'N/A'}<br/>
                  <strong>Diện tích:</strong> ${props.dien_tich_map ? props.dien_tich_map + ' ha' : 'N/A'}<br/>
                  <strong>Chế độ cao:</strong> ${props.che_do_cao || 'N/A'}<br/>
                  <strong>Cây cao:</strong> ${props.cay_cao || 'N/A'}
                </div>
              </div>
            `;
            layer.bindPopup(popupContent);
          }
        }).addTo(dashMap);
      }

      showToast(`Hiển thị ${loData.features.length} lô cây`, '✅');
    }

    // ==================== LAYER PANEL & SEARCH ====================
    function togglePanel(panelId) {
      const panel = document.getElementById(panelId);
      if (panel) {
        panel.classList.toggle('show');
        console.log(`Toggled panel: ${panelId}`);
      }
    }

    function toggleLayer(element, layerId) {
      const checkbox = element.querySelector('.mlp-check');
      if (checkbox) {
        checkbox.classList.toggle('on');
        checkbox.classList.toggle('off');
        
        const isChecked = checkbox.classList.contains('on');
        console.log(`Layer ${layerId}: ${isChecked ? 'ON' : 'OFF'}`);

        // Xử lý từng layer
        if (layerId === 'lots' && thematicLayer) {
          if (isChecked) {
            dashMap.addLayer(thematicLayer);
          } else {
            dashMap.removeLayer(thematicLayer);
          }
          showToast(isChecked ? 'Hiển thị lô cây' : 'Ẩn lô cây', '👁️');
        } else if (layerId === 'boundary' && boundaryOuterLayer) {
          if (isChecked) {
            dashMap.addLayer(boundaryOuterLayer);
          } else {
            dashMap.removeLayer(boundaryOuterLayer);
          }
          showToast(isChecked ? 'Hiển thị ranh giới' : 'Ẩn ranh giới', '👁️');
        } else if (layerId === 'background-layer') {
          showToast(isChecked ? 'Hiển thị lớp nền' : 'Ẩn lớp nền', '👁️');
        } else if (layerId === 'label') {
          showToast(isChecked ? 'Hiển thị nhãn tên' : 'Ẩn nhãn tên', '🏷️');
        } else if (layerId === 'satellite') {
          // Chuyển basemap
          if (isChecked) {
            if (basemapLayers[currentBasemap]) dashMap.removeLayer(basemapLayers[currentBasemap]);
            currentBasemap = 'satellite';
            basemapLayers.satellite.addTo(dashMap);
            basemapLayers.satellite.bringToBack();
          } else {
            if (basemapLayers.satellite) dashMap.removeLayer(basemapLayers.satellite);
            currentBasemap = 'osm';
            basemapLayers.osm.addTo(dashMap);
            basemapLayers.osm.bringToBack();
          }
          showToast(isChecked ? 'Chuyển sang vệ tinh' : 'Chuyển sang bản đồ', '🗺️');
        }
      }
    }

    function mapSearch(query) {
      const resultsDiv = document.getElementById('mapSearchResults');
      
      if (!query.trim()) {
        resultsDiv.innerHTML = '<div class="msp-result" style="color:var(--text-muted);font-style:italic">Nhập từ khóa để tìm kiếm lô...</div>';
        return;
      }

      const queryLower = query.toLowerCase();
      const results = searchData.filter(item => {
        return (
          (item.name && item.name.toLowerCase().includes(queryLower)) ||
          (item.id && item.id.toString().includes(query)) ||
          (item.giong && item.giong.toLowerCase().includes(queryLower)) ||
          (item.nam_trong && item.nam_trong.toString().includes(query)) ||
          (item.doi && item.doi.toLowerCase().includes(queryLower))
        );
      }).slice(0, 8);

      if (results.length === 0) {
        resultsDiv.innerHTML = '<div class="msp-result" style="color:var(--text-muted)">Không tìm thấy kết quả</div>';
      } else {
        resultsDiv.innerHTML = results.map((item, idx) => `
          <div class="msp-result" onclick="selectSearchResult(${idx}, ${JSON.stringify(item).replace(/"/g, '&quot;')})">
            <strong>📍 Lô ${item.id}: ${item.name || 'N/A'}</strong>
            <div class="msp-result-desc">
              ${item.doi ? `Đội: ${item.doi} | ` : ''}
              ${item.giong ? `Giống: ${item.giong}` : ''}
            </div>
          </div>
        `).join('');
      }
    }

    function selectSearchResult(idx, item) {
      console.log('Selected result:', item);
      
      if (item.geometry) {
        const geoJSON = L.geoJSON({
          type: 'Feature',
          geometry: item.geometry
        });
        const bounds = geoJSON.getBounds();
        dashMap.fitBounds(bounds, { padding: [50, 50], maxZoom: 15 });
      }

      showToast(`Đã chọn lô ${item.id}: ${item.name}`, '✅');
      
      // Đóng search panel sau khi chọn
      document.getElementById('mapSearchInput').value = '';
      document.getElementById('mapSearchResults').innerHTML = '<div class="msp-result" style="color:var(--text-muted);font-style:italic">Nhập từ khóa để tìm kiếm lô...</div>';
    }

    // Hiện/ẩn search panel khi click vào map
    document.addEventListener('DOMContentLoaded', () => {
      const mapWrapper = document.querySelector('.map-wrapper');
      const searchPanel = document.getElementById('map-search-panel');
      
      if (mapWrapper && searchPanel) {
        mapWrapper.addEventListener('click', (e) => {
          // Chỉ hiện search panel nếu click vào map, không phải vào UI elements
          if (e.target === mapWrapper || e.target.id === 'dashMap') {
            searchPanel.classList.add('show');
          }
        });

        // Ẩn khi click vào input hoặc results
        searchPanel.addEventListener('click', (e) => {
          e.stopPropagation();
        });
      }
    });

    // ==================== KHỞI CHẠY ====================
    window.addEventListener('load', initDashMap);
    
    // Gắn event listener cho filter dropdowns
    document.addEventListener('DOMContentLoaded', () => {
      const filterSelects = document.querySelectorAll('select[name="doi"], select[name="nam_trong"], select[name="giong"]');
      filterSelects.forEach(select => {
        select.addEventListener('change', applyMapFilters);
      });
    });
  </script>

</body>
</html>