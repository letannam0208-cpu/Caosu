      <span class="lo-popup-label">Tuổi cạo</span><span class="lo-popup-val">${p.tuoi_cao || "—"}</span>
      <span class="lo-popup-label">Giống</span><span class="lo-popup-val">${p.giong || "—"}</span>
      <span class="lo-popup-label">Phương pháp trồng</span><span class="lo-popup-val">${p.phuong_phap_trong || "—"}</span>
      <span class="lo-popup-label">Khoảng cách trồng</span><span class="lo-popup-val">${p.khoang_cach_trong || "—"}</span>
      <span class="lo-popup-label">Mật độ thiết kế</span><span class="lo-popup-val">${p.mat_do_tk || "—"}</span>
      <span class="lo-popup-label">Nhịp độ cạo</span><span class="lo-popup-val">${p.nhip_do_cao || "—"}</span>
      <span class="lo-popup-label">Chế độ cạo</span><span class="lo-popup-val">${p.che_do_cao || "—"}</span>
      <span class="lo-popup-label">NSBQ 2025(kg/ha)</span><span class="lo-popup-val">${p.ns25_kg_ha || "—"}</span>
      <span class="lo-popup-label">NSBQ 2026(kg/ha)</span><span class="lo-popup-val">${p.ns26_kg_ha || "—"}</span>
      <span class="lo-popup-label">Sản lượng 2026(kg)</span><span class="lo-popup-val">${p.san_luong || "—"}</span>
