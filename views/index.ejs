<script>
/* ==================== KHỞI TẠO BẢN ĐỒ & DASHBOARD ==================== */
let dashMap, xaLayer;
let lotLayers = [], backgroundLotLayers = [], labelLayers = [];
let boundaryVis = true, lotsVis = true, labelsVis = true;
let mapViewMode = 'nt';
let selectedIdx = new Set();
let currentTool = 'pointer';
let filterNT = new Set(), filterNam = new Set(), filterGiong = new Set(), filterPhienCao = new Set(), filterNhipDo = new Set(), filterQuyHoach = new Set();
let filterKhuVuc = new Set(), filterTuoiCao = new Set(), filterCheDoCao = new Set();
let caosuFeatures = [];
let userLocationMarker = null;
let userLocationCircle = null;

// Màu sắc cho các đối tượng (giống, năm trồng, Đội)
const giongPalette = {
  'IRCA 130':'#f4656a','PB 255':'#a78bfa','PB 260':'#00b4ff',
  'RRIC 121':'#34d399','RRIV 1':'#00d68f','RRIV 106':'#f59e0b',
  'RRIV 107':'#fb923c','RRIV 112':'#e879f9','RRIV 117':'#38bdf8',
  'RRIV 124':'#4ade80','RRIV 2':'#fbbf24','RRIV 201':'#c084fc',
  'RRIV 3':'#f472b6','RRIV 4':'#22d3ee','RRIV 5':'#a3e635'
};
const namPalette = {
  '2007':'#a78bfa','2008':'#818cf8','2009':'#38bdf8',
  '2010':'#00d68f','2011':'#f59e0b','2012':'#f4656a'
};
const ntPalette = {
  '1': '#00d68f','2': '#00b4ff','3': '#f59e0b'
};
const phienCaoPalette = {
  '1/2S': '#00d68f', '1/3S': '#00b4ff', '1/4S': '#f59e0b', '1/2S d3': '#a78bfa', '1/3S d3': '#f4656a'
};
const nhipDoCaoPalette = {
  '2 ngày/1 lần': '#00d68f', '3 ngày/1 lần': '#00b4ff', '4 ngày/1 lần': '#f59e0b'
};
const taiCanhPalette = {
  '2026': '#00d68f', '2027': '#00b4ff', '2028': '#f59e0b', '2029': '#a78bfa', '2030': '#f4656a'
};

/* ==================== LẤY DỮ LIỆU TỪ API ==================== */
async function fetchAPI(url) {
  const res = await fetch(url);
  if (!res.ok) throw new Error(`HTTP ${res.status}`);
  return res.json();
}

let fullNT = new Set(), fullNam = new Set(), fullGiong = new Set(), fullPhienCao = new Set(), fullNhipDo = new Set(), fullQuyHoach = new Set();
let fullKhuVuc = new Set(), fullTuoiCao = new Set(), fullCheDoCao = new Set();

async function loadCaosuData() {
  try {
    const data = await fetchAPI('/api/lo-cao-su');
    caosuFeatures = data.features || [];
    console.log('📦 Đã tải', caosuFeatures.length, 'lô từ API');
    if (caosuFeatures.length === 0) {
      console.warn('⚠️ Không có lô nào được trả về từ API. Kiểm tra database và endpoint /api/lo-cao-su');
    } else {
      console.log('Ví dụ feature đầu tiên:', caosuFeatures[0]);
    }
    fullNT.clear(); fullNam.clear(); fullGiong.clear();
    fullPhienCao.clear(); fullNhipDo.clear(); fullQuyHoach.clear();
    fullKhuVuc.clear(); fullTuoiCao.clear(); fullCheDoCao.clear();

    caosuFeatures.forEach(f => {
      const p = f.properties;
      if (p.doi) fullNT.add(p.doi);
      else fullNT.add(''); 
      if (p.nam_trong) fullNam.add(String(p.nam_trong));
      else fullNam.add(''); 
      if (p.giong) fullGiong.add(p.giong);
      else fullGiong.add(''); 
      if (p.phien_cao) fullPhienCao.add(p.phien_cao);
      else fullPhienCao.add('');
      if (p.nhip_do_cao) fullNhipDo.add(p.nhip_do_cao);
      else fullNhipDo.add(''); 
      if (p.tai_canh_nam) fullQuyHoach.add(String(p.tai_canh_nam));
      else fullQuyHoach.add(''); 
      if (p.khu_vuc) fullKhuVuc.add(p.khu_vuc);
      else fullKhuVuc.add(''); 
      if (p.tuoi_cao) fullTuoiCao.add(String(p.tuoi_cao));
      else fullTuoiCao.add(''); 
      if (p.che_do_cao) fullCheDoCao.add(p.che_do_cao);
      else fullCheDoCao.add(''); 
    });

    // Khởi tạo filter mặc định là tất cả
    filterNT = new Set(fullNT);
    filterNam = new Set(fullNam);
    filterGiong = new Set(fullGiong);
    filterPhienCao = new Set(fullPhienCao);
    filterNhipDo = new Set(fullNhipDo);
    filterQuyHoach = new Set(fullQuyHoach);
    filterKhuVuc = new Set(fullKhuVuc);
    filterTuoiCao = new Set(fullTuoiCao);
    filterCheDoCao = new Set(fullCheDoCao);

    console.log('Filters initialized:', {
      fullNT: Array.from(fullNT),
      fullNam: Array.from(fullNam),
      fullGiong: Array.from(fullGiong),
      fullKhuVuc: Array.from(fullKhuVuc),
      fullTuoiCao: Array.from(fullTuoiCao),
      fullCheDoCao: Array.from(fullCheDoCao)
    });
  } catch (err) {
    console.error('❌ Lỗi loadCaosuData:', err);
    caosuFeatures = [];
  }
}

async function buildFilterUI() {
  const ntEl = document.getElementById('filter-nt');
  ntEl.innerHTML = '<option value="all">Tất cả</option>';
  Array.from(fullNT).sort().forEach(nt => {
    const opt = document.createElement('option');
    opt.value = nt;
    opt.textContent = nt;
    ntEl.appendChild(opt);
  });

  const namEl = document.getElementById('filter-nam');
  namEl.innerHTML = '<option value="all">Tất cả</option>';
  Array.from(fullNam).sort().forEach(y => {
    const opt = document.createElement('option');
    opt.value = y;
    opt.textContent = y;
    namEl.appendChild(opt);
  });

  const giongEl = document.getElementById('filter-giong');
  giongEl.innerHTML = '<option value="all">Tất cả</option>';
  Array.from(fullGiong).sort().forEach(g => {
    const opt = document.createElement('option');
    opt.value = g;
    opt.textContent = g;
    giongEl.appendChild(opt);
  });

  const phienCaoEl = document.getElementById('filter-phien_cao');
  if (phienCaoEl) {
    phienCaoEl.innerHTML = '<option value="all">Tất cả</option>';
    Array.from(fullPhienCao).filter(v => v !== '').sort().forEach(v => {
      const opt = document.createElement('option');
      opt.value = v;
      opt.textContent = v;
      phienCaoEl.appendChild(opt);
    });
  }

  const nhipDoEl = document.getElementById('filter-Nhip_do_cao');
  if (nhipDoEl) {
    nhipDoEl.innerHTML = '<option value="all">Tất cả</option>';
    Array.from(fullNhipDo).filter(v => v !== '').sort().forEach(v => {
      const opt = document.createElement('option');
      opt.value = v;
      opt.textContent = v;
      nhipDoEl.appendChild(opt);
    });
  }

  const quyHoachEl = document.getElementById('filter-quy_hoach_tai_canh');
  if (quyHoachEl) {
    quyHoachEl.innerHTML = '<option value="all">Tất cả</option>';
    Array.from(fullQuyHoach).filter(v => v !== '').sort().forEach(v => {
      const opt = document.createElement('option');
      opt.value = v;
      opt.textContent = v;
      quyHoachEl.appendChild(opt);
    });
  }

  const khuVucEl = document.getElementById('filter-khu-vuc');
  if (khuVucEl) {
    khuVucEl.innerHTML = '<option value="all">Tất cả</option>';
    Array.from(fullKhuVuc).filter(v => v !== '').sort().forEach(v => {
      const opt = document.createElement('option');
      opt.value = v;
      opt.textContent = v;
      khuVucEl.appendChild(opt);
    });
  }

  const tuoiCaoEl = document.getElementById('filter-tuoi-cao');
  if (tuoiCaoEl) {
    tuoiCaoEl.innerHTML = '<option value="all">Tất cả</option>';
    Array.from(fullTuoiCao).filter(v => v !== '').sort((a,b) => Number(a) - Number(b)).forEach(v => {
      const opt = document.createElement('option');
      opt.value = v;
      opt.textContent = v;
      tuoiCaoEl.appendChild(opt);
    });
  }

  const cheDoCaoEl = document.getElementById('filter-che-do-cao');
  if (cheDoCaoEl) {
    cheDoCaoEl.innerHTML = '<option value="all">Tất cả</option>';
    Array.from(fullCheDoCao).filter(v => v !== '').sort().forEach(v => {
      const opt = document.createElement('option');
      opt.value = v;
      opt.textContent = v;
      cheDoCaoEl.appendChild(opt);
    });
  }
}

function featureVisible(p) {
  if (!p.ten_lo) return false;
  const nt = p.doi ?? '';
  const nam = p.nam_trong != null ? String(p.nam_trong) : '';
  const g = p.giong ?? '';
  const pc = p.phien_cao != null ? String(p.phien_cao) : '';
  const nd = p.nhip_do_cao != null ? String(p.nhip_do_cao) : '';
  const qh = p.tai_canh_nam != null ? String(p.tai_canh_nam) : '';
  const kv = p.khu_vuc ?? '';
  const tc = p.tuoi_cao != null ? String(p.tuoi_cao) : '';
  const cdc = p.che_do_cao ?? '';

  const okNT   = filterNT.size === 0 || filterNT.has(nt);
  const okNam  = filterNam.size === 0 || filterNam.has(nam);
  const okGiong= filterGiong.size === 0 || filterGiong.has(g);
  const okPC   = filterPhienCao.size === 0 || filterPhienCao.has(pc);
  const okND   = filterNhipDo.size === 0 || filterNhipDo.has(nd);
  const okQH   = filterQuyHoach.size === 0 || filterQuyHoach.has(qh);
  const okKV   = filterKhuVuc.size === 0 || filterKhuVuc.has(kv);
  const okTC   = filterTuoiCao.size === 0 || filterTuoiCao.has(tc);
  const okCDC  = filterCheDoCao.size === 0 || filterCheDoCao.has(cdc);

  return okNT && okNam && okGiong && okPC && okND && okQH && okKV && okTC && okCDC;
}

function getLotColorReal(p, mode) {
  if (mode === 'giong') return giongPalette[p.giong] || '#5a6a8a';
  if (mode === 'nam') return namPalette[p.nam_trong] || '#5a6a8a';
  if (mode === 'nt') {
    let doi = p.doi;
    if (doi && typeof doi === 'string') {
      const match = doi.match(/\d+$/);
      if (match) doi = match[0];
    }
    return ntPalette[doi] || ntPalette[p.doi] || '#5a6a8a';
  }
  if (mode === 'phien_cao') return phienCaoPalette[p.phien_cao] || '#5a6a8a';
  if (mode === 'nhiet_do_cao') return nhipDoCaoPalette[p.nhip_do_cao] || '#5a6a8a';
  if (mode === 'quy_hoach_tai_canh') return taiCanhPalette[p.tai_canh_nam] || '#5a6a8a';
  return '#00d68f';
}

/* ==================== RENDER BẢN ĐỒ ==================== */
function renderRealLots() {
  if (!dashMap) return;
  lotLayers.forEach(o => dashMap.removeLayer(o.layer));
  backgroundLotLayers.forEach(o => dashMap.removeLayer(o.layer));
  labelLayers.forEach(l => dashMap.removeLayer(l));
  lotLayers = []; backgroundLotLayers = []; labelLayers = [];

  if (!caosuFeatures.length) {
    console.warn('renderRealLots: không có feature nào để render');
    return;
  }

  // Nền cho tất cả lô
  caosuFeatures.forEach((feat, idx) => {
    const bgLayer = L.geoJSON(feat, {
      style: { color: '#d4dce833', weight: 0.5, fillColor: '#d4dce8', fillOpacity: 0.25 },
      interactive: false
    });
    bgLayer.addTo(dashMap);
    backgroundLotLayers.push({ layer: bgLayer, p: feat.properties, idx });
  });

  let count = 0;
  caosuFeatures.forEach((feat, idx) => {
    const p = feat.properties;
    if (!featureVisible(p)) return;
    const isSel = selectedIdx.has(idx);
    const col = getLotColorReal(p, mapViewMode);

    if (lotsVis) {
      const layer = L.geoJSON(feat, {
        style: {
          color: isSel ? '#ffffff' : col,
          weight: isSel ? 2.5 : 1,
          fillColor: col,
          fillOpacity: isSel ? 0.65 : 0.52
        },
        interactive: !msrActive
      });
      
      if (!msrActive) {
        const bs = `background:${col}22;color:${col};border:1px solid ${col}55`;
        layer.bindPopup(`
          <div class="lo-popup-title">
            <span class="lo-popup-badge" style="${bs}">${p.giong || '—'}</span>
            ${p.ten_lo || p.id_lo || '—'}
          </div>
          <div class="lo-popup-grid">
            <span class="lo-popup-label">Mã lô</span><span class="lo-popup-val">${p.id_lo || '—'}</span>
            <span class="lo-popup-label">Đội</span><span class="lo-popup-val">${p.doi || '—'}</span>
            <span class="lo-popup-label">Năm trồng</span><span class="lo-popup-val">${p.nam_trong || '—'}</span>
            <span class="lo-popup-label">Giống cây</span><span class="lo-popup-val">${p.giong || '—'}</span>
            <span class="lo-popup-label">Diện tích</span><span class="lo-popup-val">${p.dien_tich_map ? p.dien_tich_map + ' ha' : '—'}</span>
          </div>
          <div class="lo-popup-actions">
            <div class="lo-popup-btn" onclick="showToast('Chi tiết: ${(p.ten_lo || '').replace(/'/g, '')}','📋')">Chi tiết</div>
            <div class="lo-popup-btn" onclick="showToast('Sửa lô: ${(p.ten_lo || '').replace(/'/g, '')}','✏️')">Sửa</div>
          </div>`, { maxWidth: 260 });

        layer.on('mouseover', () => layer.setStyle({ fillOpacity: 0.7, weight: 2 }));
        layer.on('mouseout', () => { if (!selectedIdx.has(idx)) layer.setStyle({ fillOpacity: 0.52, weight: 1 }); });
        layer.on('click', e => {
          if (currentTool === 'pointer') {
            selectedIdx.has(idx) ? selectedIdx.delete(idx) : selectedIdx.add(idx);
            updateSelBar();
            renderRealLots();
            L.DomEvent.stopPropagation(e);
          }
        });
      }
      
      layer.addTo(dashMap);
      lotLayers.push({ layer, p, idx });
      count++;
    }

    if (labelsVis && p.ten_lo) {
      const z = dashMap.getZoom();
      if (z > 13) {
        const fs = Math.max(2, (z - 3) * 0.75);
        if (fs > 0) {
          const center = L.geoJSON(feat).getBounds().getCenter();
          const col = getLotColorReal(p, mapViewMode);
          const cleanName = p.ten_lo.replace(/\s*-\s*KV\s*\d+\s*$/i, '');
          const namCuoi = p.nam_trong ? String(p.nam_trong).slice(-2) : '';
          const line1 = namCuoi ? `${cleanName} - ${namCuoi}` : cleanName;
          const html = `<div style="background:transparent; color:#fff; font-size:${fs}px; padding:${Math.max(2, fs * 0.4)}px ${Math.max(4, fs * 0.7)}px; border-radius:4px; border-left:${Math.max(2, fs * 0.25)}px solid ${col}; white-space:nowrap; pointer-events:none; font-family:'Be Vietnam Pro',sans-serif; line-height:1.6; font-weight:700; text-shadow:0 1px 3px rgba(0,0,0,0.5); transform:scale(${z / 16}); transform-origin:top left; text-align:center;"><strong style="display:block">${line1}</strong>${p.giong ? `<span style="display:block; margin-top:2px">${p.giong}</span>` : ''}</div>`;
          const lbl = L.marker(center, { icon: L.divIcon({ html, className: '', iconAnchor: [0, 0] }) }).addTo(dashMap);
          labelLayers.push(lbl);
        }
      }
    }
  });

  renderMapLegend();
  document.getElementById('selCountTop').textContent = count ? `${count} lô hiển thị` : 'Không có lô nào';
  console.log(`Đã render ${count} lô (tổng số feature: ${caosuFeatures.length})`);
}

function renderMapLegend() {
  const leg = document.getElementById('mapLegend');
  if (!leg) return;
  let entries, title;
  if (mapViewMode === 'giong') { entries = Object.entries(giongPalette); title = 'Giống cây'; }
  else if (mapViewMode === 'nam') { entries = Object.entries(namPalette); title = 'Năm trồng'; }
  else if (mapViewMode === 'nt') { entries = Object.entries(ntPalette); title = 'Đội'; }
  else if (mapViewMode === 'phien_cao') { entries = Object.entries(phienCaoPalette); title = 'Phiên cạo'; }
  else if (mapViewMode === 'nhiet_do_cao') { entries = Object.entries(nhipDoCaoPalette); title = 'Nhịp độ cạo'; }
  else if (mapViewMode === 'quy_hoach_tai_canh') { entries = Object.entries(taiCanhPalette); title = 'QH tái canh'; }
  else { entries = []; title = ''; }

  const displayEntries = entries.map(([k, v]) => {
    if (mapViewMode === 'nt') {
      let displayName = k;
      if (k === '1') displayName = 'Đội 1';
      else if (k === '2') displayName = 'Đội 2';
      else if (k === '3') displayName = 'Đội 3';
      else displayName = k;
      return [displayName, v];
    }
    return [k, v];
  });

  leg.innerHTML = `<div style="display:flex; gap:16px; flex-wrap:wrap; align-items:center; width:100%">
    ${displayEntries.map(([k, v]) => `<div class="map-leg-item"><div class="map-leg-dot" style="background:${v}"></div>${k}</div>`).join('')}
    <span style="margin-left:auto;font-size:11px;color:var(--muted)">${lotLayers.length} lô · ${selectedIdx.size} đã chọn</span>
  </div>`;
}

function updateSelBar() {
  const n = selectedIdx.size;
  document.getElementById('selBarText').textContent = `Đã chọn: ${n} lô`;
  document.getElementById('selCountTop').textContent = n ? `${n} lô đã chọn` : `${lotLayers.length} lô hiển thị`;
  document.getElementById('mapSelBar').classList.toggle('show', n > 0);
  renderMapLegend();
}

function switchMapView(mode, btn) {
  mapViewMode = mode;
  document.querySelectorAll('[id^=mview-]').forEach(b => b.classList.remove('on'));
  btn.classList.add('on');
  renderRealLots();
}

function updateMapFilters(type, selectEl) {
  const val = selectEl.value;
  if (val === 'all') {
    if (type === 'NT') filterNT = new Set(fullNT);
    else if (type === 'nam') filterNam = new Set(fullNam);
    else if (type === 'giong') filterGiong = new Set(fullGiong);
    else if (type === 'phien_cao') filterPhienCao = new Set(fullPhienCao);
    else if (type === 'nhip_do_cao') filterNhipDo = new Set(fullNhipDo);
    else if (type === 'quy_hoach_tai_canh') filterQuyHoach = new Set(fullQuyHoach);
    else if (type === 'khu_vuc') filterKhuVuc = new Set(fullKhuVuc);
    else if (type === 'tuoi_cao') filterTuoiCao = new Set(fullTuoiCao);
    else if (type === 'che_do_cao') filterCheDoCao = new Set(fullCheDoCao);
  } else {
    if (type === 'NT') filterNT = new Set([val]);
    else if (type === 'nam') filterNam = new Set([val]);
    else if (type === 'giong') filterGiong = new Set([val]);
    else if (type === 'phien_cao') filterPhienCao = new Set([val]);
    else if (type === 'nhip_do_cao') filterNhipDo = new Set([val]);
    else if (type === 'quy_hoach_tai_canh') filterQuyHoach = new Set([val]);
    else if (type === 'khu_vuc') filterKhuVuc = new Set([val]);
    else if (type === 'tuoi_cao') filterTuoiCao = new Set([val]);
    else if (type === 'che_do_cao') filterCheDoCao = new Set([val]);
  }
  renderRealLots();
}

function clearSelection() {
  selectedIdx.clear();
  updateSelBar();
  renderRealLots();
}

/* ==================== CÁC CÔNG CỤ BẢN ĐỒ ==================== */
const MAP_DEFAULT_CENTER = [12.524, 105.452];
const MAP_DEFAULT_ZOOM = 12;

function mapZoomIn() {
  if (!dashMap) return;
  const z = dashMap.getZoom();
  if (z >= 19) return;
  dashMap.setZoom(z + 1, { animate: true });
  const btn = document.getElementById('btn-zoom-in');
  if (btn) { btn.classList.add('active'); setTimeout(() => btn.classList.remove('active'), 250); }
}

function mapZoomOut() {
  if (!dashMap) return;
  const z = dashMap.getZoom();
  if (z <= 1) return;
  dashMap.setZoom(z - 1, { animate: true });
  const btn = document.getElementById('btn-zoom-out');
  if (btn) { btn.classList.add('active'); setTimeout(() => btn.classList.remove('active'), 250); }
}

function goHome() {
  if (!dashMap) return;
  const btn = document.getElementById('btn-home');
  if (btn) { btn.classList.add('active'); setTimeout(() => btn.classList.remove('active'), 1500); }
  dashMap.flyTo(MAP_DEFAULT_CENTER, MAP_DEFAULT_ZOOM, { animate: true, duration: 1.2, easeLinearity: 0.35 });
  showToast('Đã quay về vị trí mặc định', '🏠');
}

function setMapTool(tool, btn) {
  if (document.getElementById('measure-panel').classList.contains('show')) {
    closeMeasure();
  }
  
  currentTool = tool;
  ['tool-pan', 'tool-pointer', 'tool-rect'].forEach(id => {
    const el = document.getElementById(id);
    if (el) el.classList.remove('active');
  });
  if (btn) btn.classList.add('active');

  const wrap = document.querySelector('.map-canvas-wrap');
  const mapEl = document.getElementById('dashMap');

  if (tool === 'pan') {
    dashMap.dragging.enable();
    dashMap.scrollWheelZoom.enable();
    dashMap.doubleClickZoom.enable();
    if (mapEl) mapEl.style.cursor = 'grab';
    wrap.classList.add('pan-mode');
    wrap.classList.remove('measuring-distance', 'measuring-area');
  } else if (tool === 'pointer') {
    dashMap.dragging.enable();
    dashMap.scrollWheelZoom.enable();
    dashMap.doubleClickZoom.disable();
    if (mapEl) mapEl.style.cursor = 'default';
    wrap.classList.remove('pan-mode', 'measuring-distance', 'measuring-area');
}
}

function togglePanel(id) {
  document.querySelectorAll('.map-layer-panel,.map-search-panel').forEach(p => {
    if (p.id !== id) p.classList.remove('show');
  });
  document.getElementById(id).classList.toggle('show');
}

function toggleLayer(el, type) {
  const chk = el.querySelector('.mlp-check');
  const on = chk.classList.toggle('on');
  chk.textContent = on ? '✓' : '';
  
  if (type === 'lots') {
    lotsVis = on;
    renderRealLots();
  } 
  else if (type === 'background-layer') {
    backgroundLotLayers.forEach(o => on ? o.layer.addTo(dashMap) : dashMap.removeLayer(o.layer));
  } 
  else if (type === 'boundary') {
    boundaryVis = on;
    // Cập nhật trực tiếp ranh giới xã
    if (boundaryVis && xaLayer) xaLayer.addTo(dashMap);
    else if (xaLayer) dashMap.removeLayer(xaLayer);
    showToast(boundaryVis ? 'Hiện ranh giới xã' : 'Ẩn ranh giới xã', '🗂');
  } 
  else if (type === 'label') {
    labelsVis = on;
    // Cập nhật trực tiếp nhãn lô
    renderRealLots();
    showToast(labelsVis ? 'Đã bật nhãn tên lô' : 'Đã tắt nhãn lô', '🏷');
  }
}

