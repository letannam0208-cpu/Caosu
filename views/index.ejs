  // ==================== ĐIỀU KHIỂN ====================
  function goHome() { 
    if(dashMap) dashMap.setView([12.524, 105.452], 12); 
  }

  function showToast(msg, icon = '✅') {
    const t = document.getElementById('toast');
    document.getElementById('toastIcon').innerHTML = icon;
    document.getElementById('toastMsg').innerHTML = msg;
    t.classList.add('show');
    setTimeout(() => t.classList.remove('show'), 4000);
  }

  // ==================== CUSTOM ZOOM ====================
  function zoomMapIn() {
    if (dashMap) {
      const currentZoom = dashMap.getZoom();
      dashMap.setZoom(currentZoom + 1);
      document.getElementById('zoomRange').value = currentZoom + 1;
      updateZoomLabel(currentZoom + 1);
    }
  }

  function zoomMapOut() {
    if (dashMap) {
      const currentZoom = dashMap.getZoom();
      dashMap.setZoom(currentZoom - 1);
      document.getElementById('zoomRange').value = currentZoom - 1;
      updateZoomLabel(currentZoom - 1);
    }
  }

  function setZoomLevel(level) {
    if (dashMap) {
      dashMap.setZoom(parseInt(level));
      updateZoomLabel(level);
    }
  }

  function updateZoomLabel(level) {
    document.getElementById('zoomLabel').textContent = level;
  }

  function zoomHome() {
    if (dashMap) {
      dashMap.setView([12.524, 105.452], 12);
      document.getElementById('zoomRange').value = 12;
      updateZoomLabel(12);
      showToast("Quay về vị trí ban đầu", "🏠");
    }
  }

  // Cập nhật zoom slider khi bản đồ zoom
  function initZoomSync() {
    if (dashMap) {
      dashMap.on('zoomend', () => {
        const zoom = dashMap.getZoom();
        document.getElementById('zoomRange').value = zoom;
        updateZoomLabel(zoom);
      });
    }
  }

  function toggleMeasurePanel() {
    showToast("Công cụ đo lường đang được phát triển", "📏");
  }

  // ==================== BASEMAP GALLERY ====================
  function toggleBasemapGallery() {
    const gallery = document.getElementById('basemapGallery');
    gallery.classList.toggle('show');
  }

  function changeBasemap(type, element) {
    // Xóa basemap hiện tại khỏi map
    if (basemapLayers[currentBasemap] && dashMap.hasLayer(basemapLayers[currentBasemap])) {
      dashMap.removeLayer(basemapLayers[currentBasemap]);
    }

    // Thêm basemap mới
    if (basemapLayers[type]) {
      basemapLayers[type].addTo(dashMap);
      basemapLayers[type].bringToBack();
      currentBasemap = type;

      // Cập nhật UI
      document.querySelectorAll('.basemap-item').forEach(item => {
        item.classList.remove('active');
      });
      element.classList.add('active');

      // Đảm bảo layers dữ liệu nằm trên basemap
      if (backgroundLayer && dashMap.hasLayer(backgroundLayer)) {
        backgroundLayer.bringToBack();
      }
      if (thematicLayer && dashMap.hasLayer(thematicLayer)) {
        thematicLayer.bringToFront();
      }

      showToast(`Đã chuyển sang bản đồ ${element.querySelector('.basemap-name').textContent}`, "🗺️");
    }
  }

  // ==================== LAYER LIST ====================
  function toggleLayerList() {
    const layerList = document.getElementById('layerList');
    layerList.classList.toggle('show');
  }

  function toggleLayer(layerName, element) {
    layerVisibility[layerName] = !layerVisibility[layerName];
    element.classList.toggle('checked');

    if (layerName === 'boundary') {
      if (layerVisibility[layerName]) {
        if (boundaryOuterLayer) dashMap.addLayer(boundaryOuterLayer);
        if (backgroundLayer) dashMap.addLayer(backgroundLayer);
      } else {
        if (boundaryOuterLayer) dashMap.removeLayer(boundaryOuterLayer);
        if (backgroundLayer) dashMap.removeLayer(backgroundLayer);
      }
      showToast(layerVisibility[layerName] ? "Hiển thị ranh giới" : "Ẩn ranh giới", "👁️");
    } else if (layerName === 'loCay') {
      if (layerVisibility[layerName]) {
        if (thematicLayer) dashMap.addLayer(thematicLayer);
      } else {
        if (thematicLayer) dashMap.removeLayer(thematicLayer);
      }
      showToast(layerVisibility[layerName] ? "Hiển thị lô cây" : "Ẩn lô cây", "👁️");
    }
  }

  function updateLayerOpacity(layerName, value) {
    const opacity = value / 100;
    if (layerName === 'loCay' && thematicLayer) {
      thematicLayer.eachLayer(layer => {
        if (layer.setStyle) {
          layer.setStyle({ fillOpacity: opacity * 0.7 });
        }
      });
    }
  }

  // ==================== SEARCH ====================
  function performSearch(query) {
    if (!query.trim()) {
      document.getElementById('searchResults').classList.remove('show');
      return;
    }

    const queryLower = query.toLowerCase();
    const results = searchData.filter(item => 
      item.name.toLowerCase().includes(queryLower) ||
      item.doi?.toLowerCase().includes(queryLower) ||
      item.giong?.toLowerCase().includes(queryLower) ||
      item.nam_trong?.toString().includes(query) ||
      item.id.toString().includes(query)
    ).slice(0, 8);

    const resultsDiv = document.getElementById('searchResults');
    if (results.length === 0) {
      resultsDiv.innerHTML = '<div class="search-no-result">Không tìm thấy kết quả</div>';
    } else {
      resultsDiv.innerHTML = results.map((item, idx) => `
        <div class="search-result-item" onclick="selectSearchResult(${idx}, ${JSON.stringify(item).replace(/"/g, '&quot;')})">
          <div class="search-result-title">📍 ${item.name}</div>
          <div class="search-result-desc">
            ${item.doi ? `Đội: ${item.doi}` : ''} 
            ${item.giong ? `| Giống: ${item.giong}` : ''} 
            ${item.nam_trong ? `| Năm: ${item.nam_trong}` : ''}
          </div>
        </div>
      `).join('');
    }
    resultsDiv.classList.add('show');
  }

  function selectSearchResult(idx, item) {
    const itemObj = JSON.parse(JSON.stringify(item));
    clearSearchInput();
    
    // Zoom to feature
    if (itemObj.geometry) {
      const geoJSON = L.geoJSON({
        type: 'Feature',
        geometry: itemObj.geometry
      });
      const bounds = geoJSON.getBounds();
      dashMap.fitBounds(bounds, { padding: [50, 50], maxZoom: 15 });
    }

    showToast(`Đã chọn lô ${itemObj.id}`, "✅");
  }

  function clearSearchInput() {
    document.getElementById('searchInput').value = '';
    document.getElementById('searchResults').classList.remove('show');
  }

  function clearSearch() {
    document.getElementById('searchResults').classList.remove('show');
  }

  // ==================== KHỞI CHẠY ====================
  window.addEventListener('load', initDashMap);
</script>

