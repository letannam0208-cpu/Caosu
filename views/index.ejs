    <div class="lo-popup-btn" onclick="editLot('${p.id_lo}')">Sửa</div>
  </div>
`,
              { maxWidth: 320 },
            );

            layer.on("mouseover", () =>
              layer.setStyle({ fillOpacity: 0.7, weight: 2 }),
            );
            layer.on("mouseout", () => {
              if (!selectedIdx.has(idx))
                layer.setStyle({ fillOpacity: 0.52, weight: 1 });
            });
            layer.on("click", (e) => {
              if (currentTool === "pointer") {
                selectedIdx.has(idx)
                  ? selectedIdx.delete(idx)
                  : selectedIdx.add(idx);
                updateSelBar();
                renderRealLots();
                L.DomEvent.stopPropagation(e);
              }
            });
          }

          layer.addTo(dashMap);
          lotLayers.push({ layer, p, idx });
          count++;
        }

        if (labelsVis && p.ten_lo) {
          const z = dashMap.getZoom();
          if (z > 13) {
            const fs = Math.max(2, (z - 3) * 0.75);
            if (fs > 0) {
              let center;
              try {
                const insidePoint = turf.pointOnFeature(feat);
                center = [insidePoint.geometry.coordinates[1], insidePoint.geometry.coordinates[0]];
              } catch(e) {
                // fallback nếu lỗi
                try {
                  const centroid = turf.centroid(feat.geometry);
                  center = [centroid.geometry.coordinates[1], centroid.geometry.coordinates[0]];
                } catch(e2) {
                  center = L.geoJSON(feat).getBounds().getCenter();
                }
              }
              const col = getLotColorReal(p, mapViewMode);
              const cleanName = p.ten_lo.replace(/\s*-\s*KV\s*\d+\s*$/i, "");
              const namCuoi = p.nam_trong ? String(p.nam_trong).slice(-2) : "";
              const line1 = namCuoi ? `${cleanName} - ${namCuoi}` : cleanName;
              const html = `<div style="background:transparent; color:#fff; font-size:${fs}px; padding:${Math.max(2, fs * 0.4)}px ${Math.max(4, fs * 0.7)}px; border-radius:4px; border-left:${Math.max(2, fs * 0.25)}px solid ${col}; white-space:nowrap; pointer-events:none; font-family:'Inter', sans-serif; line-height:1.6; font-weight:700; text-shadow:0 1px 3px rgba(0,0,0,0.5); transform:scale(${z / 16}); transform-origin:top left; text-align:center;"><strong style="display:block">${line1}</strong>${p.giong ? `<span style="display:block; margin-top:2px">${p.giong}</span>` : ""}</div>`;
              const lbl = L.marker(center, {
                icon: L.divIcon({ html, className: "", iconAnchor: [0, 0] }),
              }).addTo(dashMap);
              labelLayers.push(lbl);
            }
          }
        }
      });

      renderMapLegend();
      document.getElementById("selCountTop").textContent = count
        ? `${count} lô hiển thị`
        : "Không có lô nào";
      console.log(
        `Đã render ${count} lô (tổng số feature: ${caosuFeatures.length})`,
      );
    }

    function renderMapLegend() {
      const leg = document.getElementById("mapLegend");
      if (!leg) return;
      let entries, title;
      if (mapViewMode === "giong") {
        entries = Object.entries(giongPalette);
        title = "Giống cây";
      } else if (mapViewMode === "nam") {
        entries = Object.entries(namPalette);
        title = "Năm trồng";
      } else if (mapViewMode === "nt") {
        entries = Object.entries(ntPalette).map(([k, v]) => [
          k === "1" ? "Đội 1" : k === "2" ? "Đội 2" : k === "3" ? "Đội 3" : k, v
        ]);
        title = "Đội";
      } else if (mapViewMode === "khu_vuc") {
        entries = Object.entries(khuVucPalette);
        title = "Khu vực";
      } else if (mapViewMode === "phien_cao") {
        entries = Object.entries(phienCaoPalette);
        title = "Phiên cạo";
      } else if (mapViewMode === "nhiet_do_cao") {
        entries = Object.entries(nhipDoCaoPalette);
        title = "Nhịp độ cạo";
      } else if (mapViewMode === "quy_hoach_tai_canh") {
        entries = Object.entries(taiCanhPalette);
        title = "QH tái canh";
      } else {
        entries = [];
        title = "";
      }

      if (!entries.length) {
        leg.classList.remove("show");
        return;
      }
      leg.classList.add("show");
      leg.innerHTML =
        `<div class="map-leg-title">${title}</div>` +
        entries.map(([k, v]) =>
          `<div class="map-leg-item"><div class="map-leg-dot" style="background:${v}"></div><span>${k}</span></div>`
        ).join("");
    }

    function updateSelBar() {
      const n = selectedIdx.size;
      document.getElementById("selBarText").textContent = `Đã chọn: ${n} lô`;
      document.getElementById("selCountTop").textContent = n
        ? `${n} lô đã chọn`
        : `${lotLayers.length} lô hiển thị`;
      document.getElementById("mapSelBar").classList.toggle("show", n > 0);

      let totalArea = 0;
      selectedIdx.forEach(idx => {
        const p = caosuFeatures[idx]?.properties;
        totalArea += parseFloat(p?.dien_tich_map) || 0;
      });
      const areaEl = document.getElementById("selBarArea");
      const areaValEl = document.getElementById("selBarAreaVal");
      if (areaEl && areaValEl) {
        if (n > 0) {
          areaValEl.textContent = totalArea.toFixed(2);
          areaEl.style.display = "block";
        } else {
          areaEl.style.display = "none";
        }
      }

