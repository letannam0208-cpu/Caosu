  };

  // ==================== TẢI DỮ LIỆU CHO DROPDOWN ====================
  async function loadLoOptions(selectId) {
    try {
      const res = await fetch('/api/lo-cay');
      const data = await res.json();
      if(data.success && data.data) {
        const select = document.getElementById(selectId);
        if(select) {
          select.innerHTML = '<option value="">-- Chọn lô --</option>';
          data.data.forEach(lo => {
            const opt = document.createElement('option');
            opt.value = lo.id_lo;
            opt.textContent = `${lo.ten_lo || lo.id_lo} (${lo.id_lo})`;
            select.appendChild(opt);
          });
        }
      }
    } catch(e) {
      console.error('Lỗi tải lô:', e);
    }
  }

  async function loadDonViOptions(selectId) {
    try {
      const res = await fetch('/api/don-vi');
      const data = await res.json();
      if(data.success && data.data) {
        const select = document.getElementById(selectId);
        if(select) {
          select.innerHTML = '<option value="">-- Chọn đơn vị --</option>';
          data.data.forEach(dv => {
            const opt = document.createElement('option');
            opt.value = dv.id_don_vi;
            opt.textContent = `${dv.doi || dv.du_an || dv.id_don_vi} (${dv.id_don_vi})`;
            select.appendChild(opt);
          });
        }
      }
    } catch(e) {
      console.error('Lỗi tải đơn vị:', e);
    }
  }

  async function loadHanhChinhOptions(selectId) {
    try {
      const res = await fetch('/api/hanh-chinh');
      const data = await res.json();
      if(data.success && data.data) {
        const select = document.getElementById(selectId);
        if(select) {
          select.innerHTML = '<option value="">-- Chọn hành chính --</option>';
          data.data.forEach(hc => {
            const opt = document.createElement('option');
            opt.value = hc.id_hc;
            opt.textContent = `${hc.xa || ''}, ${hc.huyen || ''} (${hc.id_hc})`;
            select.appendChild(opt);
          });
        }
      }
    } catch(e) {
      console.error('Lỗi tải hành chính:', e);
    }
  }

  function renderForm(table) {
    const container = document.getElementById('dynamicForm');
    container.innerHTML = forms[table] || '<p>Không có form cho bảng này</p>';
    if(table === 'lo') {
      loadDonViOptions('lo_donvi');
      loadHanhChinhOptions('lo_hc');
    } else if(['dien_tich', 'hien_trang_cay', 'khai_thac', 'san_luong', 'thong_tin_trong'].includes(table)) {
      const prefix = table === 'dien_tich' ? 'dt' : (table === 'hien_trang_cay' ? 'ht' : (table === 'khai_thac' ? 'kt' : (table === 'san_luong' ? 'sl' : 'tt')));
      loadLoOptions(`${prefix}_lolo`);
    }
  }

  // ==================== XỬ LÝ NHẬP FILE VỚI DROPDOWN 8 BẢNG ====================
  const uploadZone = document.getElementById('uploadZone');
  const fileInput = document.getElementById('fileInput');
  let uploadedData = null;
  let currentUploadTable = 'lo';

  uploadZone.addEventListener('click', () => fileInput.click());
  uploadZone.addEventListener('dragover', (e) => { e.preventDefault(); uploadZone.style.borderColor = 'var(--accent)'; });
  uploadZone.addEventListener('dragleave', () => uploadZone.style.borderColor = 'var(--border2)');
  uploadZone.addEventListener('drop', (e) => {
    e.preventDefault();
    uploadZone.style.borderColor = 'var(--border2)';
    const file = e.dataTransfer.files[0];
    if(file) handleFile(file);
  });
  fileInput.addEventListener('change', (e) => {
    if(e.target.files.length) handleFile(e.target.files[0]);
  });

  // Cập nhật mode badge khi chọn radio
  document.querySelectorAll('input[name="importMode"]').forEach(radio => {
    radio.addEventListener('change', (e) => {
      const badge = document.getElementById('currentModeBadge');
      if(e.target.value === 'upsert') {
        badge.textContent = 'UPSERT (Khuyến nghị)';
        badge.className = 'mode-badge mode-upsert';
      } else {
        badge.textContent = 'INSERT (Chỉ thêm mới)';
        badge.className = 'mode-badge mode-insert';
      }
    });
  });

  // Theo dõi thay đổi bảng được chọn
  document.getElementById('uploadTableSelect').addEventListener('change', (e) => {
    currentUploadTable = e.target.value;
    // Reset preview khi đổi bảng
    uploadedData = null;
    document.getElementById('previewArea').style.display = 'none';
  });

  function handleFile(file) {
    const reader = new FileReader();
    reader.onload = function(e) {
      const data = new Uint8Array(e.target.result);
      const workbook = XLSX.read(data, { type: 'array' });
      const sheet = workbook.Sheets[workbook.SheetNames[0]];
      const json = XLSX.utils.sheet_to_json(sheet);
      uploadedData = { table: currentUploadTable, data: json };
      showPreview(json);
      addLog(`📁 Đã tải file: ${file.name} - Bảng: ${getTableName(currentUploadTable)} - Số dòng: ${json.length}`, 'info');
    };
    reader.readAsArrayBuffer(file);
  }

  function getTableName(tableValue) {
    const names = {
      lo: 'Lô cây', don_vi: 'Đơn vị', hanh_chinh: 'Hành chính',
      dien_tich: 'Diện tích', hien_trang_cay: 'Hiện trạng cây',
      khai_thac: 'Khai thác', san_luong: 'Sản lượng', thong_tin_trong: 'Thông tin trồng'
    };
    return names[tableValue] || tableValue;
  }

  function showPreview(data) {
    const previewDiv = document.getElementById('previewArea');
    const previewTable = document.getElementById('previewTable');
    if(!data || data.length === 0) {
      previewDiv.style.display = 'none';
      return;
    }
    if(data.length > 200) {
      addLog(`⚠️ File có ${data.length} dòng, chỉ hiển thị 200 dòng đầu`, 'info');
    }
    const headers = Object.keys(data[0]);
    let html = '<div style="margin-bottom:8px; color:var(--accent);">📊 ' + data.length + ' dòng dữ liệu</div>';
    html += '<table><thead><tr>';
    headers.forEach(h => html += `<th>${h}</th>`);
    html += '</tr></thead><tbody>';
    const displayData = data.slice(0, 200);
    displayData.forEach(row => {
      html += '<tr>';
      headers.forEach(h => html += `<td>${row[h] !== undefined && row[h] !== null ? row[h] : ''}</td>`);
      html += '</tr>';
    });
    if(data.length > 200) {
      html += `<tr><td colspan="${headers.length}" style="text-align:center; color:var(--muted);">... và ${data.length - 200} dòng khác</td></tr>`;
    }
    html += '</tbody></table>';
    previewTable.innerHTML = html;
    previewDiv.style.display = 'block';
  }

  document.getElementById('clearPreview')?.addEventListener('click', () => {
    uploadedData = null;
    document.getElementById('previewArea').style.display = 'none';
    fileInput.value = '';
    clearLog();
    document.getElementById('importLog').style.display = 'none';
  });

  // Xử lý UPSERT cho từng bảng
  async function upsertData(table, row) {
    const importMode = document.querySelector('input[name="importMode"]:checked').value;
    let url = '';
    let data = { ...row };
    
    // Xác định URL và xử lý ID
    switch(table) {
      case 'lo':
        url = '/api/lo-cay/upsert';
        if(!data.id_lo && data.ten_lo) data.id_lo = 'LO_' + Date.now();
        break;
      case 'don_vi':
        url = '/api/don-vi/upsert';
        if(!data.id_don_vi) data.id_don_vi = 'DV_' + Date.now();
        break;
      case 'hanh_chinh':
        url = '/api/hanh-chinh/upsert';
        if(!data.id_hc) data.id_hc = 'HC_' + Date.now();
        break;
      case 'dien_tich':
        url = '/api/dien-tich/upsert';
        if(!data.id_dien_tich && data.id_lo) data.id_dien_tich = 'DT_' + data.id_lo;
        break;
      case 'hien_trang_cay':
        url = '/api/hien-trang-cay/upsert';
        if(!data.id_htc && data.id_lo) data.id_htc = 'HTC_' + data.id_lo;
        break;
      case 'khai_thac':
        url = '/api/khai-thac/upsert';
        if(!data.id_kt && data.id_lo) data.id_kt = 'KT_' + data.id_lo;
        break;
      case 'san_luong':
        url = '/api/san-luong/upsert';
        if(!data.id_sl && data.id_lo) data.id_sl = 'SL_' + data.id_lo;
        break;
      case 'thong_tin_trong':
        url = '/api/thong-tin-trong/upsert';
        if(!data.id_ttt && data.id_lo) data.id_ttt = 'TTT_' + data.id_lo;
        break;
      default:
        throw new Error('Bảng không hợp lệ');
    }
    
    // Thêm mode vào headers
    const res = await fetch(url, {
      method: 'POST',
      headers: { 
        'Content-Type': 'application/json',
        'X-Import-Mode': importMode
      },
      body: JSON.stringify(data)
    });
    const result = await res.json();
    return result;
  }

  // Xử lý submit batch
  document.getElementById('submitBatch').addEventListener('click', async () => {
    if(!uploadedData || !uploadedData.data || uploadedData.data.length === 0) {
      alert('Không có dữ liệu để nhập');
      return;
    }
    
    const importMode = document.querySelector('input[name="importMode"]:checked').value;
    const modeText = importMode === 'upsert' ? 'UPSERT (Cập nhật nếu có, thêm nếu chưa)' : 'INSERT (Chỉ thêm mới)';
    const tableName = getTableName(uploadedData.table);
    const totalRecords = uploadedData.data.length;
    
    const confirmMsg = `📊 XÁC NHẬN NHẬP DỮ LIỆU\n\n` +
      `• Bảng: ${tableName}\n` +
      `• Số dòng: ${totalRecords}\n` +
      `• Chế độ: ${modeText}\n` +
      `• Dữ liệu cũ sẽ được GIỮ NGUYÊN (không bị xóa)\n\n` +
      `Bạn có chắc chắn muốn tiếp tục?`;
    
    if(!confirm(confirmMsg)) return;
    
    clearLog();
    addLog(`🚀 BẮT ĐẦU NHẬP LIỆU - Bảng: ${tableName} - Chế độ: ${modeText}`, 'info');
    addLog(`📊 Tổng số dòng cần xử lý: ${totalRecords}`, 'info');
    
    let success = 0, fail = 0, update = 0, insert = 0;
    const statusDiv = document.getElementById('batchStatus');
    statusDiv.innerHTML = '<i class="fas fa-spinner fa-pulse"></i> Đang xử lý...';
    
    for(let i = 0; i < uploadedData.data.length; i++) {
      const row = uploadedData.data[i];
      try {
        const result = await upsertData(uploadedData.table, row);
        if(result.success) {
          success++;
          if(result.action === 'update') {
            update++;
            addLog(`🔄 [Dòng ${i+1}] CẬP NHẬT: ${result.message || 'Thành công'}`, 'update');
          } else if(result.action === 'insert') {
            insert++;
            addLog(`✨ [Dòng ${i+1}] THÊM MỚI: ${result.message || 'Thành công'}`, 'insert');
          } else {
            addLog(`✅ [Dòng ${i+1}] Thành công: ${result.message}`, 'insert');
          }
        } else {
          fail++;
          addLog(`❌ [Dòng ${i+1}] LỖI: ${result.error || 'Không xác định'}`, 'error');
        }
      } catch(err) {
        fail++;
        addLog(`❌ [Dòng ${i+1}] LỖI KẾT NỐI: ${err.message}`, 'error');
      }
    }
    
    statusDiv.innerHTML = `
      <div style="display:flex; gap:16px; flex-wrap:wrap;">
        <span style="color:var(--accent)">✅ Thành công: ${success}</span>
        ${update > 0 ? `<span style="color:var(--warn)">🔄 Cập nhật: ${update}</span>` : ''}
        ${insert > 0 ? `<span style="color:var(--accentB)">✨ Thêm mới: ${insert}</span>` : ''}
        <span style="color:var(--danger)">❌ Thất bại: ${fail}</span>
      </div>
    `;
    
    addLog(`🏁 KẾT THÚC NHẬP LIỆU - Thành công: ${success}, Cập nhật: ${update}, Thêm mới: ${insert}, Thất bại: ${fail}`, 'info');
    addLog(`💾 Dữ liệu cũ được giữ nguyên, chỉ cập nhật/thêm mới theo yêu cầu`, 'info');
    
    updateStats();
    
    // Reset preview
    uploadedData = null;
    document.getElementById('previewArea').style.display = 'none';
    fileInput.value = '';
  });

  // Tải file mẫu theo bảng đã chọn
  document.getElementById('downloadSample').addEventListener('click', () => {
    const table = document.getElementById('uploadTableSelect').value;
    let sampleData = [];
    
    switch(table) {
      case 'lo':
        sampleData = [{ id_lo: 'LO001', ten_lo: 'Lô A', nam_trong: 2020, giong: 'PB 260', cao_trinh_tb: 12.5 }];
        break;
      case 'don_vi':
        sampleData = [{ id_don_vi: 'DV001', du_an: 'Dự án A', doi: 'Đội 1', khu_vuc: 'Khu vực 1' }];
        break;
      case 'hanh_chinh':
        sampleData = [{ id_hc: 'HC001', xa: 'Xã A', huyen: 'Huyện B', tinh: 'Tỉnh C' }];
        break;
      case 'dien_tich':
        sampleData = [{ id_lo: 'LO001', id_dien_tich: 'DT_LO001', dien_tich_map: 10.5, dien_tich_010125: 10.5, dien_tich_010126: 10.5 }];
        break;
      case 'hien_trang_cay':
        sampleData = [{ id_lo: 'LO001', id_htc: 'HTC_LO001', tong_ho_kk: 150, cay_cao: 120, cay_chua_cao: 25, mat_do_cc: 450 }];
        break;
      case 'khai_thac':
        sampleData = [{ id_lo: 'LO001', id_kt: 'KT_LO001', che_do_cao: 'S/2', phien_cao: '1', nhip_do_cao: '3 ngày', nam_mc: 2023 }];
        break;
      case 'san_luong':
        sampleData = [{ id_lo: 'LO001', id_sl: 'SL_LO001', ns25_kg_ha: 1800, ns26_kg_ha: 1850, san_luong: 18.5 }];
        break;
      case 'thong_tin_trong':
        sampleData = [{ id_lo: 'LO001', id_ttt: 'TTT_LO001', hang_dat: 'Đất đỏ', phuong_phap_trong: 'Hàng kép', khoang_cach_trong: '3x6' }];
        break;
    }
    
    const ws = XLSX.utils.json_to_sheet(sampleData);
    const wb = XLSX.utils.book_new();
    XLSX.utils.book_append_sheet(wb, ws, getTableName(table));
    XLSX.writeFile(wb, `mau_nhap_${table}.xlsx`);
    addLog(`📥 Đã tải file mẫu cho bảng ${getTableName(table)}`, 'info');
  });

  // ==================== CÁC HÀM KHÁC ====================
  async function submitDynamicForm() {
    const table = document.getElementById('tableSelect').value;
    const form = document.getElementById('dynamicForm');
    const inputs = form.querySelectorAll('input, select, textarea');
    const data = {};
    inputs.forEach(input => {
      if(input.name && input.value) data[input.name] = input.value;
    });
    
    let url = '';
    switch(table) {
      case 'lo': url = '/api/lo-cay/upsert'; break;
      case 'don_vi': url = '/api/don-vi/upsert'; break;
      case 'hanh_chinh': url = '/api/hanh-chinh/upsert'; break;
      case 'dien_tich': url = '/api/dien-tich/upsert'; break;
      case 'hien_trang_cay': url = '/api/hien-trang-cay/upsert'; break;
      case 'khai_thac': url = '/api/khai-thac/upsert'; break;
      case 'san_luong': url = '/api/san-luong/upsert'; break;
      case 'thong_tin_trong': url = '/api/thong-tin-trong/upsert'; break;
      default: alert('Bảng không hợp lệ'); return;
    }
    
    try {
      const res = await fetch(url, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'X-Import-Mode': 'upsert' },
        body: JSON.stringify(data)
      });
      const result = await res.json();
      if(result.success) {
        const actionMsg = result.action === 'update' ? 'cập nhật' : 'thêm mới';
        alert(`✅ ${result.action === 'update' ? 'Cập nhật' : 'Thêm mới'} thành công vào bảng ${table}`);
        renderForm(table);
        if(table === 'lo') updateStats();
      } else {
        alert(`❌ Lỗi: ${result.error}`);
      }
    } catch(err) {
      alert('Lỗi kết nối: ' + err.message);
    }
  }

  async function updateStats() {
    try {
      const res = await fetch('/api/lo-cay');
      const data = await res.json();
      if(data.success) {
        const totalLots = data.data.length;
        const totalArea = data.data.reduce((s, l) => s + (parseFloat(l.dien_tich_map) || 0), 0);
        document.getElementById('totalLots').innerText = totalLots;
        document.getElementById('totalArea').innerText = totalArea.toFixed(3) + ' ha';
      }
    } catch(e) {}
  }

  // ==================== KHỞI TẠO ====================
  document.getElementById('tableSelect').addEventListener('change', (e) => renderForm(e.target.value));
  document.getElementById('submitDynamic').addEventListener('click', submitDynamicForm);
  document.getElementById('resetDynamic').addEventListener('click', () => renderForm(document.getElementById('tableSelect').value));
  
  document.querySelectorAll('.tab-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const tabId = btn.dataset.tab;
      document.querySelectorAll('.tab-content').forEach(tab => tab.classList.remove('active'));
      document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
      document.getElementById(`tab-${tabId}`).classList.add('active');
      btn.classList.add('active');
    });
  });
  
  renderForm('lo');
  updateStats();
</script>
</body>
</html>