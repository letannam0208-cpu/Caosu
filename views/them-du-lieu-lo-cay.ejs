      <div class="form-row"><div class="form-group"><label>Tổng lát cạo</label><input type="number" step="0.01" name="tong_lat_cao"></div><div class="form-group"><label>Sản lượng</label><input type="number" step="0.01" name="san_luong"></div></div>
      <div class="form-row"><div class="form-group"><label>Phân loại</label><input type="text" name="phan_loai"></div><div class="form-group"><label>Đối tượng</label><input type="text" name="doi_tuong"></div></div>
