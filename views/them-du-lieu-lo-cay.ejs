    thong_tin_trong: `
      <div class="form-row"><div class="form-group"><label>ID lô *</label><select name="id_lo" id="tt_lolo"></select></div><div class="form-group"><label>ID thông tin trồng *</label><input type="text" name="id_ttt" required placeholder="VD: TTT_LO001"></div></div>
      <div class="form-row"><div class="form-group"><label>Hạng đất</label><input type="text" name="hang_dat"></div><div class="form-group"><label>Phương pháp trồng</label><input type="text" name="phuong_phap_trong"></div></div>
      <div class="form-row"><div class="form-group"><label>Khoảng cách trồng</label><input type="text" name="khoang_cach_trong"></div><div class="form-group"><label>Mật độ TK</label><input type="number" name="mat_do_tk"></div></div>
