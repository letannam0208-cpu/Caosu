<!DOCTYPE html>
<html lang="vi">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>GIS · TBKRUCO</title>
  <link rel="icon" href="/assets/image/logoTBK.jpg" type="image/jpeg" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,300;14..32,400;14..32,500;14..32,600;14..32,700;14..32,800&display=swap"
    rel="stylesheet" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  <script src="https://cdn.sheetjs.com/xlsx-0.20.2/package/dist/xlsx.full.min.js"></script>
  <link href="/assets/css/style.css" rel="stylesheet" />
  <style>
    .grid-2 {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 16px;
      margin-bottom: 20px;
    }

    .grid-full {
      grid-column: 1/-1;
      margin-top: 16px;
    }

    .card {
      background: var(--s1);
      border: 1px solid var(--border);
      border-radius: var(--r-lg);
      padding: 16px;
      transition: 0.2s;
    }

    .card:hover {
      border-color: var(--border2);
    }

    .card-title {
      font-family: var(--font);
      font-size: 14px;
      font-weight: 700;
      color: var(--text);
      margin-bottom: 16px;
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .chart-box-lg {
      height: 380px;
      position: relative;
    }

    .loader {
      text-align: center;
      padding: 40px;
      color: var(--muted2);
    }

    @media (max-width: 768px) {
      #nav {
        width: 160px;
        padding: 10px 6px;
      }

      #content {
        padding: 12px;
      }

      .page-title {
        font-size: 18px;
      }

      .grid-2 {
        grid-template-columns: 1fr;
      }

      .chart-box-lg {
        height: 280px;
      }
    }
  </style>
</head>

<body>
  <div id="topbar">
    <div class="tb-logo">
      <div class="">
        <img src="/assets/image/logoTBK.jpg" alt="Logo" />
      </div>
      <div>
        <div class="tb-title">GIS TBKRUCO</div>
      </div>
    </div>
    <div class="tb-sep"></div>
    <div class="tb-pill">
      <span class="live-dot"></span><span>Trực tuyến</span>
    </div>
    <div class="tb-pill">
      <span>Số lô</span> <strong id="totalLots">0</strong>
    </div>
    <div class="tb-pill">
      <span>Diện tích</span> <strong id="totalArea">0 ha</strong>
    </div>
    <div class="tb-right">
      <div style="display: flex; align-items: center; gap: 8px">
        <div class="tb-user-info">
          <div class="tb-user-name" id="userFullName">Nguyễn Văn An</div>
          <div class="tb-user-role" id="userRole">Quản trị viên</div>
        </div>
        <div class="tb-avatar" id="userAvatar">NA</div>
      </div>
    </div>
  </div>

  <div id="body">
    <nav id="nav">
      <div class="nav-section-label">Tổng quan</div>
      <a href="/" class="nav-item"><i class="fas fa-home nav-icon"></i>Dashboard</a>
      <div class="nav-section-label">Quản lý dữ liệu</div>
      <a href="/quan-ly-lo-cay" class="nav-item"><i class="fas fa-tree nav-icon"></i>Quản lý lô</a>
      <!-- Chỉ admin -->
      <% if (user && user.role === 'admin') { %>
      <a href="/them-du-lieu-lo-cay" class="nav-item"><i class="fas fa-plus-circle nav-icon"></i>Thêm dữ liệu lô</a>
      <div class="nav-section-label">Người dùng</div>
      <a href="/quan-ly-nguoi-dung" class="nav-item"><i class="fas fa-users nav-icon"></i>Quản lý người dùng</a>
      <% } %>
      <div class="nav-section-label">Phân tích</div>
      <a href="/thong-ke" class="nav-item active"><i class="fas fa-chart-bar nav-icon"></i>Thống kê</a>
      <div class="nav-logout">
        <a href="/logout" class="nav-item"><i class="fas fa-sign-out-alt nav-icon"></i>Đăng xuất</a>
      </div>
    </nav>

    <div id="content">
      <div class="page-header">
        <div class="page-title-group">
          <div class="page-title">Thống Kê</div>
          <div class="page-subtitle">Phân tích tổng hợp vườn cây cao su</div>
        </div>
        <!-- Nút xuất Excel có thể giữ cho cả admin và staff -->
        <!-- <button class="btn-export" id="exportExcel">
            <i class="fas fa-download"></i> Xuất Excel
          </button> -->
      </div>

      <!-- 3 biểu đồ chính (hiển thị cho tất cả) -->
      <div class="grid-2">
        <div class="card">
          <div class="card-title">🌱 Cơ cấu giống</div>
          <div class="chart-box-lg"><canvas id="chartGiongPie"></canvas></div>
        </div>
        <div class="card">
          <div class="card-title">🏭 Diện tích theo đội</div>
          <div class="chart-box-lg">
            <canvas id="chartDienTichDoi"></canvas>
          </div>
        </div>
      </div>
      <div class="grid-full">
        <div class="card">
          <div class="card-title">
            📈 Năng suất bình quân theo giống (kg/ha) - Năm 2025
          </div>
          <div class="chart-box-lg"><canvas id="chartNangSuat"></canvas></div>
        </div>
      </div>
      <div class="grid-full">
        <div class="card">
          <div class="card-title" style="justify-content: space-between">
            <span>📊 Năng suất theo tuổi cạo (kg/ha)</span>
            <select id="giongFilter" class="form-select" style="
                  width: auto;
                  background: var(--s2);
                  border: 1px solid var(--border);
                  color: var(--text);
                ">
              <option value="all">Tất cả giống</option>
            </select>
          </div>
          <div class="chart-box-lg"><canvas id="chartTuoiCao"></canvas></div>
        </div>
      </div>
      <div class="grid-full">
        <div class="card">
          <div class="card-title">
            📅 Diện tích quy hoạch tái canh theo năm
          </div>
          <div class="chart-box-lg"><canvas id="chartTaiCanh"></canvas></div>
        </div>
      </div>
    </div>
  </div>

  <script>
    // ====================== PHÂN QUYỀN ======================
    window.userRole = '<%= user ? user.role : "" %>';

    // ====================== LẤY DỮ LIỆU TỪ API ======================
    let loData = []; // bảng lo duy nhất (đã gộp tất cả)

    async function fetchData() {
      try {
        const loRes = await fetch("/api/lo-cay");
        const loJson = await loRes.json();
        loData = loJson.data || [];
        // Cập nhật thông tin tổng quan trên topbar
        const totalLots = loData.length;
        const totalArea = loData.reduce(
          (sum, lo) => sum + (parseFloat(lo.dien_tich_map) || 0),
          0,
        );
        document.getElementById("totalLots").innerText =
          totalLots.toLocaleString("vi-VN");
        document.getElementById("totalArea").innerHTML =
          totalArea.toLocaleString("vi-VN", {
            minimumFractionDigits: 2,
            maximumFractionDigits: 2,
          }) + " ha";

        console.log(`✅ Đã tải: ${loData.length} lô`);
        return true;
      } catch (err) {
        console.error("❌ Lỗi tải dữ liệu:", err);
        document.querySelectorAll(".card").forEach((card) => {
          card.innerHTML = `<div class="loader"><i class="fas fa-exclamation-triangle"></i> Lỗi tải dữ liệu: ${err.message}</div>`;
        });
        return false;
      }
    }

    // Helper: lấy diện tích từ lô (ưu tiên dien_tich_map)
    function getArea(lo) {
      return parseFloat(lo.dien_tich_map) || 0;
    }

    // ====================== 1. BIỂU ĐỒ CỘT NGANG: CƠ CẤU GIỐNG ======================
    function renderGiongPie() {
      const giongMap = new Map();
      loData.forEach((lo) => {
        const giong = lo.giong || "Khác";
        const area = getArea(lo);
        if (area > 0) {
          giongMap.set(giong, (giongMap.get(giong) || 0) + area);
        }
      });
      // Sort giảm dần theo diện tích (lớn nhất lên trên)
      const sorted = Array.from(giongMap.entries()).sort(
        (a, b) => b[1] - a[1],
      );
      const labels = sorted.map((item) => item[0]);
      const data = sorted.map((item) => item[1]);

      const ctx = document.getElementById("chartGiongPie").getContext("2d");
      if (window.giongChart) window.giongChart.destroy();
      window.giongChart = new Chart(ctx, {
        type: "bar",
        data: {
          labels: labels,
          datasets: [
            {
              label: "Diện tích (ha)",
              data: data,
              backgroundColor: [
                "#00d68f",
                "#00b4ff",
                "#f59e0b",
                "#a78bfa",
                "#f87171",
                "#64748b",
                "#22d3ee",
                "#34d399",
                "#fbbf24",
                "#c084fc",
              ],
              borderRadius: 6,
            },
          ],
        },
        options: {
          indexAxis: "y",
          responsive: true,
          maintainAspectRatio: false,
          plugins: {
            legend: { display: false },
            tooltip: {
              callbacks: {
                label: (ctx) => {
                  const total = data.reduce((a, b) => a + b, 0);
                  const percent = ((ctx.raw / total) * 100).toFixed(1);
                  return `${ctx.raw.toFixed(2)} ha (${percent}%)`;
                },
              },
            },
          },
          scales: {
            x: {
              title: {
                display: true,
                text: "Diện tích (ha)",
                color: "#8a9ab8",
              },
              ticks: { color: "#8a9ab8" },
            },
            y: {
              ticks: {
                color: "#e8eeff",
                font: { family: "Inter", size: 12 },
              },
            },
          },
        },
      });
    }

    // ====================== 2. BIỂU ĐỒ PIE: DIỆN TÍCH THEO ĐỘI ======================
    function renderDienTichDoi() {
      const teamArea = new Map();
      loData.forEach((lo) => {
        const doi = lo.doi || "Không xác định";
        const area = getArea(lo);
        if (area > 0) {
          teamArea.set(doi, (teamArea.get(doi) || 0) + area);
        }
      });
      // Sắp xếp tăng dần theo số đội (1, 2, 3...)
      const sorted = Array.from(teamArea.entries()).sort((a, b) => {
        const numA = parseInt(a[0].replace(/\D/g, "")) || 0;
        const numB = parseInt(b[0].replace(/\D/g, "")) || 0;
        return numA - numB;
      });
      const labels = sorted.map((item) => item[0]);
      const data = sorted.map((item) => item[1]);

      const ctx = document
        .getElementById("chartDienTichDoi")
        .getContext("2d");
      if (window.doiChart) window.doiChart.destroy();

      // Tính tổng để tính phần trăm
      const total = data.reduce((a, b) => a + b, 0);

      window.doiChart = new Chart(ctx, {
        type: "pie",
        data: {
          labels: labels,
          datasets: [
            {
              label: "Diện tích (ha)",
              data: data,
              backgroundColor: [
                "#00d68f",
                "#00b4ff",
                "#f59e0b",
                "#a78bfa",
                "#f87171",
                "#64748b",
                "#22d3ee",
                "#34d399",
                "#fbbf24",
                "#c084fc",
              ],
              borderWidth: 2,
              borderColor: "#1e293b",
            },
          ],
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: {
            legend: {
              position: "right",
              labels: {
                color: "#e8eeff",
                font: { family: "Inter", size: 12 },
                padding: 12,
                generateLabels: (chart) => {
                  const datasets = chart.data.datasets;
                  return chart.data.labels.map((label, i) => {
                    const value = datasets[0].data[i];
                    const percent = ((value / total) * 100).toFixed(1);
                    return {
                      text: `Đội ${label}: ${percent}%`,
                      fillStyle: datasets[0].backgroundColor[i],
                      strokeStyle: datasets[0].borderColor,
                      lineWidth: 2,
                      hidden: false,
                      index: i,
                      fontColor: "#f1f5f9",
                    };
                  });
                },
              },
            },
            tooltip: {
              callbacks: {
                label: (ctx) => {
                  const percent = ((ctx.raw / total) * 100).toFixed(1);
                  return `${ctx.raw.toFixed(2)} ha (${percent}%)`;
                },
              },
            },
          },
        },
      });
    }

    // ====================== 3. BIỂU ĐỒ CỘT: DIỆN TÍCH QH TÁI CANH THEO NĂM ======================
    function renderTaiCanh() {
      const yearArea = new Map();
      loData.forEach((lo) => {
        const year = lo.tai_canh_nam;
        if (!year) return;
        const area = getArea(lo);
        if (area > 0) {
          yearArea.set(year, (yearArea.get(year) || 0) + area);
        }
      });
      const sorted = Array.from(yearArea.entries()).sort(
        (a, b) => a[0] - b[0],
      );
      const labels = sorted.map((item) => item[0]);
      const data = sorted.map((item) => item[1]);

      const ctx = document.getElementById("chartTaiCanh").getContext("2d");
      if (window.taiCanhChart) window.taiCanhChart.destroy();
      window.taiCanhChart = new Chart(ctx, {
        type: "bar",
        data: {
          labels: labels,
          datasets: [
            {
              label: "Diện tích quy hoạch tái canh (ha)",
              data: data,
              backgroundColor: "#f59e0b",
              borderRadius: 6,
            },
          ],
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: {
            tooltip: {
              callbacks: { label: (ctx) => `${ctx.raw.toFixed(2)} ha` },
            },
          },
          scales: {
            y: {
              title: {
                display: true,
                text: "Diện tích (ha)",
                color: "#8a9ab8",
              },
              ticks: { color: "#8a9ab8" },
            },
            x: {
              title: {
                display: true,
                text: "Năm tái canh",
                color: "#8a9ab8",
              },
              ticks: { color: "#8a9ab8", font: { family: "Inter" } },
            },
          },
        },
      });
    }
    // ====================== 4. BIỂU ĐỒ LINE: NĂNG SUẤT BÌNH QUÂN THEO GIỐNG (kg/ha) ======================
    function renderNangSuat() {
      const giongNS = new Map();
      loData.forEach((lo) => {
        const giong = lo.giong || "Khác";
        const ns = parseFloat(lo.ns25_kg_ha) || 0;
        if (ns > 0) {
          // Lưu cả tổng năng suất và số lô để tính trung bình
          const current = giongNS.get(giong) || { total: 0, count: 0 };
          giongNS.set(giong, {
            total: current.total + ns,
            count: current.count + 1,
          });
        }
      });
      // Tính năng suất bình quân và sort giảm dần
      const avgData = Array.from(giongNS.entries()).map(([giong, data]) => ({
        giong,
        avg: data.total / data.count,
      }));
      const sorted = avgData.sort((a, b) => b.avg - a.avg);
      const labels = sorted.map((item) => item.giong);
      const data = sorted.map((item) => item.avg);

      const ctx = document.getElementById("chartNangSuat").getContext("2d");
      if (window.nangSuatChart) window.nangSuatChart.destroy();
      window.nangSuatChart = new Chart(ctx, {
        type: "line",
        data: {
          labels: labels,
          datasets: [
            {
              label: "Năng suất bình quân (kg/ha)",
              data: data,
              borderColor: "#00d68f",
              backgroundColor: "rgba(0, 214, 143, 0.1)",
              borderWidth: 3,
              fill: true,
              tension: 0.4,
              pointBackgroundColor: "#00d68f",
              pointBorderColor: "#fff",
              pointBorderWidth: 2,
              pointRadius: 5,
              pointHoverRadius: 7,
            },
          ],
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: {
            legend: { display: false },
            tooltip: {
              callbacks: {
                label: (ctx) => `Năng suất: ${ctx.raw.toFixed(2)} kg/ha`,
              },
            },
          },
          scales: {
            y: {
              title: {
                display: true,
                text: "Năng suất (kg/ha)",
                color: "#8a9ab8",
              },
              ticks: { color: "#8a9ab8" },
              beginAtZero: true,
            },
            x: {
              title: {
                display: true,
                text: "Giống cây",
                color: "#8a9ab8",
              },
              ticks: {
                color: "#e8eeff",
                font: { family: "Inter" },
                maxRotation: 45,
                minRotation: 45,
              },
            },
          },
        },
      });
    }

    // ====================== 5. BIỂU ĐỒ LINE: NĂNG SUẤT THEO TUỔI CẠO ======================
    function getGiongList() {
      const giongSet = new Set();
      loData.forEach((lo) => {
        if (lo.giong) giongSet.add(lo.giong);
      });
      return Array.from(giongSet).sort();
    }

    function renderTuoiCao(selectedGiong = "all") {
      // Lọc dữ liệu theo giống (nếu chọn)
      const filteredData =
        selectedGiong === "all"
          ? loData
          : loData.filter((lo) => lo.giong === selectedGiong);

      // Gom nhóm theo tuổi cạo và tính năng suất bình quân
      const tuoiCaoNS = new Map();
      filteredData.forEach((lo) => {
        const tuoiCao = lo.tuoi_cao;
        if (!tuoiCao) return;
        const ns = parseFloat(lo.ns25_kg_ha) || 0;
        if (ns > 0) {
          const current = tuoiCaoNS.get(tuoiCao) || { total: 0, count: 0 };
          tuoiCaoNS.set(tuoiCao, {
            total: current.total + ns,
            count: current.count + 1,
          });
        }
      });

      // Chuyển đổi và sort theo tuổi cạo tăng dần
      const avgData = Array.from(tuoiCaoNS.entries())
        .map(([tuoi, data]) => ({
          tuoiCao: tuoi,
          avg: data.total / data.count,
        }))
        .sort((a, b) => {
          const aNum = parseInt(a.tuoiCao) || 0;
          const bNum = parseInt(b.tuoiCao) || 0;
          return aNum - bNum;
        });

      const labels = avgData.map((item) => item.tuoiCao);
      const data = avgData.map((item) => item.avg);

      const ctx = document.getElementById("chartTuoiCao").getContext("2d");
      if (window.tuoiCaoChart) window.tuoiCaoChart.destroy();
      window.tuoiCaoChart = new Chart(ctx, {
        type: "line",
        data: {
          labels: labels,
          datasets: [
            {
              label: "Năng suất bình quân (kg/ha)",
              data: data,
              borderColor: "#00b4ff",
              backgroundColor: "rgba(0, 180, 255, 0.1)",
              borderWidth: 3,
              fill: true,
              tension: 0.4,
              pointBackgroundColor: "#00b4ff",
              pointBorderColor: "#fff",
              pointBorderWidth: 2,
              pointRadius: 5,
              pointHoverRadius: 7,
            },
          ],
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: {
            legend: { display: false },
            tooltip: {
              callbacks: {
                label: (ctx) => `Năng suất: ${ctx.raw.toFixed(2)} kg/ha`,
              },
            },
          },
          scales: {
            y: {
              title: {
                display: true,
                text: "Năng suất (kg/ha)",
                color: "#8a9ab8",
              },
              ticks: { color: "#8a9ab8" },
              beginAtZero: true,
            },
            x: {
              title: {
                display: true,
                text: "Tuổi cạo",
                color: "#8a9ab8",
              },
              ticks: {
                color: "#e8eeff",
                font: { family: "Inter" },
              },
            },
          },
        },
      });
    }

    // Khởi tạo dropdown giống
    function initGiongFilter() {
      const giongList = getGiongList();
      const select = document.getElementById("giongFilter");
      giongList.forEach((giong) => {
        const option = document.createElement("option");
        option.value = giong;
        option.textContent = giong;
        select.appendChild(option);
      });

      // Sự kiện khi thay đổi giống
      select.addEventListener("change", (e) => {
        renderTuoiCao(e.target.value);
      });
    }

    // ====================== XUẤT EXCEL ======================
    function exportToExcel() {
      try {
        const XLSX = window.XLSX;
        const wb = XLSX.utils.book_new();
        const wsLo = XLSX.utils.json_to_sheet(loData);
        XLSX.utils.book_append_sheet(wb, wsLo, "Lô cây");
        XLSX.writeFile(
          wb,
          `ThongKe_CaoSu_${new Date().toISOString().slice(0, 19).replace(/:/g, "-")}.xlsx`,
        );
      } catch (err) {
        alert("Xuất Excel thất bại: " + err.message);
      }
    }

    // ==================== LẤY THÔNG TIN NGƯỜI DÙNG ====================
    async function loadUserInfo() {
      try {
        const res = await fetch("/api/me", { credentials: "same-origin" });
        const data = await res.json();
        if (data.success) {
          const user = data.data;
          document.getElementById("userFullName").innerText = user.fullname;
          document.getElementById("userRole").innerText =
            user.role === "admin" ? "Quản trị viên" : "Người dùng";
          document.getElementById("userAvatar").innerText = user.fullname
            .charAt(0)
            .toUpperCase();
        } else {
          console.warn("Không lấy được thông tin user");
        }
      } catch (err) {
        console.error("Lỗi /api/me:", err);
      }
    }

    document.addEventListener("DOMContentLoaded", () => {
      loadUserInfo();
    });

    // ====================== KHỞI CHẠY ======================
    async function init() {
      const success = await fetchData();
      if (!success) return;
      renderGiongPie();
      renderDienTichDoi();
      renderTaiCanh();
      renderNangSuat();
      initGiongFilter();
      renderTuoiCao();
    }
    init();

    // Gán sự kiện xuất Excel (nếu có nút)
    const exportBtn = document.getElementById("exportExcel");
    if (exportBtn) exportBtn.addEventListener("click", exportToExcel);

    // Đảm bảo chart responsive khi resize window
    window.addEventListener("resize", () => {
      if (window.giongChart) window.giongChart.resize();
      if (window.doiChart) window.doiChart.resize();
      if (window.taiCanhChart) window.taiCanhChart.resize();
      if (window.nangSuatChart) window.nangSuatChart.resize();
      if (window.tuoiCaoChart) window.tuoiCaoChart.resize();
    });
  </script>
</body>

</html>