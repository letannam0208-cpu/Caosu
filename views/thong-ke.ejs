</div>

<div id="body">
  <nav id="nav">
      <div class="nav-section-label">Tổng quan</div>
      <a href="/" class="nav-item"><i class="fas fa-home nav-icon"></i> Dashboard</a>
      <div class="nav-section-label">Quản lý dữ liệu</div>
      <a href="/quan-ly-lo-cay" class="nav-item"><i class="fas fa-tree nav-icon"></i> Quản lý lô cây</a>
      <a href="/them-du-lieu-lo-cay" class="nav-item"><i class="fas fa-plus-circle nav-icon"></i> Thêm dữ liệu lô</a>
      <div class="nav-section-label">Người dùng & Phân quyền</div>
