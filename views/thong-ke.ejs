<script>
// ====================== GLOBAL DATA STORE ======================
let apiData = {
  lo: [],
  donVi: [],
  hanhChinh: [],
  dienTich: [],
  hienTrangCay: [],
  khaiThac: [],
  sanLuong: [],
  thongTinTrong: []
};
let filteredLo = []; // dùng cho tab chuyên sâu sau khi lọc

// ====================== FETCH ALL 8 TABLES ======================
async function fetchAllData() {
  const endpoints = [
    '/api/lo-cay',
    '/api/don-vi',
    '/api/hanh-chinh',
    '/api/dien-tich',
    '/api/hien-trang-cay',
    '/api/khai-thac',
    '/api/san-luong',
    '/api/thong-tin-trong'
  ];
  try {
    const responses = await Promise.all(endpoints.map(url => fetch(url).then(res => {
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      return res.json();
    })));
    if (responses[0].features) {
      apiData.lo = responses[0].features.map(f => f.properties);
    } else {
      apiData.lo = responses[0].data || [];
    }
    apiData.donVi = responses[1].data || [];
    apiData.hanhChinh = responses[2].data || [];
    apiData.dienTich = responses[3].data || [];
    apiData.hienTrangCay = responses[4].data || [];
    apiData.khaiThac = responses[5].data || [];
    apiData.sanLuong = responses[6].data || [];
    apiData.thongTinTrong = responses[7].data || [];

    console.log('✅ Đã tải dữ liệu từ 8 bảng');
    return true;
  } catch (err) {
    console.error('❌ Lỗi tải dữ liệu:', err);
    document.querySelectorAll('.loader').forEach(el => el.innerHTML = `<i class="fas fa-exclamation-triangle"></i> Lỗi tải dữ liệu: ${err.message}`);
    return false;
  }
}

// ====================== UTILITIES ======================
function getAreaFromLo(lo) {
  return parseFloat(lo.dien_tich_map) || 0;
}

// ====================== RENDER TABS 1-3 (không lọc) ======================
function renderTabs123() {
  const loList = apiData.lo;
  const farmMap = new Map();
  loList.forEach(lo => {
    const farm = lo.du_an || 'Không xác định';
    const area = getAreaFromLo(lo);
    if (!farmMap.has(farm)) farmMap.set(farm, { area: 0, count: 0 });
    const f = farmMap.get(farm);
    f.area += area;
    f.count++;
  });
  const farmNames = Array.from(farmMap.keys());
  const farmAreas = farmNames.map(n => farmMap.get(n).area);
  const farmCounts = farmNames.map(n => farmMap.get(n).count);

  const varietyMap = new Map();
  loList.forEach(lo => {
    const giong = lo.giong || 'Khác';
    const area = getAreaFromLo(lo);
    varietyMap.set(giong, (varietyMap.get(giong) || 0) + area);
  });
  const varieties = Array.from(varietyMap.keys());
  const varietyAreas = varieties.map(v => varietyMap.get(v));

  const yearMap = new Map();
  loList.forEach(lo => {
    const year = lo.nam_trong;
    if (!year) return;
    const area = getAreaFromLo(lo);
    if (!yearMap.has(year)) yearMap.set(year, { area: 0, count: 0 });
    const y = yearMap.get(year);
    y.area += area;
    y.count++;
  });
  const years = Array.from(yearMap.keys()).sort((a,b)=>a-b);
  const yearAreas = years.map(y => yearMap.get(y).area);
  const yearCounts = years.map(y => yearMap.get(y).count);

  const toMap = new Map();
  loList.forEach(lo => {
    const to = lo.doi || 'Không xác định';
    const area = getAreaFromLo(lo);
    toMap.set(to, (toMap.get(to) || 0) + area);
  });
  const topTo = Array.from(toMap.entries()).sort((a,b)=>b[1]-a[1]).slice(0,10);
  const toNames = topTo.map(t=>t[0]);
  const toAreas = topTo.map(t=>t[1]);

  const farmVarietyMap = new Map();
  loList.forEach(lo => {
    const farm = lo.du_an || 'Không xác định';
    const giong = lo.giong || 'Khác';
    const area = getAreaFromLo(lo);
    if (!farmVarietyMap.has(farm)) farmVarietyMap.set(farm, new Map());
    const gmap = farmVarietyMap.get(farm);
    gmap.set(giong, (gmap.get(giong) || 0) + area);
  });
  const allGiong = new Set();
  loList.forEach(lo => { if(lo.giong) allGiong.add(lo.giong); });
  const giongList = Array.from(allGiong).sort();
  const farmGiongData = farmNames.map(farm => {
    const gmap = farmVarietyMap.get(farm) || new Map();
    return giongList.map(g => gmap.get(g) || 0);
  });

  const totalArea = farmAreas.reduce((a,b)=>a+b,0);
  const totalLots = loList.length;
  const avgArea = totalLots ? (totalArea/totalLots).toFixed(1) : 0;
  const maxFarm = farmNames.reduce((a,b)=> farmMap.get(a).area > farmMap.get(b).area ? a : b, farmNames[0]);
  const maxFarmArea = farmMap.get(maxFarm).area;
  const maxFarmPercent = totalArea ? ((maxFarmArea/totalArea)*100).toFixed(1) : 0;
  const topVariety = varieties.reduce((a,b)=> varietyMap.get(a) > varietyMap.get(b) ? a : b, varieties[0]);
  const topVarietyArea = varietyMap.get(topVariety);
  const topVarietyPercent = totalArea ? ((topVarietyArea/totalArea)*100).toFixed(1) : 0;

  document.getElementById('total-lots').innerText = totalLots;
  document.getElementById('total-area').innerText = totalArea.toFixed(3);
  document.getElementById('kpi-tab1').innerHTML = `
    <div class="kpi"><div class="kpi-label">Tổng diện tích</div><div class="kpi-value">${totalArea.toFixed(3)} <span>ha</span></div><div class="kpi-delta">${totalLots} lô cây</div></div>
    <div class="kpi"><div class="kpi-label">Bình quân / lô</div><div class="kpi-value">${avgArea} <span>ha</span></div><div class="kpi-delta">Min, Max tự động</div></div>
    <div class="kpi"><div class="kpi-label">Nông trường lớn nhất</div><div class="kpi-value">${maxFarm}</div><div class="kpi-delta" style="color:var(--accent)">${farmMap.get(maxFarm).count} lô · ${maxFarmArea.toFixed(1)} ha (${maxFarmPercent}%)</div></div>
    <div class="kpi"><div class="kpi-label">Giống chủ lực</div><div class="kpi-value">${topVariety}</div><div class="kpi-delta" style="color:var(--accentB)">${topVarietyArea.toFixed(1)} ha · ${topVarietyPercent}%</div></div>
  `;

  // Vẽ các biểu đồ (tái sử dụng các chart cũ, nhưng cần hủy cũ trước khi tạo mới để tránh chồng)
  destroyChartIfExists('chartDienTichSoLo');
  new Chart(document.getElementById('chartDienTichSoLo'), {
    type: 'bar', data: { labels: farmNames, datasets: [
      { label: 'Diện tích (ha)', data: farmAreas, backgroundColor: ['#00d68f','#00b4ff','#f59e0b'], yAxisID: 'y' },
      { label: 'Số lô', data: farmCounts, type: 'line', borderColor: '#f59e0b', borderWidth: 3, pointBackgroundColor: '#fff', pointRadius: 5, yAxisID: 'y1' }
    ]}, options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { labels: { color: '#8a9ab8' } } }, scales: { y: { ticks: { color: '#8a9ab8' } }, y1: { position: 'right', ticks: { color: '#8a9ab8' }, grid: { drawOnChartArea: false } } } }
  });
  destroyChartIfExists('chartCoCauGiongNT');
  new Chart(document.getElementById('chartCoCauGiongNT'), {
    type: 'bar', data: { labels: giongList, datasets: farmNames.map((farm, idx) => ({ label: farm, data: farmGiongData[idx], backgroundColor: ['#00d68f','#00b4ff','#f59e0b'][idx % 3] })) },
    options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { labels: { color: '#8a9ab8' } } } }
  });
  destroyChartIfExists('chartTopTo');
  new Chart(document.getElementById('chartTopTo'), {
    type: 'bar', data: { labels: toNames, datasets: [{ label: 'Diện tích (ha)', data: toAreas, backgroundColor: '#f59e0b' }] },
    options: { indexAxis: 'y', responsive: true, maintainAspectRatio: false }
  });
  destroyChartIfExists('chartDienTichNam');
  new Chart(document.getElementById('chartDienTichNam'), {
    type: 'bar', data: { labels: years, datasets: [
      { label: 'Diện tích (ha)', data: yearAreas, backgroundColor: '#00b4ff', yAxisID: 'y' },
      { label: 'Số lô', data: yearCounts, type: 'line', borderColor: '#f59e0b', borderWidth: 3, pointBackgroundColor: '#fff', pointRadius: 5, yAxisID: 'y1' }
    ]}, options: { responsive: true, maintainAspectRatio: false, scales: { y: { ticks: { color: '#8a9ab8' } }, y1: { position: 'right', ticks: { color: '#8a9ab8' }, grid: { drawOnChartArea: false } } } }
  });
  destroyChartIfExists('chartPhanBoNT');
  new Chart(document.getElementById('chartPhanBoNT'), { type: 'doughnut', data: { labels: farmNames, datasets: [{ data: farmAreas, backgroundColor: ['#00d68f','#00b4ff','#f59e0b'] }] }, options: { responsive: true } });
  destroyChartIfExists('chartSoLoNam');
  new Chart(document.getElementById('chartSoLoNam'), { type: 'bar', data: { labels: years, datasets: [{ label: 'Số lô', data: yearCounts, backgroundColor: '#00d68f' }] }, options: { responsive: true } });
  destroyChartIfExists('chartTyLeGiong');
  new Chart(document.getElementById('chartTyLeGiong'), { type: 'doughnut', data: { labels: varieties, datasets: [{ data: varietyAreas, backgroundColor: ['#00b4ff','#00d68f','#f59e0b','#a78bfa','#f87171','#64748b'] }] }, options: { responsive: true } });
  destroyChartIfExists('chartDienTichGiong');
  new Chart(document.getElementById('chartDienTichGiong'), { type: 'bar', data: { labels: varieties, datasets: [{ label: 'Diện tích (ha)', data: varietyAreas, backgroundColor: '#00b4ff' }] }, options: { indexAxis: 'y', responsive: true } });
  destroyChartIfExists('chartDienTichNT');
  new Chart(document.getElementById('chartDienTichNT'), { type: 'bar', data: { labels: farmNames, datasets: [{ label: 'Diện tích (ha)', data: farmAreas, backgroundColor: ['#00d68f','#00b4ff','#f59e0b'] }] }, options: { responsive: true } });
  const groupGiong = (giong) => {
    if(giong.includes('PB')) return 'PB series';
    if(giong.includes('RRIV')) return 'RRIV series';
    if(giong.includes('IRCA')) return 'IRCA series';
    return 'Khác';
  };
  const groupMap = new Map();
  loList.forEach(lo => {
    const g = groupGiong(lo.giong || 'Khác');
    const area = getAreaFromLo(lo);
    groupMap.set(g, (groupMap.get(g) || 0) + area);
  });
  destroyChartIfExists('chartCoCauGiong');
  new Chart(document.getElementById('chartCoCauGiong'), { type: 'doughnut', data: { labels: Array.from(groupMap.keys()), datasets: [{ data: Array.from(groupMap.values()), backgroundColor: ['#00b4ff','#00d68f','#f59e0b','#64748b'] }] }, options: { responsive: true } });
}

// Helper để hủy chart cũ
let chartInstances = {};
function destroyChartIfExists(id) {
  if (chartInstances[id]) {
    chartInstances[id].destroy();
    delete chartInstances[id];
  }
}
function registerChart(id, chart) {
  destroyChartIfExists(id);
  chartInstances[id] = chart;
}

// ====================== RENDER TAB CHUYÊN SÂU (có lọc) ======================
function renderAdvancedTab() {
  const yearFilter = document.getElementById('filter-year').value;
  const varietyFilter = document.getElementById('filter-variety').value;
  filteredLo = apiData.lo.filter(lo => {
    if (yearFilter !== 'all' && lo.nam_trong != yearFilter) return false;
    if (varietyFilter !== 'all' && lo.giong !== varietyFilter) return false;
    return true;
  });
  const loList = filteredLo;
  // 1. Hiện trạng cây (từ hien_trang_cay, không lọc theo lo, lấy tất cả)
  const htc = apiData.hienTrangCay;
  let sumCayCao = 0, sumChuaCao = 0, sumKhoMu = 0, sumKhongPT = 0;
  htc.forEach(row => {
    sumCayCao += Number(row.cay_cao) || 0;
    sumChuaCao += Number(row.cay_chua_cao) || 0;
    sumKhoMu += Number(row.cay_kho_mu) || 0;
    sumKhongPT += Number(row.cay_khong_pt) || 0;
  });
  registerChart('chartHienTrangCay', new Chart(document.getElementById('chartHienTrangCay'), {
    type: 'doughnut',
    data: { labels: ['Cây cao', 'Cây chưa cao', 'Cây khô mủ', 'Cây không PT'], datasets: [{ data: [sumCayCao, sumChuaCao, sumKhoMu, sumKhoMu, sumKhongPT], backgroundColor: ['#00d68f','#00b4ff','#f59e0b','#f87171'] }] },
    options: { responsive: true, maintainAspectRatio: false }
  }));

  // 2. Top 10 lô năng suất cao nhất (chỉ lấy những lô trong filteredLo)
  const yieldMap = new Map();
  apiData.sanLuong.forEach(sl => {
    if(sl.id_lo && sl.ns25_kg_ha) {
      const lo = loList.find(l => l.id_lo === sl.id_lo);
      if(lo && lo.ten_lo) {
        yieldMap.set(lo.ten_lo, parseFloat(sl.ns25_kg_ha));
      }
    }
  });
  const topYield = Array.from(yieldMap.entries()).sort((a,b)=>b[1]-a[1]).slice(0,10);
  registerChart('chartTopNangSuat', new Chart(document.getElementById('chartTopNangSuat'), {
    type: 'bar', data: { labels: topYield.map(y=>y[0]), datasets: [{ label: 'NS25 (kg/ha)', data: topYield.map(y=>y[1]), backgroundColor: '#00d68f' }] },
    options: { indexAxis: 'y', responsive: true, maintainAspectRatio: false }
  }));

  // 3. Phân bố mật độ trồng (từ thong_tin_trong, không lọc)
  const matDoList = apiData.thongTinTrong.map(t => parseFloat(t.mat_do_tk)).filter(v => v>0);
  const matDoHist = Array(10).fill(0);
  const maxMatDo = Math.max(...matDoList, 100);
  matDoList.forEach(v => {
    const idx = Math.min(9, Math.floor(v / (maxMatDo/10)));
    matDoHist[idx]++;
  });
  registerChart('chartMatDoTrong', new Chart(document.getElementById('chartMatDoTrong'), {
    type: 'bar', data: { labels: Array.from({length:10}, (_,i)=>`${(i*maxMatDo/10).toFixed(0)}-${((i+1)*maxMatDo/10).toFixed(0)}`), datasets: [{ label: 'Số lô', data: matDoHist, backgroundColor: '#00b4ff' }] },
    options: { responsive: true, maintainAspectRatio: false }
  }));

  // 4. Biến động diện tích (chỉ lấy những lô trong filteredLo)
  const dtMap = new Map();
  apiData.dienTich.forEach(dt => {
    if(dt.id_lo) dtMap.set(dt.id_lo, { dt125: parseFloat(dt.dien_tich_010125)||0, dt126: parseFloat(dt.dien_tich_010126)||0 });
  });
  const loWithDT = loList.filter(lo => dtMap.has(lo.id_lo));
  const changeData = loWithDT.map(lo => ({ name: lo.ten_lo || lo.id_lo, before: dtMap.get(lo.id_lo).dt125, after: dtMap.get(lo.id_lo).dt126 }));
  const changeLabels = changeData.map(c => c.name).slice(0,20);
  const changeBefore = changeData.map(c => c.before).slice(0,20);
  const changeAfter = changeData.map(c => c.after).slice(0,20);
  registerChart('chartBienDongDT', new Chart(document.getElementById('chartBienDongDT'), {
    type: 'line', data: { labels: changeLabels, datasets: [
      { label: 'DT 01/01/25', data: changeBefore, borderColor: '#00d68f', fill: false },
      { label: 'DT 01/01/26', data: changeAfter, borderColor: '#f59e0b', fill: false }
    ]}, options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { labels: { color: '#8a9ab8' } } } }
  }));

  // 5. Phân bố diện tích lô (histogram từ dien_tich_map của filteredLo)
  const areaList = loList.map(l => getAreaFromLo(l)).filter(a => a>0);
  const areaHist = Array(10).fill(0);
  const maxArea = Math.max(...areaList, 10);
  areaList.forEach(a => {
    const idx = Math.min(9, Math.floor(a / (maxArea/10)));
    areaHist[idx]++;
  });
  registerChart('chartPhanBoDienTichLo', new Chart(document.getElementById('chartPhanBoDienTichLo'), {
    type: 'bar', data: { labels: Array.from({length:10}, (_,i)=>`${(i*maxArea/10).toFixed(1)}-${((i+1)*maxArea/10).toFixed(1)}`), datasets: [{ label: 'Số lô', data: areaHist, backgroundColor: '#f59e0b' }] },
    options: { responsive: true, maintainAspectRatio: false }
  }));

  // 6. Tình trạng khai thác (từ khai_thac, không lọc)
  const khaiThacMap = new Map();
  apiData.khaiThac.forEach(kt => { if(kt.che_do_cao) khaiThacMap.set(kt.che_do_cao, (khaiThacMap.get(kt.che_do_cao) || 0) + 1); });
  registerChart('chartTinhTrangKhaiThac', new Chart(document.getElementById('chartTinhTrangKhaiThac'), {
    type: 'pie', data: { labels: Array.from(khaiThacMap.keys()), datasets: [{ data: Array.from(khaiThacMap.values()), backgroundColor: ['#00d68f','#00b4ff','#f59e0b','#a78bfa','#f87171'] }] },
    options: { responsive: true, maintainAspectRatio: false }
  }));

  // 7. Tương quan diện tích – sản lượng (chỉ dùng filteredLo)
  const scatterData = [];
  loList.forEach(lo => {
    const area = getAreaFromLo(lo);
    const sl = apiData.sanLuong.find(s => s.id_lo === lo.id_lo);
    const yieldVal = sl ? (parseFloat(sl.ns25_kg_ha) || 0) : 0;
    if(area>0 && yieldVal>0) scatterData.push({x: area, y: yieldVal});
  });
  registerChart('chartScatterSLDT', new Chart(document.getElementById('chartScatterSLDT'), {
    type: 'scatter', data: { datasets: [{ label: 'Năng suất (kg/ha)', data: scatterData, backgroundColor: '#00d68f', pointRadius: 4 }] },
    options: { responsive: true, maintainAspectRatio: false, scales: { x: { title: { display: true, text: 'Diện tích (ha)', color: '#8a9ab8' } }, y: { title: { display: true, text: 'NS25 (kg/ha)', color: '#8a9ab8' } } } }
  }));

  // 8. Năng suất trung bình theo giống (chỉ dùng filteredLo)
  const giongYieldMap = new Map();
  loList.forEach(lo => {
    const giong = lo.giong || 'Khác';
    const sl = apiData.sanLuong.find(s => s.id_lo === lo.id_lo);
    const yieldVal = sl ? (parseFloat(sl.ns25_kg_ha) || 0) : 0;
    if(yieldVal>0) {
      if(!giongYieldMap.has(giong)) giongYieldMap.set(giong, { sum:0, count:0 });
      const g = giongYieldMap.get(giong);
      g.sum += yieldVal;
      g.count++;
    }
  });
  const giongNames = Array.from(giongYieldMap.keys());
  const avgYieldByGiong = giongNames.map(g => giongYieldMap.get(g).sum / giongYieldMap.get(g).count);
  registerChart('chartNangSuatTheoGiong', new Chart(document.getElementById('chartNangSuatTheoGiong'), {
    type: 'bar', data: { labels: giongNames, datasets: [{ label: 'NS25 TB (kg/ha)', data: avgYieldByGiong, backgroundColor: '#00b4ff' }] },
    options: { responsive: true, maintainAspectRatio: false }
  }));
}

// ====================== EXPORT EXCEL ======================
function exportToExcel() {
  // Tạo workbook và worksheet từ các bảng
  const wb = XLSX.utils.book_new();
  const sheets = {
    'Lô cây': apiData.lo,
    'Đơn vị': apiData.donVi,
    'Hành chính': apiData.hanhChinh,
    'Diện tích': apiData.dienTich,
    'Hiện trạng cây': apiData.hienTrangCay,
    'Khai thác': apiData.khaiThac,
    'Sản lượng': apiData.sanLuong,
    'Thông tin trồng': apiData.thongTinTrong
  };
  for (const [name, data] of Object.entries(sheets)) {
    if (data && data.length) {
      const ws = XLSX.utils.json_to_sheet(data);
      XLSX.utils.book_append_sheet(wb, ws, name);
    }
  }
  XLSX.writeFile(wb, `ThongKe_CaoSu_${new Date().toISOString().slice(0,19).replace(/:/g, '-')}.xlsx`);
}

// ====================== INIT ======================
async function init() {
  const success = await fetchAllData();
  if (!success) return;
  renderTabs123();
  // Populate filter dropdowns
  const yearsSet = new Set();
  const varietiesSet = new Set();
  apiData.lo.forEach(lo => {
    if (lo.nam_trong) yearsSet.add(lo.nam_trong);
    if (lo.giong) varietiesSet.add(lo.giong);
  });
  const yearSelect = document.getElementById('filter-year');
  const varietySelect = document.getElementById('filter-variety');
  Array.from(yearsSet).sort().forEach(y => {
    const opt = document.createElement('option');
    opt.value = y;
    opt.textContent = y;
    yearSelect.appendChild(opt);
  });
  Array.from(varietiesSet).sort().forEach(v => {
    const opt = document.createElement('option');
    opt.value = v;
    opt.textContent = v;
    varietySelect.appendChild(opt);
  });
  // Apply filter button
  document.getElementById('apply-filter').addEventListener('click', () => {
    renderAdvancedTab();
  });
  // Mặc định hiển thị tab chuyên sâu khi chuyển sang
  renderAdvancedTab(); // khởi tạo lần đầu
}
init();

function switchTab(tabId, btn) {
  document.querySelectorAll('.tab-content').forEach(t => t.style.display = 'none');
  document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
  document.getElementById(tabId).style.display = 'block';
  btn.classList.add('active');
  // Nếu chuyển sang tab chuyên sâu, cập nhật lại biểu đồ (có thể đã thay đổi dữ liệu)
  if (tabId === 'tab-chuyensau') {
    renderAdvancedTab();
  }
}
document.getElementById('exportExcel').addEventListener('click', exportToExcel);
</script>
