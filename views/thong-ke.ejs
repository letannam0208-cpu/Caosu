      <div class="nav-logout"><a href="/logout" class="nav-item"><i class="fas fa-sign-out-alt nav-icon"></i> Đăng xuất</a></div>
  </nav>

  <div id="content">
    <div class="page-header">
      <div class="page-title-group">
        <div class="page-title">Thống Kê</div>
        <div class="page-subtitle">Phân tích dữ liệu vườn cây từ 8 bảng</div>
      </div>
      <button class="btn-export" id="exportExcel"><i class="fas fa-download"></i> Xuất Excel</button>
