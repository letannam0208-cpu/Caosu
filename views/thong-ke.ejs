<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Thống Kê - WebGIS CAO SU</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&family=Syne:wght@700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<style>
:root {
  --bg:       #080d18;
  --s1:       #0f1729;
  --s2:       #151f35;
  --s3:       #1c2844;
  --border:   rgba(255,255,255,0.07);
  --border2:  rgba(255,255,255,0.12);
  --text:     #e8eeff;
  --muted:    #5a6a8a;
  --muted2:   #8a9ab8;
  --accent:   #00d68f;
  --accentB:  #00b4ff;
  --warn:     #f59e0b;
  --danger:   #f4656a;
  --purple:   #a78bfa;
  --font-d:   'Syne', sans-serif;
  --font-b:   'Be Vietnam Pro', sans-serif;
  --nav-w:    180px;
  --top-h:    56px;
  --r:        8px;
  --r-lg:     12px;
}

*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
body{font-family:var(--font-b);background:var(--bg);color:var(--text);height:100vh;overflow:hidden;display:flex;flex-direction:column}
::-webkit-scrollbar{width:4px;height:4px}
::-webkit-scrollbar-track{background:transparent}
::-webkit-scrollbar-thumb{background:var(--s3);border-radius:2px}

/* ── TOP BAR ── */
#topbar{
  height:var(--top-h);flex-shrink:0;
  background:var(--s1);border-bottom:1px solid var(--border);
  display:flex;align-items:center;padding:0 16px;gap:12px;
  position:relative;z-index:100;
}
#topbar::after{
  content:'';position:absolute;bottom:0;left:0;right:0;height:1px;
  background:linear-gradient(90deg,transparent,rgba(0,214,143,0.3),transparent);
}
.tb-logo{display:flex;align-items:center;gap:8px;text-decoration:none;flex-shrink:0}
.tb-icon{
  width:32px;height:32px;border-radius:8px;
  background:linear-gradient(135deg,#17d7a8,#0da878);
  display:flex;align-items:center;justify-content:center;font-size:16px;
  box-shadow:0 0 16px rgba(23,215,168,0.3);flex-shrink:0;
}
.tb-title{font-family:var(--font-d);font-size:13px;letter-spacing:.08em;color:var(--text);font-weight:700}
.tb-sub{font-size:9px;color:var(--muted);letter-spacing:.12em;text-transform:uppercase}
.tb-sep{width:1px;height:24px;background:var(--border);margin:0 2px}
.tb-pill{
  background:transparent;border:none;
  padding:4px 10px;font-size:11px;color:var(--muted2);display:flex;align-items:center;gap:6px;
}
.tb-pill strong{color:var(--text);font-weight:600;font-size:12px}
.live-dot{width:5px;height:5px;border-radius:50%;background:var(--accent);box-shadow:0 0 6px var(--accent);animation:blink 2s infinite}
@keyframes blink{0%,100%{opacity:1}50%{opacity:.3}}
.tb-right{margin-left:auto;display:flex;align-items:center;gap:12px}
.icon-btn{
  width:32px;height:32px;border-radius:var(--r);background:transparent;
  border:none;color:var(--muted2);cursor:pointer;display:flex;
  align-items:center;justify-content:center;font-size:14px;transition:.2s;
}
.icon-btn:hover{color:var(--accentB)}
.tb-avatar{
  width:32px;height:32px;border-radius:50%;
  background:linear-gradient(135deg,#00b4ff,#a78bfa);
  display:flex;align-items:center;justify-content:center;
  font-size:11px;font-weight:700;color:#fff;cursor:pointer;
  border:2px solid var(--border2);
}
.tb-user-info{text-align:right;font-size:11px}
.tb-user-name{font-weight:600;color:var(--text)}
.tb-user-role{font-size:10px;color:var(--muted);margin-top:2px}

/* ── BODY ── */
#body{display:flex;flex:1;overflow:hidden}

/* ── NAV SIDEBAR ── */
#nav{
  width:var(--nav-w);
  flex-shrink:0;
  background:linear-gradient(180deg,var(--s1),var(--bg));
  border-right:1px solid var(--border);
  display:flex;
  flex-direction:column;
  overflow-y:auto;
  padding:16px 10px;
  gap:4px;
}
.nav-section-label{
  font-size:10px;
  font-weight:700;
  letter-spacing:0.15em;
  text-transform:uppercase;
  color:var(--muted);
  padding:8px 12px 6px;
  margin:8px 0 2px;
}
.nav-item{
  display:flex;
  align-items:center;
  gap:10px;
  padding:10px 12px;
  border-radius:var(--r);
  cursor:pointer;
  transition:all 0.2s;
  color:var(--muted2);
  font-size:13px;
  font-weight:500;
  border:1px solid transparent;
  position:relative;
  text-decoration:none;
  white-space:nowrap;
}
.nav-item:hover{
  background:rgba(255,255,255,0.05);
  color:var(--text);
  border-color:var(--border2);
}
.nav-item.active{
  background:rgba(16,185,129,0.15);
  border-color:var(--accent);
  color:var(--accent);
  font-weight:600;
  box-shadow:inset 0 0 8px rgba(16,185,129,0.1);
}
.nav-item.active::before{
  content:'';
  position:absolute;
  left:0;
  top:20%;
  bottom:20%;
  width:3px;
  border-radius:0 2px 2px 0;
  background:var(--accent);
}
.nav-icon{
  width:16px;
  height:16px;
  flex-shrink:0;
  text-align:center;
  font-size:13px;
}
.nav-badge{
  margin-left:auto;
  background:rgba(239,68,68,0.2);
  color:#fca5a5;
  font-size:10px;
  font-weight:700;
  padding:2px 6px;
  border-radius:8px;
  flex-shrink:0;
}

/* Logout button */
.nav-logout{
  margin-top:auto;
  border-top:1px solid var(--border);
  padding-top:12px;
}
.nav-logout .nav-item{
  color:#fca5a5;
  border:1px solid rgba(239,68,68,0.2);
  background:rgba(239,68,68,0.08);
}
.nav-logout .nav-item:hover{
  background:rgba(239,68,68,0.15);
  border-color:rgba(239,68,68,0.4);
  color:#ff9999;
}

/* ── CONTENT ── */
#content{flex:1;overflow-y:auto;padding:16px}

/* ── PAGE HEADER ── */
.page-header{display:flex;align-items:flex-start;justify-content:space-between;margin-bottom:20px;gap:12px}
.page-title-group{flex:1}
.page-title{font-family:var(--font-d);font-size:24px;font-weight:800;color:var(--text);letter-spacing:-.02em}
.page-subtitle{font-size:11px;color:var(--muted);margin-top:3px}

.btn-export{
  background:transparent;border:1px solid var(--border2);color:var(--muted2);
  padding:8px 14px;border-radius:var(--r);font-family:var(--font-b);
  font-size:11px;font-weight:600;cursor:pointer;transition:.18s;
  display:inline-flex;align-items:center;gap:6px;flex-shrink:0;
  margin-top:2px;
}
.btn-export:hover{border-color:var(--accentB);color:var(--accentB);background:rgba(0,180,255,.08)}

/* ── TABS ── */
.tab-container{margin-bottom:20px}
.tab-buttons{
  display:flex;gap:8px;flex-wrap:wrap;
}
.tab-btn{
  padding:8px 16px;border:1px solid var(--border);background:var(--s2);
  color:var(--muted2);border-radius:var(--r);font-size:11px;font-weight:600;
  cursor:pointer;transition:.18s;font-family:var(--font-b);
}
.tab-btn:hover{border-color:var(--border2);background:var(--s3)}
.tab-btn.active{
  background:rgba(0,214,143,.15);border-color:rgba(0,214,143,.3);
  color:var(--accent);
}

/* ── GRID LAYOUTS ── */
.grid-4{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;margin-bottom:20px}
.grid-2{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-bottom:20px}
.grid-full{grid-column:1/-1}

/* ── KPI CARD ── */
.kpi{
  background:var(--s1);border:1px solid var(--border);
  border-radius:var(--r-lg);padding:16px;transition:.2s;
}
.kpi:hover{border-color:var(--border2)}
.kpi-label{font-size:10px;color:var(--muted);font-weight:500;margin-bottom:8px;display:flex;align-items:center;gap:6px}
.kpi-value{font-family:var(--font-d);font-size:22px;font-weight:700;color:var(--text);letter-spacing:-.02em}
.kpi-value span{font-family:var(--font-b);font-size:11px;color:var(--muted);font-weight:400;margin-left:4px}
.kpi-delta{font-size:10px;margin-top:6px;color:var(--muted);display:flex;align-items:center;gap:4px}

/* ── CARD ── */
.card{
  background:var(--s1);border:1px solid var(--border);
  border-radius:var(--r-lg);padding:16px;transition:.2s;
}
.card:hover{border-color:var(--border2)}
.card-title{
  font-family:var(--font-d);font-size:12px;font-weight:700;color:var(--text);
  margin-bottom:12px;display:flex;align-items:center;justify-content:space-between;
}
.chart-box{height:320px}
.chart-box-lg{height:420px}

/* ── BADGE ── */
.badge{
  display:inline-flex;align-items:center;padding:4px 10px;border-radius:10px;
  font-size:10px;font-weight:600;
}
.badge-green{background:rgba(0,214,143,.15);color:var(--accent)}
.badge-blue{background:rgba(0,180,255,.15);color:var(--accentB)}

/* ── RESPONSIVE ── */
@media(max-width:1400px){
  .grid-4{grid-template-columns:repeat(2,1fr)}
}
@media(max-width:768px){
  #nav{width:160px;padding:10px 6px}
  #content{padding:12px}
  .page-title{font-size:18px}
  .grid-4,.grid-2{grid-template-columns:1fr}
  .chart-box,.chart-box-lg{height:280px}
}
</style>
</head>
<body>

<div id="topbar">
  <a class="tb-logo" href="#">
    <div class="tb-icon">🌿</div>
    <div>
      <div class="tb-title">WEBGIS CAO SU</div>
      <div class="tb-sub">Vườn cây</div>
    </div>
  </a>
  
  <div class="tb-sep"></div>
  
  <div class="tb-pill">
    <span class="live-dot"></span>
    <span>Trực tuyến</span>
  </div>
  <div class="tb-pill">
    <strong>Lô vườn</strong> 425
  </div>
  <div class="tb-pill">
    <strong>Diện tích</strong> 7.244 ha
  </div>

  <div class="tb-right">
    <button class="icon-btn"><i class="fas fa-bell"></i></button>
    <button class="icon-btn"><i class="fas fa-globe"></i></button>
    <button class="icon-btn"><i class="fas fa-cog"></i></button>
    
    <div style="display:flex;align-items:center;gap:8px">
      <div class="tb-user-info">
        <div class="tb-user-name">Nguyễn Văn An</div>
        <div class="tb-user-role">Quản trị viên</div>
      </div>
      <div class="tb-avatar">NA</div>
    </div>
  </div>
</div>

<div id="body">

  <nav id="nav">
      <div class="nav-section-label">Tổng quan</div>
      <a href="/" class="nav-item <%= (path === '/' || path === '/dashboard') ? 'active' : '' %>">
        <i class="fas fa-home nav-icon"></i> Dashboard
      </a>

      <div class="nav-section-label">Quản lý dữ liệu</div>
      <a href="/quan-ly-lo-cay" class="nav-item <%= path === '/quan-ly-lo-cay' ? 'active' : '' %>">
        <i class="fas fa-tree nav-icon"></i> Quản lý lô cây
      </a>
      <a href="/them-du-lieu-lo-cay" class="nav-item <%= path === '/them-du-lieu-lo-cay' ? 'active' : '' %>">
        <i class="fas fa-plus-circle nav-icon"></i> Thêm dữ liệu lô
      </a>

      <div class="nav-section-label">Người dùng & Phân quyền</div>
      <a href="/quan-ly-nguoi-dung" class="nav-item <%= path === '/quan-ly-nguoi-dung' ? 'active' : '' %>">
        <i class="fas fa-users nav-icon"></i> Quản lý người dùng
      </a>

      <div class="nav-section-label">Phân tích</div>
      <a href="/thong-ke" class="nav-item <%= path === '/thong-ke' ? 'active' : '' %>">
        <i class="fas fa-chart-bar nav-icon"></i> Thống kê
      </a>

      <div class="nav-logout" style="margin-top: auto; border-top: 1px solid var(--border); padding-top: 12px;">
        <a href="/logout" class="nav-item">
          <i class="fas fa-sign-out-alt nav-icon"></i> Đăng xuất
        </a>
      </div>
    </nav>

  <div id="content">
    <div class="page-header">
      <div class="page-title-group">
        <div class="page-title">Thống Kê</div>
        <div class="page-subtitle">Phân tích dữ liệu vườn cây theo thời gian và đội</div>
      </div>
      <button class="btn-export"><i class="fas fa-download"></i> Xuất Excel</button>
    </div>

    <!-- TAB SWITCHING -->
    <div class="tab-container">
      <div class="tab-buttons">
        <button class="tab-btn active" onclick="switchTab('tab-nongtruong', this)">Theo nông trường</button>
        <button class="tab-btn" onclick="switchTab('tab-dientichnam', this)">Diện tích theo năm</button>
        <button class="tab-btn" onclick="switchTab('tab-giong', this)">Cơ cấu giống</button>
      </div>
    </div>

    <!-- TAB 1: THEO NÔNG TRƯỜNG -->
    <div id="tab-nongtruong" class="tab-content">
      <div class="grid-4">
        <div class="kpi">
          <div class="kpi-label">Tổng diện tích</div>
          <div class="kpi-value">7.244 <span>ha</span></div>
          <div class="kpi-delta">425 lô cây su</div>
        </div>
        <div class="kpi">
          <div class="kpi-label">Bình quân / lô</div>
          <div class="kpi-value">17.0 <span>ha</span></div>
          <div class="kpi-delta">Min 0,3 ha · Max 30,9 ha</div>
        </div>
        <div class="kpi">
          <div class="kpi-label">Nông trường lớn nhất</div>
          <div class="kpi-value">NT 3</div>
          <div class="kpi-delta" style="color:var(--accent)">171 lô · 2.987,8 ha (41,3%)</div>
        </div>
        <div class="kpi">
          <div class="kpi-label">Giống chủ lực</div>
          <div class="kpi-value">PB 260</div>
          <div class="kpi-delta" style="color:var(--accentB)">165 lô · 2.947,5 ha · 40,7%</div>
        </div>
      </div>

      <div class="card">
        <div class="card-title">Diện tích & số lô theo nông trường</div>
        <div class="chart-box-lg"><canvas id="chartDienTichSoLo"></canvas></div>
      </div>

      <div class="grid-2">
        <div class="card">
          <div class="card-title">Cơ cấu giống theo nông trường</div>
          <div class="chart-box"><canvas id="chartCoCauGiongNT"></canvas></div>
        </div>
        <div class="card">
          <div class="card-title">Diện tích các tổ (Top 10 tổ lớn nhất)</div>
          <div class="chart-box"><canvas id="chartTopTo"></canvas></div>
        </div>
      </div>
    </div>

    <!-- TAB 2: DIỆN TÍCH THEO NĂM -->
    <div id="tab-dientichnam" class="tab-content" style="display:none">
      <div class="card">
        <div class="card-title">Diện tích trồng theo năm (2007–2012)</div>
        <div class="chart-box-lg"><canvas id="chartDienTichNam"></canvas></div>
      </div>
      <div class="grid-2">
        <div class="card">
          <div class="card-title">Phân bổ diện tích theo nông trường</div>
          <div class="chart-box"><canvas id="chartPhanBoNT"></canvas></div>
        </div>
        <div class="card">
          <div class="card-title">Số lô theo năm trồng</div>
          <div class="chart-box"><canvas id="chartSoLoNam"></canvas></div>
        </div>
      </div>
    </div>

    <!-- TAB 3: CƠ CẤU GIỐNG -->
    <div id="tab-giong" class="tab-content" style="display:none">
      <div class="grid-2">
        <div class="card">
          <div class="card-title">Tỷ lệ diện tích theo giống cây</div>
          <div class="chart-box-lg"><canvas id="chartTyLeGiong"></canvas></div>
        </div>
        <div class="card">
          <div class="card-title">Diện tích theo từng giống (ha)</div>
          <div class="chart-box-lg"><canvas id="chartDienTichGiong"></canvas></div>
        </div>
      </div>
      <div class="grid-2">
        <div class="card">
          <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:12px">
            <div class="card-title" style="margin:0">Diện tích theo nông trường</div>
            <span class="badge badge-green">NT 1 · NT 2 · NT 3</span>
          </div>
          <div class="chart-box"><canvas id="chartDienTichNT"></canvas></div>
        </div>
        <div class="card">
          <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:12px">
            <div class="card-title" style="margin:0">Cơ cấu giống cao su</div>
            <span class="badge badge-blue">425 lô · 7.244 ha</span>
          </div>
          <div class="chart-box"><canvas id="chartCoCauGiong"></canvas></div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
// Chuyển tab nội dung
function switchTab(tabId, button) {
  document.querySelectorAll('.tab-content').forEach(tab => tab.style.display = 'none');
  document.querySelectorAll('.tab-btn').forEach(btn => btn.classList.remove('active'));

  document.getElementById(tabId).style.display = 'block';
  button.classList.add('active');
}

// Highlight menu sidebar khi click
document.querySelectorAll('.nav-item').forEach(item => {
  item.addEventListener('click', function(e) {
    // Nếu là logout thì không xử lý thêm
    if (this.getAttribute('href') === '/logout') return;

    // Xóa active cũ, thêm active mới
    document.querySelectorAll('.nav-item').forEach(i => i.classList.remove('active'));
    this.classList.add('active');
    // Không preventDefault → cho phép chuyển trang thật
  });
});

// Tự động highlight menu dựa trên URL hiện tại khi load trang
window.addEventListener('load', () => {
  const currentPath = window.location.pathname;
  document.querySelectorAll('.nav-item').forEach(item => {
    const href = item.getAttribute('href');
    if (href && (currentPath === href || (currentPath === '/dashboard' && href === '/'))) {
      item.classList.add('active');
    }
  });
});

// Logout (nếu cần confirm trước khi redirect)
function logout() {
  if (confirm('Bạn có chắc muốn đăng xuất?')) {
    window.location.href = '/logout';
  }
}
// Chart colors
const colors = {
  NT1: '#00d68f',
  NT2: '#00b4ff',
  NT3: '#f59e0b',
  accent: '#00d68f',
  accentB: '#00b4ff',
  line: '#f59e0b'
};

const chartConfig = {
  responsive: true,
  maintainAspectRatio: false,
  plugins: {
    legend: {
      labels: { 
        color: '#8a9ab8', 
        font: { size: 11, weight: '500' },
        padding: 15,
        usePointStyle: true
      }
    }
  },
  scales: {
    x: { 
      ticks: { color: '#8a9ab8', font: { size: 11 } }, 
      grid: { color: 'rgba(255,255,255,0.05)' }
    },
    y: { 
      ticks: { color: '#8a9ab8', font: { size: 11 } }, 
      grid: { color: 'rgba(255,255,255,0.05)' }
    }
  }
};

// 1. Diện tích & số lô theo nông trường
new Chart(document.getElementById('chartDienTichSoLo'), {
  type: 'bar',
  data: {
    labels: ['NT 1', 'NT 2', 'NT 3'],
    datasets: [
      { label: 'Diện tích (ha)', data: [2250, 2000, 2987.8], backgroundColor: [colors.NT1, colors.NT2, colors.NT3], yAxisID: 'y', borderRadius: 4 },
      { label: 'Số lô', data: [122, 132, 171], type: 'line', borderColor: colors.line, borderWidth: 3, pointBackgroundColor: '#fff', pointRadius: 5, yAxisID: 'y1' }
    ]
  },
  options: { ...chartConfig, scales: {
    y: { position: 'left', ticks: { color: '#8a9ab8' }, grid: { color: 'rgba(255,255,255,0.05)' } },
    y1: { position: 'right', ticks: { color: '#8a9ab8' }, grid: { drawOnChartArea: false } }
  }}
});

// 2. Cơ cấu giống theo nông trường
new Chart(document.getElementById('chartCoCauGiongNT'), {
  type: 'bar',
  data: {
    labels: ['PB 260', 'RRIV 4', 'RRIV 1', 'PB 255', 'IRCA 130', 'Khác'],
    datasets: [
      { label: 'NT 1', data: [600, 300, 200, 400, 150, 600], backgroundColor: colors.NT1 },
      { label: 'NT 2', data: [800, 200, 300, 300, 200, 200], backgroundColor: colors.NT2 },
      { label: 'NT 3', data: [1400, 400, 500, 300, 300, 87.8], backgroundColor: colors.NT3 }
    ]
  },
  options: chartConfig
});

// 3. Top 10 tổ lớn nhất
new Chart(document.getElementById('chartTopTo'), {
  type: 'bar',
  data: {
    labels: ['Tổ 4', 'Tổ 2', 'Tổ 3', 'Tổ 1', 'Tổ 5', 'Tổ 6'],
