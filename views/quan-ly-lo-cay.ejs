<script>
// FILTER FUNCTION
const searchInput = document.getElementById('searchInput');
const filters = {
  nt: document.getElementById('ntFilter'),
  giong: document.getElementById('giongFilter'),
  nam: document.getElementById('namFilter'),
  phien: document.getElementById('phienFilter'),
  nhipdo: document.getElementById('nhipdoFilter')
};
const rows = document.querySelectorAll('#tableBody tr');
const resultCountEl = document.getElementById('resultCount');

function applyFilters() {
  let visible = 0;

  rows.forEach(row => {
    const text = row.textContent.toLowerCase();
    const search = searchInput.value.toLowerCase();

    const matchSearch = !search || text.includes(search);

    const matchNT     = !filters.nt.value     || (row.dataset.nt     === filters.nt.value);
    const matchGiong  = !filters.giong.value  || (row.dataset.giong  === filters.giong.value);
    const matchNam    = !filters.nam.value    || (row.dataset.nam    === filters.nam.value);
    const matchPhien  = !filters.phien.value  || (row.dataset.phien  === filters.phien.value);
    const matchNhipdo = !filters.nhipdo.value || (row.dataset.nhipdo === filters.nhipdo.value);

    const show = matchSearch && matchNT && matchGiong && matchNam && matchPhien && matchNhipdo;

    row.style.display = show ? '' : 'none';
    if (show) visible++;
  });

  resultCountEl.textContent = visible;
}

// Event listeners
searchInput.addEventListener('input', applyFilters);
Object.values(filters).forEach(select => {
  select.addEventListener('change', applyFilters);
});

// Highlight active filters
function updateFilterStyle() {
  Object.values(filters).forEach(s => {
    s.classList.toggle('filter-active', !!s.value);
  });
}
Object.values(filters).forEach(s => s.addEventListener('change', updateFilterStyle));
updateFilterStyle();

// Run once on load
applyFilters();

// Navigation active
document.querySelectorAll('.nav-item').forEach(item => {
  item.addEventListener('click', function(e) {
    if (!this.href.includes('logout')) {
      e.preventDefault();
      document.querySelectorAll('.nav-item').forEach(i => i.classList.remove('active'));
      this.classList.add('active');
    }
  });
});

// View detail alert
document.querySelectorAll('.btn-view').forEach(btn => {
  btn.addEventListener('click', function() {
    const row = this.closest('tr');
    const name = row.querySelector('.cell-name').textContent.trim();
    alert('Chi tiết lô: ' + name);
  });
});

// Add button action
document.querySelector('.btn-add').addEventListener('click', function() {
  alert('Thêm lô cây mới');
});
</script>

