// ==================== QUẢN LÝ HIỆN TRẠNG CÂY ====================
let hienTrangData = [];
async function loadHienTrangCay() {
  const res = await fetch('/api/hien-trang-cay');
  const data = await res.json();
  if(data.success) {
    hienTrangData = data.data;
    renderHienTrangTable(hienTrangData);
    updateHienTrangFilters(hienTrangData);
  }
}
function renderHienTrangTable(data) {
  const tbody = document.getElementById('hientrang-table-body');
  tbody.innerHTML = '';
  data.forEach(ht => {
    const row = tbody.insertRow();
    row.insertCell(0).innerText = ht.id_htc;
    row.insertCell(1).innerText = ht.id_lo || '';
    row.insertCell(2).innerText = ht.ten_lo || '';
    row.insertCell(3).innerText = ht.tong_ho_kk || '';
    row.insertCell(4).innerText = ht.cay_cao || '';
    row.insertCell(5).innerText = ht.cay_chua_cao || '';
    row.insertCell(6).innerText = ht.cay_kho_mu || '';
    row.insertCell(7).innerText = ht.cay_khong_pt || '';
    row.insertCell(8).innerText = ht.ho_trong || '';
    row.insertCell(9).innerText = ht.mat_do_cc || '';
    const actionCell = row.insertCell(10);
    actionCell.innerHTML = `<button class="btn-dash" onclick="editHienTrang('${ht.id_htc}')">Sửa</button><button class="btn-view" onclick="deleteHienTrang('${ht.id_htc}')">Xóa</button>`;
  });
  document.getElementById('htResultCount').innerText = data.length;
}
function updateHienTrangFilters(data) {
  const loSet = new Set(data.map(d => d.ten_lo).filter(v => v));
  const loFilter = document.getElementById('htLoFilter');
  loFilter.innerHTML = '<option value="">Tất cả lô</option>';
  loSet.forEach(lo => { const opt = document.createElement('option'); opt.value = lo; opt.textContent = lo; loFilter.appendChild(opt); });
}
function filterHienTrang() {
  const search = document.getElementById('htSearchInput').value.toLowerCase();
  const lo = document.getElementById('htLoFilter').value;
  const cayCaoMin = parseInt(document.getElementById('htCayCaoMin').value);
  const cayCaoMax = parseInt(document.getElementById('htCayCaoMax').value);
  const filtered = hienTrangData.filter(ht => {
    const text = `${ht.id_htc} ${ht.ten_lo}`.toLowerCase();
    const matchSearch = !search || text.includes(search);
    const matchLo = !lo || ht.ten_lo === lo;
    const matchCayCao = (!cayCaoMin || ht.cay_cao >= cayCaoMin) && (!cayCaoMax || ht.cay_cao <= cayCaoMax);
    return matchSearch && matchLo && matchCayCao;
  });
  renderHienTrangTable(filtered);
}
async function editHienTrang(id) {
  const res = await fetch(`/api/hien-trang-cay/${id}`);
  const data = await res.json();
  if(data.success) showHienTrangForm(data.data);
}
async function deleteHienTrang(id) {
  if(confirm('Xóa hiện trạng này?')) {
    const res = await fetch(`/api/hien-trang-cay/${id}`, { method: 'DELETE' });
    const data = await res.json();
    if(data.success) loadHienTrangCay();
    else alert('Lỗi: ' + data.error);
  }
}
