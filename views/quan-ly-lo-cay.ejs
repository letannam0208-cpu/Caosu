<!DOCTYPE html>
<html lang="vi">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=yes" />
  <title>GIS · TBKRUCO</title>
  <link rel="icon" href="/assets/image/logoTBK.jpg" type="image/jpeg" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link
    href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,300;14..32,400;14..32,500;14..32,600;14..32,700;14..32,800&display=swap"
    rel="stylesheet" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
  <link href="/assets/css/style.css" rel="stylesheet" />
  <style>
    .filter-bar {
      display: grid;
      grid-template-columns: 2fr 1fr 1fr 1fr 1fr 1fr;
      gap: 12px;
      margin-bottom: 12px;
      background: var(--s1);
      padding: 14px;
      border-radius: var(--r-lg);
      border: 1px solid var(--border);
    }

    .search-box,
    .select-filter {
      padding: 10px 14px;
      border-radius: var(--r);
      background: var(--s2);
      border: 1px solid var(--border);
      color: var(--text);
      font-size: 12px;
    }

    .search-box:focus,
    .select-filter:focus {
      outline: none;
      border-color: var(--accent);
    }

    .show-info {
      font-size: 12px;
      color: var(--muted);
      margin-bottom: 12px;
      display: flex;
      align-items: center;
      gap: 6px;
    }

    /* ----- BỐ CỤC BẢNG VỚI THANH CUỘN NGANG CỐ ĐỊNH ----- */
    .table-wrapper {
      background: var(--s1);
      border: 1px solid var(--border);
      border-radius: var(--r-lg);
      box-shadow: var(--shadow-sm);
      display: flex;
      flex-direction: column;
      height: calc(100vh - 280px);
      min-height: 400px;
    }

    .table-container {
      flex: 1;
      overflow-y: auto;
      overflow-x: hidden;
      position: relative;
    }

    table {
      width: 100%;
      border-collapse: collapse;
      font-size: 12px;
      min-width: 2400px;
    }

    thead {
      background: linear-gradient(180deg, var(--s2), var(--s1));
      position: sticky;
      top: 0;
      z-index: 10;
    }

    th,
    td {
      padding: 10px 12px;
      text-align: center;
      border-bottom: 1px solid var(--border);
      white-space: nowrap;
    }

    th {
      font-size: 11px;
      font-weight: 700;
      color: var(--muted2);
      text-transform: uppercase;
      border-bottom: 1px solid var(--border2);
    }

    tbody tr:hover {
      background: rgba(16, 185, 129, 0.04);
    }

    .highlight-row {
      background-color: rgba(0, 214, 143, 0.3) !important;
      transition: background-color 0.5s ease;
      animation: pulse 0.6s ease-in-out 2;
    }

    @keyframes pulse {
      0% {
        background-color: rgba(0, 214, 143, 0.1);
      }

      50% {
        background-color: rgba(0, 214, 143, 0.6);
      }

      100% {
        background-color: rgba(0, 214, 143, 0.3);
      }
    }

    .horizontal-scrollbar {
      overflow-x: auto;
      overflow-y: hidden;
      background: var(--s2);
      border-top: 1px solid var(--border);
      border-radius: 0 0 var(--r-lg) var(--r-lg);
      scrollbar-width: thin;
      scrollbar-color: var(--accent) var(--s3);
    }

    .horizontal-scrollbar::-webkit-scrollbar {
      height: 8px;
    }

    .horizontal-scrollbar::-webkit-scrollbar-track {
      background: var(--s3);
      border-radius: 4px;
    }

    .horizontal-scrollbar::-webkit-scrollbar-thumb {
      background: var(--accent);
      border-radius: 4px;
    }

    .scroll-spacer {
      height: 1px;
      width: 2400px;
    }

    .btn-dash {
      background: rgba(16, 185, 129, 0.2);
      border: 1px solid rgba(16, 185, 129, 0.4);
      color: var(--accent);
      padding: 5px 10px;
      border-radius: var(--r);
      font-size: 11px;
      cursor: pointer;
      font-weight: 600;
    }

    .btn-dash:hover {
      background: rgba(16, 185, 129, 0.3);
      transform: translateY(-1px);
    }

    .btn-view {
      background: rgba(239, 68, 68, 0.2);
      border: 1px solid rgba(239, 68, 68, 0.4);
      color: #fca5a5;
      padding: 5px 10px;
      border-radius: var(--r);
      font-size: 11px;
      cursor: pointer;
      font-weight: 600;
    }

    .btn-view:hover {
      background: rgba(239, 68, 68, 0.3);
      transform: translateY(-1px);
    }

    .btn-location {
      background: rgba(6, 182, 212, 0.2);
      border: 1px solid rgba(6, 182, 212, 0.4);
      color: var(--accentB);
      padding: 5px 10px;
      border-radius: var(--r);
      font-size: 11px;
      cursor: pointer;
      font-weight: 600;
      margin-right: 6px;
    }

    .btn-location:hover {
      background: rgba(6, 182, 212, 0.3);
      transform: translateY(-1px);
    }

    .modal {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: rgba(0, 0, 0, 0.85);
      z-index: 9999;
      display: none;
      align-items: center;
      justify-content: center;
      backdrop-filter: blur(4px);
    }

    .modal-content {
      background: var(--s1);
      border-radius: 20px;
      width: 95%;
      max-width: 1200px;
      max-height: 90vh;
      overflow-y: auto;
      padding: 24px;
      border: 1px solid var(--border2);
    }

    .form-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
      gap: 20px 24px;
      margin-bottom: 24px;
    }

    .form-field {
      display: flex;
      flex-direction: column;
      gap: 6px;
    }

    .form-field label {
      font-size: 12px;
      font-weight: 600;
      color: var(--muted2);
    }

    .form-field input,
    .form-field select {
      padding: 10px 12px;
      background: var(--s2);
      border: 1px solid var(--border);
      border-radius: var(--r);
      color: var(--text);
      font-size: 13px;
    }

    .form-field input:focus,
    .form-field select:focus {
      outline: none;
      border-color: var(--accent);
      box-shadow: 0 0 0 2px rgba(16, 185, 129, 0.2);
    }

    .modal-actions {
      display: flex;
      justify-content: flex-end;
      gap: 12px;
      margin-top: 16px;
      padding-top: 16px;
      border-top: 1px solid var(--border);
    }

    @media (max-width: 1400px) {
      .filter-bar {
        grid-template-columns: 1.5fr 1fr 1fr 1fr 1fr;
      }
    }

    @media (max-width: 1200px) {
      .filter-bar {
        grid-template-columns: 1.5fr 1fr 1fr 1fr;
      }
    }

    @media (max-width: 992px) {
      :root {
        --nav-w: 180px;
      }

      .filter-bar {
        grid-template-columns: 1.5fr 1fr 1fr;
      }
    }

    @media (max-width: 768px) {
      :root {
        --nav-w: 160px;
      }

      #nav {
        padding: 12px 8px;
        width: 160px;
      }

      #topbar {
        padding: 0 16px;
      }

      #content {
        padding: 16px 12px;
      }

      .page-header {
        flex-direction: column;
        align-items: flex-start;
      }

      .page-title {
        font-size: 22px;
      }

      .filter-bar {
        grid-template-columns: 1fr;
        padding: 10px;
        gap: 10px;
      }

      .form-grid {
        grid-template-columns: 1fr;
      }

      .modal-content {
        width: 98%;
        padding: 16px;
      }

      .tb-pill {
        display: none;
      }
    }
  </style>
</head>

<body>
  <div id="topbar">
    <div class="tb-logo">
      <div class="">
        <img src="/assets/image/logoTBK.jpg" alt="Logo" />
      </div>
      <div>
        <div class="tb-title">GIS TBKRUCO</div>
      </div>
    </div>
    <div class="tb-sep"></div>
    <div class="tb-pill">
      <div class="live-dot"></div>
      <span>Trực tuyến</span>
    </div>
    <div class="tb-pill">
      <span>Số lô</span> <strong id="total-lots">0</strong>
    </div>
    <div class="tb-pill">
      <span>Diện tích</span> <strong id="totalArea">0 ha</strong>
    </div>
    <div class="tb-right">
      <div class="tb-user-info">
        <div class="tb-user-name" id="userFullName">Nguyễn Văn An</div>
        <div class="tb-user-role" id="userRole">Quản trị viên</div>
      </div>
      <div class="tb-avatar" id="userAvatar">NA</div>
    </div>
  </div>

  <div id="body">
    <nav id="nav">
      <div class="nav-section-label">Tổng quan</div>
      <a href="/" class="nav-item"><i class="fas fa-home nav-icon"></i>Dashboard</a>
      <div class="nav-section-label">Quản lý dữ liệu</div>
      <a href="/quan-ly-lo-cay" class="nav-item active"><i class="fas fa-tree nav-icon"></i>Quản lý lô</a>
      <a href="/them-du-lieu-lo-cay" class="nav-item"><i class="fas fa-plus-circle nav-icon"></i>Thêm dữ liệu lô</a>
      <% if (user.role === 'admin') { %>
      <div class="nav-section-label">Người dùng</div>
      <a href="/quan-ly-nguoi-dung" class="nav-item"><i class="fas fa-users nav-icon"></i>Quản lý người dùng</a>
      <% } %>
      <div class="nav-section-label">Phân tích</div>
      <a href="/thong-ke" class="nav-item"><i class="fas fa-chart-bar nav-icon"></i>Thống kê</a>

      <div style="
            margin-top: auto;
            border-top: 1px solid var(--border);
            padding-top: 12px;
          " class="nav-logout">
        <a href="/logout" class="nav-item"><i class="fas fa-sign-out-alt nav-icon"></i> Đăng xuất</a>
      </div>
    </nav>
    <div id="content">
      <div class="page-header">
        <div>
          <h1 class="page-title">Quản Lý Lô Cao Su</h1>
          <p class="page-subtitle">
            Toàn bộ thông tin chi tiết của từng lô cây
          </p>
        </div>
        <% if (user.role === 'admin') { %>
        <button id="btnAddLo" class="btn-add" onclick="window.location.href = '/them-du-lieu-lo-cay'">
          <i class="fas fa-upload"></i> Import từ Excel
        </button>
        <% } %>
      </div>
      <div class="filter-bar">
        <input type="text" id="searchInput" class="search-box"
          placeholder="🔍 Tìm kiếm (ID, tên lô, đội, xã, huyện...)" />
        <select id="doiFilter" class="select-filter">
          <option value="">Tất cả đội</option>
        </select>
        <select id="giongFilter" class="select-filter">
          <option value="">Tất cả giống</option>
        </select>
        <select id="namFilter" class="select-filter">
          <option value="">Tất cả năm trồng</option>
        </select>
        <select id="huyenFilter" class="select-filter">
          <option value="">Tất cả huyện</option>
        </select>
        <select id="phanLoaiFilter" class="select-filter">
          <option value="">Phân loại SL</option>
        </select>
      </div>
      <div class="show-info">
        <i class="fas fa-info-circle"></i> Hiển thị
        <strong id="resultCount">0</strong> lô
      </div>

      <div class="table-wrapper">
        <div class="table-container" id="tableContainer">
          <table id="mainTable">
            <thead>
              <tr>
                <th>ID lô</th>
                <th>Dự án</th>
                <th>Đội</th>
                <th>Khu vực</th>
                <th>Tên lô</th>
                <th>Năm trồng</th>
                <th>Hạng đất</th>
                <th>Cao trình TB</th>
                <th>Phương pháp trồng</th>
                <th>Khoảng cách trồng</th>
                <th>Mật độ TK</th>
                <th>Giống</th>
                <th>Diện tích 01/01/25</th>
                <th>Diện tích 01/01/26</th>
                <th>Diện tích map</th>
                <th>Tổng hố KK</th>
                <th>Cây cạo</th>
                <th>Cây chưa cạo</th>
                <th>Cây khô mủ</th>
                <th>Cây không PT</th>
                <th>Hố trống</th>
                <th>Mật độ CC</th>
                <th>Chế độ cạo</th>
                <th>Năm MC</th>
                <th>Tuổi cạo</th>
                <th>Năm cạo úp</th>
                <th>Tình trạng MC</th>
                <th>NS25 kg/ha</th>
                <th>NS25 kg/cây</th>
                <th>Tổng lát cạo</th>
                <th>Phân loại</th>
                <th>Xã</th>
                <th>Huyện</th>
                <th>Tỉnh</th>
                <th>NS26 kg/ha</th>
                <th>NS26 kg/cây</th>
                <th>Sản lượng</th>
                <th>Phiên cạo</th>
                <th>Nhịp độ cạo</th>
                <th>Số phân cạo</th>
                <th>BQ cây cạo phân</th>
                <th>PC bắt đầu</th>
                <th>PC kết thúc</th>
                <th>Tái canh năm</th>
                <th>Đối tượng</th>
                <th>Hành động</th>
              </tr>
            </thead>
            <tbody id="tableBody"></tbody>
          </table>
        </div>
        <div class="horizontal-scrollbar" id="horizontalScrollbar">
          <div class="scroll-spacer" id="scrollSpacer"></div>
        </div>
      </div>
    </div>
  </div>

  <div id="modal" class="modal">
    <div class="modal-content">
      <div style="
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 20px;
          ">
        <h3 id="modalTitle" style="font-family: var(--font-d); font-size: 22px">
          ✏️ Sửa thông tin lô
        </h3>
        <button class="icon-btn" id="closeModal">
          <i class="fas fa-times" style="color: #fff; font-size: 18px"></i>
        </button>
      </div>
      <form id="modalForm"></form>
    </div>
  </div>

  <script>
    let loCayData = [];
    window.userRole = '<%= user.role %>';   // "admin" hoặc "staff"

    async function loadLoCay() {
      try {
        const res = await fetch("/api/lo-cay");
        const data = await res.json();
        if (data.success) {
          loCayData = data.data;
          renderTable(loCayData);
          updateFilters(loCayData);
          document.getElementById("total-lots").innerText = loCayData.length;
          const totalArea = loCayData.reduce(
            (sum, l) => sum + (parseFloat(l.dien_tich_map) || 0),
            0,
          );
          document.getElementById("totalArea").innerHTML =
            totalArea.toLocaleString("vi-VN", {
              minimumFractionDigits: 2,
              maximumFractionDigits: 2,
            }) + " ha";
          syncScrollbarWidth();
          attachHorizontalScroll();
        } else {
          alert("Lỗi tải dữ liệu: " + (data.error || "Không xác định"));
        }
      } catch (err) {
        console.error(err);
        alert("Không thể kết nối đến server");
      }
    }

    function renderTable(data) {
      const tbody = document.getElementById("tableBody");
      tbody.innerHTML = "";
      data.forEach((l) => {
        const row = tbody.insertRow();
        row.id = `row-${l.id_lo}`;
        row.insertCell(0).innerText = l.id_lo || "";
        row.insertCell(1).innerText = l.du_an || "";
        row.insertCell(2).innerText = l.doi || "";
        row.insertCell(3).innerText = l.khu_vuc || "";
        row.insertCell(4).innerText = l.ten_lo || "";
        row.insertCell(5).innerText = l.nam_trong || "";
        row.insertCell(6).innerText = l.hang_dat || "";
        row.insertCell(7).innerText = l.cao_trinh_tb || "";
        row.insertCell(8).innerText = l.phuong_phap_trong || "";
        row.insertCell(9).innerText = l.khoang_cach_trong || "";
        row.insertCell(10).innerText = l.mat_do_tk || "";
        row.insertCell(11).innerText = l.giong || "";
        row.insertCell(12).innerText = l.dien_tich_010125.toLocaleString(
          "vi-VN",
          {
            minimumFractionDigits: 2,
            maximumFractionDigits: 2,
          },
        );
        row.insertCell(13).innerText = l.dien_tich_010126.toLocaleString(
          "vi-VN",
          {
            minimumFractionDigits: 2,
            maximumFractionDigits: 2,
          },
        );
        row.insertCell(14).innerText = l.dien_tich_map.toLocaleString("vi-VN", {
          minimumFractionDigits: 2,
          maximumFractionDigits: 2,
        }) || "";
        row.insertCell(15).innerText = l.tong_ho_kk.toLocaleString("vi-VN") || "";
        row.insertCell(16).innerText = l.cay_cao.toLocaleString("vi-VN") || "";
        row.insertCell(17).innerText = l.cay_chua_cao.toLocaleString("vi-VN") || "";
        row.insertCell(18).innerText = l.cay_kho_mu.toLocaleString("vi-VN") || "";
        row.insertCell(19).innerText = l.cay_khong_pt.toLocaleString("vi-VN") || "";
        row.insertCell(20).innerText = l.ho_trong.toLocaleString("vi-VN") || "";
        row.insertCell(21).innerText = l.mat_do_cc != null ? Math.ceil(parseFloat(l.mat_do_cc)).toLocaleString("vi-VN") : "";
        row.insertCell(22).innerText = l.che_do_cao || "";
        row.insertCell(23).innerText = l.nam_mc || "";
        row.insertCell(24).innerText = l.tuoi_cao || "";
        row.insertCell(25).innerText = l.nam_cao_up || "";
        row.insertCell(26).innerText = l.tinh_trang_mc || "";
        row.insertCell(27).innerText = l.ns25_kg_ha != null ? Math.ceil(parseFloat(l.ns25_kg_ha)).toLocaleString("vi-VN") : "";
        row.insertCell(28).innerText = l.ns25_kg_cay.toLocaleString("vi-VN", {
          minimumFractionDigits: 1,
          maximumFractionDigits: 1,
        }) || "";
        row.insertCell(29).innerText = l.tong_lat_cao.toLocaleString("vi-VN", {
          minimumFractionDigits: 1,
          maximumFractionDigits: 1,
        }) || "";;
        row.insertCell(30).innerText = l.phan_loai || "";
        row.insertCell(31).innerText = l.xa || "";
        row.insertCell(32).innerText = l.huyen || "";
        row.insertCell(33).innerText = l.tinh || "";
        row.insertCell(34).innerText = l.ns26_kg_ha || "";
        row.insertCell(35).innerText = l.ns26_kg_cay || "";
        row.insertCell(36).innerText = l.san_luong || "";
        row.insertCell(37).innerText = l.phien_cao || "";
        row.insertCell(38).innerText = l.nhip_do_cao || "";
        row.insertCell(39).innerText = l.so_phan_cao || "";
        row.insertCell(40).innerText = l.bq_cay_cao_phan || "";
        row.insertCell(41).innerText = l.pc_bat_dau || "";
        row.insertCell(42).innerText = l.pc_ket_thuc || "";
        row.insertCell(43).innerText = l.tai_canh_nam || "";
        row.insertCell(44).innerText = l.doi_tuong || "";
        const actionCell = row.insertCell(45);
        let actionHtml = `<button class="btn-location location-lo" data-id="${l.id_lo}" title="Xem vị trí trên bản đồ"><i class="fas fa-map-marker-alt"></i> 📍</button>`;
          if (window.userRole === 'admin') {
            actionHtml += `<button class="btn-dash edit-lo" data-id="${l.id_lo}"><i class="fas fa-edit"></i> Sửa</button>
                          <button class="btn-view delete-lo" data-id="${l.id_lo}" style="margin-left:8px;"><i class="fas fa-trash"></i> Xóa</button>`;
          }
          actionCell.innerHTML = actionHtml;
      });
      document.getElementById("resultCount").innerText = data.length;
      attachEvents();
      syncScrollbarWidth();
    }

    function attachEvents() {
      document
        .querySelectorAll(".edit-lo")
        .forEach((btn) =>
          btn.addEventListener("click", () => editLo(btn.dataset.id)),
        );
      document
        .querySelectorAll(".delete-lo")
        .forEach((btn) =>
          btn.addEventListener("click", () => deleteLo(btn.dataset.id)),
        );
      document
        .querySelectorAll(".location-lo")
        .forEach((btn) =>
          btn.addEventListener("click", () => showLocation(btn.dataset.id)),
        );
    }

    function showLocation(id) {
      localStorage.setItem("focus_lot_id", id);
      window.location.href = "/";
    }



    async function editLo(id) {
      if (window.userRole !== 'admin') {
        alert('Bạn không có quyền sửa dữ liệu');
        return;
      }
      try {
        const res = await fetch(`/api/lo-cay/${id}`);
        const data = await res.json();

        if (data.success) showForm(data.data);
        else alert("Không tìm thấy dữ liệu lô");
      } catch (err) {
        alert("Lỗi kết nối khi sửa");
      }
    }



    async function deleteLo(id) {
      if (window.userRole !== 'admin') {
        alert('Bạn không có quyền xóa dữ liệu');
        return;
      }
      if (
        confirm(
          "Xóa lô này sẽ xóa tất cả dữ liệu liên quan. Bạn có chắc?",
        )
      ) {
        try {
          const res = await fetch(`/api/lo-cay/${id}`, { method: "DELETE" });
          const data = await res.json();
          if (data.success) {
            alert("✅ Xóa thành công");
            loadLoCay();
          } else alert("❌ Lỗi: " + data.error);
        } catch (err) {
          alert("Lỗi kết nối khi xóa");
        }
      }
    }

    function updateFilters(data) {
      const doiSet = new Set(data.map((l) => l.doi).filter((v) => v));
      const doiSel = document.getElementById("doiFilter");
      doiSel.innerHTML = '<option value="">Tất cả đội</option>';
      [...doiSet].sort().forEach((d) => {
        let opt = document.createElement("option");
        opt.value = d;
        opt.textContent = d;
        doiSel.appendChild(opt);
      });

      const giongSet = new Set(data.map((l) => l.giong).filter((v) => v));
      const giongSel = document.getElementById("giongFilter");
      giongSel.innerHTML = '<option value="">Tất cả giống</option>';
      [...giongSet].sort().forEach((g) => {
        let opt = document.createElement("option");
        opt.value = g;
        opt.textContent = g;
        giongSel.appendChild(opt);
      });

      const namSet = new Set(data.map((l) => l.nam_trong).filter((v) => v));
      const namSel = document.getElementById("namFilter");
      namSel.innerHTML = '<option value="">Tất cả năm</option>';
      [...namSet].sort().forEach((n) => {
        let opt = document.createElement("option");
        opt.value = n;
        opt.textContent = n;
        namSel.appendChild(opt);
      });

      const huyenSet = new Set(data.map((l) => l.huyen).filter((v) => v));
      const huyenSel = document.getElementById("huyenFilter");
      huyenSel.innerHTML = '<option value="">Tất cả huyện</option>';
      [...huyenSet].sort().forEach((h) => {
        let opt = document.createElement("option");
        opt.value = h;
        opt.textContent = h;
        huyenSel.appendChild(opt);
      });

      const phanLoaiSet = new Set(
        data.map((l) => l.phan_loai).filter((v) => v),
      );
      const plSel = document.getElementById("phanLoaiFilter");
      plSel.innerHTML = '<option value="">Phân loại</option>';
      [...phanLoaiSet].sort().forEach((p) => {
        let opt = document.createElement("option");
        opt.value = p;
        opt.textContent = p;
        plSel.appendChild(opt);
      });
    }

    function filterRows() {
      const search = document
        .getElementById("searchInput")
        .value.toLowerCase();
      const doi = document.getElementById("doiFilter").value;
      const giong = document.getElementById("giongFilter").value;
      const nam = document.getElementById("namFilter").value;
      const huyen = document.getElementById("huyenFilter").value;
      const phanLoai = document.getElementById("phanLoaiFilter").value;
      const filtered = loCayData.filter((l) => {
        const text =
          `${l.id_lo} ${l.ten_lo} ${l.doi} ${l.xa} ${l.huyen} ${l.giong}`.toLowerCase();
        return (
          (!search || text.includes(search)) &&
          (!doi || l.doi === doi) &&
          (!giong || l.giong === giong) &&
          (!nam || l.nam_trong == nam) &&
          (!huyen || l.huyen === huyen) &&
          (!phanLoai || l.phan_loai === phanLoai)
        );
      });
      renderTable(filtered);
    }

    function syncScrollbarWidth() {
      const table = document.querySelector("#mainTable");
      const scrollSpacer = document.getElementById("scrollSpacer");
      if (table && scrollSpacer) {
        const tableWidth = table.scrollWidth;
        scrollSpacer.style.width = tableWidth + "px";
      }
    }

    function attachHorizontalScroll() {
      const horizontalScroll = document.getElementById("horizontalScrollbar");
      const tableContainer = document.getElementById("tableContainer");
      if (!horizontalScroll || !tableContainer) return;
      horizontalScroll.removeEventListener("scroll", syncScroll);
      tableContainer.removeEventListener("scroll", syncScrollFromTable);

      function syncScroll() {
        tableContainer.scrollLeft = horizontalScroll.scrollLeft;
      }
      function syncScrollFromTable() {
        horizontalScroll.scrollLeft = tableContainer.scrollLeft;
      }

      horizontalScroll.addEventListener("scroll", syncScroll);
      tableContainer.addEventListener("scroll", syncScrollFromTable);
    }

    // Hiển thị dang form sửa lô
    function showForm(l = null) {
      if (!l) {
        alert(
          'Chức năng thêm mới đã được chuyển sang import file Excel. Vui lòng sử dụng trang "Thêm dữ liệu lô" để nhập hàng loạt.',
        );
        return;
      }
      const val = (obj, field) => {
        if (!obj) return "";
        const v = obj[field];
        return v !== null && v !== undefined ? v : "";
      };

      const formHtml = `
    <input type="hidden" id="id_lo" name="id_lo" value="${val(l, "id_lo")}">
    <div class="form-grid">
      <div class="form-field"><label>Dự án</label><input type="text" name="du_an" value="${val(l, "du_an")}"></div>
      <div class="form-field"><label>Đội *</label><input type="text" name="doi" value="${val(l, "doi")}" required></div>
      <div class="form-field"><label>Khu vực</label><input type="text" name="khu_vuc" value="${val(l, "khu_vuc")}"></div>
      <div class="form-field"><label>Tên lô *</label><input type="text" name="ten_lo" value="${val(l, "ten_lo")}" required></div>
      <div class="form-field"><label>Năm trồng</label><input type="number" name="nam_trong" value="${val(l, "nam_trong")}"></div>
      <div class="form-field"><label>Giống</label><input type="text" name="giong" value="${val(l, "giong")}"></div>
      <div class="form-field"><label>Cao trình TB (m)</label><input type="number" step="0.1" name="cao_trinh_tb" value="${val(l, "cao_trinh_tb")}"></div>
      <div class="form-field"><label>Xã</label><input type="text" name="xa" value="${val(l, "xa")}"></div>
      <div class="form-field"><label>Huyện</label><input type="text" name="huyen" value="${val(l, "huyen")}"></div>
      <div class="form-field"><label>Tỉnh</label><input type="text" name="tinh" value="${val(l, "tinh")}"></div>
      <div class="form-field"><label>Hạng đất</label><input type="text" name="hang_dat" value="${val(l, "hang_dat")}"></div>
      <div class="form-field"><label>Phương pháp trồng</label><input type="text" name="phuong_phap_trong" value="${val(l, "phuong_phap_trong")}"></div>
      <div class="form-field"><label>Khoảng cách trồng</label><input type="text" name="khoang_cach_trong" value="${val(l, "khoang_cach_trong")}"></div>
      <div class="form-field"><label>Mật độ TK</label><input type="number" name="mat_do_tk" value="${val(l, "mat_do_tk")}"></div>
      <div class="form-field"><label>Diện tích map (ha)</label><input type="number" step="0.001" name="dien_tich_map" value="${val(l, "dien_tich_map")}"></div>
      <div class="form-field"><label>Diện tích 01/01/25</label><input type="number" step="0.001" name="dien_tich_010125" value="${val(l, "dien_tich_010125")}"></div>
      <div class="form-field"><label>Diện tích 01/01/26</label><input type="number" step="0.001" name="dien_tich_010126" value="${val(l, "dien_tich_010126")}"></div>
      <div class="form-field"><label>Tổng hộ KK</label><input type="number" name="tong_ho_kk" value="${val(l, "tong_ho_kk")}"></div>
      <div class="form-field"><label>Cây cao</label><input type="number" name="cay_cao" value="${val(l, "cay_cao")}"></div>
      <div class="form-field"><label>Cây chưa cao</label><input type="number" name="cay_chua_cao" value="${val(l, "cay_chua_cao")}"></div>
      <div class="form-field"><label>Cây khô mủ</label><input type="number" name="cay_kho_mu" value="${val(l, "cay_kho_mu")}"></div>
      <div class="form-field"><label>Cây không PT</label><input type="number" name="cay_khong_pt" value="${val(l, "cay_khong_pt")}"></div>
      <div class="form-field"><label>Hố trống</label><input type="number" name="ho_trong" value="${val(l, "ho_trong")}"></div>
      <div class="form-field"><label>Mật độ (cây/ha)</label><input type="number" step="0.1" name="mat_do_cc" value="${val(l, "mat_do_cc")}"></div>
      <div class="form-field"><label>Chế độ cạo</label><input type="text" name="che_do_cao" value="${val(l, "che_do_cao")}"></div>
      <div class="form-field"><label>Phiên cạo</label><input type="text" name="phien_cao" value="${val(l, "phien_cao")}"></div>
      <div class="form-field"><label>Nhịp độ cạo</label><input type="text" name="nhip_do_cao" value="${val(l, "nhip_do_cao")}"></div>
      <div class="form-field"><label>Số phân cạo</label><input type="number" name="so_phan_cao" value="${val(l, "so_phan_cao")}"></div>
      <div class="form-field"><label>Bình quân cây cạo/phân</label><input type="number" name="bq_cay_cao_phan" value="${val(l, "bq_cay_cao_phan")}"></div>
      <div class="form-field"><label>Phân cạo bắt đầu</label><input type="number" name="pc_bat_dau" value="${val(l, "pc_bat_dau")}"></div>
      <div class="form-field"><label>Phân cạo kết thúc</label><input type="number" name="pc_ket_thuc" value="${val(l, "pc_ket_thuc")}"></div>
      <div class="form-field"><label>Năm MC</label><input type="number" name="nam_mc" value="${val(l, "nam_mc")}"></div>
      <div class="form-field"><label>Tuổi cạo</label><input type="number" name="tuoi_cao" value="${val(l, "tuoi_cao")}"></div>
      <div class="form-field"><label>Năm cạo up</label><input type="number" name="nam_cao_up" value="${val(l, "nam_cao_up")}"></div>
      <div class="form-field"><label>Tình trạng mủ</label><input type="text" name="tinh_trang_mc" value="${val(l, "tinh_trang_mc")}"></div>
      <div class="form-field"><label>NS25 kg/ha</label><input type="number" step="0.01" name="ns25_kg_ha" value="${val(l, "ns25_kg_ha")}"></div>
      <div class="form-field"><label>NS25 kg/cây</label><input type="number" step="0.01" name="ns25_kg_cay" value="${val(l, "ns25_kg_cay")}"></div>
      <div class="form-field"><label>NS26 kg/ha</label><input type="number" step="0.01" name="ns26_kg_ha" value="${val(l, "ns26_kg_ha")}"></div>
      <div class="form-field"><label>NS26 kg/cây</label><input type="number" step="0.01" name="ns26_kg_cay" value="${val(l, "ns26_kg_cay")}"></div>
      <div class="form-field"><label>Tổng lát cạo</label><input type="number" step="0.01" name="tong_lat_cao" value="${val(l, "tong_lat_cao")}"></div>
      <div class="form-field"><label>Sản lượng</label><input type="number" step="0.01" name="san_luong" value="${val(l, "san_luong")}"></div>
      <div class="form-field"><label>Phân loại</label><input type="text" name="phan_loai" value="${val(l, "phan_loai")}"></div>
      <div class="form-field"><label>Đối tượng</label><input type="text" name="doi_tuong" value="${val(l, "doi_tuong")}"></div>
      <div class="form-field"><label>Tái canh năm</label><input type="number" name="tai_canh_nam" value="${val(l, "tai_canh_nam")}"></div>
    </div>
    <div class="modal-actions">
      <button type="button" id="cancelModalBtn" class="btn-dash">Hủy</button>
      <button type="submit" class="btn-add">Lưu lại</button>
    </div>
  `;
      document.getElementById("modalForm").innerHTML = formHtml;
      document.getElementById("modalTitle").innerHTML = "✏️ Sửa thông tin lô";
      document.getElementById("modal").style.display = "flex";

      document.getElementById("cancelModalBtn").onclick = () => closeModal();
      document.getElementById("modalForm").onsubmit = async (e) => {
        e.preventDefault();
        const formData = new FormData(e.target);
        const rawData = Object.fromEntries(formData);
        const data = {};
        for (const [key, value] of Object.entries(rawData)) {
          data[key] = value === "" ? null : value;
        }
        const id_lo = document.getElementById("id_lo").value;
        if (!data.ten_lo) {
          alert("Vui lòng nhập tên lô");
          return;
        }
        if (!data.doi) {
          alert("Vui lòng nhập đội");
          return;
        }

        const url = `/api/lo-cay/${id_lo}`;
        try {
          const res = await fetch(url, {
            method: "PUT",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(data),
          });
          const result = await res.json();
          if (result.success) {
            alert("Cập nhật thành công");
            closeModal();
            loadLoCay();
          } else {
            alert("Lỗi: " + result.error);
          }
        } catch (err) {
          alert("Lỗi kết nối khi lưu dữ liệu");
        }
      };
    }

    async function loadUserInfo() {
      try {
        const res = await fetch("/api/me", { credentials: "same-origin" });
        const data = await res.json();
        if (data.success) {
          const user = data.data;
          document.getElementById("userFullName").innerText = user.fullname;
          document.getElementById("userRole").innerText =
            user.role === "admin" ? "Quản trị viên" : "Người dùng";
          document.getElementById("userAvatar").innerText = user.fullname
            .charAt(0)
            .toUpperCase();
        }
      } catch (err) {
        console.error("Lỗi /api/me:", err);
      }
    }

    function closeModal() {
      document.getElementById("modal").style.display = "none";
    }

    // Hàm cuộn đến hàng và làm nổi bật
    function scrollToRowAndHighlight(rowId) {
      const row = document.getElementById(rowId);
      if (row) {
        row.scrollIntoView({ behavior: "smooth", block: "center" });
        row.classList.add("highlight-row");
        setTimeout(() => row.classList.remove("highlight-row"), 3000);
        return true;
      }
      return false;
    }

    // Hàm hiển thị chi tiết lô (cuộn và highlight)
    function viewLotDetail(idLo) {
      const rowId = `row-${idLo}`;
      if (scrollToRowAndHighlight(rowId)) return;
      // Nếu không tìm thấy, hỏi xóa bộ lọc
      if (
        confirm(
          `Lô ${idLo} không hiển thị do bộ lọc. Bạn có muốn xóa bộ lọc để hiển thị không?`,
        )
      ) {
        document.getElementById("searchInput").value = "";
        document.getElementById("doiFilter").value = "";
        document.getElementById("giongFilter").value = "";
        document.getElementById("namFilter").value = "";
        document.getElementById("huyenFilter").value = "";
        document.getElementById("phanLoaiFilter").value = "";
        renderTable(loCayData);
        setTimeout(() => {
          if (!scrollToRowAndHighlight(rowId)) {
            alert("Không thể tìm thấy lô. Có thể lô đã bị xóa.");
          }
        }, 100);
      }
    }

    document.addEventListener("DOMContentLoaded", function () {
      loadUserInfo();
      loadLoCay().then(() => {
        const viewId = localStorage.getItem("view_lot_id");
        if (viewId) {
          localStorage.removeItem("view_lot_id");
          viewLotDetail(viewId);
        }
        const editId = localStorage.getItem("edit_lot_id");
        if (editId) {
          localStorage.removeItem("edit_lot_id");
          editLo(editId);
        }
      });
    });

    window.addEventListener("resize", () => syncScrollbarWidth());
    document
      .getElementById("closeModal")
      .addEventListener("click", closeModal);
    document
      .getElementById("searchInput")
      .addEventListener("input", filterRows);
    document
      .getElementById("doiFilter")
      .addEventListener("change", filterRows);
    document
      .getElementById("giongFilter")
      .addEventListener("change", filterRows);
    document
      .getElementById("namFilter")
      .addEventListener("change", filterRows);
    document
      .getElementById("huyenFilter")
      .addEventListener("change", filterRows);
    document
      .getElementById("phanLoaiFilter")
      .addEventListener("change", filterRows);
  </script>
</body>

</html>