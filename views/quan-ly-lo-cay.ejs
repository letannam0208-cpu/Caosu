    <div class="form-grid">
      <div class="form-field"><label>Tên lô *</label><input type="text" name="ten_lo" value="${l ? l.ten_lo : ''}" required placeholder="VD: Lô A1"></div>
      <div class="form-field"><label>Năm trồng</label><input type="number" name="nam_trong" value="${l ? l.nam_trong : ''}" placeholder="2020"></div>
      <div class="form-field"><label>Giống</label><input type="text" name="giong" value="${l ? l.giong : ''}" placeholder="PB 260"></div>
      <div class="form-field"><label>Cao trình TB (m)</label><input type="number" step="0.1" name="cao_trinh_tb" value="${l ? l.cao_trinh_tb : ''}" placeholder="120.5"></div>
      <div class="form-field"><label>Đội *</label><select name="id_don_vi" id="id_don_vi" required></select></div>
      <div class="form-field"><label>Hành chính</label><select name="id_hc" id="id_hc"></select></div>
      <div class="form-field"><label>Hạng đất</label><input type="text" name="hang_dat" value="${l ? l.hang_dat : ''}" placeholder="Hạng I"></div>
      <div class="form-field"><label>Phương pháp trồng</label><input type="text" name="phuong_phap_trong" value="${l ? l.phuong_phap_trong : ''}" placeholder="Trồng thuần"></div>
      <div class="form-field"><label>Khoảng cách trồng</label><input type="text" name="khoang_cach_trong" value="${l ? l.khoang_cach_trong : ''}" placeholder="7x3m"></div>
      <div class="form-field"><label>Mật độ TK</label><input type="number" name="mat_do_tk" value="${l ? l.mat_do_tk : ''}" placeholder="cây/ha"></div>
      <div class="form-field"><label>Diện tích map (ha)</label><input type="number" step="0.001" name="dien_tich_map" value="${l ? l.dien_tich_map : ''}" placeholder="10.5"></div>
      <div class="form-field"><label>Diện tích 01/01/25</label><input type="number" step="0.001" name="dien_tich_010125" value="${l ? l.dien_tich_010125 : ''}"></div>
      <div class="form-field"><label>Diện tích 01/01/26</label><input type="number" step="0.001" name="dien_tich_010126" value="${l ? l.dien_tich_010126 : ''}"></div>
      <div class="form-field"><label>Tổng hộ KK</label><input type="number" name="tong_ho_kk" value="${l ? l.tong_ho_kk : ''}"></div>
      <div class="form-field"><label>Cây cao</label><input type="number" name="cay_cao" value="${l ? l.cay_cao : ''}"></div>
      <div class="form-field"><label>Cây chưa cao</label><input type="number" name="cay_chua_cao" value="${l ? l.cay_chua_cao : ''}"></div>
      <div class="form-field"><label>Cây khô mủ</label><input type="number" name="cay_kho_mu" value="${l ? l.cay_kho_mu : ''}"></div>
      <div class="form-field"><label>Cây không PT</label><input type="number" name="cay_khong_pt" value="${l ? l.cay_khong_pt : ''}"></div>
      <div class="form-field"><label>Hố trống</label><input type="number" name="ho_trong" value="${l ? l.ho_trong : ''}"></div>
      <div class="form-field"><label>Mật độ (cây/ha)</label><input type="number" step="0.1" name="mat_do_cc" value="${l ? l.mat_do_cc : ''}"></div>
      <div class="form-field"><label>Chế độ cạo</label><input type="text" name="che_do_cao" value="${l ? l.che_do_cao : ''}" placeholder="S/2 d/3"></div>
      <div class="form-field"><label>Phiên cạo</label><input type="text" name="phien_cao" value="${l ? l.phien_cao : ''}" placeholder="Phiên 1"></div>
      <div class="form-field"><label>Nhịp độ cạo</label><input type="text" name="nhip_do_cao" value="${l ? l.nhip_do_cao : ''}" placeholder="3 ngày/lần"></div>
      <div class="form-field"><label>Năm MC</label><input type="number" name="nam_mc" value="${l ? l.nam_mc : ''}"></div>
      <div class="form-field"><label>Tuổi cạo</label><input type="number" name="tuoi_cao" value="${l ? l.tuoi_cao : ''}"></div>
