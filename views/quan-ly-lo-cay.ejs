  document.getElementById('ttResultCount').innerText = data.length;
}
function updateThongTinTrongFilters(data) {
  const hangDatSet = new Set(data.map(d => d.hang_dat).filter(v => v));
  const hangDatFilter = document.getElementById('ttHangDatFilter');
  hangDatFilter.innerHTML = '<option value="">Hạng đất</option>';
  hangDatSet.forEach(hd => { const opt = document.createElement('option'); opt.value = hd; opt.textContent = hd; hangDatFilter.appendChild(opt); });
  const phuongPhapSet = new Set(data.map(d => d.phuong_phap_trong).filter(v => v));
  const phuongPhapFilter = document.getElementById('ttPhuongPhapFilter');
  phuongPhapFilter.innerHTML = '<option value="">Phương pháp trồng</option>';
  phuongPhapSet.forEach(pp => { const opt = document.createElement('option'); opt.value = pp; opt.textContent = pp; phuongPhapFilter.appendChild(opt); });
}
function filterThongTinTrong() {
  const search = document.getElementById('ttSearchInput').value.toLowerCase();
  const hangDat = document.getElementById('ttHangDatFilter').value;
  const phuongPhap = document.getElementById('ttPhuongPhapFilter').value;
  const filtered = thongTinTrongData.filter(tt => {
    const text = `${tt.id_ttt} ${tt.ten_lo} ${tt.hang_dat} ${tt.phuong_phap_trong}`.toLowerCase();
    const matchSearch = !search || text.includes(search);
    const matchHangDat = !hangDat || tt.hang_dat === hangDat;
    const matchPhuongPhap = !phuongPhap || tt.phuong_phap_trong === phuongPhap;
    return matchSearch && matchHangDat && matchPhuongPhap;
  });
  renderThongTinTrongTable(filtered);
}
async function editThongTinTrong(id) {
  const res = await fetch(`/api/thong-tin-trong/${id}`);
  const data = await res.json();
  if(data.success) showThongTinTrongForm(data.data);
}
async function deleteThongTinTrong(id) {
  if(confirm('Xóa thông tin trồng này?')) {
    const res = await fetch(`/api/thong-tin-trong/${id}`, { method: 'DELETE' });
    const data = await res.json();
    if(data.success) loadThongTinTrong();
    else alert('Lỗi: ' + data.error);
  }
}
function showThongTinTrongForm(tt = null) {
  const formHtml = `
    <input type="hidden" id="id_ttt" name="id_ttt" value="${tt ? tt.id_ttt : ''}">
    <div><label>ID Lô</label><select id="id_lo" name="id_lo" class="select-filter" style="width:100%;"></select></div>
    <div style="display:grid; grid-template-columns:1fr 1fr; gap:12px;">
      <div><label>Hạng đất</label><input type="text" name="hang_dat" class="search-box" value="${tt ? tt.hang_dat : ''}"></div>
      <div><label>Phương pháp trồng</label><input type="text" name="phuong_phap_trong" class="search-box" value="${tt ? tt.phuong_phap_trong : ''}"></div>
      <div><label>Khoảng cách trồng</label><input type="text" name="khoang_cach_trong" class="search-box" value="${tt ? tt.khoang_cach_trong : ''}"></div>
      <div><label>Mật độ TK</label><input type="number" name="mat_do_tk" class="search-box" value="${tt ? tt.mat_do_tk : ''}"></div>
    </div>
    <div style="margin-top:24px; text-align:right;">
      <button type="button" id="cancelModalBtn" class="btn-dash">Hủy</button>
      <button type="submit" class="btn-add">Lưu</button>
    </div>
  `;
  document.getElementById('modalForm').innerHTML = formHtml;
  document.getElementById('modalTitle').innerText = tt ? 'Sửa thông tin trồng' : 'Thêm thông tin trồng';
  document.getElementById('modal').style.display = 'flex';
  loadLoOptions('id_lo', tt ? tt.id_lo : null);
  
  const cancelBtn = document.getElementById('cancelModalBtn');
  if(cancelBtn) cancelBtn.onclick = closeModal;
  
  const form = document.getElementById('modalForm');
  form.onsubmit = async (e) => {
    e.preventDefault();
    const formData = new FormData(e.target);
    const data = Object.fromEntries(formData);
    const id = document.getElementById('id_ttt').value;
    const url = id ? `/api/thong-tin-trong/${id}` : '/api/thong-tin-trong';
    const method = id ? 'PUT' : 'POST';
    const res = await fetch(url, { method, headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(data) });
    const result = await res.json();
    if(result.success) {
      closeModal();
      loadThongTinTrong();
      alert('Thành công');
    } else {
      alert('Lỗi: ' + result.error);
    }
  };
}
document.getElementById('ttSearchInput')?.addEventListener('input', filterThongTinTrong);
document.getElementById('ttHangDatFilter')?.addEventListener('change', filterThongTinTrong);
document.getElementById('ttPhuongPhapFilter')?.addEventListener('change', filterThongTinTrong);

// ==================== CHUYỂN TAB ====================
document.querySelectorAll('.tab-btn').forEach(btn => {
  btn.addEventListener('click', () => {
    const tabId = btn.dataset.tab;
    document.querySelectorAll('.tab-content').forEach(tab => tab.classList.remove('active'));
    document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
    document.getElementById(`tab-${tabId}`).classList.add('active');
    btn.classList.add('active');
    if(tabId === 'lo') loadLoCay();
    if(tabId === 'donvi') loadDonVi();
    if(tabId === 'dientich') loadDienTich();
    if(tabId === 'hanhchinh') loadHanhChinh();
    if(tabId === 'hientrang') loadHienTrangCay();
    if(tabId === 'khaitac') loadKhaiThac();
    if(tabId === 'sanluong') loadSanLuong();
    if(tabId === 'thongtintrong') loadThongTinTrong();
  });
});

// ==================== KHỞI TẠO ====================
document.getElementById('closeModal')?.addEventListener('click', closeModal);
document.getElementById('btnAddLo')?.addEventListener('click', () => showLoForm());

loadGiongFilter();
loadLoCay();
</script>
</body>
</html>