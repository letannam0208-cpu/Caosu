      <div class="form-field"><label>Sản lượng</label><input type="number" step="0.01" name="san_luong" value="${l ? l.san_luong : ''}"></div>
      <div class="form-field"><label>Phân loại</label><input type="text" name="phan_loai" value="${l ? l.phan_loai : ''}" placeholder="Loại A"></div>
      <div class="form-field"><label>Đối tượng</label><input type="text" name="doi_tuong" value="${l ? l.doi_tuong : ''}"></div>
      <div class="form-field"><label>Tái canh năm</label><input type="number" name="tai_canh_nam" value="${l ? l.tai_canh_nam : ''}"></div>
    </div>
    <div class="modal-actions">
      <button type="button" id="cancelModalBtn" class="btn-dash"><i class="fas fa-times"></i> Hủy</button>
      <button type="submit" class="btn-add"><i class="fas fa-save"></i> Lưu lại</button>
    </div>
  `;
  document.getElementById('modalForm').innerHTML = formHtml;
  document.getElementById('modalTitle').innerHTML = isEdit ? '<i class="fas fa-edit"></i> ✏️ Sửa lô cây' : '<i class="fas fa-plus-circle"></i> ➕ Thêm lô cây mới';
  document.getElementById('modal').style.display = 'flex';
  
  loadDonViList(l ? l.id_don_vi : null);
  loadHanhChinhList(l ? l.id_hc : null);
  
  document.getElementById('cancelModalBtn').onclick = () => closeModal();
  document.getElementById('modalForm').onsubmit = async (e) => {
    e.preventDefault();
    const formData = new FormData(e.target);
    const data = Object.fromEntries(formData);
    const id_lo = document.getElementById('id_lo').value;
    if(!data.id_don_vi) { alert('⚠️ Vui lòng chọn đội'); return; }
    const url = id_lo ? `/api/lo-cay/${id_lo}` : '/api/lo-cay';
    const method = id_lo ? 'PUT' : 'POST';
    const res = await fetch(url, { method, headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(data) });
    const result = await res.json();
    if(result.success) {
      alert(id_lo ? '✅ Cập nhật thành công' : '✅ Thêm thành công');
      closeModal();
      loadLoCay();
    } else alert('❌ Lỗi: ' + result.error);
  };
}

async function loadDonViList(selectedId) {
  const res = await fetch('/api/don-vi-list');
  const data = await res.json();
  if(data.success) {
    const select = document.getElementById('id_don_vi');
    select.innerHTML = '<option value="">-- Chọn đơn vị --</option>';
    data.data.forEach(dv => {
      const opt = document.createElement('option');
      opt.value = dv.id_don_vi;
      opt.textContent = dv.doi;
      if(selectedId && selectedId === dv.id_don_vi) opt.selected = true;
      select.appendChild(opt);
    });
  }
}
async function loadHanhChinhList(selectedId) {
  const res = await fetch('/api/hanh-chinh');
  const data = await res.json();
  if(data.success) {
    const select = document.getElementById('id_hc');
    select.innerHTML = '<option value="">-- Chọn xã/huyện --</option>';
    data.data.forEach(hc => {
      const opt = document.createElement('option');
      opt.value = hc.id_hc;
      opt.textContent = `${hc.xa}, ${hc.huyen}`;
      if(selectedId && selectedId === hc.id_hc) opt.selected = true;
      select.appendChild(opt);
    });
  }
}
function closeModal() { document.getElementById('modal').style.display = 'none'; }

document.getElementById('closeModal').addEventListener('click', closeModal);
document.getElementById('btnAddLo').addEventListener('click', () => showForm());
document.getElementById('searchInput').addEventListener('input', filterRows);
document.getElementById('doiFilter').addEventListener('change', filterRows);
document.getElementById('giongFilter').addEventListener('change', filterRows);
document.getElementById('namFilter').addEventListener('change', filterRows);
document.getElementById('huyenFilter').addEventListener('change', filterRows);
document.getElementById('phanLoaiFilter').addEventListener('change', filterRows);

loadLoCay();
</script>
