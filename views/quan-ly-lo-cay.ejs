        <div><label>Mật độ (cây/ha)</label><input type="number" step="0.1" id="mat_do_cc" name="mat_do_cc" class="search-box" value="${l ? l.mat_do_cc : ''}"></div>
      </div>
      <h4>Khai thác</h4>
      <div style="display:grid; grid-template-columns:repeat(3,1fr); gap:12px;">
        <div><label>Chế độ cạo</label><input type="text" id="che_do_cao" name="che_do_cao" class="search-box" value="${l ? l.che_do_cao : ''}"></div>
