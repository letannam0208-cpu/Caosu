function loadDonViList(selectedId = null) {
  fetch('/api/don-vi-list').then(res => res.json()).then(data => {
    if(data.success) {
      const select = document.getElementById('id_don_vi');
      if(select) {
        select.innerHTML = '<option value="">Chọn đơn vị</option>';
        data.data.forEach(dv => {
          const opt = document.createElement('option');
          opt.value = dv.id_don_vi;
          opt.textContent = dv.doi;
          if(selectedId && selectedId == dv.id_don_vi) opt.selected = true;
          select.appendChild(opt);
        });
      }
    }
  }).catch(err => console.error('Lỗi load đơn vị:', err));
}

function loadHanhChinhList(selectedId = null) {
  fetch('/api/hanh-chinh').then(res => res.json()).then(data => {
    if(data.success) {
      const select = document.getElementById('id_hc');
      if(select) {
        select.innerHTML = '<option value="">Chọn xã/huyện</option>';
        data.data.forEach(hc => {
          const opt = document.createElement('option');
          opt.value = hc.id_hc;
          opt.textContent = `${hc.xa}, ${hc.huyen}`;
          if(selectedId && selectedId == hc.id_hc) opt.selected = true;
          select.appendChild(opt);
        });
      }
    }
  }).catch(err => console.error('Lỗi load hành chính:', err));
}

function updateLoFilters(loCay) {
  const years = [...new Set(loCay.map(l => l.nam_trong).filter(y => y))].sort();
  const namSelect = document.getElementById('namFilter');
  if(namSelect) {
    namSelect.innerHTML = '<option value="">Tất cả năm</option>';
    years.forEach(y => { const opt = document.createElement('option'); opt.value = y; opt.textContent = y; namSelect.appendChild(opt); });
  }
  const doiSelect = document.getElementById('doiFilter');
  if(doiSelect) {
    const dois = [...new Set(loCay.map(l => l.doi).filter(d => d))];
    dois.forEach(d => { const opt = document.createElement('option'); opt.value = d; opt.textContent = d; doiSelect.appendChild(opt); });
  }
}

function loadGiongFilter() {
  fetch('/api/giong-stats').then(res => res.json()).then(data => {
    if(data.success) {
      const select = document.getElementById('giongFilter');
      if(select) {
        select.innerHTML = '<option value="">Tất cả giống</option>';
        data.data.forEach(g => { const opt = document.createElement('option'); opt.value = g.giong; opt.textContent = g.giong; select.appendChild(opt); });
      }
    }
  });
}

function filterRows() {
  const search = document.getElementById('searchInput')?.value.toLowerCase() || '';
  const doi = document.getElementById('doiFilter')?.value || '';
  const giong = document.getElementById('giongFilter')?.value || '';
  const nam = document.getElementById('namFilter')?.value || '';
  const rows = document.querySelectorAll('#tableBody tr');
  let visible = 0;
  rows.forEach(row => {
    const text = row.innerText.toLowerCase();
    const matchSearch = !search || text.includes(search);
    const matchDoi = !doi || (row.cells[2]?.innerText.includes(doi) || false);
    const matchGiong = !giong || (row.cells[3]?.innerText.toLowerCase().includes(giong.toLowerCase()) || false);
    const matchNam = !nam || (row.cells[4]?.innerText === nam);
    const show = matchSearch && matchDoi && matchGiong && matchNam;
    row.style.display = show ? '' : 'none';
    if(show) visible++;
  });
  const resultCount = document.getElementById('resultCount');
  if(resultCount) resultCount.innerText = visible;
}
