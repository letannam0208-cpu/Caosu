<script>
  // ==================== QUẢN LÝ LÔ CÂY (TAB LO) ====================
  async function loadLoCay() {
    const res = await fetch('/api/lo-cay');
    const data = await res.json();
    if(data.success) {
      renderLoTable(data.data);
      updateLoFilters(data.data);
    }
  }
  function renderLoTable(loCay) {
    const tbody = document.getElementById('tableBody');
    tbody.innerHTML = '';
    loCay.forEach(l => {
      const row = tbody.insertRow();
      row.insertCell(0).innerHTML = `<span class="cell-name">${l.ten_lo || ''}</span>`;
      row.insertCell(1).innerHTML = `<span class="cell-code">${l.id_lo}</span>`;
      row.insertCell(2).innerHTML = `<span class="cell-farm-badge">${l.doi || ''}</span>`;
      row.insertCell(3).innerHTML = `<span class="species-badge">${l.giong || ''}</span>`;
      row.insertCell(4).innerHTML = l.nam_trong || '';
      row.insertCell(5).innerHTML = l.dien_tich_map ? `${l.dien_tich_map} ha` : '';
      const actionCell = row.insertCell(6);
      actionCell.innerHTML = `
        <button class="btn-dash edit-lo" data-id="${l.id_lo}"><i class="fas fa-edit"></i> Sửa</button>
        <button class="btn-view delete-lo" data-id="${l.id_lo}" style="margin-left:8px;"><i class="fas fa-trash"></i> Xóa</button>
      `;
    });
    document.querySelectorAll('.edit-lo').forEach(btn => btn.addEventListener('click', () => editLo(btn.dataset.id)));
    document.querySelectorAll('.delete-lo').forEach(btn => btn.addEventListener('click', () => deleteLo(btn.dataset.id)));
    document.getElementById('resultCount').innerText = loCay.length;
  }
  function filterRows() {
    const search = document.getElementById('searchInput').value.toLowerCase();
    const doi = document.getElementById('doiFilter').value;
    const giong = document.getElementById('giongFilter').value;
    const nam = document.getElementById('namFilter').value;
    const rows = document.querySelectorAll('#tableBody tr');
    let visible = 0;
    rows.forEach(row => {
      const text = row.innerText.toLowerCase();
      const matchSearch = !search || text.includes(search);
      const matchDoi = !doi || (row.cells[2].innerText.includes(doi));
      const matchGiong = !giong || (row.cells[3].innerText.toLowerCase().includes(giong.toLowerCase()));
      const matchNam = !nam || (row.cells[4].innerText === nam);
      const show = matchSearch && matchDoi && matchGiong && matchNam;
      row.style.display = show ? '' : 'none';
      if(show) visible++;
    });
    document.getElementById('resultCount').innerText = visible;
  }
  function updateLoFilters(loCay) {
    const years = [...new Set(loCay.map(l => l.nam_trong).filter(y => y))].sort();
    const namSelect = document.getElementById('namFilter');
    namSelect.innerHTML = '<option value="">Tất cả năm</option>';
    years.forEach(y => { const opt = document.createElement('option'); opt.value = y; opt.textContent = y; namSelect.appendChild(opt); });
    const doiSelect = document.getElementById('doiFilter');
    const dois = [...new Set(loCay.map(l => l.doi).filter(d => d))];
    dois.forEach(d => { const opt = document.createElement('option'); opt.value = d; opt.textContent = d; doiSelect.appendChild(opt); });
  }
  async function loadGiongFilter() {
    const res = await fetch('/api/giong-stats');
    const data = await res.json();
    if(data.success) {
      const select = document.getElementById('giongFilter');
      select.innerHTML = '<option value="">Tất cả giống</option>';
      data.data.forEach(g => { const opt = document.createElement('option'); opt.value = g.giong; opt.textContent = g.giong; select.appendChild(opt); });
    }
  }
  async function loadDonViListForFilter() {
    const res = await fetch('/api/don-vi-list');
    const data = await res.json();
    if(data.success) {
      const select = document.getElementById('id_don_vi');
      select.innerHTML = '<option value="">Chọn đơn vị</option>';
      data.data.forEach(dv => { const opt = document.createElement('option'); opt.value = dv.doi; opt.textContent = dv.doi; select.appendChild(opt); });
    }
  }
  async function loadHanhChinhList() {
    const res = await fetch('/api/hanh-chinh-list');
    const data = await res.json();
    if(data.success) {
      const select = document.getElementById('id_hc');
      select.innerHTML = '<option value="">Chọn xã/huyện</option>';
      data.data.forEach(hc => { const opt = document.createElement('option'); opt.value = hc.id_hc; opt.textContent = `${hc.xa}, ${hc.huyen}`; select.appendChild(opt); });
    }
  }
  async function editLo(id) {
    const res = await fetch(`/api/lo-cay/${id}`);
    const data = await res.json();
    if(data.success) {
      const l = data.data;
      // Hiển thị modal với form lo cây (tái sử dụng)
      showLoForm(l);
    }
  }
